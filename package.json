{
	"name": "pokenavi",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"prebuild": "python3 scripts/sync_article_meta.py",
		"build": "astro build && rm -rf dist/sim-data-verify",
		"deploy": "npm run build && rm -f dist/sim-data/saved.json && npx wrangler pages deploy dist --project-name pokenavi --branch main && python3 scripts/request_indexing.py --all-posts",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/mdx": "^5.0.6",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.2",
		"astro": "^6.3.5",
		"sharp": "^0.34.3"
	}
}
