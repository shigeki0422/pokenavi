---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AdUnit from '../components/AdUnit.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MentionedPokemon from '../components/MentionedPokemon.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SimPartyCard from '../components/SimPartyCard.astro';
import articleMeta from '../data/article-meta.json';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string; body?: string };

const { title, description, pubDate, updatedDate, heroImage, slug, body } = Astro.props;
const blogPokemonName = slug ? (articleMeta as Record<string, { name: string }>)[slug]?.name : undefined;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pokenavi.jp';
const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	inLanguage: 'ja',
	articleSection: 'ポケモン対戦考察',
	image: heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Organization', name: 'ポケナビ', url: siteUrl },
	publisher: { '@type': 'Organization', name: 'ポケナビ', url: siteUrl, logo: { '@type': 'ImageObject', url: siteUrl + '/logo-mark.png' } },
	mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'ホーム', item: siteUrl + '/' },
		{ '@type': 'ListItem', position: 2, name: 'ブログ', item: siteUrl + '/blog/' },
		{ '@type': 'ListItem', position: 3, name: title, item: articleUrl },
	],
};
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" pubDate={pubDate} updatedDate={updatedDate} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 780px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 0.5em 1em 2em;
				color: rgb(var(--gray-dark));
				font-size: 15px;
				line-height: 1.6;
			}
			.breadcrumb ol { display: flex; flex-wrap: wrap; list-style: none; margin: 0 0 .3em; padding: 0; font-size: .75rem; color: rgb(var(--gray)); }
			.breadcrumb { margin-top: .75em; }
			.breadcrumb li + li::before { content: '›'; padding: 0 .35em; }
			.breadcrumb a { color: rgb(var(--gray)); text-decoration: none; }
			.breadcrumb a:hover { text-decoration: underline; }
			.breadcrumb [aria-current] { color: rgb(var(--gray-dark)); font-weight: 600; }
			.title {
				margin-bottom: 0.6em;
				padding: 0.5em 0 0.25em;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.4em;
				font-size: 1.3rem;
				line-height: 1.35;
				text-align: left;
				color: rgb(var(--black));
			}
			.date {
				margin-bottom: 0.4em;
				color: rgb(var(--gray));
				font-size: 0.82rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			/* グローバルCSS の過剰スペースを記事ページに限り圧縮 */
			:global(.prose p) { margin-bottom: 0.75em; }
			:global(.prose hr) { margin: 0.4rem 0; border-color: #f1f5f9; }
			:global(.prose h2) {
				font-size: 1rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 1.5rem 0 0.6rem;
				padding: 0.45rem 0.9rem;
				background: #f8fafc;
				border-left: 3px solid var(--accent, #f97316);
				border-radius: 0 6px 6px 0;
			}
			:global(.prose h3) {
				font-size: 0.95rem;
				font-weight: 700;
				margin: 1rem 0 0.4rem;
				color: rgb(var(--black));
			}
			:global(.prose h1) { font-size: 1.3rem; }
			:global(.prose th) { white-space: nowrap; }
			:global(.prose table) { display: block; overflow-x: auto; max-width: 100%; }
			.share-row { display: flex; gap: 8px; margin: 1.5em 0 0.5em; }
			.share-x {
				display: inline-flex; align-items: center; gap: 6px;
				padding: 7px 16px; border-radius: 8px;
				background: #000; color: #fff;
				font-size: 0.82rem; font-weight: 700; text-decoration: none;
				transition: opacity 0.15s;
			}
			.share-x:hover { opacity: 0.8; color: #fff; }
			@media (max-width: 720px) {
				.prose { font-size: 14px; padding: 0.5em 0.75em 2em; }
				/* 記事内ポケモン画像をモバイルで縮小 */
				:global(.poke-header img:not([src*="/images/types/"])) { width: 64px !important; height: 64px !important; }
				:global(.poke-header img[src*="/images/types/"]) { width: 28px !important; height: 28px !important; }
				:global(.partner-card img) { width: 44px !important; height: 44px !important; }
				:global(.partner-grid) { grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)) !important; gap: 8px !important; }
			}
			.sim-cta { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin: 2rem 0 0; padding: 1rem 1.25rem; background: #f0f4ff; border-left: 4px solid var(--accent); border-radius: 4px; text-decoration: none; flex-wrap: wrap; }
			.sim-cta span { font-size: .88rem; color: #1e293b; }
			.sim-cta-arrow { font-weight: 700; color: var(--accent); white-space: nowrap; }
			.sim-cta:hover { background: #e0e8ff; }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<nav class="breadcrumb" aria-label="パンくずリスト">
						<ol>
							<li><a href="/">ホーム</a></li>
							<li><a href="/blog/">考察記事</a></li>
							<li aria-current="page">{title}</li>
						</ol>
					</nav>
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					{blogPokemonName && <SimPartyCard pokemonName={blogPokemonName} />}
					<div class="share-row">
						<a
							class="share-x"
							href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(articleUrl)}`}
							target="_blank"
							rel="noopener noreferrer"
						>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.402 6.231H2.746l7.73-8.835L2.195 2.25H8.48l4.264 5.633 5.5-5.633Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg>
							Xでシェア
						</a>
					</div>
					<AdUnit />
					{body && <MentionedPokemon currentSlug={slug ?? ''} body={body} />}
					<RelatedPosts currentSlug={slug ?? ''} />
					{blogPokemonName && (
						<a class="sim-cta" href={`/simulator-mb/?sf=${encodeURIComponent(blogPokemonName)}`}>
							<span>{blogPokemonName}入りの上位構築で対戦シミュレーション</span>
							<span class="sim-cta-arrow">M-Bシミュレーターで試す →</span>
						</a>
					)}
				</div>
			</article>
		</main>
		<Footer />
		<script>
			// タイプアイコン横のテキスト名を削除 → タップでツールチップ
			(function () {
				const tip = document.createElement('div');
				tip.style.cssText = 'position:fixed;background:#1e293b;color:#fff;padding:3px 10px;border-radius:6px;font-size:0.78rem;font-weight:600;z-index:300;pointer-events:none;opacity:0;transition:opacity 0.15s;transform:translateX(-50%);white-space:nowrap;';
				document.body.appendChild(tip);
				let tipTimer;

				document.querySelectorAll('img[src*="/images/types/"]').forEach(img => {
					// 直後のテキストノードがalt名（または「alt名・」区切り）に一致する場合に削除
					let next = img.nextSibling;
					while (next && next.nodeType === 3) {
						const n = next;
						next = n.nextSibling;
						const t = n.textContent.trim();
						if (
							t === img.alt ||
							t === img.alt + '・' ||
							t.startsWith(img.alt + '（×') ||
							t.startsWith(img.alt + '(×')
						) n.remove();
					}
					img.style.cursor = 'pointer';
					img.addEventListener('click', e => {
						e.stopPropagation();
						clearTimeout(tipTimer);
						const r = img.getBoundingClientRect();
						tip.textContent = img.alt;
						tip.style.left = (r.left + r.width / 2) + 'px';
						tip.style.top = Math.max(4, r.top - 30) + 'px';
						tip.style.opacity = '1';
						tipTimer = setTimeout(() => tip.style.opacity = '0', 1800);
					});
				});
				document.addEventListener('click', () => { clearTimeout(tipTimer); tip.style.opacity = '0'; });
			})();

			(async function () {
				const res = await fetch('/pokemon-map.json');
				if (!res.ok) return;
				const map = await res.json();

				function dexKeyFromImg(img) {
					const m = img.src.match(/pokemon-(\d{4}-\d{2})\.webp/);
					return m ? m[1] : null;
				}

				// poke-header の h2 をリンク化
				const header = document.querySelector('.poke-header');
				if (header) {
					const img = header.querySelector('img:not([src*="/images/types/"])');
					const h2 = header.querySelector('h2');
					if (img && h2) {
						const key = dexKeyFromImg(img);
						const url = key && map[key];
						if (url && !h2.querySelector('a')) {
							const a = document.createElement('a');
							a.href = url;
							a.style.cssText = 'color:inherit;text-decoration:underline;text-decoration-color:#cbd5e1;';
							a.innerHTML = h2.innerHTML;
							h2.innerHTML = '';
							h2.appendChild(a);
						}
					}
				}

				// 有利・不利テーブルのポケモンセルをリンク化
				document.querySelectorAll('td img[src*="/images/pokemon/pokemon-"]').forEach(img => {
					const td = img.closest('td');
					if (!td || td.querySelector('a')) return;
					const key = dexKeyFromImg(img);
					const url = key && map[key];
					if (!url) return;
					const a = document.createElement('a');
					a.href = url;
					a.style.cssText = 'color:inherit;text-decoration:none;';
					while (td.firstChild) a.appendChild(td.firstChild);
					td.appendChild(a);
					td.style.cursor = 'pointer';
				});

				// partner-card をリンク化
				document.querySelectorAll('.partner-card').forEach(card => {
					if (card.closest('a') || card.tagName === 'A') return;
					const img = card.querySelector('img');
					if (!img) return;
					const key = dexKeyFromImg(img);
					const url = key && map[key];
					if (!url) return;
					const a = document.createElement('a');
					a.href = url;
					a.style.cssText = 'text-decoration:none;color:inherit;display:contents;';
					// card を a で包む
					card.parentNode.insertBefore(a, card);
					a.appendChild(card);
					card.style.cursor = 'pointer';
					card.addEventListener('mouseenter', () => card.style.borderColor = '#f97316');
					card.addEventListener('mouseleave', () => card.style.borderColor = '');
				});
			})();
		</script>
	</body>
</html>
