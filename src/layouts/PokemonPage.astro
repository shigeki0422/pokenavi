---
import type { CollectionEntry } from 'astro:content';
import AdUnit from '../components/AdUnit.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'pokemon'>['data'];

const { title, description, pubDate, updatedDate, pokemonName, dexNumber, imageForm } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pokenavi.jp';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const dexPad = String(dexNumber ?? 0).padStart(4, '0');
const pokemonImageUrl = `${siteUrl}/images/pokemon/pokemon-${dexPad}-${imageForm ?? '00'}.webp`;

const pokemonJsonLd = pokemonName ? {
	'@context': 'https://schema.org',
	'@type': 'Thing',
	name: pokemonName,
	description,
	url: pageUrl,
	image: pokemonImageUrl,
} : null;

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'ホーム', item: siteUrl + '/' },
		{ '@type': 'ListItem', position: 2, name: 'ポケモン情報', item: siteUrl + '/pokemon/' },
		{ '@type': 'ListItem', position: 3, name: pokemonName ?? title, item: pageUrl },
	],
};
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		{pokemonJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(pokemonJsonLd)} />}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.page-meta {
				display: flex;
				align-items: center;
				gap: 12px;
				margin-bottom: 0.5em;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.badge {
				display: inline-block;
				background: #e0f2fe;
				color: #0369a1;
				font-size: 0.75rem;
				font-weight: 700;
				padding: 2px 8px;
				border-radius: 4px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="page-meta">
						<span class="badge">ポケモン情報</span>
						<FormattedDate date={pubDate} />
						{updatedDate && <span>（更新: <FormattedDate date={updatedDate} />）</span>}
					</div>
					<slot />
					<AdUnit />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
