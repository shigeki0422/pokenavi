---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import AdUnit from '../components/AdUnit.astro';
import MatchupSection from '../components/MatchupSection.astro';
import { getMatchups } from '../scripts/party-builder/matchup-static';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SimPartyCard from '../components/SimPartyCard.astro';
import { MOVE_NAME_EN, MOVE_NAME_KO, ABILITY_NAME_EN, ABILITY_NAME_KO, ITEM_NAME_EN, ITEM_NAME_KO, NATURE_NAME_EN, NATURE_NAME_KO } from '../i18n/game-terms';
import { POKEMON_NAME_EN, POKEMON_NAME_KO } from '../i18n/pokemon-names';
import partySuggestSlugs from '../data/party-suggest-slugs.json';

type Props = CollectionEntry<'pokemon'>['data'] & { lang?: 'ja' | 'en' | 'ko' };

const { title, description, pokemonName, dexNumber, imageForm, usageRank, faq, analysisSlug, lang = 'ja' } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pokenavi.jp';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const pokemonSlugIdx = pathParts.findIndex(p => p === 'pokemon');
const pokemonSlug = pokemonSlugIdx >= 0 ? pathParts[pokemonSlugIdx + 1] : '';
const pfx = lang === 'en' ? '/en' : lang === 'ko' ? '/ko' : '';
const psSlugSet = new Set(partySuggestSlugs as string[]);
const hasPartySuggest = !!pokemonSlug && psSlugSet.has(pokemonSlug);
const hasMegaPartySuggest = !!pokemonSlug && psSlugSet.has(`mega-${pokemonSlug}`);
const MOVE_MAP = lang === 'en' ? MOVE_NAME_EN : lang === 'ko' ? MOVE_NAME_KO : {};
const ABILITY_MAP = lang === 'en' ? ABILITY_NAME_EN : lang === 'ko' ? ABILITY_NAME_KO : {};
const ITEM_MAP = lang === 'en' ? ITEM_NAME_EN : lang === 'ko' ? ITEM_NAME_KO : {};
const NATURE_MAP = lang === 'en' ? NATURE_NAME_EN : lang === 'ko' ? NATURE_NAME_KO : {};
const POKEMON_MAP = lang === 'en' ? POKEMON_NAME_EN : lang === 'ko' ? POKEMON_NAME_KO : {};
const pokemonNameDisp = pokemonName ? (POKEMON_MAP[pokemonName] ?? pokemonName) : pokemonName;
const metaDescription = pokemonName && usageRank ? (
  lang === 'en'
    ? `${pokemonNameDisp} — Pokémon Champions M-4, Usage Rank #${usageRank}. TOP10 usage rates for moves, held items, abilities & natures. Base stats and type matchup chart included.`
    : lang === 'ko'
    ? `${pokemonNameDisp} 챔피언스M-4 사용률 ${usageRank}위 — 기술·지닌물건·특성·성격 채용률 TOP10과 종족값·타입 상성 수록.`
    : `チャンピオンズM-4使用率${usageRank}位${pokemonName}の対戦データ。技・持ち物・特性・性格の採用率TOP10と種族値・タイプ相性を掲載。`
) : description;
const T = {
  ja: { home: 'ホーム', pokemonInfo: 'ポケモン情報', badge: 'ポケモン情報', navAria: 'セクションナビゲーション', breadAria: 'パンくずリスト', hubAnalysis: '📖 考察記事を読む', hubWatch: '🎬 上位構築の対戦を観る', hubBuild: '⚔️ パーティに入れる', quickBuild: (n: string) => `${n}を軸にした簡単構築`, quickBuildMega: (n: string) => `メガ${n}を軸にした簡単構築` },
  en: { home: 'Home', pokemonInfo: 'Pokémon Info', badge: 'Pokémon Info', navAria: 'Section navigation', breadAria: 'Breadcrumb', hubAnalysis: '📖 Read Analysis', hubWatch: '🎬 Watch Top Builds Battle', hubBuild: '⚔️ Add to Party', quickBuild: (n: string) => `Quick Build from ${n}`, quickBuildMega: (n: string) => `Quick Build from Mega ${n}` },
  ko: { home: '홈', pokemonInfo: '포켓몬 정보', badge: '포켓몬 정보', navAria: '섹션 네비게이션', breadAria: '탐색 경로', hubAnalysis: '📖 분석 기사 읽기', hubWatch: '🎬 상위 구성 대전 관전', hubBuild: '⚔️ 파티에 추가', quickBuild: (n: string) => `${n} 축으로 간단 구성`, quickBuildMega: (n: string) => `메가${n} 축으로 간단 구성` },
}[lang];
/** contentコレクションのtitleは和名のみ(全言語共通データ)のため、en/koでは
 * <title>・OGP・JSON-LD name にそのまま使うと日本語タイトルがSEOに露出してしまう。
 * ここでlang別に組み立て直す。 */
const pageTitle = pokemonNameDisp
  ? (lang === 'en'
      ? `${pokemonNameDisp} | Pokémon Champions Usage Rate & Base Stats`
      : lang === 'ko'
      ? `${pokemonNameDisp} | 포켓몬 챔피언스 사용률・기초 데이터`
      : title)
  : title;
const quickBuildHref = lang === 'ja' ? `/party-suggest/${pokemonSlug}/` : `${pfx}/party-suggest/?core=${encodeURIComponent(pokemonName ?? '')}`;
const quickBuildMegaHref = lang === 'ja' ? `/party-suggest/mega-${pokemonSlug}/` : `${pfx}/party-suggest/?core=${encodeURIComponent('メガ' + (pokemonName ?? ''))}`;
const hreflangAlternates = pokemonSlug ? [
  { lang: 'ja', url: `${siteUrl}/pokemon/${pokemonSlug}/` },
  { lang: 'en', url: `${siteUrl}/en/pokemon/${pokemonSlug}/` },
  { lang: 'ko', url: `${siteUrl}/ko/pokemon/${pokemonSlug}/` },
  { lang: 'x-default', url: `${siteUrl}/pokemon/${pokemonSlug}/` },
] : undefined;
const dexPad = String(dexNumber ?? 0).padStart(4, '0');
const pokemonImageUrl = `${siteUrl}/images/pokemon/pokemon-${dexPad}-${imageForm ?? '00'}.webp`;

const ownIcon = `${dexPad}-${imageForm ?? '00'}`;
const matchups = dexNumber ? getMatchups(ownIcon) : null;
const iconToSlug: Record<string, string> = {};
if (matchups) {
	const allPokemonPages = await getCollection('pokemon', p => !p.data.draft);
	for (const p of allPokemonPages) {
		const key = `${String(p.data.dexNumber ?? 0).padStart(4, '0')}-${p.data.imageForm ?? '00'}`;
		iconToSlug[key] = p.id;
	}
}

const siteName = lang === 'en' ? 'PokeNavi' : lang === 'ko' ? '포케나비' : 'ポケナビ';
const pokemonJsonLd = pokemonName ? {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: pageTitle,
	description: metaDescription ?? description,
	url: pageUrl,
	image: pokemonImageUrl,
	about: {
		'@type': 'Thing',
		name: pokemonNameDisp,
		image: pokemonImageUrl,
	},
	author: { '@type': 'Organization', name: siteName, url: siteUrl },
	publisher: { '@type': 'Organization', name: siteName, url: siteUrl },
} : null;

const faqJsonLd = faq ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: `${pokemonName}の最も使われている技は？`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: `${faq.season}環境では${faq.topMoves[0]}（採用率${faq.topMovePct[0]}%）が最多です。次いで${faq.topMoves.slice(1).map((m, i) => `${m}（${faq.topMovePct[i+1]}%）`).join('、')}の順です。`,
			},
		},
		{
			'@type': 'Question',
			name: `${pokemonName}の最も使われている持ち物は？`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: `${faq.season}環境では${faq.topItems[0]}（採用率${faq.topItemPct[0]}%）が最多です。次いで${faq.topItems.slice(1).map((it, i) => `${it}（${faq.topItemPct[i+1]}%）`).join('、')}の順です。`,
			},
		},
		{
			'@type': 'Question',
			name: `${pokemonName}の特性は何が使われている？`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: `${faq.season}環境では${faq.topAbility}（採用率${faq.topAbilityPct}%）が主流です。`,
			},
		},
		{
			'@type': 'Question',
			name: `${pokemonName}の性格は何が使われている？`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: `${faq.season}環境では${faq.topNature}（採用率${faq.topNaturePct}%）が最多です。${faq.topNature2 ? `次いで${faq.topNature2}（${faq.topNaturePct2}%）です。` : ''}`,
			},
		},
	],
} : null;

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: T.home, item: siteUrl + `${pfx}/` },
		{ '@type': 'ListItem', position: 2, name: T.pokemonInfo, item: siteUrl + `${pfx}/pokemon/` },
		{ '@type': 'ListItem', position: 3, name: pokemonNameDisp ?? pageTitle, item: pageUrl },
	],
};
---

<html lang={lang}>
	<head>
		<BaseHead title={pageTitle} description={metaDescription} imageUrl={pokemonImageUrl} alternates={hreflangAlternates} ogLocale={lang === 'en' ? 'en_US' : lang === 'ko' ? 'ko_KR' : 'ja_JP'} />
		{pokemonJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(pokemonJsonLd)} />}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		{faqJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.prose {
				width: min(1100px, calc(100% - 2em));
				margin: auto;
				padding: 0.75em 1em 2em;
				color: rgb(var(--gray-dark));
				font-size: 15px;
				line-height: 1.6;
			}
			.prose :global(table) {
				display: block;
				overflow-x: auto;
				max-width: 100%;
			}
			/* global.css の過剰スペースをポケモンページに限り圧縮 */
			:global(.prose p) { margin-bottom: 0.75em; }
			:global(.prose hr) { margin: 0.35rem 0; border-color: #f1f5f9; }
			:global(.prose h3) {
				font-size: 0.95rem;
				font-weight: 700;
				margin: 0.75rem 0 0.4rem;
				color: rgb(var(--black));
			}
			:global(.prose h1) {
				font-size: 1.3rem;
				margin: 0 0 0.4rem;
			}
			@media (max-width: 720px) {
				.prose { font-size: 14px; padding: 0.5em 0.75em 2em; }
				.page-meta { display: none; }
			}
			.breadcrumb ol { display: flex; flex-wrap: wrap; list-style: none; margin: 0 0 .4em; padding: 0; font-size: .75rem; color: rgb(var(--gray)); }
			.breadcrumb li + li::before { content: '›'; padding: 0 .35em; }
			.breadcrumb a { color: rgb(var(--gray)); text-decoration: none; }
			.breadcrumb a:hover { text-decoration: underline; }
			.breadcrumb [aria-current] { color: rgb(var(--gray-dark)); font-weight: 600; }
			.page-meta {
				display: flex;
				align-items: center;
				gap: 12px;
				margin-bottom: 0.5em;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.badge {
				display: inline-block;
				background: #e0f2fe;
				color: #0369a1;
				font-size: 0.75rem;
				font-weight: 700;
				padding: 2px 8px;
				border-radius: 4px;
			}

			/* ① スティッキー目次ナビ */
			.poke-nav {
				background: white;
				border-bottom: 1px solid #f1f5f9;
				overflow-x: auto;
				scrollbar-width: none;
				z-index: 30;
			}
			.poke-nav::-webkit-scrollbar { display: none; }
			.poke-nav-inner {
				display: flex;
				gap: 2px;
				padding: 4px 1rem;
				max-width: min(1100px, 100%);
				margin: 0 auto;
				min-height: 36px;
				align-items: center;
			}
			:global(.poke-nav a) {
				font-size: 0.79rem;
				font-weight: 600;
				color: rgb(var(--gray));
				text-decoration: none;
				padding: 5px 10px;
				border-radius: 6px;
				white-space: nowrap;
				transition: background 0.15s, color 0.15s;
				flex-shrink: 0;
			}
			:global(.poke-nav a:hover) { background: #f8fafc; color: rgb(var(--black)); }
			:global(.poke-nav a.active) {
				background: #fff7ed;
				color: var(--accent);
			}
			@media (min-width: 1024px) {
				.poke-nav {
					position: sticky;
					top: 0;
				}
			}

			/* アクションハブ */
			.action-hub {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin: 0.6em 0 0.9em;
			}
			.hub-btn {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				padding: 7px 14px;
				border: 1px solid #e2e8f0;
				border-radius: 9999px;
				background: #fff;
				font-size: 0.82rem;
				font-weight: 700;
				color: #334155;
				text-decoration: none;
				white-space: nowrap;
				transition: border-color 0.15s, box-shadow 0.15s;
			}
			.hub-btn:hover { border-color: var(--accent, #f97316); box-shadow: 0 2px 8px rgba(0,0,0,.06); }
			.hub-primary { background: #fff7ed; border-color: #fdba74; color: #c2410c; }
			@media (max-width: 720px) {
				.action-hub { overflow-x: auto; flex-wrap: nowrap; -webkit-overflow-scrolling: touch; padding-bottom: 4px; }
			}

			/* ③ セクションヘッダー色分け */
			:global(.prose h2) {
				font-size: 1rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 1.25rem 0 0.6rem;
				padding: 0.45rem 0.9rem;
				background: #f8fafc;
				border-left: 3px solid var(--accent, #f97316);
				border-radius: 0 6px 6px 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<nav class="poke-nav" id="poke-nav" aria-label={T.navAria}>
			<div class="poke-nav-inner" id="poke-nav-inner"></div>
		</nav>
		<main>
			<article>
				<div class="prose">
					<nav class="breadcrumb" aria-label={T.breadAria}>
						<ol>
							<li><a href={`${pfx}/`}>{T.home}</a></li>
							<li><a href={`${pfx}/pokemon/`}>{T.pokemonInfo}</a></li>
							{pokemonName && <li aria-current="page">{pokemonName}</li>}
						</ol>
					</nav>
					<div class="page-meta">
						<span class="badge">{T.badge}</span>
					</div>
					<div class="action-hub">
						{lang === 'ja' && analysisSlug && (
							<a href={`/blog/${analysisSlug}/`} class="hub-btn hub-primary">{T.hubAnalysis}</a>
						)}
						{pokemonName && (
							<a href={`${pfx}/simulator-mb/?sf=${encodeURIComponent(pokemonName)}`} class="hub-btn">{T.hubWatch}</a>
						)}
						<a href={`${pfx}/party-builder/`} class="hub-btn">{T.hubBuild}</a>
					</div>
					<slot />
					{matchups && <MatchupSection matchups={matchups} iconToSlug={iconToSlug} nameMap={POKEMON_MAP} lang={lang} />}
					{pokemonName && <SimPartyCard pokemonName={pokemonName} />}
					{(hasPartySuggest || hasMegaPartySuggest) && (
						<div class="ps-cta-wrap">
							{hasPartySuggest && (
								<a href={quickBuildHref} class="ps-cta">
									<span>{T.quickBuild(pokemonNameDisp)}</span>
									<span class="ps-cta-arrow">→</span>
								</a>
							)}
							{hasMegaPartySuggest && (
								<a href={quickBuildMegaHref} class="ps-cta">
									<span>{T.quickBuildMega(pokemonNameDisp)}</span>
									<span class="ps-cta-arrow">→</span>
								</a>
							)}
						</div>
					)}
					<AdUnit />
				</div>
			</article>
		</main>
		<Footer />

		{lang !== 'ja' && <script is:inline define:vars={{ POKENAVI_LANG: lang, POKENAVI_MOVE: MOVE_MAP, POKENAVI_ABILITY: ABILITY_MAP, POKENAVI_ITEM: ITEM_MAP, POKENAVI_NATURE: NATURE_MAP, POKENAVI_POKEMON: POKEMON_MAP }}>(function(){
var L=POKENAVI_LANG;
var H2={en:{'種族値':'Base Stats','メガシンカ':'Mega Evolution','タイプ相性':'Type Matchup','特性':'Abilities','使用率データ':'Usage Data','性格':'Natures','チームメイト':'Partners','考察記事':'Analysis Articles','構築例':'Team Examples','同じチーム':'Partners'},ko:{'種族値':'종족값','メガシンカ':'메가진화','タイプ相性':'타입 상성','特性':'특성','使用率データ':'사용률 데이터','性格':'성격','チームメイト':'파트너','考察記事':'분석 기사','構築例':'구성 예시','同じチーム':'파트너'}}[L]||{};
var STAT={en:{'こうげき':'Attack','ぼうぎょ':'Defense','とくこう':'Sp. Atk','とくぼう':'Sp. Def','すばやさ':'Speed','合計':'Total'},ko:{'こうげき':'공격','ぼうぎょ':'방어','とくこう':'특공','とくぼう':'특방','すばやさ':'스피드','合計':'합계'}}[L]||{};
var TH={en:{'順位':'Rank','特性名':'Ability','採用率':'Usage','持ち物':'Held Item','技名':'Move','性格名':'Nature','チームメイト名':'Partner','×4 弱点':'×4 Weak','×2 弱点':'×2 Weak','×½ 耐性':'×½ Resist','×0 無効':'×0 Immune','ポケモン':'Pokémon','平均順位・前回比':'Avg. Rank・vs Prev.'},ko:{'順位':'순위','特性名':'특성명','採用率':'채용률','持ち物':'지닌물건','技名':'기술명','性格名':'성격명','チームメイト名':'파트너명','×4 弱点':'×4 약점','×2 弱点':'×2 약점','×½ 耐性':'×½ 저항','×0 無効':'×0 무효','ポケモン':'포켓몬','平均順位・前回比':'평균 순위・전회 대비'}}[L]||{};
var TYPE_L={en:{'物理':'Physical','特殊':'Special','変化':'Status'},ko:{'物理':'물리','特殊':'특수','変化':'변화'}}[L]||{};
var FIELD={en:{'威力':'Power','命中':'Accuracy','採用率の推移':'Usage Trend'},ko:{'威力':'위력','命中':'명중','採用率の推移':'채용률 추이'}}[L]||{};
var MISC=L==='en'?{'技':'Moves','持ち物':'Held Items','特性：':'Ability: ','効果・推移':'Effect・Trend','詳細':'Details','ステータス振り':'EV Spread','その他の構築や対戦での動きを確認':'See more team examples'}:L==='ko'?{'技':'기술','持ち物':'지닌물건','特性：':'특성: ','効果・推移':'효과・추이','詳細':'상세','ステータス振り':'스탯 배분','その他の構築や対戦での動きを確認':'다른 파티 구성 보기'}:{};
var ALL=Object.assign({},H2,STAT,TH,TYPE_L,FIELD,MISC,POKENAVI_MOVE,POKENAVI_ABILITY,POKENAVI_ITEM,POKENAVI_NATURE,POKENAVI_POKEMON);
var SUBS=L==='en'?[
  [/全国図鑑/g,'Pokédex'],[/使用率/g,'Usage Rank'],[/データ集計日：/g,'Data as of '],
  [/(\d+\.\d+)位/g,'$1'],[/(\d+)位/g,'#$1'],
  [/平均\s*/g,'Avg. '],[/前回比/g,'vs Prev.'],[/シーズン/g,'Season'],[/推移/g,'Trend'],
  [/効果・推移/g,'Effect・Trend'],[/詳細/g,'Details']
]:L==='ko'?[
  [/全国図鑑/g,'전국도감'],[/使用率/g,'사용률'],[/データ集計日：/g,'데이터 집계일：'],
  [/(\d+\.\d+)位/g,'$1위'],[/(\d+)位/g,'$1위'],
  [/平均\s*/g,'평균 '],[/前回比/g,'전회비'],[/シーズン/g,'시즌'],[/推移/g,'추이'],
  [/効果・推移/g,'효과・추이'],[/詳細/g,'상세']
]:[];
function megastone(tr){
  if(L!=='en')return null;
  var mX=/^(.+)ナイトX$/.exec(tr),mY=/^(.+)ナイトY$/.exec(tr),m=/^(.+)ナイト$/.exec(tr);
  var base=mX||mY||m;if(!base)return null;
  var jp=base[1];
  var en=POKENAVI_POKEMON[jp]||POKENAVI_POKEMON[jp+'ー'];
  if(!en)return null;
  return en+(mX?' X':mY?' Y':'')+'ite';
}
function megapoke(tr){
  var m=/^メガ(.+)$/.exec(tr);if(!m)return null;
  var jp=m[1];
  var en=POKENAVI_POKEMON[jp]||POKENAVI_POKEMON[jp+'ー'];
  if(!en)return null;
  return L==='en'?'Mega '+en:L==='ko'?'메가'+en:null;
}
function rep(container){
  var w=document.createTreeWalker(container,NodeFilter.SHOW_TEXT);
  var nodes=[];var n;
  while(n=w.nextNode())nodes.push(n);
  nodes.forEach(function(node){
    var t=node.textContent,tr=t.trim();
    if(!tr)return;
    if(ALL[tr]){node.textContent=t.replace(tr,ALL[tr]);return;}
    var ms=megastone(tr)||megapoke(tr);
    if(ms){node.textContent=t.replace(tr,ms);return;}
    var am=/^特性：(.+)$/.exec(tr);
    if(am&&ALL[am[1]]){node.textContent=t.replace(tr,(L==='en'?'Ability: ':L==='ko'?'특성: ':'')+ALL[am[1]]);return;}
    var nm=/^(.+)(\s+\([A-Z↑↓±\+\-\s]+\))$/.exec(tr);
    if(nm&&ALL[nm[1]]){node.textContent=t.replace(tr,ALL[nm[1]]+nm[2]);return;}
    SUBS.forEach(function(p){t=t.replace(p[0],p[1]);});
    if(/[ぁ-ん]/.test(t)&&t.trim().length>20){node.textContent='';return;}
    node.textContent=t;
  });
}
