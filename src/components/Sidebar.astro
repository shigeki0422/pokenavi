---
import { SITE_TITLE } from '../consts';
import GlobalSearch from './GlobalSearch.astro';

const path = Astro.url.pathname;
const lang = path.startsWith('/en') ? 'en' : path.startsWith('/ko') ? 'ko' : 'ja';
const pfx = lang === 'ja' ? '' : `/${lang}`;

const NAV = {
  ja: {
    home: 'ホーム',
    navResearch: '調べる', navRead: '読む', navWatch: '観る', navBuild: '戦う',
    watchParent: '仮想バトル観戦', simA: 'M-A環境', simB: 'M-B環境', soonTitle: '近日公開予定',
    buildParent: 'パーティ構築', quickBuild: '軸から簡単構築', detailBuild: 'パーティ工房',
    pokemon: 'ポケモン情報', ranking: '使用率ランキング', blog: '考察記事',
    m4: 'M-4 シーズン', m3: 'M-3 シーズン', m2: 'M-2 シーズン', about: '運営者情報', privacy: 'プライバシーポリシー',
  },
  en: {
    home: 'Home',
    navResearch: 'Research', navRead: 'Read', navWatch: 'Watch', navBuild: 'Battle',
    watchParent: 'AI Battle Replays', simA: 'M-A', simB: 'M-B', soonTitle: 'Coming soon',
    buildParent: 'Team Building', quickBuild: 'Quick Build from Core', detailBuild: 'Party Workshop',
    pokemon: 'Pokémon Data', ranking: 'Usage Ranking', blog: 'Analysis',
    m3: 'M-3 Season', m2: 'M-2 Season', about: 'About', privacy: 'Privacy Policy',
  },
  ko: {
    home: '홈',
    navResearch: '알아보기', navRead: '읽기', navWatch: '보기', navBuild: '배틀',
    watchParent: '가상 대전 관전', simA: 'M-A', simB: 'M-B', soonTitle: '준비 중',
    buildParent: '파티 구성', quickBuild: '축으로 간단 구성', detailBuild: '파티 공방',
    pokemon: '포켓몬 정보', ranking: '사용률 랭킹', blog: '공략 기사',
    m3: 'M-3 시즌', m2: 'M-2 시즌', about: '운영자 정보', privacy: '개인정보 처리방침',
  },
}[lang];

const isActive = (href: string) => (href === `${pfx}/` ? path === `${pfx}/` || path === `${pfx}` : path.startsWith(href));
const isM4Active = path.startsWith('/blog/m4') || (path.startsWith('/blog/') && path.includes('-m4'));
const isM3Active = path.startsWith(`${pfx}/blog/m3`) || (path.startsWith('/blog/') && path.includes('-m3'));
const isM2Active = path.startsWith('/blog/m2') || (path.startsWith('/blog/') && path.includes('-m2'));
const isBlogActive = (path === '/blog' || path === '/blog/') || (path.startsWith('/blog/') && !path.startsWith('/blog/m4') && !path.startsWith('/blog/m3') && !path.startsWith('/blog/m2'));
const isSimAActive = path === `${pfx}/simulator` || path === `${pfx}/simulator/`;
const isSimBActive = isActive(`${pfx}/simulator-mb`);
const isWatchParentActive = isActive(`${pfx}/battle-simulator`);
const isQuickBuildActive = isActive(`${pfx}/party-suggest`);
const isDetailBuildActive = isActive(`${pfx}/party-builder`);
const isPartyBuildingActive = isActive(`${pfx}/party-building`);
const isBuildParentActive = isPartyBuildingActive;
const buildParentHref = `${pfx}/party-building`;
const brandHref = pfx ? `${pfx}/` : '/';
const siteName = lang === 'en' ? 'PokeNavi' : lang === 'ko' ? '포케나비' : SITE_TITLE;

const basePath = path.startsWith('/en/') ? path.slice(3)
               : path.startsWith('/ko/') ? path.slice(3)
               : path === '/en' || path === '/en/' ? '/'
               : path === '/ko' || path === '/ko/' ? '/'
               : path;
const langUrls = {
  ja: basePath || '/',
  en: basePath === '/' ? '/en/' : `/en${basePath}`,
  ko: basePath === '/' ? '/ko/' : `/ko${basePath}`,
};
---

<div class="sidebar-overlay" id="sidebar-overlay"></div>
<aside class="sidebar" id="sidebar">
	<a class="sb-brand" href={brandHref}>
		<img class="sb-logo" src="/logo-mark.png" alt="ポケナビ ロゴ" width="36" height="36" />
		<span class="sb-brand-text">{siteName}</span>
	</a>
	<GlobalSearch variant="sidebar" lang={lang} />
	<nav class="sb-nav">
		<a href={brandHref} class:list={['sb-link', { active: path === `${pfx}/` || path === `${pfx}` }]}>{NAV.home}</a>

		<div class="sb-verb-caption">🔍 {NAV.navResearch}</div>
		<a href={`${pfx}/pokemon`} class:list={['sb-link', { active: isActive(`${pfx}/pokemon`) }]}>{NAV.pokemon}</a>
		<a href={`${pfx}/ranking/`} class:list={['sb-sublink', { active: isActive(`${pfx}/ranking`) }]}>{NAV.ranking}</a>

		{lang === 'ja' && <>
			<div class="sb-verb-caption">📖 {NAV.navRead}</div>
			<a href="/blog" class:list={['sb-link', { active: isBlogActive }]}>{NAV.blog}</a>
			<a href="/blog/m4/" class:list={['sb-sublink', { active: isM4Active }]}>{NAV.m4}<span class="season-badge new">NEW</span></a>
			<a href="/blog/m3/" class:list={['sb-sublink', { active: isM3Active }]}>{NAV.m3}</a>
			<a href="/blog/m2/" class:list={['sb-sublink', { active: isM2Active }]}>{NAV.m2}</a>
		</>}

		<div class="sb-verb-caption">🎬 {NAV.navWatch}</div>
		<a href={`${pfx}/battle-simulator`} class:list={['sb-link', { active: isWatchParentActive }]}>{NAV.watchParent}</a>
		<a href={`${pfx}/simulator`} class:list={['sb-sublink', { active: isSimAActive }]}>{NAV.simA}</a>
		<a href={`${pfx}/simulator-mb`} class:list={['sb-sublink', { active: isSimBActive }]}>{NAV.simB}<span class="season-badge new">NEW</span></a>

		<div class="sb-verb-caption">⚔️ {NAV.navBuild}</div>
		<a href={buildParentHref} class:list={['sb-link', { active: isBuildParentActive }]}>{NAV.buildParent}</a>
		<a href={`${pfx}/party-suggest`} class:list={['sb-sublink', { active: isQuickBuildActive }]}>{NAV.quickBuild}<span class="season-badge new">NEW</span></a>
		<a href={`${pfx}/party-builder`} class:list={['sb-sublink', { active: isDetailBuildActive }]}>{NAV.detailBuild}<span class="season-badge new">NEW</span></a>
	</nav>
	<div class="sb-foot">
		<div class="lang-switcher">
			<a href={langUrls.ja} class:list={['lang-btn', { 'lang-active': lang === 'ja' }]}>JA</a>
			<a href={langUrls.en} class:list={['lang-btn', { 'lang-active': lang === 'en' }]}>EN</a>
			<a href={langUrls.ko} class:list={['lang-btn', { 'lang-active': lang === 'ko' }]}>KO</a>
		</div>
		<a href={`${pfx}/about/`}>{NAV.about}</a>
		<a href={`${pfx}/privacy/`}>{NAV.privacy}</a>
	</div>
</aside>

<style>
	.sidebar-overlay {
		display: none;
		position: fixed;
		inset: 0;
		background: rgba(0,0,0,0.35);
		z-index: 201;
		backdrop-filter: blur(2px);
	}
	.sidebar-overlay.open {
		display: block;
	}
	.sidebar {
		display: flex;
		flex-direction: column;
		position: fixed;
		top: 0;
		left: 0;
		width: 260px;
		height: 100vh;
		overflow-y: auto;
		background: #fff;
		border-right: 1px solid #e2e8f0;
		padding: 1rem 0;
		z-index: 202;
		/* モバイル: デフォルトは左に隠す */
		transform: translateX(-100%);
		transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.sidebar.open {
		transform: translateX(0);
	}
	@media (min-width: 1024px) {
		.sidebar {
			transform: translateX(0);
			width: 220px;
		}
		.sidebar-overlay {
			display: none !important;
		}
	}
	.sb-brand {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		padding: 0.5rem 1.0rem 0.9rem;
		border-bottom: 1px solid #f1f5f9;
		margin-bottom: 0.2rem;
	}
	.sb-logo {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		flex-shrink: 0;
		box-shadow: 0 1px 4px rgba(0,0,0,0.08);
	}
	.sb-brand-text {
		font-weight: 800;
		font-size: 1.1rem;
		color: rgb(var(--gray-dark));
		letter-spacing: -0.01em;
	}
	.sb-nav {
		display: flex;
		flex-direction: column;
	}
	.sb-link {
		padding: 0.42rem 1.2rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 600;
		border-left: 3px solid transparent;
		line-height: 1.3;
	}
	.sb-link:hover {
		background: #f8fafc;
	}
	.sb-link.active {
		border-left-color: var(--accent);
		color: var(--accent);
		background: #fff7ed;
	}
	.sb-sublink {
		padding: 0.3rem 0.9rem 0.3rem 2.1rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.84rem;
		border-left: 3px solid transparent;
		white-space: nowrap;
		line-height: 1.3;
	}
	.sb-sublink:hover { background: #f8fafc; }
	.sb-soon {
		display: flex;
		align-items: center;
		color: rgb(var(--gray));
		cursor: not-allowed;
		opacity: 0.65;
	}
	.sb-soon:hover { background: transparent; }
	.season-badge {
		font-size: 0.58rem;
		font-weight: 700;
		border-radius: 9999px;
		padding: 0.05em 0.5em;
		margin-left: 0.45em;
		letter-spacing: 0.02em;
	}
	.season-badge.new {
		background: #fef3c7;
		color: #b45309;
	}
	.soon-badge {
		font-size: 0.58rem;
		font-weight: 700;
		background: #e2e8f0;
		color: rgb(var(--gray));
		border-radius: 9999px;
		padding: 0.05em 0.5em;
		margin-left: 0.45em;
		letter-spacing: 0.02em;
	}
	.sb-sublink.active {
		border-left-color: var(--accent);
		color: var(--accent);
		background: #fff7ed;
		font-weight: 700;
	}
	.sb-cat {
		font-size: 0.92rem;
		font-weight: 700;
		color: rgb(var(--gray-dark));
		padding: 0.7rem 1.2rem 0.25rem;
		margin-top: 0.2rem;
	}
	.sb-verb-caption {
		font-size: 0.68rem;
		font-weight: 800;
		color: var(--accent);
		letter-spacing: 0.08em;
		padding: 0.4rem 1.2rem 0.36rem;
		margin-top: 0.25rem;
		background: #eef2ff;
		border-left: 3px solid var(--accent);
		border-top: 1px solid #e0e7ff;
	}
	.sb-verb-caption:first-of-type {
		border-top: none;
		margin-top: 0.15rem;
	}
	.sb-cat-link {
		display: block;
		font-size: 0.95rem;
		font-weight: 800;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		padding: 0.6rem 1.2rem;
		border-left: 3px solid transparent;
	}
	.sb-cat-link:hover { background: #f8fafc; }
	.sb-cat-link.active {
		border-left-color: var(--accent);
		color: var(--accent);
		background: #fff7ed;
	}
	.sb-subcat {
		font-size: 0.72rem;
		font-weight: 700;
		color: rgb(var(--gray));
		letter-spacing: 0.03em;
		padding: 0.4rem 1.2rem 0.2rem 2.1rem;
	}
	.sb-section-label {
		font-size: 0.7rem;
		font-weight: 700;
		color: rgb(var(--gray));
		letter-spacing: 0.05em;
		padding: 1rem 1.2rem 0.4rem;
		border-top: 1px solid #f1f5f9;
		margin-top: 0.5rem;
	}
	.sb-types {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px 0;
		padding: 0.1rem 0.6rem 0.3rem 1.8rem;
	}
	.sb-type {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 5px 6px;
		border-radius: 6px;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		font-size: 0.78rem;
	}
	.sb-type:hover {
		background: #f8fafc;
	}
	.sb-type.active {
		background: #fff7ed;
		color: var(--accent);
		font-weight: 700;
	}
	.sb-type img {
		width: 20px;
		height: 20px;
	}
	.sb-foot {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin-top: auto;
		padding: 1rem 1.2rem;
		border-top: 1px solid #f1f5f9;
	}
	.sb-foot a {
		font-size: 0.75rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.sb-foot a:hover {
		color: var(--accent);
	}
	.lang-switcher {
		display: flex;
		gap: 4px;
		margin-bottom: 6px;
	}
	.lang-btn {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 3px 8px;
		border-radius: 4px;
		text-decoration: none;
		color: rgb(var(--gray));
		background: #f1f5f9;
		letter-spacing: 0.03em;
	}
	.lang-btn:hover {
		background: #e2e8f0;
		color: rgb(var(--gray-dark));
	}
	.lang-btn.lang-active {
		background: var(--accent);
		color: #fff;
	}
</style>

<script>
  const btn     = document.getElementById('menu-btn');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');

  function open() {
    sidebar?.classList.add('open');
    overlay?.classList.add('open');
    btn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    sidebar?.classList.remove('open');
    overlay?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () =>
    sidebar?.classList.contains('open') ? close() : open()
  );
  overlay?.addEventListener('click', close);

  // リンクをタップしたら閉じる（モバイルのみ）
  sidebar?.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      if (window.innerWidth < 1024) close();
    })
  );
</script>
