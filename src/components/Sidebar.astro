---
import { SITE_TITLE } from '../consts';
import GlobalSearch from './GlobalSearch.astro';

const path = Astro.url.pathname;
const lang = path.startsWith('/en') ? 'en' : path.startsWith('/ko') ? 'ko' : 'ja';
const pfx = lang === 'ja' ? '' : `/${lang}`;

const NAV = {
  ja: {
    home: 'ホーム', simulator: 'バトルシミュレータ', simWhat: 'バトルシミュレータとは',
    simTop: '上位環境シミュレーション', simSoon: 'パーティ診断', soonTitle: '近日公開予定',
    pokemon: 'ポケモン情報', ranking: '使用率ランキング', blog: '考察記事',
    m3: 'M-3 シーズン', m2: 'M-2 シーズン', about: '運営者情報', privacy: 'プライバシーポリシー',
  },
  en: {
    home: 'Home', simulator: 'Battle Simulator', simWhat: 'About Simulator',
    simTop: 'Top Env. Simulation', simSoon: 'Party Diagnosis', soonTitle: 'Coming soon',
    pokemon: 'Pokémon Data', ranking: 'Usage Ranking', blog: 'Analysis',
    m3: 'M-3 Season', m2: 'M-2 Season', about: 'About', privacy: 'Privacy Policy',
  },
  ko: {
    home: '홈', simulator: '배틀 시뮬레이터', simWhat: '시뮬레이터란',
    simTop: '상위 환경 시뮬레이션', simSoon: '파티 진단', soonTitle: '준비 중',
    pokemon: '포켓몬 정보', ranking: '사용률 랭킹', blog: '공략 기사',
    m3: 'M-3 시즌', m2: 'M-2 시즌', about: '운영자 정보', privacy: '개인정보 처리방침',
  },
}[lang];

const isActive = (href: string) => (href === `${pfx}/` ? path === `${pfx}/` || path === `${pfx}` : path.startsWith(href));
const isM3Active = path.startsWith(`${pfx}/blog/m3`) || (path.startsWith('/blog/') && path.includes('-m3'));
const isM2Active = path.startsWith('/blog/m2') || (path.startsWith('/blog/') && path.includes('-m2'));
const isBlogActive = (path === '/blog' || path === '/blog/') || (path.startsWith('/blog/') && !path.startsWith('/blog/m3') && !path.startsWith('/blog/m2'));
const brandHref = pfx ? `${pfx}/` : '/';
const siteName = lang === 'en' ? 'PokeNavi' : lang === 'ko' ? '포케나비' : SITE_TITLE;
---

<div class="sidebar-overlay" id="sidebar-overlay"></div>
<aside class="sidebar" id="sidebar">
	<a class="sb-brand" href={brandHref}>
		<img class="sb-logo" src="/logo-mark.png" alt="ポケナビ ロゴ" width="36" height="36" />
		<span class="sb-brand-text">{siteName}</span>
	</a>
	<GlobalSearch variant="sidebar" lang={lang} />
	<nav class="sb-nav">
		<a href={brandHref} class:list={['sb-link', { active: path === `${pfx}/` || path === `${pfx}` }]}>{NAV.home}</a>

		<a href={`${pfx}/battle-simulator`} class:list={['sb-cat-link', { active: path === `${pfx}/battle-simulator` }]}>{NAV.simulator}</a>
		<a href={`${pfx}/battle-simulator`} class:list={['sb-sublink', { active: path === `${pfx}/battle-simulator` }]}>{NAV.simWhat}</a>
		<a href={`${pfx}/simulator`} class:list={['sb-sublink', { active: isActive(`${pfx}/simulator`) }]}>{NAV.simTop}</a>
		<span class="sb-sublink sb-soon" aria-disabled="true" title={NAV.soonTitle}>{NAV.simSoon}<span class="soon-badge">Coming soon</span></span>

		<a href={`${pfx}/pokemon`} class:list={['sb-link', { active: isActive(`${pfx}/pokemon`) }]}>{NAV.pokemon}</a>
		<a href={`${pfx}/ranking/`} class:list={['sb-sublink', { active: isActive(`${pfx}/ranking`) }]}>{NAV.ranking}</a>
		{lang === 'ja' && <>
			<a href="/blog" class:list={['sb-link', { active: isBlogActive }]}>{NAV.blog}</a>
			<a href="/blog/m3/" class:list={['sb-sublink', { active: isM3Active }]}>{NAV.m3}<span class="season-badge new">NEW</span></a>
			<a href="/blog/m2/" class:list={['sb-sublink', { active: isM2Active }]}>{NAV.m2}</a>
		</>}
	</nav>
	<div class="sb-foot">
		<a href={`${pfx}/about/`}>{NAV.about}</a>
		<a href={`${pfx}/privacy/`}>{NAV.privacy}</a>
	</div>
</aside>

<style>
	.sidebar-overlay {
		display: none;
		position: fixed;
		inset: 0;
		background: rgba(0,0,0,0.35);
		z-index: 201;
		backdrop-filter: blur(2px);
	}
	.sidebar-overlay.open {
		display: block;
	}
	.sidebar {
		display: flex;
		flex-direction: column;
		position: fixed;
		top: 0;
		left: 0;
		width: 260px;
		height: 100vh;
		overflow-y: auto;
		background: #fff;
		border-right: 1px solid #e2e8f0;
		padding: 1rem 0;
		z-index: 202;
		/* モバイル: デフォルトは左に隠す */
		transform: translateX(-100%);
		transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.sidebar.open {
		transform: translateX(0);
	}
	@media (min-width: 1024px) {
		.sidebar {
			transform: translateX(0);
			width: 220px;
		}
		.sidebar-overlay {
			display: none !important;
		}
	}
	.sb-brand {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		padding: 0.5rem 1.0rem 0.9rem;
		border-bottom: 1px solid #f1f5f9;
		margin-bottom: 0.2rem;
	}
	.sb-logo {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		flex-shrink: 0;
		box-shadow: 0 1px 4px rgba(0,0,0,0.08);
	}
	.sb-brand-text {
		font-weight: 800;
		font-size: 1.1rem;
		color: rgb(var(--gray-dark));
		letter-spacing: -0.01em;
	}
	.sb-nav {
		display: flex;
		flex-direction: column;
	}
	.sb-link {
		padding: 0.6rem 1.2rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 600;
		border-left: 3px solid transparent;
	}
	.sb-link:hover {
		background: #f8fafc;
	}
	.sb-link.active {
		border-left-color: var(--accent);
		color: var(--accent);
		background: #fff7ed;
	}
	.sb-sublink {
		padding: 0.42rem 1.2rem 0.42rem 2.1rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.84rem;
		border-left: 3px solid transparent;
	}
	.sb-sublink:hover { background: #f8fafc; }
	.sb-soon {
		display: flex;
		align-items: center;
		color: rgb(var(--gray));
		cursor: not-allowed;
		opacity: 0.65;
	}
	.sb-soon:hover { background: transparent; }
	.season-badge {
		font-size: 0.58rem;
		font-weight: 700;
		border-radius: 9999px;
		padding: 0.05em 0.5em;
		margin-left: 0.45em;
		letter-spacing: 0.02em;
	}
	.season-badge.new {
		background: #fef3c7;
		color: #b45309;
	}
	.soon-badge {
		font-size: 0.58rem;
		font-weight: 700;
		background: #e2e8f0;
		color: rgb(var(--gray));
		border-radius: 9999px;
		padding: 0.05em 0.5em;
		margin-left: 0.45em;
		letter-spacing: 0.02em;
	}
	.sb-sublink.active {
		border-left-color: var(--accent);
		color: var(--accent);
		background: #fff7ed;
		font-weight: 700;
	}
	.sb-cat {
		font-size: 0.92rem;
		font-weight: 700;
		color: rgb(var(--gray-dark));
		padding: 0.7rem 1.2rem 0.25rem;
		margin-top: 0.2rem;
	}
	.sb-cat-link {
		display: block;
		font-size: 0.95rem;
		font-weight: 800;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		padding: 0.6rem 1.2rem;
		border-left: 3px solid transparent;
	}
	.sb-cat-link:hover { background: #f8fafc; }
	.sb-cat-link.active {
		border-left-color: var(--accent);
		color: var(--accent);
		background: #fff7ed;
	}
	.sb-subcat {
		font-size: 0.72rem;
		font-weight: 700;
		color: rgb(var(--gray));
		letter-spacing: 0.03em;
		padding: 0.4rem 1.2rem 0.2rem 2.1rem;
	}
	.sb-section-label {
		font-size: 0.7rem;
		font-weight: 700;
		color: rgb(var(--gray));
		letter-spacing: 0.05em;
		padding: 1rem 1.2rem 0.4rem;
		border-top: 1px solid #f1f5f9;
		margin-top: 0.5rem;
	}
	.sb-types {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px 0;
		padding: 0.1rem 0.6rem 0.3rem 1.8rem;
	}
	.sb-type {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 5px 6px;
		border-radius: 6px;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		font-size: 0.78rem;
	}
	.sb-type:hover {
		background: #f8fafc;
	}
	.sb-type.active {
		background: #fff7ed;
		color: var(--accent);
		font-weight: 700;
	}
	.sb-type img {
		width: 20px;
		height: 20px;
	}
	.sb-foot {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin-top: auto;
		padding: 1rem 1.2rem;
		border-top: 1px solid #f1f5f9;
	}
	.sb-foot a {
		font-size: 0.75rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.sb-foot a:hover {
		color: var(--accent);
	}
</style>

<script>
  const btn     = document.getElementById('menu-btn');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');

  function open() {
    sidebar?.classList.add('open');
    overlay?.classList.add('open');
    btn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    sidebar?.classList.remove('open');
    overlay?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () =>
    sidebar?.classList.contains('open') ? close() : open()
  );
  overlay?.addEventListener('click', close);

  // リンクをタップしたら閉じる（モバイルのみ）
  sidebar?.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      if (window.innerWidth < 1024) close();
    })
  );
</script>
