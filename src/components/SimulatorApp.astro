      }
      function matrixHTML(d, selMe, selOpp){
        const cell=v=>v==='A'?'bg-g':v==='B'?'bg-r':'bg-n';
        const hdr=n=>{const u=iconUrl(n); const dn=tPoke(n); return `${u?`<img class="mtx-ico" src="${u}" title="${dn}" alt="${dn}" onerror="this.style.display='none'">`:''}<div class="mtx-name">${dn}</div>`;};
        let mt=`<div class="muted" style="margin-bottom:.4em"><span class="bg-g" style="padding:0 .3em;border-radius:3px">${I18N.mtxWin}</span> <span class="bg-r" style="padding:0 .3em;border-radius:3px">${I18N.mtxLose}</span> ｜ ${I18N.mtxDmgNote}${selMe?' ｜ '+I18N.mtxNote:''}</div><div style="overflow-x:auto"><table class="mtx"><tr><th class="mtx-corner">${I18N.mtxCornerMe}<br>${I18N.mtxCornerOpp}</th>`;
        d.namesB.forEach(n=>{const sd=selOpp&&selOpp.get(n);mt+=`<th class="${!selOpp||sd?'':'dim'} ${sd?'mtx-sel':''}">${hdr(n)}</th>`;}); mt+='</tr>';
        d.cells.forEach((row,i)=>{ const nm=d.namesA[i], rsel=selMe&&selMe.get(nm), rdim=(!selMe||rsel)?'':'dim';
          mt+=`<tr><th class="${rdim} ${rsel?'mtx-sel':''}">${hdr(nm)}</th>`;
          row.forEach((cc,j)=>{const dim=(!selMe||(rsel&&selOpp.get(d.namesB[j])))?'':'dim';mt+=`<td class="${cell(cc.v)} ${dim}">${cc.dealt}/${cc.taken}</td>`;}); mt+='</tr>'; });
        mt+='</table></div>';
        const help = `<details class="mtx-help"><summary>${I18N.mtxHelpSum}</summary><div class="mtx-help-body">${I18N.mtxHelpBody}</div></details>`;
        return `<div class="sect"><div class="sect-head">${I18N.t1v1Pfx}${d.a_win}${I18N.t1v1Mid}${d.b_win}${I18N.t1v1Sfx}</div><div class="sect-body">${help}${mt}</div></div>`;
      }
      function buildsHTML(d){ const bt=arr=>{let t='<table class="bt"><tbody>';
        (arr||[]).forEach(x=>t+=`<tr><td style="font-weight:700">${tPoke(x.name)}</td><td class="muted">${x.type}</td><td>${tItem(x.item)}</td><td class="muted">${tAbil(x.ability)}</td><td class="muted">S${x.speed}</td><td class="muted" style="white-space:normal">${(x.moves||[]).map(tMove).join('・')}</td></tr>`);
        return t+'</tbody></table>';};
        return `<div class="sect"><div class="sect-head">${I18N.buildTitle}</div><div class="sect-body">${I18N.buildsOpp}${bt(d.buildsB)}${I18N.buildsMe}${bt(d.buildsA)}</div></div>`;
      }

      // VS ポケモン（相手に選出された各ポケモンに対する実戦勝敗・型別勝率）
