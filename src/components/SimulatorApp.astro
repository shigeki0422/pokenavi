          PSORT==='num' ? (PNDIR==='asc'?a.n-b.n:b.n-a.n)
                        : (PWDIR==='asc'?a.win_rate-b.win_rate:b.win_rate-a.win_rate));
        if(!arr.length){ $('opp-list').innerHTML=`<div class="muted" style="padding:.6em">${I18N.noSelectData}</div>`; $('summary').textContent=''; return; }
        $('summary').textContent=I18N.sumPokePfx+arr.length+I18N.sumPokeMid+labelName(SUBJECT.label,SUBJECT.party)+I18N.sumPokeSfx;
        $('opp-list').innerHTML = arr.map(p=>{const wr=Math.round(p.win_rate*100),cls=p.win_rate>=0.6?'g':p.win_rate<=0.4?'r':'n';const u=iconUrl(p.name);
          return `<div class="pitem" data-pk="${encodeURIComponent(p.name)}" onclick="selectOppPoke('${p.name.replace(/'/g,"\\'")}')"><div class="pitem-icons">${u?`<img src="${u}" alt="">`:''}</div><span class="nm">${tPoke(p.name)}</span><span class="muted">${p.wins}-${p.losses}-${p.draws}</span><span class="wr ${cls}">${wr}%</span></div>`;}).join('');
        if(OPP&&VSPOKE[OPP]) document.querySelectorAll('#opp-list .pitem').forEach(e=>e.classList.toggle('active', decodeURIComponent(e.dataset.pk||'')===OPP));
        else selectOppPoke(arr[0].name);
      }
      async function selectOppPoke(nm){
        OPP=nm;
        document.querySelectorAll('#opp-list .pitem').forEach(e=>e.classList.toggle('active', decodeURIComponent(e.dataset.pk||'')===nm));
        const p=VSPOKE[nm];
        if(p){ const wr=Math.round(p.win_rate*100),cls=p.win_rate>=0.6?'g':p.win_rate<=0.4?'r':'n';
          $('opp-comp').innerHTML=`<div class="ctitle">${tPoke(nm)}</div><div>${I18N.totalLabel} <b>${p.wins}${I18N.winsLabel} ${p.losses}${I18N.lossesLabel} ${p.draws}${I18N.drawsLabel}</b> <span class="wr ${cls}">${wr}%</span></div>`; }
        // 型別戦績
        let h='';
        if(p&&p.builds&&p.builds.length){
          h+=`<div class="sect"><div class="sect-head">📊 ${tPoke(nm)}${I18N.buildTypePfx}${p.builds.length}${I18N.buildTypeSfx}</div><div class="sect-body">`;
          const _evk=['H','A','B','C','D','S'];
          [...p.builds].sort((a,b)=>{                       // 第一キー=勝率(降順)、以降は 持ち物→性格→技→EV→特性
            if(b.win_rate!==a.win_rate) return b.win_rate-a.win_rate;
            const s=(x,y)=>((x||'')<(y||'')?-1:(x||'')>(y||'')?1:0);
            let c=s(a.item,b.item)||s(a.nature,b.nature); if(c) return c;
            const ma=(a.moves||[]).slice().sort().join('/'),mb=(b.moves||[]).slice().sort().join('/'); if(ma!==mb) return ma<mb?-1:1;
            for(const k of _evk){const d=((a.evs||{})[k]||0)-((b.evs||{})[k]||0); if(d) return d;}
            return s(a.ability,b.ability);
          }).forEach((b,bi)=>{const wr=Math.round(b.win_rate*100),cls=b.win_rate>=0.6?'g':b.win_rate<=0.4?'r':'n';
            const _bNatNm=NATURE_NAME_MAP[b.nature]||b.nature; const nat=b.nature?`${_bNatNm}${NATURE[b.nature]?` (${NATURE[b.nature]})`:''}`:'—';
            const moves=(b.moves&&b.moves.length)?b.moves.map(m=>`<span class="mvchip">${typeIcon(m)}${tMove(m)}</span>`).join(''):'—';
            const movesTxt=(b.moves&&b.moves.length)?b.moves.join(' / '):'—';
            const ev=b.evs?['H','A','B','C','D','S'].map(l=>b.evs[l]?`<span class="evchip ev-${l}">${l}<b>${b.evs[l]}</b></span>`:null).filter(Boolean).join(''):'';
            const evx=b.ev_variants>1?` <span class="muted" style="font-size:.7rem">ほかEV${b.ev_variants-1}種</span>`:'';
            h+=`<div class="bvrow${bi===0?' open':''}" onclick="this.classList.toggle('open')">
              <div class="bvhd">
                <span class="wr ${cls}">${wr}%</span>
                <span class="bv-item">${itemIcon(b.item)}${b.item||'—'}</span>
                <span class="bv-moves">${movesTxt}</span>
                <span class="bv-toggle">▼</span>
              </div>
              <div class="bvbody">
                <div class="muted" style="font-size:.78rem;margin-bottom:.3em">${b.wins}${I18N.winsLabel} ${b.losses}${I18N.lossesLabel} ${b.draws}${I18N.drawsLabel}</div>
                <div class="cdgrid">
                  <div class="cdcell"><span class="cdlabel abil">${I18N.labelAbil}</span><span class="cdval">${tAbil(b.ability)||'—'}</span></div>
                  <div class="cdcell"><span class="cdlabel nat">${I18N.labelNat}</span><span class="cdval">${nat}</span></div>
                </div>
                <div class="cdrow mvrow"><span class="cdlabel mv">${I18N.labelMv}</span><span class="mvwrap">${moves}</span></div>
                <div class="cdrow mvrow"><span class="cdlabel ev">EV</span><span class="mvwrap">${ev||'—'}${evx}</span></div>
                <div class="use">${USED_BY_LABEL}${(b.labels||[]).join('・')}</div>
              </div></div>`;});
          h+=`</div></div>`;
        }
        // 代表型（最多使用）に対する1v1相性表
        $('detail').innerHTML = h + `<div class="muted" style="padding:.5em">${I18N.calcMtx1v1}</div>`;
        const spec = (p&&p.builds&&p.builds[0]&&p.builds[0].spec) ? p.builds[0].spec : nm;
        const d = STATIC ? (p&&p.matchup || {namesA:[],namesB:[],cells:[],a_win:0,b_win:0})
          : await fetch(API+'/api/matchup_explain',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({p1:SUBJECT.party,p2:[spec],season:'M-2'})}).then(r=>r.json());
        $('detail').innerHTML = h + (d.cells&&d.cells.length ? matrixHTML(d, null, null) : '');
      }

      // リプレイ（インライン）
      async function openReplay(label,idx,noscroll){ stopAuto();
        document.querySelectorAll('.rtab').forEach(e=>e.classList.remove('act')); const ch=$('rchip-'+idx); ch&&ch.classList.add('act');
        const box=$('rp-box'); if(box){ box.classList.remove('hidden'); const t=$('rp-title'); if(t)t.textContent=I18N.replayPfx+(idx+1)+I18N.replaySfx; $('replay-sides').innerHTML=`<div class="muted">${I18N.loading}</div>`; }
        const d=STATIC ? ((SUBJDATA&&SUBJDATA.opp&&SUBJDATA.opp[label]&&SUBJDATA.opp[label].replays[idx]) || {error:I18N.noRecord})
          : await fetch(API+'/api/f1/replay',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({analysis_id:AID,label,idx})}).then(r=>r.json());
        if(d.error){ $('replay-sides').innerHTML=`<div class="muted r">${d.error}</div>`; return; }
        RBATTLE=d; RTURN=0; renderReplay(0); if(!noscroll) box&&box.scrollIntoView({behavior:'smooth',block:'nearest'}); }
      function closeReplay(){ stopAuto(); const b=$('rp-box'); if(b)b.classList.add('hidden'); RBATTLE=null; document.querySelectorAll('.rtab').forEach(e=>e.classList.remove('act')); }
      const hpColor=f=>f>0.5?'#22c55e':f>0.2?'#eab308':'#ef4444';
      function renderMon(p,active,mine,action,hidden){
        if(hidden){ return `<div class="rp-mon unknown">
          <div class="rp-mon-ico"><span class="rp-unknown-q">？</span></div>
          <div class="rp-mon-body"><div class="rp-mon-name muted">${I18N.steUnknown}</div>
          <div class="muted" style="font-size:.68rem">${I18N.steNotAppeared}</div></div></div>`; }
        const f=p.max_hp?p.hp/p.max_hp:0; const u=iconUrl(p.name);
        const boosts=Object.entries(p.stages||{}).filter(([,v])=>v).map(([k,v])=>`<span class="${v>0?'bup':'bdn'}">${k}${v>0?'▲':'▼'}${Math.abs(v)}</span>`).join(' ');
        return `<div class="rp-mon ${active?'act':''} ${p.alive?'':'dead'}">
          <div class="rp-mon-ico">${u?`<img src="${u}" alt="${p.name}" onerror="this.style.display='none'">`:''}${active?`<span class="rp-active-badge">${mine?'🔵':'🔴'}</span>`:''}${p.alive?'':'<span class="rp-x">×</span>'}</div>
          <div class="rp-mon-body">
            <div class="rp-mon-name">${tPoke(p.name)}${typeIconName(p.type1)}${p.type2?typeIconName(p.type2):''}</div>
            ${(()=>{const b=`${p.mega?I18N.steMega:''}${p.blade_forme?I18N.steBlade:''}${p.hero?I18N.steHero:''}${p.status?`<span class="rp-status">${STATUS_JP[p.status]||p.status}</span>`:''}${p.disguise_broken?I18N.steDisg:''}${p.electro_charged?I18N.steCharge:''}${p.confused?I18N.steConfused:''}${p.seeded?I18N.steSeeded:''}${p.taunt?I18N.steTaunt:''}${p.encore?I18N.steEncore:''}${p.salted?I18N.steSalted:''}${p.transformed?I18N.steTrans:''}${p.substitute_hp?I18N.steSubPfx+p.substitute_hp+I18N.steSubSfx:''}${p.illusion_name?I18N.steIlluPfx+p.illusion_name+I18N.steIlluSfx:''}`;return b?`<div class="rp-badges">${b}</div>`:'';})()}
            <div class="row" style="gap:.3rem"><div class="hpbar"><div class="hpfill" style="width:${Math.round(f*100)}%;background:${hpColor(f)}"></div></div><span class="rp-hp">${p.hp}/${p.max_hp}</span></div>
            ${boosts?`<div class="rp-boost">${boosts}</div>`:''}
            ${action?`<div class="rp-move"><span class="rp-order ${action.order===1?'first':''}">${action.order}</span>${typeIcon(action.move)||'➤'} ${tMove(action.move)}</div>`:''}
          </div>
        </div>`;
      }
      function hazardBar(sd){
        const h=[];
        if(sd.stealth_rock) h.push(I18N.hazSR);
        if(sd.spikes) h.push(I18N.hazSpikes+(sd.spikes>1?`×${sd.spikes}`:''));
        if(sd.toxic_spikes) h.push(I18N.hazToxicSpikes+(sd.toxic_spikes>1?`×${sd.toxic_spikes}`:''));
        if(sd.reflect) h.push(I18N.hazReflect);
        if(sd.light_screen) h.push(I18N.hazLightScreen);
        if(sd.aurora_veil) h.push(I18N.hazAuroraVeil);
        return `<div class="rp-haz">${h.map(x=>`<span class="hazchip">${x}</span>`).join('')}</div>`;
      }
      const EXPL_REASON={qselect:'十分読んだ中で最も勝率が高い手',visit:'最も多く探索した手',downside_guard:'最悪ケースを避けて交代に変更',certain_ko:'相手を確定で倒せる手'};
      function renderExplain(t, played){
        const e1=t.expl1; if(!e1) return '';        // 相手の評価は非表示（自分のみ）
        const pc=x=>x==null?'—':Math.round(x*100)+'%';
        const cands=e1.cands.slice();
        let hon=null,mv=-1; for(const c of cands){ if(c.v>mv){ mv=c.v; hon=c.a; } }   // 本命＝最多探索
        const thr=0.1*mv;                                                             // qselectの足切り相当(最多探索の10%)
        // ▶は「実際に打った手」(played=ログ由来)に合わせる。確定KO安全弁等でMCTS選択とズレるため。
        const norm=s=>(s||'').replace('メガ+','');
        let chosen=e1.chosen;
        if(played){ const h=cands.find(c=>norm(c.a)===played); if(h) chosen=h.a; }
        cands.sort((a,b)=>(b.q==null?-1:b.q)-(a.q==null?-1:a.q));                      // 勝率順
        const rows=cands.map(c=>{ const weak=(c.v||0)<thr && c.a!==chosen;            // 探索不足＝勝率が当てにならない
          return `<tr class="${c.a===chosen?'chosen':''}${weak?' weak':''}"><td>${c.a===chosen?'▶ ':''}${translateCandAction(c.a)}${c.a===hon?`<span class="honmei">${I18N.honmei}</span>`:''}${weak?`<span class="lowconf">${I18N.lowconf}</span>`:''}</td><td>${pc(c.q)}</td></tr>`;
        }).join('');
        return `<div class="expl"><div class="expl-h">${I18N.aiTitle}</div><div class="expl-side"><table class="expl-tbl"><tr><th>${I18N.candidateMove}</th><th>${I18N.winRateLabel}</th></tr>${rows}</table></div></div>`;
      }
      function renderColumn(sd,mine,act,revealed){
        return `<div class="rp-col ${mine?'mine':'opp'}"><div class="rp-label">${mine?I18N.mine:I18N.opp}</div>${hazardBar(sd)}
          ${sd.party.map((p,i)=>renderMon(p,i===sd.active_idx,mine,(act||{})[p.name],revealed&&!revealed.has(i))).join('')}</div>`;
      }
      function renderReplay(idx){ if(!RBATTLE)return; RTURN=Math.max(0,Math.min(idx,RBATTLE.turns.length-1)); const t=RBATTLE.turns[RTURN];
        const acn={}; const a1=t.side1.party[t.side1.active_idx], a2=t.side2.party[t.side2.active_idx]; if(a1&&a2&&a1.name!==a2.name){ acn[a1.name]=1; acn[a2.name]=2; }
        const wc=t.weather_count?`（あと${t.weather_count}）`:''; const wx=(t.weather&&WEATHER[t.weather])?`${WEATHER[t.weather]}${wc}　`:''; const trc=t.trick_room_count?`（あと${t.trick_room_count}）`:''; const tr=t.trick_room?`🌀 トリックルーム${trc}`:''; const ACT=parseActions(t.logs, acn);
        const banner=(wx||tr)?`<div class="rp-banner">${wx}${tr}</div>`:'';
        const seenOpp=new Set(); for(let k=0;k<=RTURN;k++){ const ai=RBATTLE.turns[k].side2.active_idx; if(ai!=null)seenOpp.add(ai); }
        $('replay-sides').innerHTML=`${banner}<div class="rp-grid">${renderColumn(t.side1,true,ACT[1])}${renderColumn(t.side2,false,ACT[2],seenOpp)}</div>`;
        $('replay-expl').innerHTML = renderExplain(t, (a1 && ACT[1] && ACT[1][a1.name]) ? ACT[1][a1.name].move : null);
        const simple=summarizeTurn(t.logs, acn);
        $('replay-log').innerHTML =
          `<div class="expl-h" style="margin-bottom:.35em">${I18N.logTitle}</div>`
          + `<div class="rlog-simple">${simple.length?simple.map(s=>`<div>${s}</div>`).join(''):`<div class="muted">${I18N.noAction}</div>`}</div>`
          + `<details class="rlog-detail"><summary>${I18N.logDetail}</summary><div class="rlog-full">${reorderLogs(t.logs||[]).map(l=>`<div>${l}</div>`).join('')||'—'}</div></details>`;
        $('replay-turn').textContent=I18N.turnPfx+t.turn+I18N.turnMid+(RBATTLE.turns.length-1);
        const rb=$('replay-result'); if(RTURN===RBATTLE.turns.length-1){rb.textContent='🏆 '+RBATTLE.winner;rb.className='wr-tag '+(RBATTLE.result===1?'g':RBATTLE.result===2?'r':'n');}else rb.textContent=''; }
      function stepTurn(d){
        stopAuto(); renderReplay(RTURN+d);
        const log=$('replay-log');
        if(log){const r=log.getBoundingClientRect();if(r.bottom>window.innerHeight)log.scrollIntoView({behavior:'smooth',block:'end'});}
      }
      function toggleAuto(){if(autoTimer)stopAuto();else{$('btn-auto').textContent=I18N.autoStop;autoTimer=setInterval(()=>{if(RTURN>=RBATTLE.turns.length-1){stopAuto();return;}renderReplay(RTURN+1);},1170);}}
      function stopAuto(){if(autoTimer){clearInterval(autoTimer);autoTimer=null;}const b=$('btn-auto');if(b)b.textContent=I18N.autoPlay;}

      // define:varsはスクリプト全体をIIFEで包むため、inline onclick等から呼ぶ関数はwindowに明示登録する
      Object.assign(window, {
        selComp, toggleSubjSeason, toggleOppSeason, clearSubjFilter,
        onSubjFilterInput, onSubjFilterKey, applySug, removeFilterPoke,
        onOppFilterInput, onOppFilterKey, applyOppSug, removeOppFilterPoke,
        selectSubjectIdx, switchTab, setSort, selectOppRanker,
        stepTurn, toggleAuto, openReplay, selectOppPoke,
      });
    </script>
