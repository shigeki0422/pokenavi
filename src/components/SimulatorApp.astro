      function renderPokeList(){
        $('sort-num').classList.toggle('btn-active', PSORT==='num');
        $('sort-wr').classList.toggle('btn-active', PSORT==='wr');
        $('sort-num').textContent = PSORT==='num' ? (PNDIR==='asc' ? I18N.sortNumAscP : I18N.sortNumDescP) : I18N.sortBaseP;
        $('sort-wr').textContent = PSORT==='wr' ? (PWDIR==='asc' ? I18N.sortWrAscP : I18N.sortWrDescP) : I18N.sortWrBaseP;
