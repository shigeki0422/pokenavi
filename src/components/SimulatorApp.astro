          if(b.setup_loss_rate>=0.3) h+=`<div class="frow"><b class="r">${I18N.setupLossPfx}${Math.round(b.setup_loss_rate*100)}${I18N.setupLossSfx}</b></div>`;
          h+=`</div>`;
        }
        const br=b.battle_results||[]; const escL=label.replace(/'/g,"\\'");
        const tabs=Array.from({length:c.n},(_,i)=>{const res=br[i];const cls=res===1?'win':res===2?'lose':'draw';const mk=res===1?I18N.winMark:res===2?I18N.loseMark:res===0?I18N.drawMark:'';return `<button class="rtab ${cls}" id="rchip-${i}" onclick="openReplay('${escL}',${i})">${I18N.battlePfx}${i+1}${I18N.battleSfx}${mk?` <b>${mk}</b>`:''}</button>`;}).join('');
        h+=`<div class="rp-pick-hd">${I18N.rp_pickhd}</div>
