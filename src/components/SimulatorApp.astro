        const ev = p.evs.length===6 ? ['H','A','B','C','D','S'].map((l,k)=>(p.evs[k]&&p.evs[k]!=='0')?`<span class="evchip ev-${l}">${l}<b>${p.evs[k]}</b></span>`:null).filter(Boolean).join('') : '';
        const _natNm = NATURE_NAME_MAP[p.nature] || p.nature; const nat = p.nature ? `${_natNm}${NATURE[p.nature]?` (${NATURE[p.nature]})`:''}` : '—';
        const moves = p.moves.filter(m=>m&&m!=='なし').length ? p.moves.filter(m=>m&&m!=='なし').map(m=>`<span class="mvchip">${typeIcon(m)}${tMove(m)}</span>`).join('') : '—';
        $(containerId+'-d').innerHTML =
          `<div class="cdgrid">
             <div class="cdcell"><span class="cdlabel item">${I18N.labelItem}</span><span class="cdval">${itemIcon(p.item)}${tItem(p.item)||'—'}</span></div>
             <div class="cdcell"><span class="cdlabel abil">${I18N.labelAbil}</span><span class="cdval">${tAbil(p.ability)||'—'}</span></div>
             <div class="cdcell"><span class="cdlabel nat">${I18N.labelNat}</span><span class="cdval">${nat}</span></div>
           </div>
           <div class="cdrow mvrow"><span class="cdlabel mv">${I18N.labelMv}</span><span class="mvwrap">${moves}</span></div>
           <div class="cdrow mvrow"><span class="cdlabel ev">EV</span><span class="mvwrap">${ev||'—'}</span></div>`;
      }

      const toKatakana = s => s.replace(/[ぁ-ゖ]/g, c => String.fromCharCode(c.charCodeAt(0) + 0x60));

      const basePoName = n => n.split('（')[0].split('(')[0].trim();
      function partyMatches(r){
        if(!SUBJ_FILTER_POKES.length) return true;
        if(!r.party) return false;
        const names = r.party.map(s => basePoName(parseSpec(s).name));
        return SUBJ_FILTER_POKES.every(p => {
          const fb = basePoName(p.name);
          return names.includes(fb);
        });
      }
      function specsIconsHtml(specs, filterBases){
        if(!specs||!specs.length) return '';
        const imgs = specs.slice(0,6).map(s=>{
          const n=parseSpec(s).name; const u=iconUrl(n);
          const hit=filterBases&&filterBases.length&&filterBases.includes(basePoName(n));
          return u?`<img src="${u}" alt="" class="${hit?'matched':''}">`:''
        }).join('');
        return imgs ? `<div class="pitem-icons">${imgs}</div>` : '';
      }
      function partyIconsHtml(r){
        if(!r.party) return '';
        return specsIconsHtml(r.party, SUBJ_FILTER_POKES.map(p=>basePoName(p.name)));
      }

      function renderFilterChips(){
        const el=$('filter-chips'); if(!el) return;
        el.innerHTML = SUBJ_FILTER_POKES.map(p=>`<span class="filter-chip" title="${p.name}">${p.icon?`<img src="${p.icon}" alt="${p.name}">`:''}<button class="filter-chip-x" onclick="removeFilterPoke('${p.name.replace(/'/g,"\\'")}')">✕</button></span>`).join('');
        $('subj-filter').placeholder = SUBJ_FILTER_POKES.length ? I18N.filterMore : I18N.filterPh;
        const btn=$('subj-clear-btn'); if(btn) btn.style.display = SUBJ_FILTER_POKES.length ? '' : 'none';
      }
      function removeFilterPoke(name){
        SUBJ_FILTER_POKES = SUBJ_FILTER_POKES.filter(p=>p.name!==name);
        renderFilterChips(); renderSubjectList(); saveUrlState();
      }
      function clearSubjFilter(){
        SUBJ_FILTER_POKES = [];
        SUBJ_SEASONS = {'M-1':true,'M-2':true};
        document.querySelectorAll('.seasonbar input[type=checkbox]').forEach(cb=>{ cb.checked=true; });
        renderFilterChips(); renderSubjectList(); saveUrlState();
      }

      // STATICモードで全パーティをバックグラウンドプリフェッチ（フィルター追加時に1回だけ）
      async function prefetchAllParties(){
        if(_prefetchStarted||!STATIC) return; _prefetchStarted=true;
        const unloaded=RANKERS.filter(r=>!r.party&&r.file);
        await Promise.all(unloaded.map(async r=>{
          try{ const d=await fetch(`${R2}/subjects/${r.file}`).then(x=>x.json()); if(d) r.party=d.subject.party; }catch{}
        }));
        renderSubjectList();
      }

      // フィルター入力サジェスト
      let _searchIdx = null;
      let _sugActive = -1;
      async function loadSearchIdx(){ if(_searchIdx) return _searchIdx; try{ _searchIdx=await fetch('/search-index.json').then(r=>r.json()); }catch{ _searchIdx=[]; } return _searchIdx; }
      function hlSug(text, q){ const qk=toKatakana(q); const t=qk!==q?qk:q; const i=text.indexOf(t); if(i<0)return text; return text.slice(0,i)+'<mark>'+text.slice(i,i+t.length)+'</mark>'+text.slice(i+t.length); }
      async function onSubjFilterInput(val){
        const sug=$('subj-sug'); _sugActive=-1;
        if(!val.trim()){ sug.style.display='none'; return; }
        const q=val.trim(), qk=toKatakana(q);
        const idx=await loadSearchIdx();
        const hits=idx.filter(x=>x.t==='p'&&(x.n.includes(q)||x.n.includes(qk))).slice(0,8);
        if(!hits.length){ sug.style.display='none'; return; }
        sug.innerHTML=hits.map((x,i)=>{
          const already=SUBJ_FILTER_POKES.some(p=>p.name===x.n);
          return `<div class="sug-item${already?' added':''}" data-name="${x.n}" data-icon="${x.i}" data-idx="${i}" onclick="applySug('${x.n.replace(/'/g,"\\'")}','${x.i}')"><img src="${x.i}" alt=""><span>${hlSug(x.n,q)}</span></div>`;
        }).join('');
        sug.style.display='block';
      }
      function applySug(name, icon){
        if(!SUBJ_FILTER_POKES.some(p=>p.name===name)){
          SUBJ_FILTER_POKES.push({name, icon});
          prefetchAllParties();
        }
        $('subj-filter').value=''; $('subj-sug').style.display='none'; _sugActive=-1;
        renderFilterChips(); renderSubjectList(); saveUrlState();
      }
      function onSubjFilterKey(e){
        const sug=$('subj-sug'); const items=[...sug.querySelectorAll('.sug-item:not(.added)')];
        if(!items.length||sug.style.display==='none') return;
        if(e.key==='ArrowDown'){ e.preventDefault(); _sugActive=Math.min(_sugActive+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('act',i===_sugActive)); }
        else if(e.key==='ArrowUp'){ e.preventDefault(); _sugActive=Math.max(_sugActive-1,0); items.forEach((el,i)=>el.classList.toggle('act',i===_sugActive)); }
        else if(e.key==='Enter'&&_sugActive>=0){ const it=items[_sugActive]; applySug(it.dataset.name, it.dataset.icon); }
        else if(e.key==='Escape'){ sug.style.display='none'; _sugActive=-1; }
      }
      document.addEventListener('click', e=>{ if(!e.target.closest('.filter-wrap')){ $('subj-sug').style.display='none'; $('opp-sug').style.display='none'; } });
      let _oppSugActive = -1;
      function renderOppFilterChips(){
        const el=$('opp-filter-chips'); if(!el) return;
        el.innerHTML = OPP_FILTER_POKES.map(p=>`<span class="filter-chip" title="${p.name}">${p.icon?`<img src="${p.icon}" alt="${p.name}">`:''}<button class="filter-chip-x" onclick="removeOppFilterPoke('${p.name.replace(/'/g,"\\'")}')">✕</button></span>`).join('');
        $('opp-filter').placeholder = OPP_FILTER_POKES.length ? I18N.filterMore : I18N.filterPh;
      }
      function removeOppFilterPoke(name){
        OPP_FILTER_POKES = OPP_FILTER_POKES.filter(p=>p.name!==name);
        renderOppFilterChips(); if(TAB==='ranker') renderRankerTab(); saveUrlState();
      }
      function oppCardMatches(c){
        if(!OPP_FILTER_POKES.length) return true;
        if(!c.specs||!c.specs.length) return false;
        const names = c.specs.map(s=>basePoName(parseSpec(s).name));
        return OPP_FILTER_POKES.every(p=>names.includes(basePoName(p.name)));
      }
      async function onOppFilterInput(val){
        const sug=$('opp-sug'); _oppSugActive=-1;
        if(!val.trim()){ sug.style.display='none'; return; }
        const q=val.trim(), qk=toKatakana(q);
        const idx=await loadSearchIdx();
        const hits=idx.filter(x=>x.t==='p'&&(x.n.includes(q)||x.n.includes(qk))).slice(0,8);
        if(!hits.length){ sug.style.display='none'; return; }
        sug.innerHTML=hits.map((x,i)=>{
          const already=OPP_FILTER_POKES.some(p=>p.name===x.n);
          return `<div class="sug-item${already?' added':''}" data-name="${x.n}" data-icon="${x.i}" data-idx="${i}" onclick="applyOppSug('${x.n.replace(/'/g,"\\'")}','${x.i}')"><img src="${x.i}" alt=""><span>${hlSug(x.n,q)}</span></div>`;
        }).join('');
        sug.style.display='block';
      }
      function applyOppSug(name, icon){
        if(!OPP_FILTER_POKES.some(p=>p.name===name)) OPP_FILTER_POKES.push({name, icon});
        $('opp-filter').value=''; $('opp-sug').style.display='none'; _oppSugActive=-1;
        renderOppFilterChips(); if(TAB==='ranker') renderRankerTab(); saveUrlState();
      }
      function onOppFilterKey(e){
        const sug=$('opp-sug'); const items=[...sug.querySelectorAll('.sug-item:not(.added)')];
        if(!items.length||sug.style.display==='none') return;
        if(e.key==='ArrowDown'){ e.preventDefault(); _oppSugActive=Math.min(_oppSugActive+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('act',i===_oppSugActive)); }
        else if(e.key==='ArrowUp'){ e.preventDefault(); _oppSugActive=Math.max(_oppSugActive-1,0); items.forEach((el,i)=>el.classList.toggle('act',i===_oppSugActive)); }
        else if(e.key==='Enter'&&_oppSugActive>=0){ const it=items[_oppSugActive]; applyOppSug(it.dataset.name, it.dataset.icon); }
        else if(e.key==='Escape'){ sug.style.display='none'; _oppSugActive=-1; }
      }
      const rankNo=l=>{const mm=(l||'').match(/#(\d+)/);return mm?+mm[1]:99999;};  // 「M-1#100」の100を数値で抽出（番号順ソート用）
      const seasonOf=l=>{const m=(l||'').match(/^(M-\d)/);return m?m[1]:'';};       // ラベル先頭の「M-1」「M-2」
      const seasonOrd=l=>{const s=seasonOf(l);return s==='M-1'?0:s==='M-2'?1:2;};   // M-1→M-2の順
      const cmpLabel=(a,b)=>{const d=seasonOrd(a.label)-seasonOrd(b.label);return d||rankNo(a.label)-rankNo(b.label);};
      if(STATIC){
        Promise.all([
          fetch(META+'/index.json').then(r=>r.json()),
          fetch(META+'/icons.json').then(r=>r.json()),
          fetch(META+'/move_types.json').then(r=>r.json())
        ]).then(([idx,ic,mt])=>{ RANKERS=(idx.subjects||[]).slice().sort(cmpLabel); ICONS=ic; Object.assign(MOVET,mt);
          RANKERS.forEach(s=>SAVEDWR[s.label]=s.win_rate); renderSubjectList();
          if(RANKERS.length) restoreUrlState(RANKERS[0]); });
      } else {
        Promise.all([
          fetch(API+'/api/f1/rankers').then(r=>r.json()),
          fetch(API+'/api/f1/saved').then(r=>r.json()),
          fetch(API+'/api/f1/icons').then(r=>r.json()),
          fetch(API+'/api/f1/move_types').then(r=>r.json())
        ]).then(([rs,sv,ic,mt])=>{ RANKERS=rs.slice().sort(cmpLabel); SAVED=sv; ICONS=ic; Object.assign(MOVET,mt); renderSubjectList();
          const first=RANKERS.findIndex(r=>sv[r.label]); restoreUrlState(RANKERS[first>=0?first:0]); });
      }

      function subjectWR(label){ if(STATIC) return (label in SAVEDWR)?SAVEDWR[label]:null;
        const s=SAVED[label]; if(!s) return null;
        const a=s.cards; return a.length? a.reduce((t,c)=>t+c.win_rate,0)/a.length : null; }
      function seasonBadge(label){ const s=seasonOf(label); return s?`<span class="sbadge ${s==='M-1'?'m1':'m2'}">${s}</span>`:''; }
      const nameNoSeason=l=>(l||'').replace(/^M-\d\s*/,'');   // バッジと重複する先頭「M-1/M-2」を名称から除去
      function renderSubjectList(){
        const items = RANKERS.map((r,i)=>({r,i}))
          .filter(({r})=>SUBJ_SEASONS[seasonOf(r.label)]!==false)
          .filter(({r})=>partyMatches(r));
        const sl=$('subject-list');
        sl.classList.toggle('filter-active', SUBJ_FILTER_POKES.length>0);
        const uNames = uniquePartyNames(items.map(({r})=>r.party));
        sl.innerHTML = items.map(({r,i},k)=>{
          const sc=seasonOf(r.label)==='M-1'?'s-m1':seasonOf(r.label)==='M-2'?'s-m2':'';
          return `<div class="pitem ${sc}" data-i="${i}" onclick="selectSubjectIdx(${i})">${seasonBadge(r.label)}<span class="nm" title="${partyFullTitle(r.party)}">${uNames[k]}</span>${partyIconsHtml(r)}</div>`;
        }).join('') || `<div class="muted" style="padding:.6em">${SUBJ_FILTER_POKES.length?I18N.noPartyMatch:I18N.selectSeason}</div>`;
      }
      function saveUrlState(){
        const p=new URLSearchParams();
        if(SUBJECT) p.set('subj',SUBJECT.label);
        if(OPP) p.set('opp',OPP);
        if(SUBJ_FILTER_POKES.length) p.set('sf',SUBJ_FILTER_POKES.map(x=>x.name).join(','));
        if(OPP_FILTER_POKES.length) p.set('of',OPP_FILTER_POKES.map(x=>x.name).join(','));
        ['static','theme','verify'].forEach(k=>{const v=new URLSearchParams(location.search).get(k);if(v!==null)p.set(k,v);});
        history.replaceState(null,'',location.pathname+(p.toString()?'?'+p.toString():''));
      }
      async function restoreUrlState(defaultSubj){
        const p=new URLSearchParams(location.search);
        const sfNames=(p.get('sf')||'').split(',').filter(Boolean);
        const ofNames=(p.get('of')||'').split(',').filter(Boolean);
        if(sfNames.length||ofNames.length){
          const idx=await loadSearchIdx();
          sfNames.forEach(n=>{if(!SUBJ_FILTER_POKES.some(x=>x.name===n)){const f=idx.find(x=>x.n===n);SUBJ_FILTER_POKES.push({name:n,icon:f?.i||''});}});
          ofNames.forEach(n=>{if(!OPP_FILTER_POKES.some(x=>x.name===n)){const f=idx.find(x=>x.n===n);OPP_FILTER_POKES.push({name:n,icon:f?.i||''});}});
          renderFilterChips(); renderOppFilterChips(); renderSubjectList();
          if(STATIC) prefetchAllParties();
        }
        const subjLabel=p.get('subj');
        const target=subjLabel?RANKERS.find(r=>r.label===subjLabel):null;
        await selectSubject(target||defaultSubj);
        const oppLabel=p.get('opp');
        if(oppLabel&&CARDS[oppLabel]) selectOppRanker(oppLabel);
      }
      function toggleSubjSeason(s,el){ SUBJ_SEASONS[s]=el.checked; renderSubjectList(); }
      function toggleOppSeason(s,el){ OPP_SEASONS[s]=el.checked; if(TAB==='ranker') renderRankerTab(); }
      function selectSubjectIdx(i){ selectSubject(RANKERS[i]); }
      async function selectSubject(r){
        SUBJECT=r; OPP=null;
        document.querySelectorAll('#subject-list .pitem').forEach(e=>e.classList.toggle('active', RANKERS[+e.dataset.i]===r));
        $('opp-comp').innerHTML = `<div class="muted">${I18N.oppSelectMsg}</div>`;
        $('detail').innerHTML = ''; $('progress-wrap').classList.add('hidden');
        CARDS = {}; SUBJDATA = null;
        if(STATIC){
          $('btn-analyze').classList.add('hidden'); setStatus(I18N.loading,'#b45309');
          $('subject-comp').innerHTML=`<div class="muted">${I18N.loading}</div>`; $('opp-list').innerHTML='';
          const d = await fetch(`${R2}/subjects/${r.file}`).then(x=>x.json()).catch(()=>null);
          if(!SUBJECT || SUBJECT!==r) return;   // 連打時の取り違え防止
          if(!d){ setStatus(I18N.dataFail,'#dc2626'); return; }
          SUBJDATA=d; SUBJECT={label:r.label, party:d.subject.party, file:r.file}; AID=r.label;
          r.party = d.subject.party;
          renderComp('subject-comp', d.subject.party, `${labelName(r.label, r.party)}${I18N.compOf}`);
          d.cards.forEach(c=>CARDS[c.label]=c); setStatus('',''); renderTab(); renderSubjectList(); saveUrlState();
          return;
        }
        renderComp('subject-comp', r.party, `${labelName(r.label, r.party)}${I18N.compOf}`);
        if(SAVED[r.label]){ AID=SAVED[r.label].analysis_id; $('btn-analyze').classList.add('hidden'); setStatus('','');
          SAVED[r.label].cards.forEach(c=>CARDS[c.label]=c); renderTab();
        } else { AID=null; $('btn-analyze').classList.remove('hidden'); setStatus(I18N.notCalc,'');
          $('opp-list').innerHTML=`<div class="muted" style="padding:.6em">${I18N.runFirst}</div>`; $('summary').textContent=''; }
        saveUrlState();
      }

      $('btn-analyze').onclick = async ()=>{
        if(!SUBJECT) return; $('btn-analyze').disabled=true; $('progress-wrap').classList.remove('hidden'); setStatus(I18N.analyzing,'#b45309');
        const res = await fetch(API+'/api/f1/analyze',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({p1:SUBJECT.party,n:10,season:'M-2',exclude_label:SUBJECT.label})}).then(r=>r.json());
        AID=res.analysis_id; pollProgress();
      };
      async function pollProgress(){
        const p = await fetch(API+`/api/f1/progress/${AID}`).then(r=>r.json());
        if(p.error){ setStatus(I18N.errPfx+p.error,'#dc2626'); return; }
        $('progress-fill').style.width=(p.total?Math.round(p.done/p.total*100):0)+'%';
        $('progress-text').textContent=`${p.done} / ${p.total}${I18N.progMid}${p.cards.length}${I18N.progSfx}`;
        p.cards.forEach(c=>CARDS[c.label]=c); if(TAB==='ranker') renderTab();
        if(p.running){ setStatus(I18N.analyzing,'#b45309'); setTimeout(pollProgress,2000); }
        else{ setStatus(I18N.done,'#16a34a'); $('btn-analyze').disabled=false; renderSubjectList(); }
      }

      function switchTab(t){ TAB=t; $('tab-ranker').classList.toggle('active',t==='ranker'); $('tab-pokemon').classList.toggle('active',t==='pokemon');
        const osb=$('opp-seasonbar'); if(osb) osb.style.display = (t==='ranker')?'flex':'none';
        OPP=null; $('opp-comp').innerHTML=`<div class="muted">${I18N.leftSelectMsg}</div>`; $('detail').innerHTML=''; renderTab(); }
      function renderTab(){ $('sortbar').style.display = 'flex'; if(TAB==='ranker') renderRankerTab(); else renderPokemonTab(); }
      function setSort(s){
        if(TAB==='ranker'){
          if(s===SORT){ if(s==='wr') WRDIR=WRDIR==='asc'?'desc':'asc'; else NUMDIR=NUMDIR==='asc'?'desc':'asc'; }
          else SORT=s;
          renderRankerTab();
        } else {
          if(s===PSORT){ if(s==='wr') PWDIR=PWDIR==='asc'?'desc':'asc'; else PNDIR=PNDIR==='asc'?'desc':'asc'; }
          else PSORT=s;
          renderPokeList();
        }
      }

      // VS ランカー
      function renderRankerTab(){
        $('sort-num').classList.toggle('btn-active', SORT==='num');
        $('sort-wr').classList.toggle('btn-active', SORT==='wr');
        $('sort-num').textContent = SORT==='num' ? (NUMDIR==='asc' ? I18N.sortNumAscR : I18N.sortNumDescR) : I18N.sortNum;
        $('sort-wr').textContent = SORT==='wr' ? (WRDIR==='asc' ? I18N.sortWrAscR : I18N.sortWrDescR) : I18N.sortWr;
        const rn = l => { const m=l.match(/#(\d+)/); return m?+m[1]:9999; };
        const allCards = Object.values(CARDS).filter(c=>OPP_SEASONS[seasonOf(c.label)]!==false).sort((a,b)=>
          SORT==='num' ? ((seasonOrd(a.label)-seasonOrd(b.label)) || (NUMDIR==='asc'?rn(a.label)-rn(b.label):rn(b.label)-rn(a.label)))
                       : (WRDIR==='asc'?a.win_rate-b.win_rate:b.win_rate-a.win_rate));
        const cards = allCards.filter(c=>oppCardMatches(c));
        const ol=$('opp-list');
        ol.classList.toggle('filter-active', OPP_FILTER_POKES.length>0);
        if(!cards.length){ const all=Object.keys(CARDS).length; ol.innerHTML=`<div class="muted" style="padding:.6em">${OPP_FILTER_POKES.length?I18N.noPartyMatch:all?I18N.selectSeason:I18N.noData}</div>`; $('summary').textContent=''; return; }
        const ng=cards.filter(c=>c.win_rate>=0.6).length, nb=cards.filter(c=>c.win_rate<=0.4).length, nm=cards.length-ng-nb;
        $('summary').innerHTML=`<div class="wr-summary"><span>${labelName(SUBJECT.label, SUBJECT.party)}${I18N.sumRkMid}${cards.length}${VSNOUN}</span><div class="wr-bar"><div class="wr-bar-g" style="flex:${ng}"></div><div class="wr-bar-n" style="flex:${nm}"></div><div class="wr-bar-r" style="flex:${nb}"></div></div><span><span class="wr-cnt-g">${I18N.sumGoodFmt.replace('{n}',ng)}</span>${I18N.sumSep}${I18N.sumEvenFmt.replace('{n}',nm)}${I18N.sumSep}<span class="wr-cnt-r">${I18N.sumBadFmt.replace('{n}',nb)}</span></span></div>`;
        const oppFilterBases = OPP_FILTER_POKES.map(p=>basePoName(p.name));
        const uNames = uniquePartyNames(cards.map(c=>c.specs));
        ol.innerHTML = cards.map((c,k)=>{ const wr=c.win_rate, sc=seasonOf(c.label)==='M-1'?'s-m1':seasonOf(c.label)==='M-2'?'s-m2':'', wrc=wr>=0.6?'opp-g':wr<=0.4?'opp-r':'';
          return `<div class="pitem ${sc} ${wrc}" data-label="${encodeURIComponent(c.label)}" onclick="selectOppRanker('${c.label.replace(/'/g,"\\'")}')">${seasonBadge(c.label)}<span class="nm" title="${partyFullTitle(c.specs)}">${uNames[k]}</span>${specsIconsHtml(c.specs,oppFilterBases)}</div>`;
        }).join('');
        if(!OPP || !cards.some(c=>c.label===OPP)) selectOppRanker(cards[0].label);
        else document.querySelectorAll('#opp-list .pitem').forEach(e=>e.classList.toggle('active', decodeURIComponent(e.dataset.label||'')===OPP));
      }
      function selectOppRanker(label){ OPP=label; const c=CARDS[label];
        document.querySelectorAll('#opp-list .pitem').forEach(e=>e.classList.toggle('active', decodeURIComponent(e.dataset.label||'')===label));
        renderComp('opp-comp', c.specs, `${labelName(label, c.specs)}${I18N.compOf}`);
        renderRankerDetail(label, c);
        saveUrlState();
      }
      function verdict(wr){
        if(wr>=1) return {t:I18N.verdictWinAllT,c:'#15803d',bg:'#dcfce7',i:'🏆'};
        if(wr>=0.67) return {t:I18N.verdictWinT,c:'#15803d',bg:'#dcfce7',i:'✅'};
        if(wr>=0.34) return {t:I18N.verdictEvenT,c:'#475569',bg:'#f1f5f9',i:'⚖'};
        if(wr>0) return {t:I18N.verdictLoseT,c:'#b91c1c',bg:'#fee2e2',i:'⚠'};
