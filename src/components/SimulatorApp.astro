눈', stBurn:'화상', stPoison:'독', stBadPoison:'맹독', stParalysis:'마비', stSleep:'수면', stFreeze:'얼음', swBadge:'교체', mine:'내 쪽', opp:'상대', sideMe:'내 쪽', sideOpp:'상대', logTitle:'📜 배틀 로그', logDetail:'상세 로그 보기', noAction:'행동 없음', turnPfx:'턴 ', turnMid:' / ', aiTitle:'🧠 이 턴의 AI 예상', candidateMove:'후보 수', winRateLabel:'승률', honmei:'유력', lowconf:'자신 없음', calcMtx1v1:'1v1 상성표 계산 중…' , headingMA:'시뮬레이션: M-A', headingMB:'시뮬레이션: M-B', toMAText:'M-A(과거 시즌)로 →', toMBText:'M-B(최신 시즌)로 →', tabParty:'VS 파티', obStep1T:'파티를 선택', obStep1D:'목록에서 원하는 상위 구성을 선택(이름으로 검색 가능)', obStep2T:'상대를 선택', obStep2D:'VS 랭커에서 전체 전적을, VS 포켓몬에서 특정 상대와의 상성을 확인', obStep3T:'결과를 확인', obStep3D:'승률·선출 경향·리플레이로 상위 구성의 움직임을 학습' },
};
const I18N = I18N_ALL[lang];
const NATURE_NAME_MAP = lang === 'en' ? NATURE_NAME_EN : lang === 'ko' ? NATURE_NAME_KO : {};
const POKEMON_NAME_MAP = lang === 'en' ? POKEMON_NAME_EN : lang === 'ko' ? POKEMON_NAME_KO : {};
const MOVE_NAME_MAP = lang === 'en' ? MOVE_NAME_EN : lang === 'ko' ? MOVE_NAME_KO : {};
const ITEM_NAME_MAP = lang === 'en' ? ITEM_NAME_EN : lang === 'ko' ? ITEM_NAME_KO : {};
const ABILITY_NAME_MAP = lang === 'en' ? ABILITY_NAME_EN : lang === 'ko' ? ABILITY_NAME_KO : {};

const heading = isMB ? I18N.headingMB : I18N.headingMA;
const lead = `${I18N.lead}<a href="${I18N.bsHref}">${I18N.bsLink}</a>　<a href="${isMB ? pfx + '/simulator' : pfx + '/simulator-mb'}">${isMB ? I18N.toMAText : I18N.toMBText}</a>`;
---

<style is:global>
      main { width: auto; max-width: 1040px; margin: 0 auto; padding: 1.4em 1em 4em; color: rgb(var(--gray-dark)); overflow-x: clip; }
      h1 { font-size: 1.5rem; margin: 0 0 .2em; }
      .lead { font-size: .88rem; color: rgb(var(--gray)); margin: 0 0 1.1em; }
      .seclabel { font-size: .82rem; font-weight: 700; color: rgb(var(--gray)); margin: 0 0 .4em; }
      .card { background:#fff; border:1px solid rgb(var(--gray-light)); border-radius:12px; box-shadow:0 1px 3px rgba(var(--black),0.05); }
      .mb { margin-bottom:1.1em; }
      .muted { font-size:.8rem; color:rgb(var(--gray)); }
      .row { display:flex; align-items:center; gap:.7rem; flex-wrap:wrap; }
      .btn { background:var(--accent); color:#fff; border:none; border-radius:8px; padding:.55em 1.2em; font-weight:700; font-size:.85rem; cursor:pointer; font-family:var(--font-atkinson); }
      .btn:disabled{opacity:.5;cursor:default}
      @media (hover:hover){ .btn:hover{background:var(--accent-dark)} .btn-ghost:hover{background:#cdd5df} }
      .btn-sm{padding:.35em .8em;font-size:.78rem;border-radius:6px}
      .btn-ghost{background:rgb(var(--gray-light));color:rgb(var(--gray-dark))}
      .btn-active{background:var(--accent);color:#fff}
      .hpbar{height:8px;border-radius:9999px;background:rgb(var(--gray-light));overflow:hidden;flex:1}
      .hpfill{height:100%;border-radius:9999px;transition:width .2s}
      .g{color:#16a34a}.r{color:#dc2626}.n{color:rgb(var(--gray-dark))}
      .bg-g{background:#dcfce7;color:#15803d}.bg-r{background:#fee2e2;color:#b91c1c}.bg-n{background:rgb(var(--gray-light));color:rgb(var(--gray))}
      /* 上下2分割（一覧＋構成） */
      .split{display:grid;grid-template-columns:400px 1fr;gap:.8rem;align-items:start}
      @media(max-width:760px){.split{grid-template-columns:1fr}}
      .pl-wrap{position:relative}
      .filter-chips{display:flex;flex-wrap:wrap;gap:3px;align-items:center}
      .filter-chip{display:inline-flex;align-items:center;gap:1px;padding:1px 3px 1px 1px;background:#eef2ff;border:1px solid #c7d2fe;border-radius:999px}
      .filter-chip img{width:22px;height:22px;object-fit:contain;flex-shrink:0}
      .filter-chip-x{background:none;border:none;cursor:pointer;color:#94a3b8;font-size:.65rem;line-height:1;padding:0 1px;display:flex;align-items:center}
      .filter-chip-x:hover{color:#dc2626}
      .filter-inp{width:100%;box-sizing:border-box;padding:.35em .65em;border:1px solid rgb(var(--gray-light));border-radius:8px;font-size:.82rem;margin:.15em 0 .35em;outline:none;font-family:var(--font-atkinson)}
      .filter-inp:focus{border-color:var(--accent)}
      .picklist{border:1px solid rgb(var(--gray));border-radius:10px;overflow-y:scroll;max-height:250px;min-height:0;background:#fff}
      /* スクロールバーを常時表示（標準scrollbar-widthは付けない＝webkit指定を有効化し、macOSのオーバーレイを無効化） */
      .picklist::-webkit-scrollbar{-webkit-appearance:none;width:13px}
      .picklist::-webkit-scrollbar-track{background:#eef0f3;border-radius:0 10px 10px 0}
      .picklist::-webkit-scrollbar-thumb{background:#94a3b8;border-radius:7px;border:3px solid #eef0f3;min-height:40px}
      .picklist::-webkit-scrollbar-thumb:hover{background:#64748b}
      .pitem{display:flex;align-items:center;gap:.35rem;padding:.4em .5em;cursor:pointer;border-top:1px solid #f1f5f9;font-size:.8rem;border-left:3px solid transparent}
      .pitem:first-child{border-top:none}
      .pitem:hover{background:#f8fafc}
      .pitem.active{background:#eef2ff;border-left-color:var(--accent);font-weight:700}
      .pitem.s-m1{box-shadow:inset 3px 0 0 #93c5fd}
      .pitem.s-m2{box-shadow:inset 3px 0 0 #fcd34d}
      .seasonbar{display:flex;align-items:center;gap:.5em;padding:.25em .15em .4em;font-size:.78rem;flex-wrap:wrap}
      .seasonbar .schk{display:inline-flex;align-items:center;gap:.3em;cursor:pointer;user-select:none}
      .sbadge{font-size:.62rem;font-weight:800;padding:.08em .4em;border-radius:5px;flex-shrink:0;letter-spacing:-.02em}
      .sbadge.m1{background:#dbeafe;color:#1d4ed8}
      .sbadge.m2{background:#fef3c7;color:#b45309}
      .expl{margin:.5em 0;padding:.5em .7em;background:#f8fafc;border:1px solid rgb(var(--gray-light));border-radius:8px;font-size:.8rem}
      .expl-h{font-weight:800;margin-bottom:.35em}
      .expl-side{margin-bottom:.35em}
      .expl-side.opp2{color:rgb(var(--gray));font-size:.76rem}
      .expl-tbl{border-collapse:collapse;margin-top:.25em;width:100%;max-width:360px}
      .expl-tbl th,.expl-tbl td{border:1px solid rgb(var(--gray-light));padding:.12em .5em;text-align:left;font-size:.76rem}
      .expl-tbl th{background:#eef2f7;font-weight:700}
      .expl-tbl td:nth-child(2),.expl-tbl td:nth-child(3),.expl-tbl th:nth-child(2),.expl-tbl th:nth-child(3){text-align:right}
      .expl-tbl tr.chosen td{background:#eef2ff;font-weight:700}
      .honmei{display:inline-block;margin-left:.4em;font-size:.6rem;font-weight:800;padding:.05em .35em;border-radius:5px;background:#fee2e2;color:#b91c1c;vertical-align:middle}
      .expl-tbl tr.weak td{color:#9aa3af}
      .lowconf{display:inline-block;margin-left:.4em;font-size:.6rem;font-weight:800;padding:.05em .35em;border-radius:5px;background:#e5e7eb;color:#6b7280;vertical-align:middle}
      .pitem .nm{flex:1;font-weight:700;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .pitem .wr{font-weight:700;font-size:.85rem}
      .pitem.opp-g{border-right:3px solid #4ade80}
      .pitem.opp-r{border-right:3px solid #f87171}
      .pitem-icons{display:flex;gap:1px;flex-shrink:0}
      .pitem-icons img{width:16px;height:16px;object-fit:contain}
      .filter-active .pitem-icons img.matched{outline:2px solid #6366f1;border-radius:3px}
      .wr-summary{display:flex;align-items:center;gap:.6em;flex-wrap:wrap;font-size:.8rem;margin-bottom:.4em}
      .wr-bar{display:flex;height:7px;border-radius:4px;overflow:hidden;flex:1;min-width:80px;gap:1px;align-self:center}
      .wr-bar-g{background:#4ade80}.wr-bar-n{background:#cbd5e1}.wr-bar-r{background:#f87171}
      .wr-cnt-g{color:#15803d;font-weight:700}.wr-cnt-r{color:#b91c1c;font-weight:700}
      @media(max-width:760px){
        .split{grid-template-columns:1fr}
        .picklist{max-height:160px !important}
        .comp{font-size:.8rem}
      }
      .filter-wrap{position:relative}
      .filter-sug{position:absolute;top:calc(100% + 2px);left:0;right:0;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,.12);z-index:200;overflow:hidden;max-height:240px;overflow-y:auto}
      .sug-item{display:flex;align-items:center;gap:8px;padding:6px 12px;cursor:pointer;font-size:.82rem;border-bottom:1px solid #f8fafc}
      .sug-item:last-child{border-bottom:none}
      .sug-item:hover,.sug-item.act{background:#fff7ed}
      .sug-item img{width:28px;height:28px;object-fit:contain;flex-shrink:0}
      .sug-item mark{background:#fef9c3;color:inherit;border-radius:2px;padding:0 1px}
      .sug-item.added{opacity:.4;pointer-events:none}
      .bvrow{border-bottom:1px solid #f1f5f9;cursor:pointer;user-select:none}
      .bvrow:last-child{border-bottom:none}
      .bvhd{display:flex;align-items:center;gap:.45em;padding:.45em .1em;font-size:.82rem;flex-wrap:wrap}
      .bvhd .wr{font-weight:700;flex-shrink:0}
      .bv-item{display:inline-flex;align-items:center;gap:.15em;color:rgb(var(--gray-dark));font-weight:600;flex-shrink:0}
      .bv-moves{color:rgb(var(--gray));font-size:.76rem;flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
      .bv-toggle{margin-left:auto;font-size:.65rem;color:rgb(var(--gray));flex-shrink:0;transition:transform .15s}
      .bvrow.open .bv-toggle{transform:rotate(180deg)}
      .bvbody{display:none;padding:.1em .1em .5em}
      .bvrow.open .bvbody{display:block}
      .bvrow .use{font-size:.7rem;color:rgb(var(--gray));margin-top:.25em}
      .comp{border:1.5px solid #94a3b8;border-radius:10px;padding:.7em .8em;background:#fcfcfd;box-shadow:0 1px 6px rgba(0,0,0,.07)}
      .comp .ctitle{font-size:.82rem;font-weight:700;margin-bottom:.4em}
      .iconrow{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.3rem}
      .montab{display:flex;flex-direction:column;align-items:center;width:auto;padding:.25em .15em;border:1px solid rgb(var(--gray-light));border-radius:8px;background:#fff;cursor:pointer;font-family:var(--font-atkinson);overflow:hidden}
      .montab.active{border-color:var(--accent);background:#eef2ff}
      .monicon{width:40px;height:40px;object-fit:contain;image-rendering:auto}
      .mname{font-size:.6rem;line-height:1.1;text-align:center;margin-top:.1em}
      .mitem{font-size:.56rem;color:rgb(var(--gray));text-align:center;line-height:1.1}
      .compdetail{margin-top:.5em;border-top:1px solid rgb(var(--gray-light));padding-top:.5em}
      .cdgrid{display:flex;flex-wrap:wrap;gap:.35em .9em;margin-bottom:.35em}
      .cdcell{font-size:.8rem}
      .cdrow{font-size:.8rem;padding:.18em 0}
      .cdrow.mvrow{display:flex;align-items:flex-start;gap:.35em;margin:.35em 0}
      .cdlabel{display:inline-block;font-size:.64rem;font-weight:800;padding:.08em .45em;border-radius:5px;margin-right:.35em;color:#fff;vertical-align:1px}
      .cdlabel.item{background:#0ea5e9}.cdlabel.abil{background:#8b5cf6}.cdlabel.nat{background:#f59e0b}.cdlabel.mv{background:#10b981}.cdlabel.ev{background:#64748b}
      .cdval{font-weight:600;color:rgb(var(--gray-dark))}
      .mvwrap{display:inline-flex;flex-wrap:wrap;gap:.25em}
      .mvchip{display:inline-flex;align-items:center;gap:.15em;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:9999px;padding:.08em .55em;font-size:.75rem;font-weight:600}
      .evval{font-family:ui-monospace,monospace;font-size:.78rem;letter-spacing:.02em}
      .evchip{display:inline-flex;align-items:center;gap:.12em;color:#fff;font-size:.7rem;font-weight:700;padding:.06em .5em;border-radius:5px}
      .evchip b{font-weight:800}
      .ev-H{background:#16a34a}.ev-A{background:#dc2626}.ev-B{background:#2563eb}.ev-C{background:#7c3aed}.ev-D{background:#0d9488}.ev-S{background:#db2777}
      .tic{width:15px;height:15px;vertical-align:-2px}
      .iic{width:24px;height:24px;object-fit:contain;vertical-align:-7px;margin-right:2px}
      .iic-spr{display:inline-block;background-image:url('/images/items/item-sprite.png');background-size:480px 648px}
      .rp-move{font-size:.66rem;color:var(--accent-dark);font-weight:700;margin-top:.18em;display:flex;align-items:center;gap:.15em;white-space:nowrap;min-width:0}
      .rp-move>span:last-child,.rp-move{overflow:hidden}
      .rp-badges span{white-space:nowrap}
      .rp-move .tic{width:13px;height:13px}
      .rp-col.opp .rp-move{color:#b91c1c}
      .rp-order{display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;background:#94a3b8;color:#fff;font-size:.55rem;font-weight:800;flex-shrink:0}
      .rp-order.first{background:#f59e0b}
      .mon{font-size:.78rem;padding:.2em 0;border-bottom:1px solid #f1f5f9}
      .mon b{font-weight:700} .mon .mv{color:rgb(var(--gray))}
      /* タブ */
      .tabs{display:flex;gap:.4rem;margin-bottom:.7em}
      .tab{padding:.45em 1.1em;border:1px solid rgb(var(--gray-light));border-radius:8px;background:#fff;font-size:.85rem;font-weight:700;cursor:pointer;font-family:var(--font-atkinson);color:rgb(var(--gray))}
      .tab.active{background:var(--accent);color:#fff;border-color:var(--accent)}
      /* 詳細 */
      .sect{border:1.5px solid #94a3b8;border-radius:10px;margin-bottom:.7em;background:#fff;box-shadow:0 1px 6px rgba(0,0,0,.07)}
      .sect-head{padding:.45em .8em;background:#f8fafc;border-radius:10px 10px 0 0;font-size:.78rem;font-weight:700}
      .sect-body{padding:.6em .8em}
      .amber{background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:.6em;font-size:.84rem}
      table.mtx{font-size:.72rem;border-collapse:separate;border-spacing:2px}
      table.mtx th{font-size:.7rem;font-weight:700;padding:.2em;vertical-align:bottom}
      table.mtx th.dim,table.mtx td.dim{opacity:.32}
      table.mtx td{text-align:center;border-radius:5px;font-weight:700;padding:.25em;min-width:46px;white-space:nowrap}
      table.bt{width:100%;font-size:.72rem}table.bt td{padding:.22em .4em;border-bottom:1px solid #f1f5f9;white-space:nowrap}
      .overlay{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:1rem}
      .overlay.hidden{display:none}
      .sheet{background:#fff;border-radius:12px;max-width:620px;width:100%;max-height:90vh;overflow:auto;padding:1.1em}
      .x{background:none;border:none;font-size:1.4rem;line-height:1;color:rgb(var(--gray));cursor:pointer}
      .log{margin-top:.5em;font-size:.74rem;background:#f8fafc;border:1px solid rgb(var(--gray-light));border-radius:6px;padding:.55em}
      .rlog-simple div{padding:.12em 0;font-size:.8rem;font-weight:600;color:rgb(var(--gray-dark))}
      .rlog-sw{display:inline-block;font-size:.62rem;font-weight:800;background:#e0e7ff;color:#3730a3;border-radius:4px;padding:.05em .4em;margin-right:.15em}
      .rlog-mega{display:inline-block;font-size:.62rem;font-weight:800;background:linear-gradient(90deg,#7c3aed,#db2777);color:#fff;border-radius:4px;padding:.05em .4em;margin-right:.15em}
      .rlog-side{display:inline-block;font-size:.6rem;font-weight:800;border-radius:4px;padding:.05em .4em;margin-right:.15em}
      .rlog-side.s1{background:#dbeafe;color:#1d4ed8}
      .rlog-side.s2{background:#fee2e2;color:#b91c1c}
      .rlog-simple div .rlog-dmg{font-size:.72rem;font-weight:500;color:rgb(var(--gray))}
      .rlog-detail{margin-top:.45em;border-top:1px dashed rgb(var(--gray-light));padding-top:.35em}
      .rlog-detail summary{cursor:pointer;font-size:.72rem;color:var(--accent);font-weight:700}
      .rlog-full{margin-top:.3em;max-height:8rem;overflow:auto;font-size:.72rem;color:rgb(var(--gray))}
      .wr-tag{font-weight:700}
      .hidden{display:none}
      /* 対戦サマリ */
      .verdict{font-weight:800;font-size:.92rem;padding:.18em .75em;border-radius:8px}
      .fbox{border-radius:8px;padding:.5em .7em;margin-bottom:.45em;font-size:.8rem}
      .fbox.win{background:#f0fdf4;border:1px solid #bbf7d0}
      .fbox.lose{background:#fef2f2;border:1px solid #fecaca}
      .frow{margin-top:.25em}
      .pchip{display:inline-flex;align-items:center;gap:.15rem;padding:.1em .55em .1em .15em;border-radius:9999px;font-size:.72rem;margin:.12em .15em 0 0;font-weight:700}
      .pchip img{width:22px;height:22px;object-fit:contain}
      .pchip.good{background:#dcfce7;color:#15803d}
      .pchip.bad{background:#fee2e2;color:#b91c1c}
      /* 1v1相性表（アイコン） */
      .mtx-ico{width:30px;height:30px;object-fit:contain;display:block;margin:0 auto}
      table.mtx th.mtx-sel{background:#eef2ff;border:1px solid #c7d2fe}
      .mtx-name{font-size:.58rem;line-height:1.05;margin-top:1px;white-space:nowrap;color:rgb(var(--gray-dark));text-align:center;margin-left:auto;margin-right:auto}
      .mtx-seltag{font-size:.52rem;font-weight:800;color:#15803d;background:#dcfce7;border-radius:4px;padding:0 .3em;margin-top:1px;display:inline-block}
      .mtx-corner{font-size:.56rem;color:rgb(var(--gray));text-align:center;line-height:1.15;white-space:nowrap;font-weight:700}
      /* リプレイ選択チップ（勝敗色・件数増に対応） */
      .rp-pick-hd{font-size:.8rem;color:rgb(var(--gray-dark));margin:.6em 0 .35em}
      .rtab-row{display:flex;flex-wrap:wrap;gap:.25em;align-items:flex-end}
      .rtab{font-size:.78rem;font-weight:700;border:1px solid rgb(var(--gray-light));border-bottom:none;border-radius:8px 8px 0 0;padding:.4em .9em;cursor:pointer;font-family:var(--font-atkinson);background:#f1f5f9;color:rgb(var(--gray));position:relative;top:1px}
      .rtab.win b{color:#15803d} .rtab.lose b{color:#b91c1c} .rtab.draw b{color:rgb(var(--gray))}
      .rtab:hover{background:#e8edf3}
      .rtab.act{background:#fff;color:rgb(var(--gray-dark));border-color:var(--accent);border-bottom:2px solid #fff;z-index:1}
      .rp-panel{border:1px solid var(--accent);border-radius:0 8px 8px 8px}
      .rp-title{font-weight:800;color:var(--accent-dark);font-size:.82rem;margin-right:.3em}
      /* リプレイ（左=自分3体 / 右=相手3体・縦並び） */
      .rp-banner{text-align:center;font-size:.72rem;color:rgb(var(--gray));margin:.1em 0 .5em;font-weight:700}
      #replay-ctrl{justify-content:center;gap:.5rem;margin:.1em 0 .6em;padding-bottom:.5em;border-bottom:1px solid rgb(var(--gray-light))}
      #replay-turn{font-weight:800;font-size:.85rem;min-width:5.5rem;text-align:center}
      #replay-result{font-weight:700}
      .rp-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;align-content:start}
      .rp-col{border:1px solid rgb(var(--gray-light));border-radius:10px;padding:.5em;background:#fff;min-width:0}
      /* スマホでも自分/相手は横並び維持。名前は省略・各種を縮めて収める */
      @media(max-width:560px){
        main{padding-left:.55em;padding-right:.55em}
        .rp-grid{gap:.35rem}
        .rp-col{padding:.3em}
        .rp-mon{gap:.25rem;padding:.2em}
        .rp-mon-ico,.rp-mon-ico img{width:30px;height:30px}
        .rp-mon-name{font-size:.68rem}
        .rp-move{font-size:.64rem}
        /* HP数字をバーに重ねて中央表示（横幅が狭く数字とバーが競合し折り返す問題の回避）*/
        .rp-mon-body .row{position:relative}
        .rp-mon-body .hpbar{height:13px}
        .rp-hp{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;width:auto;min-width:0;white-space:nowrap;font-size:.52rem;font-weight:800;color:#0f172a;text-shadow:0 0 2px #fff,0 0 3px #fff,0 0 3px #fff}
        .rp-boost{font-size:.58rem}
        .rp-label{font-size:.7rem}
      }
      .rp-col.mine{border-color:#c7d2fe;background:#f5f7ff}
      .rp-col.opp{border-color:#fecaca;background:#fff7f7}
      .rp-label{font-size:.74rem;font-weight:800;margin-bottom:.45em;text-align:center}
      .rp-col.mine .rp-label{color:var(--accent-dark)} .rp-col.opp .rp-label{color:#b91c1c}
      .rp-mon{display:flex;gap:.5rem;align-items:center;padding:.35em;border-radius:8px;margin-bottom:.3em;border:2px solid transparent;transition:all .2s}
      .rp-mon:last-child{margin-bottom:0}
      .rp-mon.act{border-color:var(--accent);background:#fff;box-shadow:0 1px 7px rgba(35,55,255,.2)}
      .rp-col.opp .rp-mon.act{border-color:#ef4444;box-shadow:0 1px 7px rgba(239,68,68,.2)}
      .rp-mon.dead{opacity:.5}
      .rp-mon.unknown{opacity:.85;border-style:dashed;border-color:rgb(var(--gray-light));background:rgba(0,0,0,.02)}
      .rp-unknown-q{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.6rem;font-weight:800;color:rgb(var(--gray));background:rgba(0,0,0,.05);border-radius:6px}
      .rp-mon-ico{position:relative;width:44px;height:44px;flex-shrink:0}
      .rp-mon-ico img{width:44px;height:44px;object-fit:contain}
      .rp-mon.dead .rp-mon-ico img{filter:grayscale(1)}
      .rp-x{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.7rem;color:#ef4444;font-weight:800}
      .rp-active-badge{position:absolute;top:-3px;left:-3px;font-size:.7rem;line-height:1}
      .rp-mon-body{flex:1;min-width:0}
      .rp-mon-name{font-size:.76rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .rp-badges{display:flex;flex-wrap:wrap;gap:2px;margin:.15em 0}
      .rp-badges:empty{display:none}
      .rp-hp{font-size:.64rem;color:rgb(var(--gray));width:3.4rem;text-align:right;flex-shrink:0}
      .rp-boost{font-size:.64rem;font-weight:700;margin-top:.15em}
      .rp-boost .bup{color:#16a34a} .rp-boost .bdn{color:#dc2626}
      .rp-status{font-size:.6rem;background:#fde68a;color:#92400e;border-radius:4px;padding:0 .3em;font-weight:700}
      .rp-disg{font-size:.6rem;background:#fee2e2;color:#9d174f;border-radius:4px;padding:0 .3em;font-weight:700}
      .mtx-help{margin-bottom:.5em}
      .mtx-help summary{cursor:pointer;font-size:.78rem;color:var(--accent);font-weight:700}
      .mtx-help:not([open]) .mtx-help-body{display:none}
      .mtx-help-body{font-size:.78rem;line-height:1.7;color:rgb(var(--gray-dark));margin:.4em 0 .2em;padding:.5em .7em;background:#f8fafc;border-radius:8px}
      .rp-forme{font-size:.6rem;background:#e0e7ff;color:#3730a3;border-radius:4px;padding:0 .3em;font-weight:700}
      .rp-charge{font-size:.6rem;background:#fef9c3;color:#854d0e;border-radius:4px;padding:0 .3em;font-weight:700}
      .rp-vol{font-size:.58rem;background:#f1f5f9;color:#334155;border-radius:4px;padding:0 .3em;font-weight:700}
      .rp-mega{font-size:.58rem;background:linear-gradient(90deg,#7c3aed,#db2777);color:#fff;border-radius:4px;padding:0 .35em;font-weight:800;letter-spacing:.02em}
      .rp-tic{width:14px;height:14px;vertical-align:-2px;margin-left:1px}
      .rp-haz{display:flex;flex-wrap:wrap;gap:.2rem;justify-content:center}
      .rp-haz:not(:empty){margin-bottom:.4em}
      .hazchip{font-size:.56rem;font-weight:700;background:#fde68a;color:#92400e;border-radius:4px;padding:.08em .45em}
    </style>

    <main data-simmode={mode}>
      <h1>{heading}</h1>
      <p class="lead" set:html={lead}></p>
      <OnboardingGuide
        storageKey="sim"
        lang={lang}
        steps={[
          { icon: '👥', title: I18N.obStep1T, desc: I18N.obStep1D },
          { icon: '🎯', title: I18N.obStep2T, desc: I18N.obStep2D },
          { icon: '📊', title: I18N.obStep3T, desc: I18N.obStep3D },
        ]}
      />

      <!-- ① パーティ選択 -->
      <div class="seclabel">{I18N.sec1}</div>
      <section class="card mb" style="padding:.9em 1em">
        <div class="split">
          <div class="pl-wrap"><div class="seasonbar">{!isMB && (<Fragment><span class="muted">{I18N.showLabel}</span><label class="schk"><input type="checkbox" checked onchange="toggleSubjSeason('M-1',this)"/><span class="sbadge m1">M-1</span></label><label class="schk"><input type="checkbox" checked onchange="toggleSubjSeason('M-2',this)"/><span class="sbadge m2">M-2</span></label></Fragment>)}<div id="filter-chips" class="filter-chips"></div><button class="btn btn-ghost" id="subj-clear-btn" onclick="clearSubjFilter()" style="margin-left:auto;padding:2px 8px;font-size:.75rem;white-space:nowrap;display:none">{I18N.clearBtn}</button></div><div class="filter-wrap"><input type="text" id="subj-filter" class="filter-inp" placeholder={I18N.filterPh} autocomplete="off" oninput="onSubjFilterInput(this.value)" onkeydown="onSubjFilterKey(event)"><div class="filter-sug" id="subj-sug" style="display:none"></div></div><div class="picklist" id="subject-list"></div></div>
          <div class="comp" id="subject-comp"><div class="muted">{I18N.noPartyMsg}</div></div>
        </div>
        <div class="row" style="margin-top:.7em">
          <button id="btn-analyze" class="btn btn-sm hidden">{I18N.analyzeBtn}</button>
          <span id="status" class="muted"></span>
        </div>
        <div id="progress-wrap" class="hidden" style="margin-top:.5em">
          <div class="hpbar"><div id="progress-fill" class="hpfill" style="width:0%;background:var(--accent)"></div></div>
          <div id="progress-text" class="muted" style="margin-top:.3em"></div>
        </div>
      </section>

      <!-- ② 戦績（タブ） -->
      <div class="seclabel">{I18N.sec2}</div>
      <div class="tabs">
        <button class="tab active" id="tab-ranker" onclick="switchTab('ranker')">{isMB ? I18N.tabParty : I18N.tabRanker}</button>
        <button class="tab" id="tab-pokemon" onclick="switchTab('pokemon')">{I18N.tabPoke}</button>
      </div>
      <div id="summary" class="muted mb"></div>
      <div id="sortbar" class="row" style="margin-bottom:.5em">
        <span class="muted">{I18N.sortLabel}</span>
        <button class="btn btn-sm btn-ghost" id="sort-num" onclick="setSort('num')">{I18N.sortNum}</button>
        <button class="btn btn-sm btn-ghost" id="sort-wr" onclick="setSort('wr')">{I18N.sortWr}</button>
      </div>

      <!-- ③ 相手一覧＋構成＋詳細 -->
      <section class="card" style="padding:.9em 1em">
        <div class="split">
          <div class="pl-wrap"><div class="seasonbar" id="opp-seasonbar">{!isMB && (<Fragment><span class="muted">{I18N.showLabel}</span><label class="schk"><input type="checkbox" checked onchange="toggleOppSeason('M-1',this)"/><span class="sbadge m1">M-1</span></label><label class="schk"><input type="checkbox" checked onchange="toggleOppSeason('M-2',this)"/><span class="sbadge m2">M-2</span></label></Fragment>)}<div id="opp-filter-chips" class="filter-chips"></div></div><div class="filter-wrap"><input type="text" id="opp-filter" class="filter-inp" placeholder={I18N.filterPh} autocomplete="off" oninput="onOppFilterInput(this.value)" onkeydown="onOppFilterKey(event)"><div class="filter-sug" id="opp-sug" style="display:none"></div></div><div class="picklist" id="opp-list" style="max-height:300px"></div></div>
          <div class="comp" id="opp-comp"><div class="muted">{I18N.oppSelectMsg}</div></div>
        </div>
        <div id="detail" style="margin-top:.9em"></div>
      </section>
    </main>

    <script is:inline define:vars={{ I18N, NATURE_NAME_MAP, POKEMON_NAME_MAP, MOVE_NAME_MAP, ITEM_NAME_MAP, ABILITY_NAME_MAP, LANG: lang }}>
      const IS_MB = document.querySelector('main[data-simmode]')?.dataset.simmode === 'MB';
      const _IS_JA = LANG === 'ja';
      function tPoke(n){ return POKEMON_NAME_MAP[n]||n; }
      function tMove(m){ return MOVE_NAME_MAP[m]||m; }
      function tItem(it){ if(!it||it==='—') return it; if(ITEM_NAME_MAP[it]) return ITEM_NAME_MAP[it]; var mX=/^(.+)ナイトX$/.exec(it),mY=/^(.+)ナイトY$/.exec(it),m0=/^(.+)ナイト$/.exec(it),base=mX||mY||m0; if(base){var en=POKEMON_NAME_MAP[base[1]]||POKEMON_NAME_MAP[base[1]+'ー'];if(en)return en+(mX?' X':mY?' Y':'')+'ite';} return it; }
      function tAbil(a){ return ABILITY_NAME_MAP[a]||a; }
      let _tlPairs = null;
      function _buildTLPairs() {
        const s = (map) => Object.entries(map).sort((a,b)=>b[0].length-a[0].length).filter(([k,v])=>k!==v);
        return [...s(POKEMON_NAME_MAP),...s(MOVE_NAME_MAP),...s(ABILITY_NAME_MAP),...s(ITEM_NAME_MAP)];
      }
      function translateLogText(text) {
        if(_IS_JA||!text) return text;
        if(!_tlPairs) _tlPairs=_buildTLPairs();
        let t=text;
        t=t
          .replace(/こんらん（あばれ終了）/g,'Confusion (end)')
          .replace(/こんらんで自傷/g,'Confusion self-hit')
          .replace(/こんらんになった/g,'Confused')
          .replace(/反動/g,'Recoil')
          .replace(/繰り出し（瀕死後）/g,'sent out (after KO)')
          .replace(/繰り出し/g,'sent out')
          .replace(/が強制交代/g,' forced out')
          .replace(/が破れた/g,' broken')
          .replace(/回復/g,' healed')
          .replace(/（効果なし）/g,'(immune)')
          .replace(/に無効/g,'→ (immune)');
        for(const [jp,tr] of _tlPairs){ if(t.includes(jp)) t=t.split(jp).join(tr); }
        t=t
          .replace(/ の (.+?) を落とした/g,' knocked off $1')
          .replace(/ に(\d)/g,' $1')
          .replace(/：/g,': ')
          .replace(/ は /g,' ');
        return t;
      }
      const _TAGS_EN = {外し:'Miss',効果抜群:'Super eff.',いまひとつ:'Resisted',急所:'Crit',相手耐え:'Endured',展開:'Setup',設置:'Hazard',ばけのかわ:'Disguise',防がれた:'Blocked',ひるみで動けない:'Flinch',守り:'Protect'};
      function translateTag(t) {
        if(_IS_JA) return t;
        const ko=t.match(/^(.+?)を倒した$/); if(ko) return `KO'd ${tPoke(ko[1])}`;
        const st=t.match(/^(こうげき|ぼうぎょ|とくこう|とくぼう|すばやさ)([↑↓])$/);
        if(st){const S={こうげき:'Atk',ぼうぎょ:'Def',とくこう:'SpAtk',とくぼう:'SpDef',すばやさ:'Spd'};return `${S[st[1]]}${st[2]}`;}
        return _TAGS_EN[t]||t;
      }
      function translateCandAction(a) {
        if(_IS_JA||!a) return a;
        const hasMega=a.startsWith('メガ+'); const base=hasMega?a.slice(3):a;
        const sw=base.match(/^(.+?)に交代$/); if(sw) return (hasMega?'Mega+':'')+'Switch → '+tPoke(sw[1]);
        return (hasMega?'Mega+':'')+tMove(base);
      }
      const VSNOUN = LANG==='ja' ? (IS_MB?'パーティ':'ランカー') : LANG==='ko' ? (IS_MB?' 파티':' 랭커') : (IS_MB?' parties':' rankers');
      const USED_BY_LABEL = LANG==='ja' ? (IS_MB?'使用パーティ: ':'使用ランカー: ') : LANG==='ko' ? (IS_MB?'사용 파티: ':'사용 랭커: ') : I18N.usedBy;
      // 構築を表す名前の材料（メガ軸を先頭に、以降は編成順）。「メガ」の文字は軸であることが自明なので付けない。
      // 括弧書きの型注記（永遠/オス等）は表示幅の都合で省略（アイコンで判別可能・titleに全体名を残す）。
      const _shortMonName = n => tPoke(n).replace(/[（(][^）)]*[）)]$/,'');
      function partyNameParts(party){
        if(!party||!party.length) return [];
        const names = party.map(s=>s.split('@')[0].split(':')[0]);
        const items = party.map(s=>(s.split('@')[1]||'').split(':')[0]);
        const megaIdx=[], restIdx=[];
        items.forEach((it,i)=>{ (/ナイト/.test(it)?megaIdx:restIdx).push(i); });
        return [...megaIdx,...restIdx].map(i=>{
          const it=items[i]; const nm=_shortMonName(names[i]);
          if(/ナイト/.test(it)){ const xy=/[XＸ]$/.test(it)?'X':/[YＹ]$/.test(it)?'Y':''; return nm+xy; }
          return nm;
        });
      }
      const _AXIS_SFX = LANG==='ja' ? '軸' : LANG==='ko' ? ' 축' : ' core';
      function partyName(party, n){ const s=partyNameParts(party).slice(0, n||2).join(_IS_JA?'・':' / '); return s?s+_AXIS_SFX:''; }
      function partyFullTitle(party){   // ホバー用：省略なしの全6体名
        if(!party||!party.length) return '';
