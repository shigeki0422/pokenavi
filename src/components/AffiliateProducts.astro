---
/**
 * AffiliateProducts.astro
 * 記事末尾に表示するAmazonアフィリエイト商品カード
 *
 * 使い方:
 *   <AffiliateProducts category="pokemon" />
 *
 * 環境変数 PUBLIC_AMAZON_ASSOCIATE_TAG にアソシエイトIDを設定すると
 * リンクにタグが付与されます（未設定でもリンクは機能します）。
 */

interface Product {
  emoji: string;
  name: string;
  description: string;
  searchKeyword: string;
}

interface Props {
  category?: 'pokemon' | 'gaming' | 'general';
  heading?: string;
}

const { category = 'pokemon', heading = 'この記事を読んだ方におすすめ' } = Astro.props;

const tag = import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG ?? '';

function amazonUrl(keyword: string): string {
  const base = `https://www.amazon.co.jp/s?k=${encodeURIComponent(keyword)}`;
  return tag ? `${base}&tag=${tag}` : base;
}

const productMap: Record<string, Product[]> = {
  pokemon: [
    {
      emoji: '📱',
      name: 'スマホスタンド',
      description: '長時間の対戦を快適に。角度調整できるタイプが人気です。',
      searchKeyword: 'スマホスタンド ゲーム 角度調整',
    },
    {
      emoji: '🔋',
      name: 'モバイルバッテリー',
      description: '外出先でのランクマッチに。大容量・急速充電対応モデルを。',
      searchKeyword: 'モバイルバッテリー 大容量 急速充電',
    },
    {
      emoji: '📖',
      name: 'ポケモン公式図鑑・攻略本',
      description: 'タイプ相性・種族値をすぐ確認。対戦研究のお供に。',
      searchKeyword: 'ポケモン 図鑑 攻略本',
    },
    {
      emoji: '🎧',
      name: 'ゲーミングイヤホン',
      description: 'ランクマッチに集中したいときに。遮音性の高いモデルがおすすめ。',
      searchKeyword: 'ゲーミングイヤホン スマホ',
    },
  ],
  gaming: [
    {
      emoji: '🎮',
      name: 'ゲーミングコントローラー',
      description: 'スマホゲームを快適に操作。',
      searchKeyword: 'スマホ ゲームコントローラー',
    },
    {
      emoji: '📱',
      name: 'スマホスタンド',
      description: '長時間の対戦を快適に。',
      searchKeyword: 'スマホスタンド ゲーム',
    },
    {
      emoji: '🔋',
      name: 'モバイルバッテリー',
      description: '外出先でのプレイに欠かせない。',
      searchKeyword: 'モバイルバッテリー 大容量',
    },
  ],
};

const products = productMap[category] ?? productMap.pokemon;
---

<div class="affiliate-section">
  <div class="affiliate-heading">
    <span class="affiliate-icon">🛒</span>
    {heading}
  </div>
  <p class="affiliate-note">
    ※ Amazonアソシエイトプログラムを通じた商品紹介です。
  </p>
  <div class="affiliate-grid">
    {products.map((p) => (
      <a
        href={amazonUrl(p.searchKeyword)}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="affiliate-card"
      >
        <div class="affiliate-emoji">{p.emoji}</div>
        <div class="affiliate-body">
          <div class="affiliate-name">{p.name}</div>
          <div class="affiliate-desc">{p.description}</div>
        </div>
        <div class="affiliate-cta">Amazonで見る →</div>
      </a>
    ))}
  </div>
</div>

<style>
.affiliate-section {
  margin: 2.5rem 0 1.5rem;
  padding: 20px 20px 16px;
  background: #fdf8ff;
  border: 1px solid #e2d4f0;
  border-radius: 12px;
}
.affiliate-heading {
  font-size: 1rem;
  font-weight: 700;
  color: #5b21b6;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.affiliate-icon {
  font-size: 1.1rem;
}
.affiliate-note {
  font-size: 0.75rem;
  color: #9ca3af;
  margin: 0 0 14px;
}
.affiliate-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
@media (max-width: 560px) {
  .affiliate-grid {
    grid-template-columns: 1fr;
  }
}
.affiliate-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: #fff;
  border: 1px solid #e9d8f9;
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.15s, border-color 0.15s;
}
.affiliate-card:hover {
  box-shadow: 0 2px 8px rgba(139, 92, 246, 0.15);
  border-color: #c084db;
}
.affiliate-emoji {
  font-size: 1.6rem;
  flex-shrink: 0;
  width: 36px;
  text-align: center;
}
.affiliate-body {
  flex: 1;
  min-width: 0;
}
.affiliate-name {
  font-size: 0.88rem;
  font-weight: 700;
  color: #1e1b4b;
  margin-bottom: 2px;
}
.affiliate-desc {
  font-size: 0.76rem;
  color: #6b7280;
  line-height: 1.4;
}
.affiliate-cta {
  font-size: 0.75rem;
  font-weight: 600;
  color: #f59e0b;
  white-space: nowrap;
  flex-shrink: 0;
}
</style>
