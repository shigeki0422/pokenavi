    const rows = g.slice().sort((x,y)=>y.wr-x.wr).map(x=>{
      const pct = Math.round(x.wr*100);
      const cls = pct>=55?'adv-good':pct<45?'adv-bad':'adv-mid';
      const opp = (x.opp||[]).map(n=>icoImg(n,'dtl-ico')).join('');
      const rec = (x.recommend||[]).map(n=>icoImg(n,'dtl-ico')).join('');
      const recNames = (x.recommend||[]).map(n=>esc(tPoke(n))).join(' / ');
      const band = w => w>=0.75?[I18N.bandGood,'gd-b-good']:w>=0.6?[I18N.bandOk,'gd-b-ok']:w>=0.4?[I18N.bandMid,'gd-b-mid']:[I18N.bandBad,'gd-b-bad'];
      const vsRows = (x.vs||[]).map(v=>{
        const [bl,bc]=band(v.wr??1);
        const alt = v.alt?`<div class="gd-alt">${I18N.altReadable.replace('{mons}',(v.alt.my3||[]).map(n=>icoImg(n,'cnt-ico')).join(''))}</div>`:'';
        return `<div class="cnt-row">${I18N.vsRow.replace('{opp}',(v.opp3||[]).map(n=>icoImg(n,'cnt-ico')).join('')).replace('{band}',`<span class="gd-band ${bc}">${bl}</span>`)}${alt}</div>`;
      }).join('');
      return `<tr>
        <td><div class="arch-lb">${esc(x.label)}</div><div class="dtl-mem">${opp}</div></td>
        <td><div class="dtl-mem">${rec}</div><div class="gd-names">${recNames}</div>${vsRows?`<details class="gd-det"><summary>${I18N.guideDetSummary}</summary>${vsRows}</details>`:''}</td>
        <td><div class="advbar"><div class="advfill ${cls}" style="width:${pct}%"></div></div><div class="advtxt ${cls}">${pct}%</div></td></tr>`;
    }).join('');
    return `${strategyChart(res.strategy)}
      <details class="gd-detail-wrap"><summary>${I18N.guideDetailWrap}</summary>
      <div class="mtx-legend"><span>${I18N.guideLegend}</span></div>
      <table class="dtl arch gd"><tr><th>${I18N.thOpp}</th><th>${I18N.thRec}</th><th>${I18N.thWr}</th></tr>${rows}</table></details>`;
  }
  function strategyChart(s){
    if(!s||!s.base) return '';
    const trio = (arr,cls='')=>`<div class="sc-trio ${cls}">${(arr||[]).map(n=>`<span class="sc-mon" title="${esc(tPoke(n))}">${icoImg(n,'sc-ico')}</span>`).join('')}</div>`;
    const pct = w=>Math.round((w||0)*100)+'%';
    const b = s.base;
    let html = `<div class="sc-wrap"><div class="sc-hd">${I18N.scHd}</div>`;
    if(s.concept) html += `<div class="sc-concept">${esc(s.concept)}</div>`;
    html += `<div class="sc-base"><div class="sc-tag">${I18N.scBaseTag}</div>${trio(b.trio,'sc-big')}
      <div class="sc-meta"><b>${I18N.thWr} ${pct(b.wr)}</b><div class="sc-sub">${I18N.scBaseSub((b.opps||[]).length)}</div></div></div>`;
    if((s.rules||[]).length){
      html += `<div class="sc-branch-hd">${I18N.scTeamCond}</div>`;
      html += s.rules.map(ru=>{
        // 軸ポケモン：勝率の微差検定（decisive/tie）ではなく、実測で選出された構築を直接示す。
        // 8構築程度のサンプルでは勝率の細かい優劣より「活きる場」を示す方が頑健で誤解を招かない。
        if(ru.core){
          let condChip = '';
          if(ru.cond && ru.cond.kind==='mon') condChip = `<span class="sc-typechip">${I18N.chipMonIn(esc(tPoke(ru.cond.value)))}</span>`;
          else if(ru.cond && ru.cond.kind==='type') condChip = `<span class="sc-typechip">${I18N.chipType2(esc(ru.cond.value))}</span>`;
          else if(ru.cond && ru.cond.kind==='trait') condChip = `<span class="sc-typechip">${esc(ru.cond.label)}</span>`;
          const sel = (ru.selected||[]).map(a=>`<div class="sc-team"><div class="sc-team-ico">${(a.names||[]).map(n=>icoImg(n,'sc-ico-t')).join('')}</div>
            <div class="sc-sub">${esc(a.opp)}</div></div>`).join('');
          return `<div class="sc-rule2">
            <div class="sc-summary">${esc(ru.summary)}</div>
            <div class="sc-rule-body">
              <div class="sc-teams">${sel || `<div class="sc-sub muted">${I18N.unseenAny}</div>`}</div>
              <div class="sc-arr">▶</div>
              <div class="sc-rule-act"><div class="sc-swap">${icoImg(ru.mon,'sc-ico-s')} <b>${esc(tPoke(ru.mon))}</b>${(ru.roles||[]).length?`<span class="sc-role">${ru.roles.map(r=>esc(tRole(r))).join('・')}</span>`:''}（${I18N.coreTag}）</div><div class="sc-chips">${condChip}</div></div>
            </div>
          </div>`;
        }
        const evd = ru.evidence;
        const refName = e => (e && e.ref==='base') ? I18N.refBase : I18N.refAlt;
        const watchHd = (!evd)
          ? `<div class="sc-watch sc-watch-n">${I18N.watchNone}</div>` : '';
        const teams = (ru.teams||[]).map(t=>{
          const hi = new Set(t.hi||[]);
          const dim = t.mode==='decisive';
          const ev = t.ev;
          const isTop = evd && t.opp===evd.opp && ev && ev.key;
          let badge;
          if(isTop){
            badge = `<span class="sc-mode sc-m-top">${I18N.modeTop(Math.round(ev.key.base*100),Math.round(ev.key.pick*100))}</span>`;
          } else if(ev){
            badge = ev.tie ? `<span class="sc-mode sc-m-nt">${I18N.modeTieWith(refName(ev))}</span>`
                      : `<span class="sc-mode sc-m-sp">${I18N.modeDelta(refName(ev),Math.round(ev.delta*100))}</span>`;
          } else {
            badge = `<span class="sc-mode sc-m-nt">${I18N.modeNoData}</span>`;
          }
          return `<div class="sc-team"><div class="sc-team-ico">${(t.names||[]).map(n=>
            `<span class="${hi.has(n)?'sc-hi':(dim?'sc-dim':'')}">${icoImg(n,'sc-ico-t')}</span>`).join('')}</div>
            <div class="sc-sub">${esc(t.opp)} ${badge}</div></div>`;
        }).join('');
        let condChip = '';
        if(ru.cond && ru.cond.kind==='mon') condChip = `<span class="sc-typechip">${I18N.chipMonIn(esc(tPoke(ru.cond.value)))}</span>`;
        else if(ru.cond && ru.cond.kind==='type') condChip = `<span class="sc-typechip">${I18N.chipType2(esc(ru.cond.value))}</span>`;
        else if(ru.cond && ru.cond.kind==='trait') condChip = `<span class="sc-typechip">${esc(ru.cond.label)}</span>`;
        let reason = '';
        if(evd){
          const rt = evd.ref_trio||[], tr = evd.trio||[];
          const gained = tr.filter(n=>!rt.includes(n)), lost = rt.filter(n=>!tr.includes(n));
          reason = (gained.length && lost.length)
            ? I18N.reasonSwap(lost.map(n=>esc(tPoke(n))).join('・'), gained.map(n=>esc(tPoke(n))).join('・'), Math.round(evd.base*100), Math.round(evd.pick*100))
            : I18N.reasonAdopt(Math.round(evd.base*100), Math.round(evd.pick*100));
          if(evd.cost) reason += I18N.reasonCost((evd.cost.opp3||[]).map(n=>esc(tPoke(n))).join('・'), Math.round(evd.cost.base*100), Math.round(evd.cost.pick*100));
        } else if(ru.explain==='tie'){
          reason = I18N.reasonTie;
        } else if(ru.why) reason = ru.why;
        reason = reason ? `<div class="sc-sub">${reason}</div>` : '';
        const swap = ru.out ? `${icoImg(ru.out,'sc-ico-s')}<span class="sc-arr2">→</span>${icoImg(ru.mon,'sc-ico-s')}` : icoImg(ru.mon,'sc-ico-s');
        return `<div class="sc-rule2">
          ${ru.summary?`<div class="sc-summary">${esc(ru.summary)}</div>`:''}
          ${watchHd}
          <div class="sc-rule-body">
            <div class="sc-teams">${teams}</div>
            <div class="sc-arr">▶</div>
            <div class="sc-rule-act"><div class="sc-swap">${swap} ${I18N.swapAdd(esc(tPoke(ru.mon)))}${(ru.roles||[]).length?`<span class="sc-role">${ru.roles.map(r=>esc(tRole(r))).join('・')}</span>`:''}</div>${reason}<div class="sc-chips">${condChip}</div></div>
          </div>
        </div>`;
      }).join('');
    }
    if((s.role_table||[]).length){
      const stLbl = {core:I18N.roleCore, flex:I18N.roleFlex, spot:I18N.roleSpot, bench:I18N.roleBench};
      html += `<div class="sc-branch-hd">${I18N.roleTable}</div><table class="sc-roles"><tr><th></th><th>${I18N.roleColRole}</th><th>${I18N.roleColTurn}</th></tr>` +
        s.role_table.map(rt=>`<tr class="sc-st-${rt.status}">
          <td>${icoImg(rt.mon,'sc-ico-s')} ${esc(tPoke(rt.mon))}</td>
          <td>${(rt.roles||[]).map(r=>esc(tRole(r))).join('・')||'-'}</td>
          <td><span class="sc-stbadge sc-stb-${rt.status}">${stLbl[rt.status]||''}</span> <span class="sc-sub">${I18N.selRate(rt.n,rt.N)}</span></td>
        </tr>`).join('') + `</table>`;
    }
    if((s.alts||[]).length){
      html += `<details class="sc-ex"><summary>${I18N.altExDetails(s.alts.length)}</summary>` +
        s.alts.map(a=>{
          const gain = (a.delta!=null) ? `<span class="sc-gain">${I18N.measGain(Math.round(a.delta*100))}</span>` : '';
          const swap = (a.out&&a.in&&a.out.length&&a.in.length)
            ? `<div class="sc-swap">${a.out.map(n=>icoImg(n,'sc-ico-s')).join('')}<span class="sc-arr2">→</span>${a.in.map(n=>icoImg(n,'sc-ico-s')).join('')}</div>` : '';
          const altline = a.alt_trio ? `<div class="sc-alt">${I18N.refAlt} ${trio(a.alt_trio,'sc-mini')} ${pct(a.alt_wr)} ${gain}</div>` : '';
          return `<div class="sc-branch">
            <div class="sc-col"><div class="sc-lbl">${I18N.oppTeamLbl(esc(a.opp))}</div>${trio(a.team&&a.team.length?a.team:a.opp3,'sc-opp sc-mini')}<div class="sc-sub">${I18N.oftenSends((a.opp3||[]).map(n=>esc(tPoke(n))).join('・'))}</div></div>
            <div class="sc-arr">▶</div>
            <div class="sc-col"><div class="sc-lbl">${I18N.thisTrioLbl}</div>${trio(a.trio)}<div class="sc-meta"><b>${pct(a.wr)}</b></div>${swap}${altline}</div>
          </div>`;
        }).join('') + `</details>`;
    }
    if(s.caution){
      const alt = s.caution.alt?I18N.cautionAlt(trio(s.caution.alt,'sc-mini')):'';
      html += `<div class="sc-caution">${I18N.caution(esc(s.caution.opp), trio(s.caution.opp3,'sc-mini'))}${alt}</div>`;
    }
    if(s.hard && ((s.hard.teams||[]).length || (s.hard.mons||[]).length)){
      html += `<div class="sc-branch-hd">${I18N.hardOpp}</div><div class="sc-hard">`;
      if((s.hard.mons||[]).length){
        html += `<div class="sc-hard-row"><span class="sc-hard-lb">${I18N.hardMons}</span>` +
          s.hard.mons.map(m=>`<span class="sc-w">${icoImg(m.mon,'sc-ico-s')}${esc(tPoke(m.mon))} <b>${pct(m.wr)}</b></span>`).join('') +
          `<div class="sc-sub">${I18N.hardMonsSub}</div></div>`;
      }
      if((s.hard.teams||[]).length){
        const whyRows = s.hard.teams.filter(t=>t.why&&t.why.length).map(t=>
          `<div class="sc-sub">${I18N.hardWhy(esc(t.opp), t.why.map(n=>`<span class="sc-w">${icoImg(n,'sc-ico-s')}${esc(tPoke(n))}</span>`).join(''))}</div>`).join('');
        html += `<div class="sc-hard-row"><span class="sc-hard-lb">${I18N.hardTeams}</span>` +
          s.hard.teams.map(t=>`<span class="sc-w">${esc(t.opp)} <b>${pct(t.wr)}</b></span>`).join('') +
          `<div class="sc-sub">${I18N.hardTeamsSub(s.hard.teams[0]?I18N.hardBestFor(esc(s.hard.teams[0].opp), trio(s.hard.teams[0].trio,'sc-mini')):'')}</div>${whyRows}</div>`;
      }
      html += `</div>`;
    }
    if(s.best&&s.worst){
      html += `<div class="sc-bw"><span class="sc-good">${I18N.bwGood(esc(s.best.opp), pct(s.best.wr))}</span><span class="sc-bad">${I18N.bwBad(esc(s.worst.opp), pct(s.worst.wr))}</span></div>`;
    }
    return html + `</div>`;
  }
  function firepowerHtml(res){
    const fp = res.firepower; if(!fp) return '';
    const head = `<tr><th class="mtx-corner mtx-stick">${I18N.selfVsOpp}</th>` + fp.tops.map(t=>`<th>${icoImg(t.sp,'mtx-ico')}<div class="mtx-name">${esc(t.label)}</div></th>`).join('') + `</tr>`;
    const rows = fp.rows.map(r=>{
      const cells = r.cells.map((c,j)=>{
        const tip = I18N.cellTip + (c.move?` (${I18N.assumedMove} ${tMove(c.move)})`:'');
        return `<td class="${c.cls} fire-cell" data-mon="${esc(r.mon)}" data-opp="${esc(fp.tops[j].sp)}" title="${esc(tip)}">${esc(tKo(c.lab))}${c.note?'<span class="ko-note">*</span>':''}</td>`;
      }).join('');
      return `<tr>${memRowHead({name:r.mon})}${cells}</tr>`;
    }).join('');
    return `<div class="mtx-legend"><span>${I18N.fireLegend(30)}</span></div>
      <div class="mg"><table class="mtx">${head}${rows}</table></div>`;
  }
  const SPSYM = {win:'◎', may:'△', lose:'×'};
  function speedHtml(res){
    const sp = res.speed; if(!sp) return '';
    const head = `<tr><th class="mtx-corner mtx-stick">${I18N.selfVsOpp}</th>` + sp.tops.map(t=>`<th>${icoImg(t.sp,'mtx-ico')}<div class="mtx-name">${esc(t.label)}</div></th>`).join('') + `</tr>`;
    const rows = sp.rows.map(r=>{
      const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(r.mon,'mtx-ico')}<div class="mtx-name">${esc(tPoke(r.mon))}<br><span class="sp-val">S${r.spd}${r.scarf?'⚡':''}</span></div></div></th>`;
      const cells = r.cells.map((c,j)=>`<td class="${col(SPSYM[c])} sp-cell" data-mon="${esc(r.mon)}" data-opp="${esc(sp.tops[j].sp)}">${SPSYM[c]}</td>`).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    return `<div class="mtx-legend"><span>${I18N.speedLegend}</span></div>
      <div class="mg"><table class="mtx">${head}${rows}</table></div>`;
  }
  function paneHtml(res, t, i){
    if(t==='deftype') return defenseTypeHtml(res);
    if(t==='mu') return matchupHtml(res);
    if(t==='speed') return speedHtml(res);
    if(t==='arch') return archetypeHtml(res);
    if(t==='guide') return guideHtml(res);
    return attackTypeHtml(res);
  }

  function popShow(html){ document.getElementById('pop-body').innerHTML=html; document.getElementById('popup').style.display='flex'; }
  function popHide(){ document.getElementById('popup').style.display='none'; }
  function suggOf(el){ const c=el.closest('.sug'); return c?LAST[+c.dataset.sug]:null; }
  function fireDetailHtml(d){
    const cols = d.cols.map(c=>`<th>${I18N.thVariant(c.idx)}<span class="pop-types">${typeIcoByName(c.t1)}${c.t2?typeIcoByName(c.t2):''}</span><span class="pop-col-sub">${esc(tItem(c.item))}<br>${esc(c.ev)}<br>${esc(tAbil(c.ability))}</span></th>`).join('');
    const rows = d.rows.map(r=>{
      const cells = r.cells.map(c=>`<td class="${c.best?'best':''}">${c.best?'★':''}<span class="pop-pct">${esc(c.pct)}</span><br><span class="pop-ko">${esc(tKo(c.ko))}${c.note?'・'+esc(tSurviveNote(c.note)):''}</span></td>`).join('');
      return `<tr><td class="lft"><span class="mvchip-s">${typeIcoByName(r.type)}${esc(tMove(r.move))}</span></td>${cells}</tr>`;
    }).join('');
    return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(tPoke(d.mon))}<span class="arw">→</span>${icoImg(d.opp,'')}${esc(tPoke(d.opp))}</div>
      <div class="pop-sub">${I18N.popFireSub}</div>
      <div style="overflow-x:auto"><table class="pop-t"><tr><th class="lft">${I18N.thMove}</th>${cols}</tr>${rows}</table></div>`;
  }
  function speedDetailHtml(d){
    const items = d.builds.map(b=>({s:b.s, mine:false, item:b.item, ev:b.ev, idx:b.idx, scarf:b.scarf}));
    items.push({s:d.my_s, mine:true, scarf:d.my_scarf});
    items.sort((a,b)=>b.s-a.s);
    const rows = items.map(it=>{
      if(it.mine) return `<div class="spd-row me">${icoImg(d.mon,'')}<span class="spd-s">S${it.s}${it.scarf?'⚡':''}</span><span>${I18N.speedYou(esc(tPoke(d.mon)))}</span></div>`;
      const cmp = d.my_s>it.s?'out':(d.my_s<it.s?'in':'eq');
      const tag = cmp==='out'?`<span class="spd-tag t-out">${I18N.speedFaster}</span>`:cmp==='in'?`<span class="spd-tag t-in">${I18N.speedSlower}</span>`:`<span class="spd-tag t-eq">${I18N.speedEq}</span>`;
      const cls = cmp==='out'?'slower':(cmp==='in'?'faster':'');
      return `<div class="spd-row ${cls}">${icoImg(d.opp,'')}<span class="spd-s">S${it.s}${it.scarf?'⚡':''}</span><span>${I18N.thVariant(it.idx)} ${esc(tItem(it.item))} ${esc(it.ev)}</span>${tag}</div>`;
    }).join('');
    return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(tPoke(d.mon))}<span class="arw">vs</span>${icoImg(d.opp,'')}${esc(tPoke(d.opp))}</div>
      <div class="pop-sub">${I18N.popSpeedSub}</div>${rows}`;
  }
  function matchupDetailHtml(d){
    const cols = d.cols.map(c=>`<th>${I18N.thVariant(c.idx)}<span class="pop-types">${typeIcoByName(c.t1)}${c.t2?typeIcoByName(c.t2):''}</span><span class="pop-col-sub">${esc(tItem(c.item))}<br>${esc(tNature(c.nature))}<br>${esc(c.ev)}</span></th>`).join('');
    const dmgRow = (lab, arr) => `<tr><td class="lft">${lab}</td>${arr.map(c=>`<td><span class="pop-pct">${esc(c.pct)}</span> <span class="pop-ko">${esc(tKo(c.ko))}</span><br><span class="pop-ko">${esc(tMove(c.move))}</span></td>`).join('')}</tr>`;
    const spRow = `<tr><td class="lft">${I18N.speedRow}</td>${d.spd.map(c=>`<td class="${c.fast?'sp-win':'sp-lose'}">${esc(tSpdTxt(c.txt))}</td>`).join('')}</tr>`;
    const jRow = `<tr><td class="lft">${I18N.judgeRow}</td>${d.judge.map(c=>`<td class="${col(c.v)}"><b style="font-size:1.05em">${c.v}</b><br><span class="pop-ko">${esc(tJudgeTxt(c.txt))}</span></td>`).join('')}</tr>`;
    return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(tPoke(d.mon))}<span class="arw">vs</span>${icoImg(d.opp,'')}${esc(tPoke(d.opp))}</div>
      <div class="pop-sub">${I18N.popMuSub}</div>
      <div style="overflow-x:auto"><table class="pop-t"><tr><th class="lft"> </th>${cols}</tr>${dmgRow(I18N.dmgSelf,d.me)}${dmgRow(I18N.dmgOpp,d.op)}${spRow}${jRow}</table></div>`;
  }
  function atkDetailHtml(d){
    const EFF = e=>e>=2?'×2':e===1?'×1':e===0?'無効':e<=0.25?'¼':'½';
    const CLR = e=>e>=2?'#15803d':e===1?'#64748b':'#dc2626';
    const rows = d.moves.map(m=>{
      const val = m.atk ? `<span style="font-weight:800;color:${CLR(m.eff)}">${EFF(m.eff)}</span>` : `<span class="muted">${I18N.changeMove}</span>`;
      return `<tr><td class="lft"><span class="mvchip-s">${typeIcoByName(m.type)}${esc(tMove(m.name))}</span></td><td>${val}</td></tr>`;
    }).join('');
    return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(tPoke(d.mon))}<span class="arw">→</span>${typeIcoByName(d.type)}${esc(d.type)}</div>
      <div class="pop-sub">${I18N.popAtkSub(esc(tPoke(d.mon)), esc(d.type))}</div>
      <table class="pop-t"><tr><th class="lft">${I18N.thMove}</th><th>${I18N.thAtkMult(esc(d.type))}</th></tr>${rows}</table>`;
  }
  async function openAtkDetail(el){
    const res = suggOf(el); if(!res) return;
    popShow(`<div class="muted" style="padding:1em">${I18N.calculating}</div>`);
    try{
      const d = await fetch(API+'/atk_detail', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({specs:res.specs, mon:el.dataset.mon, type:el.dataset.type})}).then(r=>r.json());
      popShow(atkDetailHtml(d));
    }catch(e){ popShow(`<div class="muted" style="padding:1em">${I18N.fetchFailed}</div>`); }
  }
  async function openDetail(el, kind){
    const res = suggOf(el); if(!res) return;
    const body = {specs:res.specs, mon:el.dataset.mon, opp:el.dataset.opp};
    popShow(`<div class="muted" style="padding:1em">${I18N.calculating}</div>`);
    try{
      const d = await fetch(API+'/'+kind, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)}).then(r=>r.json());
      const render = {fire_detail:fireDetailHtml, speed_detail:speedDetailHtml, matchup_detail:matchupDetailHtml}[kind];
      popShow(render(d));
    }catch(e){ popShow(`<div class="muted" style="padding:1em">${I18N.fetchFailed}</div>`); }
  }
  document.getElementById('pop-x').addEventListener('click', popHide);
  document.getElementById('popup').addEventListener('click', e=>{ if(e.target.id==='popup') popHide(); });
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') popHide(); });
  document.addEventListener('click', e=>{
    const fc=e.target.closest('.fire-cell'); if(fc){ openDetail(fc,'fire_detail'); return; }
    const sc=e.target.closest('.sp-cell'); if(sc){ openDetail(sc,'speed_detail'); return; }
    const mc=e.target.closest('.mu-cell'); if(mc){ openDetail(mc,'matchup_detail'); return; }
    const ac=e.target.closest('.at-cell'); if(ac){ openAtkDetail(ac); return; }
    const gr=e.target.closest('.gd-req'); if(gr){ requestGuide(gr); return; }
    const ib=e.target.closest('.ps-import-btn'); if(ib){ handleImportToBuilder(ib); return; }
  });

  /** 「パーティ工房で保存・微調整」: 提案の6specをlocalStorage経由でパーティ工房へ引き継ぐ。
   * res.specs は scripts/gen_party_pool.py が組んだ spec 文字列そのもの(fromSpec互換書式・
   * H/A/B/C/D/S=32スケール)なので、mons配列から組み立て直さずそのまま渡す。 */
  function handleImportToBuilder(el){
    const res = suggOf(el); if(!res || !res.specs || !res.specs.length) return;
    const label = LAST_FIXED.length ? LAST_FIXED.map(tPoke).join('+') : (CORE.length ? CORE.map(p=>tPoke(p.label)).join('+') : I18N.omakase);
    const name = I18N.importName(label);
    try{ localStorage.setItem('pn-builder-import', JSON.stringify({name, specs: res.specs})); }
    catch(e){ /* localStorage不可時は遷移のみ行う(工房側で無視される) */ }
    location.href = pfx + '/party-builder';
  }
  async function requestGuide(btn){
    btn.disabled = true;
    try{
      const core = CORE.map(p=>({sp:p.sp, mega:p.mega}));
      await fetch(API+'/guide_request',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({core})});
      btn.style.display='none';
      const d = btn.parentElement.querySelector('.gd-req-done'); if(d) d.style.display='block';
    }catch(_){ btn.disabled=false; }
  }

  let LAST = [];
  let LAST_FIXED = [];
  function bindTabs(){
    document.querySelectorAll('.montab').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const i = +btn.dataset.i, j = +btn.dataset.j;
        document.querySelectorAll(`.montab[data-i="${i}"]`).forEach(b=>b.classList.toggle('active', +b.dataset.j===j));
        document.getElementById('det-'+i).innerHTML = detailHtml(LAST[i].mons[j]);
      });
    });
    document.querySelectorAll('.tb').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const i = +btn.dataset.i, t = btn.dataset.t;
        document.querySelectorAll(`.tb[data-i="${i}"]`).forEach(b=>b.classList.toggle('active', b.dataset.t===t));
        document.getElementById('pane-'+i).innerHTML = paneHtml(LAST[i], t, i);
      });
    });
  }

  let SPECIES = [];
  let CORE = [];
  let _sugActive = -1;
  const vid = v => v.sp + '' + (v.mega==null?'*':v.mega);

  fetch(API + '/species').then(r=>r.json()).then(d=>{
    SPECIES = d.map(v=>({label:v.label, sp:v.sp, mega:v.mega, id:vid(v), icon:iconUrl(v.sp), rank:v.rank}));
  }).catch(()=>{});

  function renderCoreChips(){
    const el = document.getElementById('core-chips');
    el.innerHTML = CORE.map(p=>`<span class="filter-chip" title="${esc(tPoke(p.label))}">${p.icon?`<img src="${p.icon}" alt="${esc(p.sp)}">`:''}${esc(tPoke(p.label))}<button class="filter-chip-x" data-id="${esc(p.id)}">✕</button></span>`).join('');
    el.querySelectorAll('.filter-chip-x').forEach(b=>b.addEventListener('click',()=>removeCore(b.dataset.id)));
    document.getElementById('core-filter').placeholder = CORE.length ? I18N.corePlaceholderMore : I18N.corePlaceholder;
  }
  function addCore(id){
    const v = SPECIES.find(s=>s.id===id);
    if(v && !CORE.some(p=>p.id===id)) CORE.push(v);
    const inp = document.getElementById('core-filter'); inp.value=''; inp.focus();
    document.getElementById('core-sug').style.display='none'; _sugActive=-1;
    renderCoreChips();
  }
  function removeCore(id){ CORE = CORE.filter(p=>p.id!==id); renderCoreChips(); }

  function hlSug(text, q){
    const disp = tPoke(text);
    if(disp!==text){
      const di = disp.toLowerCase().indexOf(q.toLowerCase());
      if(di>=0) return esc(disp.slice(0,di))+'<mark>'+esc(disp.slice(di,di+q.length))+'</mark>'+esc(disp.slice(di+q.length));
      return esc(disp);
    }
    const qk=toKatakana(q); const t=qk!==q?qk:q; const i=text.indexOf(t);
    if(i<0) return esc(text);
    return esc(text.slice(0,i))+'<mark>'+esc(text.slice(i,i+t.length))+'</mark>'+esc(text.slice(i+t.length));
  }
  function onFilterInput(val){
    const sug = document.getElementById('core-sug'); _sugActive=-1;
    const q = val.trim(); if(!q){ sug.style.display='none'; return; }
    const qk = toKatakana(q);
    const ql = q.toLowerCase();
    const hits = SPECIES.filter(s=>s.label.includes(q)||s.label.includes(qk)||tPoke(s.label).toLowerCase().includes(ql)).slice(0,12);
    if(!hits.length){ sug.innerHTML=`<div class="sug-item added">${I18N.noHit}</div>`; sug.style.display='block'; return; }
    sug.innerHTML = hits.map((s,i)=>{
      const already = CORE.some(p=>p.id===s.id);
      const rk = (s.rank && s.rank<9999) ? `<span class="rk">${I18N.rankLbl(s.rank)}</span>` : '';
      return `<div class="sug-item${already?' added':''}" data-id="${esc(s.id)}" data-idx="${i}">${s.icon?`<img src="${s.icon}" alt="">`:''}<span>${hlSug(s.label,q)}</span>${rk}</div>`;
    }).join('');
    sug.querySelectorAll('.sug-item[data-id]').forEach(el=>el.addEventListener('click',()=>{ if(!el.classList.contains('added')) addCore(el.dataset.id); }));
    sug.style.display='block';
  }
  function onFilterKey(e){
    const sug = document.getElementById('core-sug');
    const items = [...sug.querySelectorAll('.sug-item[data-id]:not(.added)')];
    if(sug.style.display==='none') return;
    if(e.key==='ArrowDown'){ e.preventDefault(); _sugActive=Math.min(_sugActive+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('act',i===_sugActive)); }
    else if(e.key==='ArrowUp'){ e.preventDefault(); _sugActive=Math.max(_sugActive-1,0); items.forEach((el,i)=>el.classList.toggle('act',i===_sugActive)); }
    else if(e.key==='Enter'){ e.preventDefault(); if(_sugActive>=0&&items[_sugActive]) addCore(items[_sugActive].dataset.id); else if(items.length===1) addCore(items[0].dataset.id); }
    else if(e.key==='Escape'){ sug.style.display='none'; _sugActive=-1; }
  }
  document.getElementById('core-filter').addEventListener('input', e=>onFilterInput(e.target.value));
  document.getElementById('core-filter').addEventListener('keydown', onFilterKey);
  document.addEventListener('click', e=>{ if(!e.target.closest('.filter-wrap')) document.getElementById('core-sug').style.display='none'; });

  async function run(){
    const core = CORE.map(p=>({sp:p.sp, mega:p.mega}));
    const go = document.getElementById('go'); go.disabled = true; go.classList.add('loading');
    const out = document.getElementById('out');
    document.getElementById('status').textContent = '';
    const msgs = I18N.loadMsgs;
    out.innerHTML = `<div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg" id="ps-lmsg">${msgs[0]}</div><div class="ps-lsub">${I18N.loadSub}</div></div>`;
    let mi = 0; const timer = setInterval(()=>{ mi=(mi+1)%msgs.length; const el=document.getElementById('ps-lmsg'); if(el) el.textContent=msgs[mi]; }, 2500);
    try{
      const r = await fetch(API + '/suggest', {method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({core, ncand:100, top:5})});
      const d = await r.json();
      if(d.error){ out.innerHTML=''; document.getElementById('status').textContent = I18N.errPrefix + d.error; return; }
      LAST = d.results;
      LAST_FIXED = d.fixed || [];
      document.getElementById('status').textContent = (d.fixed.length? I18N.fixedLbl(d.fixed.map(tPoke).join(' + ')) : '') + I18N.resultCount(d.results.length);
      out.innerHTML = d.results.map((res,i)=>sugHtml(res,i)).join('');
      bindTabs();
    }catch(e){ out.innerHTML=''; document.getElementById('status').textContent = I18N.connErr; }
    finally{ clearInterval(timer); go.disabled = false; go.classList.remove('loading'); }
  }
  document.getElementById('go').addEventListener('click', run);
  if (preCoreLabel) {
    const _waitForSpecies = setInterval(() => {
      if (!SPECIES.length) return;
      clearInterval(_waitForSpecies);
      const v = SPECIES.find(s => s.label === preCoreLabel);
      if (v) { addCore(v.id); run(); }
    }, 100);
  }
</script>
