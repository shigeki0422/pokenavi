  /** メガストーン(「〜ナイト」)は辞書に個別登録せず、素体名+ナイト接尾辞から動的に組み立てる
   * (ポケモン名同様、独自メガ進化が大半で公式訳が存在しないため)。 */
  function tItem(n){
    if(!n) return n;
