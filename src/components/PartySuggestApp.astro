  const I18N = I18N_ALL[lang];
  const API = /(^|\.)pokenavi\.jp$/.test(location.hostname) ? 'https://pokenavi-suggest-799947701075.asia-northeast1.run.app' : 'http://localhost:8899';
  const EVK = ['H','A','B','C','D','S'];
  const esc = s => (s||'').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const toKatakana = s => s.replace(/[ぁ-ゖ]/g, c => String.fromCharCode(c.charCodeAt(0) + 0x60));
  const _regionalPrefix = [['ヒスイ',3],['ガラル',3],['アローラ',4]];
  /** メガ進化名(「メガガブリアス」等)は辞書に個別登録せず、素体名+メガ接頭辞から動的に組み立てる
   * (公式訳が存在しないポケモンチャンピオンズ独自メガ進化が大半のため)。 */
  function tPoke(n){
    if(!n) return n;
    if(POKEMON_NAME_MAP[n]) return POKEMON_NAME_MAP[n];
    let rest = n, prefix = '';
    if(n.startsWith('メガ')){ prefix = 'メガ'; rest = n.slice(2); }
    let base = POKEMON_NAME_MAP[rest], suf = '';
    if(!base && (rest.endsWith('X')||rest.endsWith('Y'))){ suf = rest.slice(-1); base = POKEMON_NAME_MAP[rest.slice(0,-1)]; }
    if(base){
      if(prefix) return lang==='ko' ? `메가${base}${suf}` : `Mega ${base}${suf?` ${suf}`:''}`;
      return `${base}${suf}`;
    }
    return n;
  }
  /** 想定パーティ相性/選出ガイドの対戦相手ラベルは「{ポケモン名}軸」「{名1}＋{名2}軸」の
   * 固定パターン(scripts/_pick_archetypes*.py の label_of())。稀に手動命名の特殊ラベル
   * (「サザングロス」等)が混じるが、パターンに一致しない場合はそのまま返す。 */
  function tArchLabel(label){
    if(!label || !label.endsWith('軸')) return label;
    const names = label.slice(0,-1).split('＋').map(tPoke);
    return lang==='ja' ? label : `${names.join('+')} ${I18N.coreTag}`;
  }
  const tMove = n => n && MOVE_NAME_MAP[n] || n;
  const tAbil = n => n && ABILITY_NAME_MAP[n] || n;
  const tNature = n => n && NATURE_NAME_MAP[n] || n;
  const tType = n => n && TYPE_NAME_MAP[n] || n;
  const tRole = n => n && ROLE_NAME_MAP[n] || n;
  /** メガストーン(「〜ナイト」)は辞書に個別登録せず、素体名+ナイト接尾辞から動的に組み立てる
   * (ポケモン名同様、独自メガ進化が大半で公式訳が存在しないため)。 */
  function tItem(n){
    if(!n) return n;
    if(ITEM_NAME_MAP[n]) return ITEM_NAME_MAP[n];
    if(n.endsWith('ナイト')){
      const base = POKEMON_NAME_MAP[n.slice(0,-3)];
      if(base) return lang==='ko' ? `${base}나이트` : `${base}ite`;
    }
    return n;
  }
  const STAT_LABELS = {'最大弱点重複':'statMaxWeakOverlap','メガ数':'statMegaCount','設置技':'statHazards','天候':'statWeather','スカーフ':'statScarf','物理/特殊':'statPhysSpec','平均素早さ':'statAvgSpeed'};
  function statLabel(k){ const key = STAT_LABELS[k]; return key ? I18N[key] : k; }
  function statValue(k, v){
    const s = String(v);
    if(k==='最大弱点重複'){ const m=/^(.+?) に(\d+)体$/.exec(s); if(m) return I18N.statWeakOverlapVal(tType(m[1]), m[2]); }
    if(k==='設置技'||k==='天候'){ return s==='有'?I18N.yes:s==='無'?I18N.no:s; }
    if(k==='平均素早さ'){ const m=/^(\d+)（最速(\d+)）$/.exec(s); if(m) return I18N.statAvgSpeedVal(m[1],m[2]); }
    return s;
  }

  function iconUrl(name){
    const n = (name||'').replace(' (','(');
    const base = n.split('(')[0].trim();
    let id = ICONS[n] || ICONS[base];
    if(!id){ for(const [p,l] of _regionalPrefix){ if(n.startsWith(p)){ id=ICONS[n.slice(l)+'('+p+')']; if(id) break; } } }
    if(!id){ const k = Object.keys(ICONS).find(kk=>kk.split('(')[0].trim()===base); if(k) id=ICONS[k]; }
    return id ? `/images/pokemon/pokemon-${id}.webp` : null;
  }
  function icoImg(name, cls){
    const u = iconUrl(name);
    const dn = tPoke(name);
    return u ? `<img class="${cls}" src="${u}" alt="${esc(dn)}" title="${esc(dn)}" onerror="this.style.display='none'">` : '';
  }
