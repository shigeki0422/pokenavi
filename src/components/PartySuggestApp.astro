  function typeIco(move){
    const t = MOVET[move]; const e = t ? TYPEICON[t] : null;
    return e ? `<img class="tic" src="/images/types/type-${e[0]}-${e[1]}.png" alt="${esc(t)}">` : '';
  }
  function itemIco(item){
    if(ITEM_PNG[item]) return `<img class="iic" src="/images/items/${ITEM_PNG[item]}" alt="">`;
    // 専用PNGが無い持ち物はスプライトから切り出す（いのちのたま等、以前は無表示だった）
    const sp = ITEM_SPRITE[item];
    if(sp) return `<span class="iic isp" style="background-position:${sp[0]}px ${sp[1]}px" title="${esc(item)}"></span>`;
    return '';
  }
  function evChips(ev){
    return (ev||'').split(/\s+/).filter(Boolean).map(tok=>{
      const k = tok[0], v = tok.slice(1);
      return EVK.includes(k) ? `<span class="evchip ev-${k}">${k}<b>${v}</b></span>` : '';
    }).join('');
  }
  function natDisp(na){ return na ? `${tNature(na)}${NATURE[na] ? ` (${NATURE[na]})` : ''}` : '—'; }

  function detailHtml(m){
    return `<div class="dgrid">
        <div class="dcell"><span class="lbl item">${I18N.itemLbl}</span><span class="dval">${itemIco(m.item)}${esc(tItem(m.item))||'—'}</span></div>
        <div class="dcell"><span class="lbl abil">${I18N.abilLbl}</span><span class="dval">${esc(tAbil(m.ability))||'—'}</span></div>
        <div class="dcell"><span class="lbl nat">${I18N.natLbl}</span><span class="dval">${esc(natDisp(m.nature))}</span></div>
      </div>
