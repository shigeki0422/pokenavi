  .ps-ad-bg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
  .ps-ad-unit{position:relative;display:inline-block;width:300px;height:250px}

  /* 複数軸の事前注意書き・エラー表示 */
  .ps-notice{font-size:.78rem;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:.5em .7em;margin-top:.5em}
