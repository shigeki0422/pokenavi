      <div class="drow"><span class="lbl ev">${I18N.evLbl}</span><span class="mvwrap">${evChips(m.ev)||'—'}</span></div>
      ${(m.roles&&m.roles.length)?`<div style="margin-top:.35em">${m.roles.map(r=>`<span class="role">${esc(tRole(r))}</span>`).join('')}</div>`:''}`;
  }

  const col = c => ({'◎':'bg-cc','○':'bg-cb','△':'bg-cn','▲':'bg-cw','×':'bg-cx'}[c]||'bg-cn');
  /** (A2) 長文凡例は<details>化してスマホでは折りたたむ(デスクトップはCSSで常時展開)。 */
  function legendBox(text){
    return `<details class="mtx-legend-det"><summary class="mtx-legend-sum">${esc(I18N.legendSummary)}</summary><div class="mtx-legend"><span>${text}</span></div></details>`;
  }
  /** (A4)(C03) 横スクロール可能な相性表をラップし、右端にフェード+矢印ヒントを付ける。
   * 実装は工房(PartyBuilderApp.astro)と共有するsrc/scripts/party-builder/mg-hints.tsに切り出し済み。
   * このスクリプトはdefine:varsのis:inlineでimportできないため、window.__mgWrapHtml経由で呼ぶ
   * (window.__openMuDialogと同じ渡し方)。未ロードの場合に備え、フォールバックとして旧実装を残す。 */
  function mgWrap(tableHtml){
    if (typeof window.__mgWrapHtml === 'function') return window.__mgWrapHtml(tableHtml);
    return `<div class="mg-wrap"><div class="mg">${tableHtml}</div><div class="mg-hint" aria-hidden="true">→</div></div>`;
  }
  function matchupHtml(res){
    const mu = res.matchup; if(!mu) return '';
    // (A4) 味方の誰も◎/○を取れない相手列(穴)を強調する
    const holeCols = mu.tops.map((t,j) => !mu.rows.some(rw => rw.cells[j] && (rw.cells[j].v==='◎'||rw.cells[j].v==='○')));
    const head = `<tr><th class="mtx-corner mtx-stick">${I18N.selfVsOpp}</th>` + mu.tops.map((t,j)=>`<th class="${holeCols[j]?'th-hole':''}">${icoImg(t.sp,'mtx-ico')}<div class="mtx-name">${esc(tPoke(t.label))}</div></th>`).join('') + `</tr>`;
    const rows = mu.rows.map(rw=>{
      const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(rw.mon,'mtx-ico')}<div class="mtx-name">${esc(tPoke(rw.mon))}</div></div></th>`;
      const cells = rw.cells.map((c,j)=>`<td class="${col(c.v)} mu-cell" data-mon="${esc(rw.mon)}" data-opp="${esc(mu.tops[j].sp)}" data-lbl="${esc(mu.tops[j].label)}">${c.v}${c.dep?'<span class="mu-dep">*</span>':''}</td>`).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    return `${legendBox(I18N.muLegend)}
      ${mgWrap(`<table class="mtx">${head}${rows}</table>`)}`;
  }
  function typeIcoByName(t){ const e=TYPEICON[t]; return e?`<img class="dtl-ico" src="/images/types/type-${e[0]}-${e[1]}.png" alt="${esc(t)}">`:''; }

  function memRowHead(m){
    return `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(m.name,'mtx-ico')}<div class="mtx-name">${esc(tPoke(m.name))}</div></div></th>`;
  }
  const DEFG = x => x===0?'0':x<=0.25?'¼':x<0.5?'½':x<1?'½':x>=4?'×4':x>1?'×2':'';
  const DEFC = x => x===0?'df-imm':x<0.5?'df-r2':x<1?'df-r1':x>=4?'df-w2':x>1?'df-w1':'df-n';
  function _typeMatrix(res, corner, cellFn, legend){
    const tm = (res.details||{}).typematrix; if(!tm) return '';
    const mem = res.mons;
    // (A2) titleだけに頼らず短いタイプ名を併記する(タッチ端末でも判別可能に)
    const head = `<tr><th class="mtx-corner mtx-stick">${corner}</th>` + tm.rows.map(r=>`<th title="${esc(r.type)}">${typeIcoByName(r.type)}<div class="mtx-tname">${esc(tType(r.type))}</div></th>`).join('') + `</tr>`;
    const rows = mem.map((m,mi)=>`<tr>${memRowHead(m)}${tm.rows.map(r=>cellFn(r.cells[mi], m, r.type)).join('')}</tr>`).join('');
    return `${legend}${mgWrap(`<table class="mtx">${head}${rows}</table>`)}`;
  }
  function attackTypeHtml(res){
    const cell = (c, mon, type)=>{
      const mult = c.atk;
      const inner = mult==null?'–':(DEFG(mult)||'・');
      const cls = mult==null?'ao-none':mult>=2?'ao-good':mult===1?'ao-neu':'ao-bad';
      return `<td class="${cls} at-cell" data-mon="${esc(mon.name)}" data-type="${esc(type)}">${inner}</td>`;
