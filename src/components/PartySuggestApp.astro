    const head = `<tr><th class="mtx-corner mtx-stick">${I18N.selfVsOpp}</th>` + mu.tops.map(t=>`<th>${icoImg(t.sp,'mtx-ico')}<div class="mtx-name">${esc(t.label)}</div></th>`).join('') + `</tr>`;
