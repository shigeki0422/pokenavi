  }

  function sugHtml(res, i){
    const tabs = res.mons.map((m,j)=>`<button class="montab${m.core?' core':''}${j===0?' active':''}" data-i="${i}" data-j="${j}">
        ${m.core?'<span class="mcore">◆</span>':''}${m.mega?'<span class="mmega">★</span>':''}
        ${icoImg(m.name,'monicon')}
        <span class="mname">${esc(tPoke(m.name))}</span>
        <span class="mitem">${esc(tItem(m.item))||'—'}</span>
      </button>`).join('');
    const _skip = {'脅威対応率':1,'攻撃カバー':1,'防御相補':1};
    const st = res.stats ? `<div class="stats">${Object.entries(res.stats).filter(([k])=>!_skip[k]).map(([k,v])=>`<span><b>${esc(statLabel(k))}</b> ${esc(statValue(k,v))}</span>`).join('')}</div>` : '';
    const dt = res.details || {};
    const tm = dt.typematrix;
    // 「想定パーティ相性」は 2026-09-14 に外したまま。選出ガイドは学習選出・よくある構築で作り直して復活（2026-10）。
    // (S18) 初期タブは攻撃相性→ポケモン相性。パーティの穴が最初に見えるタブを優先する(工房のB16と同じ判断)。
    const tbar = `<div class="tabbar">
        <button class="tb" data-i="${i}" data-t="atktype">${I18N.tabAtk}</button>
        <button class="tb" data-i="${i}" data-t="deftype">${I18N.tabDef}</button>
        <button class="tb active" data-i="${i}" data-t="mu">${I18N.tabMu}</button>
        <button class="tb" data-i="${i}" data-t="speed">${I18N.tabSpeed}</button>
        ${/(^|\.)pokenavi\.jp$/.test(location.hostname) ? '' : `<button class="tb" data-i="${i}" data-t="guide">${I18N.tabGuide}</button>`}
      </div>`;
    const collapsed = i !== 0;
    // (S01) 「工房で保存・微調整」はアコーディオンの開閉トグル(.sug-toggle)の外、.sug-body末尾に置く。
    // ヘッダ内に置いていた頃は、畳もうとタップした指がボタンにも重なりやすく、
    // 畳むつもりが誤って工房へ遷移する事故があったため、当たり判定を完全に分離する。
    return `<div class="card sug${collapsed?' collapsed':''}" data-sug="${i}">
      <div class="hd sug-toggle" data-i="${i}"><span>${I18N.suggestion(i+1)}</span><span class="sug-chev" aria-hidden="true">${collapsed?'▾':'▴'}</span></div>
      ${st}
      <div class="iconrow">${tabs}</div>
      <div class="sug-body">
        <div class="detail" id="det-${i}">${collapsed ? '' : detailHtml(res.mons[0])}</div>
        ${tbar}
        <div class="pane" id="pane-${i}"${collapsed ? '' : ' data-rendered="1"'}>${collapsed ? '' : matchupHtml(res)}</div>
        <div class="sug-save-row"><button type="button" class="pb-btn-sub ps-import-btn">${I18N.saveToBuilder}</button></div>
      </div>
    </div>`;
  }
  /** (S04) 折りたたみ状態(2〜5案目)は初期DOMに.detail/.paneの中身(攻撃相性表等の画像・セル)を
   * 生成せず、初回展開時(toggleSugでcollapsedが外れた瞬間)にだけ生成する。初期DOMの画像数・
   * セル数が案の数だけ膨らんでいたのを1/5程度に抑える狙い。pane側はdata-renderedで二重生成を防ぐ。 */
  function ensureSugBodyRendered(i){
    const paneEl = document.getElementById('pane-'+i);
    if (!paneEl || paneEl.dataset.rendered || !LAST[i]) return;
    paneEl.dataset.rendered = '1';
    const detEl = document.getElementById('det-'+i);
    if (detEl && !detEl.innerHTML) detEl.innerHTML = detailHtml(LAST[i].mons[0]);
    const activeBtn = document.querySelector(`.tb.active[data-i="${i}"]`);
    const t = activeBtn ? activeBtn.dataset.t : 'mu';
    paneEl.innerHTML = paneHtml(LAST[i], t, i);
  }
  function toggleSug(hd){
    const card = hd.closest('.sug'); if(!card) return;
    const collapsed = card.classList.toggle('collapsed');
    const chev = hd.querySelector('.sug-chev'); if(chev) chev.textContent = collapsed?'▾':'▴';
    if(!collapsed){
      ensureSugBodyRendered(+hd.dataset.i); // (S04) 初回展開時に遅延生成
      // 折りたたみ中はdisplay:noneでscrollWidth/clientWidthが0になり、
      // 横スクロールヒントの判定(initMgHints)が不正確なまま済んでしまうため、
      // 展開時に判定をやり直す。
      card.querySelectorAll('.mg-wrap').forEach(w=>{ w.removeAttribute('data-mg-init'); w.classList.remove('mg-scrolled'); });
      initMgHints();
    }
    saveCurrentUi(); // (S14)
  }
  function archetypeHtml(res){
    const a = res.archetypes; if(!a||!a.length) return `<div class="muted">${I18N.noArchData}</div>`;
    const rows = a.slice().sort((x,y)=>y.adv-x.adv).map(x=>{
      const pct = Math.round(x.adv*100);
      const cls = pct>=55?'adv-good':pct<45?'adv-bad':'adv-mid';
      const opp = x.opp.map(n=>icoImg(n,'dtl-ico')).join('');
      return `<tr>
        <td><div class="arch-lb">${esc(tArchLabel(x.label))}</div><div class="dtl-mem">${opp}</div></td>
        <td><div class="advbar"><div class="advfill ${cls}" style="width:${pct}%"></div></div><div class="advtxt ${cls}">${pct}%</div></td></tr>`;
    }).join('');
    return `<div class="mtx-legend"><span>${I18N.archLegend}</span></div>
      <table class="dtl arch"><tr><th>${I18N.thOpp}</th><th>${I18N.thWr}</th></tr>${rows}</table>`;
  }
  const guideBody = g => window.__guideBody(g, legendBox);
  function loadGuide(res, i){
    if(res._guideP) return;
    res._guideP = fetch(API+'/guide',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({specs:res.specs})})
      .then(r=>r.json())
      .then(d=>{ if(!d || d.error || !d.members) throw new Error(d && d.error); res._guide = d; return true; })
      .catch(()=>false)
      .then(ok=>{
        if(!ok) res._guideP = null;
        const tb = document.querySelector(`.tb.active[data-i="${i}"]`), pane = document.getElementById('pane-'+i);
        if(LAST[i]!==res || !tb || tb.dataset.t!=='guide' || !pane) return;
        pane.innerHTML = ok ? guideBody(res._guide) : `<div class="muted">${I18N.fetchFailed}</div>`;
        syncLegendOpen();
      });
  }
  function guideHtml(res, i){
    if(res._guide) return guideBody(res._guide);
    if(!res.specs || !res.specs.length) return `<div class="muted">${I18N.fetchFailed}</div>`;
    loadGuide(res, i);
    return `<div class="muted gd-wait">${I18N.gdCalc}</div>`;
  }
  const SPSYM = {win:'◎', may:'△', lose:'×'};
  function speedHtml(res){
    const sp = res.speed; if(!sp) return '';
    const head = `<tr><th class="mtx-corner mtx-stick">${I18N.selfVsOpp}</th>` + sp.tops.map(t=>`<th>${icoImg(t.sp,'mtx-ico')}<div class="mtx-name">${esc(tPoke(t.label))}</div></th>`).join('') + `</tr>`;
    const rows = sp.rows.map(r=>{
      const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(r.mon,'mtx-ico')}<div class="mtx-name">${esc(tPoke(r.mon))}<br><span class="sp-val">S${r.spd}${r.scarf?'⚡':''}</span></div></div></th>`;
      const cells = r.cells.map((c,j)=>`<td class="${col(SPSYM[c])} sp-cell" data-mon="${esc(r.mon)}" data-opp="${esc(sp.tops[j].sp)}" data-lbl="${esc(sp.tops[j].label)}">${SPSYM[c]}</td>`).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    return `${legendBox(I18N.speedLegend)}
      ${mgWrap(`<table class="mtx">${head}${rows}</table>`)}`;
  }
  function paneHtml(res, t, i){
    if(t==='deftype') return defenseTypeHtml(res);
    if(t==='mu') return matchupHtml(res);
    if(t==='speed') return speedHtml(res);
    if(t==='arch') return archetypeHtml(res);
    if(t==='guide') return guideHtml(res, i);
    return attackTypeHtml(res);
  }

  function popShow(html){ document.getElementById('pop-body').innerHTML=html; document.getElementById('popup').style.display='flex'; document.documentElement.classList.add('ps-scroll-lock'); }
  function popHide(){ document.getElementById('popup').style.display='none'; document.documentElement.classList.remove('ps-scroll-lock'); }
  function suggOf(el){ const c=el.closest('.sug'); return c?LAST[+c.dataset.sug]:null; }
  /** (C7) 同一セルの再タップは即座に再表示できるよう、種別+specs+対象で結果をキャッシュする。
   * specsは提案ごとに固定なので同一提案内での再タップのみキーが一致する。 */
  const _detailCache = new Map();
  function _cacheKey(kind, specs, a, b){ return kind+'|'+(specs||[]).join(',')+'|'+a+'|'+(b||''); }
  function speedDetailHtml(d){
    const items = d.builds.map(b=>({s:b.s, mine:false, item:b.item, ev:b.ev, idx:b.idx, scarf:b.scarf}));
    items.push({s:d.my_s, mine:true, scarf:d.my_scarf});
    items.sort((a,b)=>b.s-a.s);
    const rows = items.map(it=>{
      if(it.mine) return `<div class="spd-row me">${icoImg(d.mon,'')}<span class="spd-s">S${it.s}${it.scarf?'⚡':''}</span><span>${I18N.speedYou(esc(tPoke(d.mon)))}</span></div>`;
      const cmp = d.my_s>it.s?'out':(d.my_s<it.s?'in':'eq');
      const tag = cmp==='out'?`<span class="spd-tag t-out">${I18N.speedFaster}</span>`:cmp==='in'?`<span class="spd-tag t-in">${I18N.speedSlower}</span>`:`<span class="spd-tag t-eq">${I18N.speedEq}</span>`;
      const cls = cmp==='out'?'slower':(cmp==='in'?'faster':'');
      return `<div class="spd-row ${cls}">${icoImg(d.opp,'')}<span class="spd-s">S${it.s}${it.scarf?'⚡':''}</span><span>${I18N.thVariant(it.idx)} ${esc(tItem(it.item))} ${esc(it.ev)}</span>${tag}</div>`;
    }).join('');
    return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(tPoke(d.mon))}<span class="arw">vs</span>${icoImg(d.opp,'')}${esc(tPoke(d.opp))}</div>
      <div class="pop-sub">${I18N.popSpeedSub}</div>${rows}`;
  }
  /** 1v1判定の内訳は工房・ポケモン情報ページと同じダイアログ（mu-cell-popup.ts の openMuDialog）。
   * 自分＝提案のその個体の spec、相手＝その種の代表型（builder-data/targets.json）。wasm でブラウザ内計算する。 */
  function openMuDetail(el){
    const res = suggOf(el); if(!res) return;
    const spec = (res.specs||[]).find(s => s.split('@')[0] === el.dataset.mon);
    if(!spec || typeof window.__openMuDialog !== 'function') return;
    window.__openMuDialog({
      lang, names: { tPoke, tMove, tItem, tAbil, tNature }, mine: spec,
      opp: { sp: el.dataset.opp, label: el.dataset.lbl }, show: popShow,
      loadingHtml: `<div class="muted" style="padding:1em">${I18N.calculating}</div>`,
      errorHtml: `<div class="muted" style="padding:1em">${I18N.fetchFailed}</div>`,
    });
  }
  function atkDetailHtml(d){
    const EFF = e=>e>=2?'×2':e===1?'×1':e===0?'無効':e<=0.25?'¼':'½';
    const CLR = e=>e>=2?'#15803d':e===1?'#64748b':'#dc2626';
    const rows = d.moves.map(m=>{
      const val = m.atk ? `<span style="font-weight:800;color:${CLR(m.eff)}">${EFF(m.eff)}</span>` : `<span class="muted">${I18N.changeMove}</span>`;
      return `<tr><td class="lft"><span class="mvchip-s">${typeIcoByName(m.type)}${esc(tMove(m.name))}</span></td><td>${val}</td></tr>`;
    }).join('');
    return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(tPoke(d.mon))}<span class="arw">→</span>${typeIcoByName(d.type)}${esc(d.type)}</div>
      <div class="pop-sub">${I18N.popAtkSub(esc(tPoke(d.mon)), esc(d.type))}</div>
      <table class="pop-t"><tr><th class="lft">${I18N.thMove}</th><th>${I18N.thAtkMult(esc(d.type))}</th></tr>${rows}</table>`;
  }
  async function openAtkDetail(el){
    const res = suggOf(el); if(!res) return;
    const key = _cacheKey('atk_detail', res.specs, el.dataset.mon, el.dataset.type);
    if(_detailCache.has(key)){ popShow(atkDetailHtml(_detailCache.get(key))); return; }
    popShow(`<div class="muted" style="padding:1em">${I18N.calculating}</div>`);
    try{
      const d = await fetch(API+'/atk_detail', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({specs:res.specs, mon:el.dataset.mon, type:el.dataset.type})}).then(r=>r.json());
      _detailCache.set(key, d);
      popShow(atkDetailHtml(d));
    }catch(e){ popShow(`<div class="muted" style="padding:1em">${I18N.fetchFailed}</div>`); }
  }
  async function openDetail(el, kind){
    const res = suggOf(el); if(!res) return;
    const body = {specs:res.specs, mon:el.dataset.mon, opp:el.dataset.opp, lbl:el.dataset.lbl};
    const render = {speed_detail:speedDetailHtml}[kind];
    const key = _cacheKey(kind, res.specs, el.dataset.mon, el.dataset.lbl || el.dataset.opp);
    if(_detailCache.has(key)){ popShow(render(_detailCache.get(key))); return; }
    popShow(`<div class="muted" style="padding:1em">${I18N.calculating}</div>`);
    try{
      const d = await fetch(API+'/'+kind, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)}).then(r=>r.json());
      _detailCache.set(key, d);
      popShow(render(d));
    }catch(e){ popShow(`<div class="muted" style="padding:1em">${I18N.fetchFailed}</div>`); }
  }
  document.getElementById('pop-x').addEventListener('click', popHide);
  document.getElementById('popup').addEventListener('click', e=>{ if(e.target.id==='popup') popHide(); });
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') popHide(); });
  document.addEventListener('click', e=>{
    const sc=e.target.closest('.sp-cell'); if(sc){ openDetail(sc,'speed_detail'); return; }
    const mc=e.target.closest('.mu-cell'); if(mc){ openMuDetail(mc); return; }
    const ac=e.target.closest('.at-cell'); if(ac){ openAtkDetail(ac); return; }
    const ib=e.target.closest('.ps-import-btn'); if(ib){ handleImportToBuilder(ib); return; }
    const hd=e.target.closest('.sug-toggle'); if(hd){ toggleSug(hd); return; }
  });

  /** 「パーティ工房で保存・微調整」: 提案の6specをlocalStorage経由でパーティ工房へ引き継ぐ。
   * res.specs は scripts/gen_party_pool.py が組んだ spec 文字列そのもの(fromSpec互換書式・
   * H/A/B/C/D/S=32スケール)なので、mons配列から組み立て直さずそのまま渡す。 */
  function handleImportToBuilder(el){
    const res = suggOf(el); if(!res || !res.specs || !res.specs.length) return;
    const label = LAST_FIXED.length ? LAST_FIXED.map(tPoke).join('+') : (CORE.length ? CORE.map(p=>tPoke(p.label)).join('+') : I18N.omakase);
    const name = I18N.importName(label);
    try{ localStorage.setItem('pn-builder-import', JSON.stringify({name, specs: res.specs})); }
    catch(e){ /* localStorage不可時は遷移のみ行う(工房側で無視される) */ }
    location.href = pfx + '/party-builder';
  }

  let LAST = [];
  let LAST_FIXED = [];
  /** (A3) タブバーがsticky top:0で貼り付く際、グローバルヘッダー(モバイルではsticky)の
   * 実高さ分だけ下にオフセットする(ヘッダーの内部構成が変わっても追従できるよう実測する)。 */
  function updateStickyOffset(){
    const header = document.querySelector('header');
    let h = 0;
    if(header){ const cs = getComputedStyle(header); if(cs.position==='sticky'||cs.position==='fixed') h = header.getBoundingClientRect().height; }
    document.documentElement.style.setProperty('--ps-sticky-top', h+'px');
  }
  window.addEventListener('resize', updateStickyOffset);
  updateStickyOffset();
  /** (A2) 凡例<details>の開閉をブレークポイントに合わせて同期する(デスクトップは常時展開)。 */
  function syncLegendOpen(){
    const mobile = window.matchMedia('(max-width:640px)').matches;
    document.querySelectorAll('details.mtx-legend-det').forEach(d=>{ d.open = !mobile; });
  }
  window.addEventListener('resize', syncLegendOpen);
  /** (A4)(C03) 新しく描画された.mg-wrapに横スクロールヒントの表示/消去を仕込む(冪等)。
   * mgWrap()と同じ理由でwindow.__mgHints経由(未ロード時は旧実装にフォールバック)。
   * (C05) フォールバック側も{once:true}をやめ、左端まで戻したら再表示する。 */
  function initMgHints(){
    if (typeof window.__mgHints === 'function') { window.__mgHints(); return; }
    document.querySelectorAll('.mg-wrap:not([data-mg-init])').forEach(wrap=>{
      wrap.setAttribute('data-mg-init','1');
      const mg = wrap.querySelector('.mg'); if(!mg) return;
      const check = () => {
        if (mg.scrollWidth <= mg.clientWidth + 2) { wrap.classList.add('mg-scrolled'); return; }
        wrap.classList.toggle('mg-scrolled', mg.scrollLeft > 2);
      };
      check();
      mg.addEventListener('scroll', check, {passive:true});
      window.addEventListener('resize', check);
    });
  }
  function bindTabs(){
    document.querySelectorAll('.montab').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const i = +btn.dataset.i, j = +btn.dataset.j;
        document.querySelectorAll(`.montab[data-i="${i}"]`).forEach(b=>b.classList.toggle('active', +b.dataset.j===j));
        document.getElementById('det-'+i).innerHTML = detailHtml(LAST[i].mons[j]);
        // 提案2以降は畳まれた状態で出る。詳細は .sug-body 内にあるため、畳んだままポケモンを
        // タップしても何も起きないように見える（スマホで顕著）。タップを「開く」操作として扱う。
        const card = btn.closest('.card.sug');
        if(card && card.classList.contains('collapsed')){
          const hd = card.querySelector('.sug-toggle');
          if(hd) toggleSug(hd);
        }
        saveCurrentUi(); // (S14)
      });
    });
    document.querySelectorAll('.tb').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const i = +btn.dataset.i, t = btn.dataset.t;
        document.querySelectorAll(`.tb[data-i="${i}"]`).forEach(b=>b.classList.toggle('active', b.dataset.t===t));
        document.getElementById('pane-'+i).innerHTML = paneHtml(LAST[i], t, i);
        syncLegendOpen();
        initMgHints();
        saveCurrentUi(); // (S14)
      });
    });
    syncLegendOpen();
    initMgHints();
  }

  let SPECIES = [];
  let CORE = [];
  let _sugActive = -1;
  let speciesLoadFailed = false;
  const vid = v => v.sp + '' + (v.mega==null?'*':v.mega);

  /** (S09/S10) 静的JSON(ビルド済み・軸ページと同じデータ)を優先し、404/失敗時のみ
   * 従来のバックエンド(localhost:8899 または本番Cloud Run)へフォールバックする。
   * 取得自体に失敗した場合はSPECIES=[]のまま「該当なし」と同じ見た目になってしまうため、
   * speciesLoadFailedで区別し、検索欄側で専用メッセージ+再試行を出す(onFilterInput参照)。 */
  function loadSpecies(){
    return fetch('/suggest-data/species.json')
      .then(r => r.ok ? r.json() : Promise.reject(new Error('static species unavailable')))
      .catch(() => fetch(API + '/species').then(r => r.json()))
      .then(d => {
        SPECIES = d.map(v=>({label:v.label, sp:v.sp, mega:v.mega, id:vid(v), icon:iconUrl(v.sp), rank:v.rank, exp:!!v.exp}));
        speciesLoadFailed = false;
      })
      .catch(() => { speciesLoadFailed = true; });
  }
  loadSpecies();

  function renderCoreChips(){
    const el = document.getElementById('core-chips');
    el.innerHTML = CORE.map(p=>`<span class="filter-chip" title="${esc(tPoke(p.label))}">${p.icon?`<img src="${p.icon}" alt="${esc(p.sp)}">`:''}${esc(tPoke(p.label))}<button class="filter-chip-x" data-id="${esc(p.id)}">✕</button></span>`).join('');
    el.querySelectorAll('.filter-chip-x').forEach(b=>b.addEventListener('click',()=>removeCore(b.dataset.id)));
    document.getElementById('core-filter').placeholder = CORE.length ? I18N.corePlaceholderMore : I18N.corePlaceholder;
    // (B5) 軸2件以上は必ずライブ計算(10〜20秒)になることを実行前に知らせる
    const notice = document.getElementById('ps-multi-notice');
    if(notice) notice.style.display = CORE.length>=2 ? 'block' : 'none';
  }
  function addCore(id){
    const v = SPECIES.find(s=>s.id===id);
    if(v && !CORE.some(p=>p.id===id)) CORE.push(v);
    const inp = document.getElementById('core-filter'); inp.value=''; inp.focus();
    document.getElementById('core-sug').style.display='none'; _sugActive=-1;
    renderCoreChips();
  }
  function removeCore(id){ CORE = CORE.filter(p=>p.id!==id); renderCoreChips(); }

  function hlSug(text, q){
    const disp = tPoke(text);
    if(disp!==text){
      const di = disp.toLowerCase().indexOf(q.toLowerCase());
      if(di>=0) return esc(disp.slice(0,di))+'<mark>'+esc(disp.slice(di,di+q.length))+'</mark>'+esc(disp.slice(di+q.length));
      return esc(disp);
    }
    const qk=toKatakana(q); const t=qk!==q?qk:q; const i=text.indexOf(t);
    if(i<0) return esc(text);
    return esc(text.slice(0,i))+'<mark>'+esc(text.slice(i,i+t.length))+'</mark>'+esc(text.slice(i+t.length));
  }
  function onFilterInput(val){
    const sug = document.getElementById('core-sug'); _sugActive=-1;
    const q = val.trim(); if(!q){ sug.style.display='none'; return; }
    // (S09) 取得失敗と「該当なし」は原因が違う(前者は再試行で直る)ため、専用メッセージ+再試行を出す。
    if(speciesLoadFailed && !SPECIES.length){
      sug.innerHTML = `<div class="sug-item added">${esc(I18N.speciesLoadFailedMsg)}`
        + `<button type="button" class="pb-btn-sub" id="core-sug-retry" style="margin-left:.5em">${esc(I18N.retryBtn)}</button></div>`;
      sug.style.display='block';
      const retryBtn = document.getElementById('core-sug-retry');
      if(retryBtn) retryBtn.addEventListener('click', () => loadSpecies().then(() => onFilterInput(val)));
      return;
    }
    const qk = toKatakana(q);
    const ql = q.toLowerCase();
    const hits = SPECIES.filter(s=>s.label.includes(q)||s.label.includes(qk)||tPoke(s.label).toLowerCase().includes(ql)).slice(0,12);
    if(!hits.length){ sug.innerHTML=`<div class="sug-item added">${I18N.noHit}</div>`; sug.style.display='block'; return; }
    sug.innerHTML = hits.map((s,i)=>{
      const already = CORE.some(p=>p.id===s.id);
      const rk = (s.rank && s.rank<9999) ? `<span class="rk">${I18N.rankLbl(s.rank)}</span>` : '';
      return `<div class="sug-item${already?' added':''}" data-id="${esc(s.id)}" data-idx="${i}">${s.icon?`<img src="${s.icon}" alt="">`:''}<span>${hlSug(s.label,q)}</span>${rk}</div>`;
    }).join('');
    sug.querySelectorAll('.sug-item[data-id]').forEach(el=>el.addEventListener('click',()=>{ if(!el.classList.contains('added')) addCore(el.dataset.id); }));
    sug.style.display='block';
  }
  function onFilterKey(e){
    const sug = document.getElementById('core-sug');
    const items = [...sug.querySelectorAll('.sug-item[data-id]:not(.added)')];
    if(sug.style.display==='none') return;
    if(e.key==='ArrowDown'){ e.preventDefault(); _sugActive=Math.min(_sugActive+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('act',i===_sugActive)); }
    else if(e.key==='ArrowUp'){ e.preventDefault(); _sugActive=Math.max(_sugActive-1,0); items.forEach((el,i)=>el.classList.toggle('act',i===_sugActive)); }
    else if(e.key==='Enter'){ e.preventDefault(); if(_sugActive>=0&&items[_sugActive]) addCore(items[_sugActive].dataset.id); else if(items.length===1) addCore(items[0].dataset.id); }
    else if(e.key==='Escape'){ sug.style.display='none'; _sugActive=-1; }
  }
  document.getElementById('core-filter').addEventListener('input', e=>onFilterInput(e.target.value));
  document.getElementById('core-filter').addEventListener('keydown', onFilterKey);
  document.addEventListener('click', e=>{ if(!e.target.closest('.filter-wrap')) document.getElementById('core-sug').style.display='none'; });

  /** (A1/S21) 結果描画後は#out先頭へ自動スクロールする(モバイルではボタン操作位置から離れるため)。
   * ライブ計算中は#ps-ad-inline(広告)へscrollIntoViewする(run()側)が、結果が描画された後まで
   * 広告優先のままだと#outの先頭(実際の結果)が画面外に残ってしまうため、ここでは常に#outを狙う。 */
  function scrollToOut(){
    const out = document.getElementById('out');
    if(out && out.firstElementChild) out.scrollIntoView({behavior:'smooth', block:'start'});
  }
  function renderResults(d){
    LAST = d.results;
    LAST_FIXED = d.fixed || [];
    document.getElementById('status').textContent = (d.fixed && d.fixed.length ? I18N.fixedLbl(d.fixed.map(tPoke).join(' + ')) : '') + I18N.resultCount(d.results.length);
    document.getElementById('out').innerHTML = d.results.map((res,i)=>sugHtml(res,i)).join('');
    bindTabs();
    scrollToOut();
  }
  function currentCoreParam(){ return CORE.map(p=>p.label).join(','); }
  /** (B6/S12) 直前の提案結果をsessionStorageにキャッシュし、軸が完全一致する場合のみ
   * APIを叩き直さず即復元する(bfcacheが効かないリロードでも軸2件以上の10〜20秒待ちを避けるため)。
   * A→B→Aのように軸を行き来しても再計算しないよう、直近5件までLRU保持する(古いものから捨てる)。 */
  const SS_KEY = 'ps-last-results';
  const SS_MAX = 5;
  function loadAllSessionResults(){
    try{
      const raw = sessionStorage.getItem(SS_KEY); if(!raw) return [];
      const arr = JSON.parse(raw);
      return Array.isArray(arr) ? arr : [];
    }catch(e){ return []; }
  }
  function saveSessionResult(coreParam, d){
    try{
      let arr = loadAllSessionResults().filter(e=>e.core!==coreParam);
      arr.push({core: coreParam, d, ui: null});
      if(arr.length > SS_MAX) arr = arr.slice(arr.length - SS_MAX);
      sessionStorage.setItem(SS_KEY, JSON.stringify(arr));
    }catch(e){}
  }
  function loadSessionResult(coreParam){
    const hit = loadAllSessionResults().find(e=>e.core===coreParam);
    return hit ? hit.d : null;
  }
  function loadSessionUi(coreParam){
    const hit = loadAllSessionResults().find(e=>e.core===coreParam);
    return hit ? hit.ui : null;
  }
  /** (S14) タブ・展開/折りたたみ・選択中ポケの状態を、同じ軸のキャッシュ結果に紐付けて保存する。
   * 結果のfetch自体はしないため、該当軸のエントリが無い(=まだ結果が無い)場合は何もしない。 */
  function captureCardUiState(){
    return LAST.map((_, i)=>{
      const card = document.querySelector(`.sug[data-sug="${i}"]`);
      if(!card) return null;
      const activeTb = card.querySelector('.tb.active');
      const activeMontab = card.querySelector('.montab.active');
      return { collapsed: card.classList.contains('collapsed'), tab: activeTb ? activeTb.dataset.t : 'mu', j: activeMontab ? +activeMontab.dataset.j : 0 };
    });
  }
  function saveCurrentUi(){
    const coreParam = currentCoreParam();
    if(!coreParam) return;
    try{
      const arr = loadAllSessionResults();
      const idx = arr.findIndex(e=>e.core===coreParam);
      if(idx<0) return;
      arr[idx].ui = captureCardUiState();
      sessionStorage.setItem(SS_KEY, JSON.stringify(arr));
    }catch(e){}
  }
  function applyCardUiState(ui){
    if(!ui) return;
    ui.forEach((st, i)=>{
      if(!st) return;
      const card = document.querySelector(`.sug[data-sug="${i}"]`);
      if(!card) return;
      if(st.collapsed !== card.classList.contains('collapsed')){
        const hd = card.querySelector('.sug-toggle');
        if(hd) toggleSug(hd);
      }
      if(st.j){
        const montab = card.querySelector(`.montab[data-j="${st.j}"]`);
        if(montab && !montab.classList.contains('active')) montab.click();
      }
      if(st.tab && st.tab!=='mu'){
        const tb = card.querySelector(`.tb[data-t="${st.tab}"]`);
        if(tb && !tb.classList.contains('active')) tb.click();
      }
    });
  }
  /** 軸2件以上（cache miss）はCloud Runの実CPU課金が発生するため、その計算待ちに出すAdSenseの広告枠。
   * 枠が非表示のまま広告を読み込むと幅0で失敗するので、表示に切り替えて幅が確定してから読み込む。 */
  let _adLoaded = false;
  function _ensureAdLoaded(tries){
    if (_adLoaded) return;
    const slot = document.getElementById('ps-ad-slot');
    if (!slot) return;
    if (!slot.offsetWidth) {
      if ((tries || 0) < 20) requestAnimationFrame(() => _ensureAdLoaded((tries || 0) + 1));
      return;
    }
    const ins = document.createElement('ins');
    ins.className = 'adsbygoogle ps-ad-unit';
    ins.style.cssText = 'display:inline-block;width:300px;height:250px';
    // IDはHTMLに出る公開値。is:inlineスクリプトからはフロントマターの定数を参照できないため直書きする
    ins.setAttribute('data-ad-client', 'ca-pub-6144860227440327');
    ins.setAttribute('data-ad-slot', '8319443257');
    slot.appendChild(ins);
    try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) { return; }
    _adLoaded = true;
    // 在庫が無いとAdSenseが枠を高さ0に畳むため、「広告」のラベルだけが残らないようブロックごと隠す
    setTimeout(() => {
      if (ins.dataset.adStatus === 'unfilled') {
        const el = document.getElementById('ps-ad-inline');
        if (el) el.style.display = 'none';
      }
    }, 3000);
  }
  function showInlineAd(){
    const el = document.getElementById('ps-ad-inline');
    if (!el) return;
    el.style.display = '';
    _ensureAdLoaded(0);
  }
  let _suggestAbort = null;
  let _suggestSeq = 0;
  /** (S07/S11) 失敗表示は#outだけに出す(#statusとの重複表示をやめる)。retryFnがあれば再試行ボタンを添える。
   * msgHtmlは呼び出し側で既にesc済みの表示用文字列を渡すこと。 */
  function renderRunError(msgHtml, retryFn){
    const out = document.getElementById('out');
    out.innerHTML = `<div class="ps-err">${msgHtml}`
      + (retryFn ? `<button type="button" class="pb-btn-sub" id="ps-retry-btn">${esc(I18N.retryBtn)}</button>` : '')
      + `</div>`;
    const btn = retryFn && document.getElementById('ps-retry-btn');
    if(btn) btn.addEventListener('click', retryFn);
  }
  async function run(){
    const core = CORE.map(p=>({sp:p.sp, mega:p.mega}));
    const coreParam = currentCoreParam();
    const go = document.getElementById('go'); go.disabled = true; go.classList.add('loading');
    const out = document.getElementById('out');
    const status = document.getElementById('status');
    status.textContent = '';
    // (S05) 軸を変えて再度「提案する」を押された場合は直前のリクエストを中断する。
    // 連番(mySeq)はAbortの取りこぼし(古いfetchが中断前に解決する等)に備えた保険。
    if(_suggestAbort) _suggestAbort.abort();
    const abortCtrl = new AbortController();
    _suggestAbort = abortCtrl;
    const mySeq = ++_suggestSeq;
    // (B5) 軸2件以上は必ずライブ計算(10〜20秒)。軸1件以下はsuggest_cacheに事前計算済みで数百msなので
    // 「10〜20秒」の表示は出さず、実態に合わせた短い表示にする。
    const isLive = core.length >= 2;
    const msgs = I18N.loadMsgs;
    let mi = 0, sec = 0, timer = null;
    if(isLive){
      out.innerHTML = `<div class="ps-loading" id="ps-loading"><div class="ps-spinner"></div>`
        + `<div class="ps-lmsg" id="ps-lmsg">${msgs[0]}</div><div class="ps-lsub">${I18N.loadSub}</div>`
        + `<div class="ps-elapsed" id="ps-elapsed">${I18N.elapsedSec(0)}</div>`
        + `<div class="ps-urgent-note" id="ps-urgent-note">${esc(I18N.urgentNote)}</div>`
        + `<button type="button" class="pb-btn-sub ps-cancel-btn" id="ps-cancel-btn">${esc(I18N.cancelBtn)}</button></div>`;
      const cancelBtn = document.getElementById('ps-cancel-btn');
      if(cancelBtn) cancelBtn.addEventListener('click', () => abortCtrl.abort());
      timer = setInterval(()=>{
        sec++;
        const es = document.getElementById('ps-elapsed'); if(es) es.textContent = I18N.elapsedSec(sec);
        const lmsgEl = document.getElementById('ps-lmsg');
        // (S08) 20秒を超えたら「混み合っています」に固定し、以降のメッセージ切り替えは止める
        if(sec >= 20){ if(lmsgEl) lmsgEl.textContent = I18N.congestedMsg; }
        else if(sec % 3 === 0){ mi = (mi+1)%msgs.length; if(lmsgEl) lmsgEl.textContent = msgs[mi]; }
        // (S08) 45秒経過でキャンセルを強調表示する
        if(sec === 45){ const el = document.getElementById('ps-loading'); if(el) el.classList.add('ps-urgent'); }
      }, 1000);
    } else {
      out.innerHTML = `<div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">${I18N.calculating}</div></div>`;
    }
    if(isLive){
      showInlineAd();
      // モバイルではボタン位置のままだと広告が画面外になるため、広告+計算中表示を視界に入れる
      document.getElementById('ps-ad-inline').scrollIntoView({block:'start'});
    }
    try{
      const r = await fetch(API + '/suggest', {method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({core, ncand:100, top:5}), signal: abortCtrl.signal});
      if(mySeq !== _suggestSeq) return; // より新しいリクエストに追い越された
      // (S22) MIN_INTERVAL/同時実行上限は429で返る。本文はJSON({error})想定だが、パース失敗時も
      // 汎用文言でフォールバックできるよう、ステータスコードを先に見る。
      if(r.status === 429){
        let msg = I18N.tooManyMsg;
        try{ const d = await r.json(); if(d && d.error) msg = d.error; }catch(e){}
        renderRunError(esc(msg), run);
        return;
      }
      const d = await r.json();
      if(mySeq !== _suggestSeq) return;
      if(d.error){
        renderRunError(I18N.errPrefix + esc(d.error), run); // (S07/S11)
        return;
      }
      saveSessionResult(coreParam, d);
      // (B6) ?core=軸1,軸2 をURLに反映し、リロード/共有で自動復元できるようにする
      const url = new URL(location.href);
      if(coreParam) url.searchParams.set('core', coreParam); else url.searchParams.delete('core');
      history.replaceState(null, '', url.pathname + url.search);
      renderResults(d);
    }catch(e){
      if(mySeq !== _suggestSeq) return;
      if(e && e.name === 'AbortError'){
        // (S06) キャンセル: エラー表示はせず初期状態(空の#out)に戻す
        out.innerHTML = '';
        return;
      }
      renderRunError(esc(I18N.connErr), run); // (S07/S11)
    } finally {
      // timerはこの呼び出し専用(runのローカル変数)なので、他の呼び出しに追い越されていても
      // 必ず止める。止め忘れると、古いintervalが同じidの#ps-elapsed等を殴り続けて
      // 新しい呼び出しの経過秒表示が裏から壊れる。
      if(timer) clearInterval(timer);
      // ボタンの活性化はまだ自分が最新のときだけ(追い越されていたら次のrunがfinallyで戻す)。
      if(mySeq === _suggestSeq){
        go.disabled = false; go.classList.remove('loading');
      }
    }
  }
  document.getElementById('go').addEventListener('click', run);
  /** en/ko版には軸ごとの静的プリセットページ(/party-suggest/{slug}/)が存在しないため、
   * ポケモン情報ページのCTAは代わりに ?core=軸ポケモン和名(複数はカンマ区切り) を付けてこの汎用ページへ
   * 誘導する。ja版は静的プリセットページ側のpreCoreLabelプロパティを優先する。
   * sessionStorageに軸が完全一致する結果があればAPIを叩き直さず即復元する。
   * (C9) /species取得待ちのポーリングには上限を設け、失敗時に無限ループしないようにする。 */
  const _preCore = preCoreLabel || new URLSearchParams(location.search).get('core');
  if (_preCore) {
    const _cached = loadSessionResult(_preCore);
    if (_cached) {
      renderResults(_cached);
      applyCardUiState(loadSessionUi(_preCore)); // (S14) タブ・展開・選択ポケの状態も合わせて復元
      // チップ表示は非同期にSPECIES待ちで反映(結果表示はブロックしない)
      applyPreCoreChips(_preCore);
    } else {
      let _tries = 0;
      const _waitForSpecies = setInterval(() => {
        _tries++;
        if (!SPECIES.length) {
          if (_tries >= 50) { clearInterval(_waitForSpecies); document.getElementById('status').textContent = I18N.connErr; }
          return;
        }
        clearInterval(_waitForSpecies);
        applyPreCoreChipsNow(_preCore);
        if (CORE.length) run();
      }, 100);
    }
  }
  // SPECIES取得済み前提の同期版。「チップ追加→CORE.length判定→run()」を同一tickで行うため
  // 非同期版を挟むとCOREが空のままrun()判定が走り自動実行されない
  function applyPreCoreChipsNow(param){
    param.split(',').map(s => s.trim()).filter(Boolean).forEach(label => {
      const v = SPECIES.find(s => s.label === label);
      if (v && !CORE.some(p => p.id === v.id)) CORE.push(v);
    });
    renderCoreChips();
  }
  function applyPreCoreChips(param){
    let tries = 0;
    const t = setInterval(() => {
      tries++;
      if (!SPECIES.length) { if (tries >= 50) clearInterval(t); return; }
      clearInterval(t);
      applyPreCoreChipsNow(param);
    }, 100);
  }
</script>

<script>
  // このページのメインスクリプトは define:vars のため is:inline で、import できない。
  // 共有レンダラだけモジュール側で読み込んで window 経由で渡す。
  import { openMuDialog } from '../scripts/party-builder/mu-cell-popup';
  import '../styles/matchup-table.css';
  import '../styles/mu-card.css';
  window.__openMuDialog = openMuDialog;
  import { guideBody } from '../scripts/party-builder/diag-shared';
  import '../styles/select-guide.css';
  window.__guideBody = (g, legend) => guideBody(g, { lang: window.__PS_LANG__, ico: window.__PS_ICO__, tPoke: window.__PS_TPOKE__, esc: window.__PS_ESC__, legend });
  // (C03) 横スクロールヒント(.mg-wrap)は工房(PartyBuilderApp.astro)と共有する実装に切り出した。
  import { mgWrapHtml, initMgHints } from '../scripts/party-builder/mg-hints';
  window.__mgWrapHtml = mgWrapHtml;
  window.__mgHints = initMgHints;
  // (C15) GA4計測ヘルパも同じ理由でwindow経由に橋渡しする。
  import { track } from '../scripts/track';
  window.track = track;
</script>
