    return store.parties.find((p) => p.id === store.activeId) || null;
  }
  /** アクティブパーティ切替(新規/複製/削除/選択変更/インポート)時に選択枠・提案系の一時状態を破棄する。
   * H1: 提案結果を持ち越すと、切替後の別パーティの空き枠を古いインデックスで上書きしうるため
   * 必ずここでクリアする(採用ボタン自体もH1で現在の空き枠を再計算する方式に修正済み)。 */
  function resetPartyUiState() {
    selectedIdx = null;
    fillLoading = false;
    fillFailed = false;
    fillRaw = null;
    fillView = null;
    tuneResults = null;
    activeMuTab = null;
    muEdit = null;
    renamingParty = false;
    holeFillResult = null;
    holeFillLoading = false;
    clearPendingUndo();
    clearUiState(); // (B20) パーティ切替後は旧パーティの枠インデックスを引きずらないよう保存済みUI状態も捨てる
  }

  // ---- (B20/B21) 選択枠・タブ・スクロール位置の保存/復元 ----
  // Storeのlocalstorage(pn-builder-v1)とは別キーにし、バージョニングに影響しないようにする。
  const UI_SS_KEY = 'pn-builder-ui';
  function saveUiState() {
    try {
      sessionStorage.setItem(UI_SS_KEY, JSON.stringify({ selectedIdx, balanceTab, activeMuTab, selTab, scrollY: window.scrollY }));
    } catch (e) { /* noop */ }
  }
  function loadUiState() {
    try {
      const raw = sessionStorage.getItem(UI_SS_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch (e) { return null; }
  }
  function clearUiState() {
    try { sessionStorage.removeItem(UI_SS_KEY); } catch (e) { /* noop */ }
  }
  /** (B21) 簡単構築の?core=反映(history.replaceState)と同じ流儀で、選択枠とパーティ全体の
   * バランスタブをURLに反映する。共有・リロード復元・戻る/進むボタンでの参照に使う。 */
  function syncUrlFromState() {
    const p = activeParty();
    const url = new URL(location.href);
    if (p) url.searchParams.set('party', p.id); else url.searchParams.delete('party');
    if (selectedIdx !== null) url.searchParams.set('slot', String(selectedIdx)); else url.searchParams.delete('slot');
    url.searchParams.set('tab', balanceTab);
    history.replaceState(null, '', url.pathname + url.search + url.hash);
  }
  function persistUi() {
    saveUiState();
    syncUrlFromState();
  }
  function resolveSlotSafe(slot) {
    if (!slot || !core) return null;
    try { return resolveSlot(slot, core.species, core.moves); } catch (e) { return null; }
  }
  function resolvedPartyList() {
    const p = activeParty();
    if (!p || !core) return [];
    const out = [];
    for (const slot of p.slots) {
      const rb = resolveSlotSafe(slot);
      // 仮想敵ごとの前提は枠に保存されている。相性表・タブで「前提つきなら勝てる」を
      // 出すために、解決済みの型に添えて持ち回る（判定そのものには使わない）。
      if (rb) { rb.sc = slot.scenarios || null; out.push(rb); }
    }
    return out;
  }
  function moveType(name) {
    if (!core || !name) return null;
    const m = core.moves[name];
    return m ? m[0] : null;
  }
  function typeIcoForMove(name) { return typeIcoByName(moveType(name)); }
  /**
   * マトリクスの相手列。相手1ラベルにつき想定型(≤3、targets.jsonのbuilds全部)を全てresolveTargetする。
   * scripts/_explain.py matchup_grid() と同じく「代表型1固定」ではなく複数型を集約評価するための材料。
   * ポケモン相性タブ・穴判定(findHoles)はこのbuilds配列をjudgeVsBuildsに渡して集約する。
   * 素早さタブは従来どおり代表型1体(builds[0])のみを見るため、そちらはこの配列の先頭要素を使う。
   */
  /** buildOppCols()の計算結果キャッシュ。customTargets変更時(saveMuEdit/deleteMuBuild/resetMuDefault)にのみ
   * invalidateOppColsCache()で無効化する(M3: EVスライダー連打時にrenderBalance毎回の再計算を避ける)。 */
  let oppColsCache = null;
  function invalidateOppColsCache() { oppColsCache = null; }
  function buildOppCols() {
    if (!core) return [];
    ensureNameUrlMapLoaded();
    if (oppColsCache) return oppColsCache;
    oppColsCache = effectiveTargets()
      .map((g) => ({
        icon: g.icon,
        label: g.label,
        sp: g.sp, // (1) 紹介ページリンク解決用(labelはメガ名の場合があるため、base種名のspで引く)
        builds: (g.builds || [])
          .map((b) => resolveTargetSafe(g.sp, g.label, g.icon, b, core.moves))
          .filter((b) => b !== null),
      }))
      .filter((g) => g.builds.length);
    return oppColsCache;
  }
  /** (B25) findHolesはparty×oppCols全組に対しjudgeVsBuildsを回す(1v1マトリクスと同じ重さ)ため、
   * renderBalance→matchupMatrixHtmlのように同じフレームで同じparty/oppColsに対して2回呼ぶと
   * 無駄になる。oppColsCacheと同じ流儀で、直近1件だけをholeFillSignature()と同じ署名文字列で
   * キャッシュする(署名生成は軽いので、findHoles本体より十分安い)。 */
  let findHolesCache = null;
  function findHolesMemo(resolvedParty, oppCols) {
    const key = holeFillSignature(resolvedParty, oppCols);
    if (findHolesCache && findHolesCache.key === key) return findHolesCache.result;
    const result = findHoles(resolvedParty, oppCols);
    findHolesCache = { key, result };
    return result;
  }

  // ---- (1) ポケモン相性・素早さタブの相手ヘッダのリンク化 ----
  /** search-index.json のロードは相性/素早さタブが初めて描画される(=buildOppCols初回呼び出し)時でよい。
   * 完了後、その時点で相性/素早さタブを表示中ならリンクを反映するため再描画する。 */
  let nameUrlMapLoadStarted = false;
  function ensureNameUrlMapLoaded() {
    if (nameUrlMapLoadStarted) return;
    nameUrlMapLoadStarted = true;
    loadNameUrlMap().then(() => {
      if (balanceTab === 'mu' || balanceTab === 'speed') {
        const pane = document.getElementById('pb-balance-pane');
        if (!pane) return;
        pane.innerHTML = balancePaneHtml(resolvedPartyList(), balanceTab);
        bindMtxPopovers(pane);
        bindMatchupHolesToggle(pane, resolvedPartyList());
        bindHoleFillButton(pane);
        initMgHints();
      }
    }).catch((e) => console.warn('[ensureNameUrlMapLoaded] search-index.jsonの取得に失敗しました', e));
  }
  /** sp(種の和名)から紹介ページURLを引く。ページが存在しない種・未ロード時はnull。 */
  function oppPageUrl(sp) {
    if (!sp) return null;
    const map = nameUrlMapSync();
    if (!map) return null;
    const e = map.get(sp);
    if (!e) return null;
    return lang === 'en' ? e.ue : lang === 'ko' ? e.uk : e.u;
  }
  /** 相手列ヘッダ(スプライト+名前)。紹介ページがあればaでリンク化し、無ければ従来通りの非リンク表示。
   * ポケモン相性・素早さタブで共有する(セルのポップオーバーとは別要素のため誤爆しない)。 */
  function oppHeaderCellHtml(o, extraCls) {
    const inner = `${icoImg(o.icon, o.label, 'mtx-ico')}<div class="mtx-name">${esc(tPoke(o.label))}</div>`;
    const url = oppPageUrl(o.sp);
    const body = url ? `<a class="mtx-opp-link" href="${esc(url)}">${inner}</a>` : inner;
    return `<th class="${extraCls || ''}">${body}</th>`;
  }

  /** targets.json由来の仮想敵一覧を、store.customTargets(仮想敵の型のユーザー編集)で差し替えた「効果的builds」で返す。
   * マトリクス・穴判定・仮想敵パネルはすべてこれ経由で仮想敵を参照する(core.targetsを直接見ない)。 */
  function effectiveTargets() {
    if (!core || !store) return [];
    return getEffectiveTargets(store, core.targets);
  }

  const MU_SYM_RANK = { '◎': 4, '○': 3, '△': 2, '▲': 1, '×': 0 };
  /** grpの全型(≤3)についてjudge1v1(rb, opp)を回し、最も悪い(判定ランクが最低の)symを返す。
   * 仮想敵タブの警告バッジ(muTabBadge)とミニバー折りたたみ表示(B10)が共通して使う「最悪判定」ロジック。
   * 選択枠の仮想敵のみが対象で型数も≤3のため、描画のたびに回しても軽量。 */
  function worstMuSym(rb, grp, sc) {
    if (!rb || !grp || !grp.builds.length || !core) return null;
    const worstOf = () => {
      let worst = null, worstRank = 99;
      for (const b of grp.builds) {
        const opp = resolveTargetSafe(grp.sp, grp.label, grp.icon, b, core.moves);
        if (!opp) continue;
        const r = MU_SYM_RANK[judge1v1(rb, opp).sym];
        if (r < worstRank) { worstRank = r; worst = judge1v1(rb, opp).sym; }
      }
      return worst;
    };
    const base = worstOf();
    if (base == null) return null;
    // 前提つきなら勝てる対面は、素の記号を残したまま印だけ足す。
    let cond = null;
    if (sc && !scenarioIsDefault(sc)) {
      applyScenario(sc);
      try {
        const w = worstOf();
        if (w !== base) cond = { sym: w, text: scenarioText(sc, (rb.moves || []).map((m) => m.n)) };
      } finally { setScenario(null); }
    }
    return { sym: base, cond };
  }
  /** (7) 仮想敵タブ用の最悪判定バッジ。×/▲のときだけ表示する(◎/○/△は警告不要のため非表示)。 */
  function muTabBadge(rb, grp, sc) {
    const w = worstMuSym(rb, grp, sc);
    if (!w || (w.sym !== '×' && w.sym !== '▲')) return null;
    return w;
  }

  /** label(仮想敵ラベル)に対応する種のmon jsonをloadMonで取得する。sp→species.icon経由(メガ型ラベルのicon誤用を避ける)。 */
  async function loadMonForTargetLabel(label) {
    const grp = effectiveTargets().find((g) => g.label === label);
    if (!grp) throw new Error(`target group not found: ${label}`);
    const sm = core.species.find((s) => s.n === grp.sp);
    if (!sm) throw new Error(`species not found for target: ${grp.sp}`);
    return loadMon(sm.icon);
  }

  /** customTargets未編集のラベルを初回編集時にtargets.jsonのデフォルトでmaterializeする。 */
  function materializeCustomTarget(label) {
    if (!store.customTargets) store.customTargets = {};
    if (!store.customTargets[label] || !store.customTargets[label].length) {
      const grp = core.targets.find((g) => g.label === label);
      store.customTargets[label] = grp ? JSON.parse(JSON.stringify(grp.builds)) : [];
    }
  }

  function targetBuildSpec(sp, b) {
    return `${sp}@${b.item || ''}:${b.nature || ''}:${(b.moves || []).filter(Boolean).join('|')}:${b.ev.join('/')}:${b.ability || ''}`;
  }

  // =========================================================
  // 描画
  // =========================================================
  /** M3: EVスライダー連打時にrenderBalance()(マトリクス再計算)をtrailingデバウンスするためのタイマー。
   * scheduleRenderBalance()で予約し、renderBalance()を直接呼ぶ経路(render()等)では即時実行に統一する
   * ため、その際は保留中の予約をキャンセルする(二重計算防止)。 */
  let balanceDebounceTimer = null;
  function cancelScheduledRenderBalance() {
    if (balanceDebounceTimer) { clearTimeout(balanceDebounceTimer); balanceDebounceTimer = null; }
  }
  function scheduleRenderBalance() {
    cancelScheduledRenderBalance();
    balanceDebounceTimer = setTimeout(() => {
      balanceDebounceTimer = null;
      renderBalance();
    }, 80);
  }
  /** (B12) EVスライダー/ステッパー連打時にrenderTargetsPanel()(仮想敵パネル+ミニバー再生成)をtrailing
   * デバウンスするためのタイマー。実数値表示自体はapplyEvChange側で即時更新済みのため、ここを80ms遅らせても
   * 数値の反映は遅延しない。scheduleRenderBalanceと同じ方式。 */
  let targetsDebounceTimer = null;
  function cancelScheduledRenderTargets() {
    if (targetsDebounceTimer) { clearTimeout(targetsDebounceTimer); targetsDebounceTimer = null; }
  }
  function scheduleRenderTargets() {
    cancelScheduledRenderTargets();
    targetsDebounceTimer = setTimeout(() => {
      targetsDebounceTimer = null;
      renderTargetsPanel();
    }, 80);
  }
  function render() {
    cancelScheduledRenderBalance();
    cancelScheduledRenderTargets();
    renderPartyBar();
    renderValidate();
    renderTray();
    updateFillBtnVisibility();
    renderSlotSearch();
    renderSelectedHead();
    renderEditor();
    renderTargetsPanel();
    renderBalance();
  }

  /** (B01) 枠タップ後、≤1023pxでは「選択中のポケモン」セクションが画面外(トレイの下)にあることが
   * 多いため、そこまでスクロールする。PCは2カラムがそのままトレイの下に見えているため不要。 */
  function scrollToSelectedSection() {
    if (mqDesktopSplit.matches) return;
    const sec = document.querySelector('.pb-selected');
    if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /** (B15) 「選択中のポケモン」セクションの見出し(枠番号+ポケモン名)と2タブ(型エディタ/仮想敵)。
   * #pb-editor/#pb-targets自体のHTML生成(renderEditor/renderTargetsPanel)には手を入れず、
   * .pb-selectedのdata-tab属性をCSSで見て≤1023pxのときだけ表示切替する(≥1024pxはこの見出しごと
   * 非表示にして、常に両カードdisplay:blockの.pb-splitグリッドのまま=デスクトップの見た目は不変)。
   * 未選択時はdata-tabを外し、両カードとも従来通りのプレースホルダーを縦積みで見せる。 */
  function renderSelectedHead() {
    const sec = document.querySelector('.pb-selected');
    const el = document.getElementById('pb-selected-head');
    const p = activeParty();
    const slot = p && selectedIdx !== null ? p.slots[selectedIdx] : null;
    if (!p || selectedIdx === null || !slot) {
      if (sec) sec.removeAttribute('data-tab');
      if (el) el.innerHTML = '';
      persistUi(); // (B20/B21)
      return;
    }
    if (sec) sec.dataset.tab = selTab;
    if (!el) return;
    const rb = resolveSlotSafe(slot);
    const targetsCount = slot.targets.length;
    const tabBtn = (key, title, sub, badge) => `<button type="button" class="pb-sel-tab${selTab === key ? ' active' : ''}" data-sel-tab="${key}" role="tab" aria-selected="${selTab === key}">
          <span class="pb-sel-tab-main">${esc(title)}${badge}</span><span class="pb-sel-tab-sub">${esc(sub)}</span></button>`;
    el.innerHTML = `
      <div class="pb-selected-title">${icoImg(rb ? rb.icon : null, rb ? rb.label : slot.sp, 'monicon')}<span>${esc(I18N.slotHeading(selectedIdx + 1))}</span></div>
      <div class="pb-selected-tabs" role="tablist">
        ${tabBtn('editor', I18N.editorTitle, I18N.selTabEditorSub, '')}
        ${tabBtn('targets', I18N.targetsHeading, I18N.selTabTargetsSub, targetsCount ? `<span class="pb-sel-count">${targetsCount}</span>` : '')}
      </div>`;
    el.querySelectorAll('[data-sel-tab]').forEach((btn) => btn.addEventListener('click', () => {
      if (btn.dataset.selTab === selTab) return;
      selTab = btn.dataset.selTab;
      renderSelectedHead();
      // ミニバーの表示条件にselTabが絡むため、直前の描画内容で出し直す(二重表示/消し忘れ防止)。
      if (lastMiniBarArgs) renderMiniBar(lastMiniBarArgs.activeGrp, lastMiniBarArgs.allTabs, lastMiniBarArgs.sheetCtx);
    }));
    persistUi(); // (B20/B21)
  }

  // ---- (1) モバイル固定判定ミニバー / ボトムシート ----
  /** 選択中枠が仮想敵ありのとき、画面下部に固定表示する。collapsed(既定)は「選択中の枠が持つ全仮想敵」
   * の最悪判定を1体1チップで横スクロール表示する(worstMuSym()をmuTabBadgeと共有・確定数計算は書き直さない)。
   * チップタップはactiveMuTabの切替+#pb-targetsへのスクロール、チップ以外の場所のタップでボトムシート
   * (既定50vh・ドラッグハンドルで最大85vh)に展開する。展開後は仮想敵パネル(renderTargetsPanel)の型カード
   * (chips/cardsBlockHtml/addResetRow)とそのイベント紐付け(bindMuSection)をsheetCtx経由でそのまま
   * 再利用する(二重実装を避けるため、シート専用のHTML生成/イベント処理は持たない)。
   * activeGrp/allTabs/sheetCtxはrenderTargetsPanel()が算出済みのものをそのまま渡す(二重計算しない)。
   * (B13) #pb-targetsが画面内に見えている間は二重表示になるため折りたたみ表示を出さない(targetsPanelVisible)。 */
  function hideMiniBar() {
    const el = document.getElementById('pb-minibar');
    if (el) { el.classList.remove('pb-minibar-show', 'pb-sheet-expanded'); el.innerHTML = ''; }
    lastMiniBarHtml = null;
    document.body.classList.remove('pb-minibar-active', 'pb-sheet-open');
    sheetExpanded = false;
  }
  function renderMiniBar(activeGrp, allTabs, sheetCtx) {
    const el = document.getElementById('pb-minibar');
    const reopenEl = document.getElementById('pb-minibar-reopen');
    if (!el) return;
    lastMiniBarArgs = { activeGrp, allTabs, sheetCtx };
    const hasContent = !!activeGrp && !!allTabs && allTabs.length > 0;
    if (!hasContent) { hideMiniBar(); if (reopenEl) reopenEl.classList.remove('pb-minibar-reopen-show'); return; }
    // (B15) 仮想敵タブを見ている間は#pb-targets本体と内容が重複するため、ミニバーは型エディタタブのときだけ出す。
    if (selTab !== 'editor') { sheetExpanded = false; hideMiniBar(); return; }
    if (miniBarMinimized) { hideMiniBar(); if (reopenEl) reopenEl.classList.add('pb-minibar-reopen-show'); return; }
    if (reopenEl) reopenEl.classList.remove('pb-minibar-reopen-show');
    // 展開中のシートは操作対象なので、#pb-targetsが見えてきても閉じない(折りたたみ表示だけが対象)。
    if (targetsPanelVisible && !sheetExpanded) { hideMiniBar(); return; }

    el.classList.add('pb-minibar-show');
    el.classList.toggle('pb-sheet-expanded', sheetExpanded);
    document.body.classList.add('pb-minibar-active');
    document.body.classList.toggle('pb-sheet-open', sheetExpanded);

    const collapse = () => { sheetExpanded = false; renderMiniBar(activeGrp, allTabs, sheetCtx); };
    const expand = () => {
      sheetExpanded = true;
      document.documentElement.style.setProperty('--pb-sheet-h', '50vh'); // (B34) 展開のたびに既定50vhへ戻す
      renderMiniBar(activeGrp, allTabs, sheetCtx);
    };

    let html;
    if (!sheetExpanded) {
      const items = allTabs.map((t) => {
        const act = t.label === activeMuTab ? ' act' : '';
        const symHtml = t.sym ? `<span class="pb-minibar-sym ${symCls(t.sym)}">${t.sym}</span>` : '';
        return `<button type="button" class="pb-minibar-item${act}" data-mb-tab="${esc(t.label)}">${icoImg(t.icon, t.label, 'pb-minibar-ico')}<span class="pb-minibar-name">${esc(tPoke(t.label))}</span>${symHtml}</button>`;
      }).join('');
      html = `<div class="pb-minibar-inner" id="pb-minibar-tap" role="button" tabindex="0" aria-expanded="false" aria-label="${esc(I18N.miniBarExpandAria)}">
          <div class="pb-minibar-scroll">${items}</div>
          <span class="pb-minibar-caret">${esc(I18N.sheetExpandCaret)}</span>
          <button type="button" class="pb-minibar-x" id="pb-minibar-x" aria-label="${esc(I18N.miniBarMinimizeAria)}">✕</button>
        </div>`;
    } else {
      html = `
        <div class="pb-sheet-handle" id="pb-sheet-handle" aria-hidden="true"><span></span></div>
        <div class="pb-minibar-head">
          <span class="pb-minibar-title">${icoImg(activeGrp.icon, activeGrp.label, 'pb-minibar-ico')}${esc(tPoke(activeGrp.label))}</span>
          <button type="button" class="pb-btn-sub" id="pb-sheet-collapse" aria-expanded="true">${esc(I18N.sheetCollapseBtn)}</button>
        </div>
        <div class="pb-sheet-body" id="pb-sheet-body">
          <div class="filter-chips">${sheetCtx.chips}</div>
          ${sheetCtx.scenarioHtml}
          ${sheetCtx.cardsBlockHtml}
          ${sheetCtx.addResetRow}
        </div>`;
    }

    // (B12) 直前と同じ内容ならinnerHTMLに触れない(EV連打のたびにシートのscrollTop/select開閉状態が
    // リセットされるのを防ぐ)。内容が変わる場合のみ、シートのscrollTopを保存して復元する。
    if (html === lastMiniBarHtml) return;
    const prevScrollTop = sheetExpanded ? document.getElementById('pb-sheet-body')?.scrollTop : null;
    lastMiniBarHtml = html;
    el.innerHTML = html;

    if (!sheetExpanded) {
      const tapEl = document.getElementById('pb-minibar-tap');
      tapEl.addEventListener('click', (e) => {
        if (e.target.closest('#pb-minibar-x')) return;
        const chip = e.target.closest('[data-mb-tab]');
        if (chip) { onMiniBarTabPick(chip.dataset.mbTab); return; }
        expand();
      });
      tapEl.addEventListener('keydown', (e) => {
        if (e.target.closest('#pb-minibar-x') || e.target.closest('[data-mb-tab]')) return;
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); expand(); }
      });
      document.getElementById('pb-minibar-x').addEventListener('click', (e) => {
        e.stopPropagation();
        miniBarMinimized = true;
        renderMiniBar(activeGrp, allTabs, sheetCtx);
      });
      return;
    }

    document.getElementById('pb-sheet-collapse').addEventListener('click', collapse);
    const sheetBodyEl = document.getElementById('pb-sheet-body');
    if (sheetBodyEl) {
      sheetCtx.bindMuSection(sheetBodyEl);
      if (prevScrollTop != null) sheetBodyEl.scrollTop = prevScrollTop;
    }
    const handleEl = document.getElementById('pb-sheet-handle');
    if (handleEl) bindSheetDrag(handleEl);
  }
  /** ミニバー折りたたみ表示のチップタップ。activeMuTabを切り替え、(B15)仮想敵タブへ切替えて表示する。
   * selTabを'targets'にするとミニバー自体は次の描画でCSS/JS両方の条件から消える(型エディタ専用のため)。 */
  function onMiniBarTabPick(label) {
    activeMuTab = label;
    muEdit = null;
    selTab = 'targets';
    renderSelectedHead();
    renderTargetsPanel();
    scrollToSelectedSection();
  }
  /** (B34) ボトムシートの高さをドラッグハンドルで調整する。既定50vh・上限85vh・下限30vh(誤操作で
   * シートが消えてしまわない程度)。--pb-sheet-hはdocumentElementに持たせ、CSS側のheight/paddingが参照する。 */
  function bindSheetDrag(handleEl) {
    let dragging = false, startY = 0, startVh = 50;
    const currentVh = () => parseFloat(document.documentElement.style.getPropertyValue('--pb-sheet-h')) || 50;
    const onPointerMove = (e) => {
      if (!dragging) return;
      const deltaVh = ((startY - e.clientY) / window.innerHeight) * 100;
      const next = Math.max(30, Math.min(85, startVh + deltaVh));
      document.documentElement.style.setProperty('--pb-sheet-h', `${next}vh`);
    };
    const onPointerUp = (e) => { dragging = false; try { handleEl.releasePointerCapture(e.pointerId); } catch (err) { /* noop */ } };
    handleEl.addEventListener('pointerdown', (e) => {
      dragging = true; startY = e.clientY; startVh = currentVh();
      try { handleEl.setPointerCapture(e.pointerId); } catch (err) { /* noop */ }
    });
    handleEl.addEventListener('pointermove', onPointerMove);
    handleEl.addEventListener('pointerup', onPointerUp);
    handleEl.addEventListener('pointercancel', onPointerUp);
  }

  /** 空き枠がない(6匹満員)時は「空き枠を提案で埋める」ボタンを非表示にする。空きができたら再表示。 */
  function updateFillBtnVisibility() {
    const btn = document.getElementById('pb-fill-btn');
    if (!btn) return;
    const p = activeParty();
    const hasEmpty = !!p && p.slots.some((s) => !s);
    btn.style.display = hasEmpty ? '' : 'none';
    if (!hasEmpty && (fillRaw || fillFailed)) {
      fillRaw = null;
      fillView = null;
      fillFailed = false;
    }
  }

