  const I18N = I18N_ALL[lang];
  /** メガ進化名(「メガガブリアス」等)は辞書に個別登録せず、素体名+メガ接頭辞から動的に組み立てる
   * (公式訳が存在しないポケモンチャンピオンズ独自メガ進化が大半のため)。 */
  function tPoke(n) {
    if (!n) return n;
    const map = window.__PB_POKEMON_MAP__;
    if (map[n]) return map[n];
    if (n.startsWith('メガ')) {
      const rest = n.slice(2);
      let base = map[rest], suf = '';
      if (!base && (rest.endsWith('X') || rest.endsWith('Y'))) { suf = rest.slice(-1); base = map[rest.slice(0, -1)]; }
      if (base) return lang === 'ko' ? `메가${base}${suf}` : `Mega ${base}${suf ? ` ${suf}` : ''}`;
    }
    return n;
  }
  const tMove = (n) => (n && window.__PB_MOVE_MAP__[n]) || n;
  const tAbil = (n) => (n && window.__PB_ABIL_MAP__[n]) || n;
  const tNature = (n) => (n && window.__PB_NATURE_MAP__[n]) || n;
  const tType = (n) => (n && window.__PB_TYPE_MAP__[n]) || n;
  /** メガストーン(「〜ナイト」)は辞書に個別登録せず、素体名+ナイト接尾辞から動的に組み立てる
   * (ポケモン名同様、独自メガ進化が大半で公式訳が存在しないため)。 */
  function tItem(n) {
    if (!n) return n;
    const map = window.__PB_ITEM_MAP__;
    if (map[n]) return map[n];
    if (n.endsWith('ナイト')) {
      const base = window.__PB_POKEMON_MAP__[n.slice(0, -3)];
      if (base) return lang === 'ko' ? `${base}나이트` : `${base}ite`;
    }
    return n;
  }
  /** natureDisp(stats.ts)は「せっかち (S↑B↓)」のように和名を埋め込んで返すため、
   * 和名部分だけをtNature()で置き換えて表示用に翻訳する(stats.ts自体は変更しない)。 */
  function tNatureDisp(na) {
    if (!na) return '';
    const raw = natureDisp(na);
    return raw.startsWith(na) ? tNature(na) + raw.slice(na.length) : tNature(na);
  }

  const EVK = ['H', 'A', 'B', 'C', 'D', 'S'];
  // PartySuggestApp.astro の ITEM_PNG と同一(仮想敵カードの持ち物表示体裁を揃えるための小規模な固定表)。
  const ITEM_PNG = {
    きあいのタスキ: 'item-0275-tasuki.png', こだわりスカーフ: 'item-0287-scarf.png', オボンのみ: 'item-0158-obon.png',
    ラムのみ: 'item-0157-ram.png', ヤチェのみ: 'item-0188-yache.png', ハバンのみ: 'item-0197-haban.png',
  };
  const TYPEICON = {
    ノーマル: ['00', 'normal'], かくとう: ['01', 'fighting'], ひこう: ['02', 'flying'], どく: ['03', 'poison'],
    じめん: ['04', 'ground'], いわ: ['05', 'rock'], むし: ['06', 'bug'], ゴースト: ['07', 'ghost'],
    はがね: ['08', 'steel'], ほのお: ['09', 'fire'], みず: ['10', 'water'], くさ: ['11', 'grass'],
    でんき: ['12', 'electric'], エスパー: ['13', 'psychic'], こおり: ['14', 'ice'], ドラゴン: ['15', 'dragon'],
    あく: ['16', 'dark'], フェアリー: ['17', 'fairy'],
  };

  const esc = (s) => (s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const toKatakana = (s) => s.replace(/[ぁ-ゖ]/g, (c) => String.fromCharCode(c.charCodeAt(0) + 0x60));
  /** 与ダメレンジ表示: 「68〜80 (52〜61%)」。最小乱数=最大乱数の場合は単一値「80 (61%)」。 */
  function dmgRangeTxt(lo, hi, pLo, pHi) {
    const dmg = lo === hi ? `${lo}` : `${lo}〜${hi}`;
    const pct = lo === hi ? `${Math.round(pLo)}%` : `${Math.round(pLo)}〜${Math.round(pHi)}%`;
    return `${dmg} (${pct})`;
  }
  const sortJa = (arr) => [...arr].sort((a, b) => a.localeCompare(b, 'ja'));
  function spriteUrl(icon) { return icon ? `/images/pokemon/pokemon-${icon}.webp` : null; }
  function icoImg(icon, name, cls) {
    const u = spriteUrl(icon);
    const dn = tPoke(name);
    return u ? `<img class="${cls || ''}" src="${u}" alt="${esc(dn || '')}" title="${esc(dn || '')}" loading="lazy" onerror="this.style.display='none'">` : '';
  }
  function typeIcoByName(t) {
    const e = t ? TYPEICON[t] : null;
    return e ? `<img class="tic" src="/images/types/type-${e[0]}-${e[1]}.png" alt="${esc(t)}">` : '';
  }
  /** PartySuggestApp.astro の itemIco と同一体裁(持ち物スプライト。ITEM_PNGに無い持ち物はアイコン無し)。
   * lookupは常にitemの生の(和名)値で行う(和名キーの固定表のため)。表示名の翻訳はesc(tItem(item))側で行う。 */
  function itemIco(item) {
    return ITEM_PNG[item] ? `<img class="iic" src="/images/items/${ITEM_PNG[item]}" alt="">` : '';
  }
  /** PartySuggestApp.astro の evChips 相当(StatArray版)。EVチップ「H<b>4</b>」のように各stat色付きで表示。 */
  function evChipsArr(evs) {
    return EVK.map((k, i) => `<span class="evchip ev-${k}">${k}<b>${Number(evs[i]) || 0}</b></span>`).join('');
  }
  /** 仮想敵カードの型表示。PartySuggestApp.astro の detailHtml() と同じ体裁(dgrid+lblチップ・mvchip・evChips)に揃える。 */
  function muDetailHtml(b) {
    return `<div class="dgrid">
        <div class="dcell"><span class="lbl item">${I18N.itemLbl}</span><span class="dval">${itemIco(b.item)}${esc(tItem(b.item)) || '—'}</span></div>
        <div class="dcell"><span class="lbl abil">${I18N.abilLbl}</span><span class="dval">${esc(tAbil(b.ability)) || '—'}</span></div>
        <div class="dcell"><span class="lbl nat">${I18N.natLbl}</span><span class="dval">${esc(tNatureDisp(b.nature)) || '—'}</span></div>
      </div>
      <div class="drow"><span class="lbl mv">${I18N.moveLbl}</span><span class="mvwrap">${b.moves.filter(Boolean).map((x) => `<span class="mvchip">${typeIcoForMove(x)}${esc(tMove(x))}</span>`).join('') || '—'}</span></div>
      <div class="drow"><span class="lbl ev">${I18N.evLbl}</span><span class="mvwrap">${evChipsArr(b.ev)}</span></div>`;
  }
  /** 穴を埋める候補カードに出す型の要約(持ち物・性格・技・EV)。 */
  function hfBuildHtml(slot) {
    const moves = (slot.moves || []).filter(Boolean).map((x) => `<span class="mvchip">${typeIcoForMove(x)}${esc(tMove(x))}</span>`).join('');
    return `<div class="pb-hf-build">
        <span class="pb-hf-bitem">${itemIco(slot.item)}${esc(tItem(slot.item)) || '—'}</span>
        <span class="pb-hf-bnat">${esc(tNatureDisp(slot.nature)) || '—'}</span>
        ${moves}
        <span class="pb-hf-bev">${esc(pbEvStr(slot.evs)) || 'EV—'}</span>
      </div>`;
  }
  /** 検索候補のハイライト表示。表示言語(en/ko)での一致はtPoke後の文字列に対してハイライトし、
   * 和名一致時はそのまま元のマッチ位置でハイライトする。 */
  function hlSug(text, q) {
    const disp = tPoke(text);
    if (disp !== text) {
      const di = disp.toLowerCase().indexOf(q.toLowerCase());
      if (di >= 0) return esc(disp.slice(0, di)) + '<mark>' + esc(disp.slice(di, di + q.length)) + '</mark>' + esc(disp.slice(di + q.length));
      return esc(disp);
    }
    const qk = toKatakana(q);
    const t = qk !== q ? qk : q;
    const i = text.indexOf(t);
    if (i < 0) return esc(text);
    return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + t.length)) + '</mark>' + esc(text.slice(i + t.length));
  }
  /** 和名・カタカナに加え、表示言語(en/ko)の翻訳名でも一致させる(でないとen/ko版でポケモン名を
   * 入力してもヒットしない)。 */
  function matchesQuery(name, q, qk) {
    return name.includes(q) || name.includes(qk) || tPoke(name).toLowerCase().includes(q.toLowerCase());
  }
  const DEFG = (x) => (x === 0 ? '0' : x <= 0.25 ? '¼' : x < 0.5 ? '½' : x < 1 ? '½' : x >= 4 ? '×4' : x > 1 ? '×2' : '');
  const DEFC = (x) => (x === 0 ? 'df-imm' : x < 0.5 ? 'df-r2' : x < 1 ? 'df-r1' : x >= 4 ? 'df-w2' : x > 1 ? 'df-w1' : 'df-n');
  const symCls = (c) => ({ '◎': 'bg-cc', '○': 'bg-cb', '△': 'bg-cn', '▲': 'bg-cw', '×': 'bg-cx' }[c] || 'bg-cn');

  // ---- 状態 ----
  let core = null;
  let store = null;
  let selectedIdx = null;
  let currentMonDetail = null;
  let balanceTab = 'atk';
  let fillLoading = false;
  let fillFailed = false;
  let fillProposals = null;
  let fillEmptyIdx = [];
  let slotFillLoading = false;
  let slotFillProposals = null;
  let slotFillFailed = false;
  let tuneResults = null;
  let spSugActive = -1;
  let targetSugActive = -1;
  let dragSrcIdx = null;
  let activeMuTab = null; // 仮想敵パネル: ポケモン単位タブの選択状態(描画状態のみ・保存不要)
  let miniBarDismissed = false; // (1) モバイル判定ミニバーを✕で閉じた状態(このページセッション中は再表示しない)
  let sheetExpanded = false; // ミニバーのボトムシート展開状態(セッション中のみ保持・保存不要)。renderMiniBar()のみが読み書きする。
  let mtxPopData = []; // (5) ポケモン相性マトリクスのセル用ポップオーバー内容(renderのたびに作り直す)
  let holeFillResult = null; // 「穴を埋める候補」の計算結果キャッシュ。{ sig, additions, swaps } または null(未計算)
  let holeFillLoading = false; // 計算中フラグ(ポップオーバーのスピナー表示用)
  let holeFillAllowDup = false; // もちもの重複を許可するか(既定は重複型を候補から除外)
  let holeFillView = { additions: [], swaps: [] }; // いま描画中のリスト(適用ボタンの参照先)
  let mbPopData = []; // (5) 仮想敵カードの技チップ用ポップオーバー内容(renderTargetsPanelのたびに作り直す)
  let renamingParty = false; // (12b) パーティ名インライン編集中フラグ(renderPartyBarのみが参照)
  let pendingUndo = null; // (9) 枠✕のUndoトースト。{ partyId, index, slotData, timer } または null(最後の1件のみ保持)
  const mqMobileTray = window.matchMedia('(max-width:639.98px)'); // (4) トレイが3列グリッドになる幅の判定(空き枠検索の吹き出し矢印位置に使用)
  const mqDesktopSplit = window.matchMedia('(min-width:1024px)'); // 2カラム幅に切り替わったらボトムシートを強制的に閉じる(padding-bottom残留防止)
  mqDesktopSplit.addEventListener('change', (e) => {
    if (e.matches && sheetExpanded) { sheetExpanded = false; renderTargetsPanel(); }
  });
  /** 仮想敵の型 編集状態。{ label, bi: number|'new', draft: TargetBuild, detail: MonDetail|null, loading } または null。
   * bi は effectiveTargets() 上の当該ラベルのbuilds配列インデックス('new'=追加中で未保存)。 */
  let muEdit = null;

  function activeParty() {
    if (!store) return null;
    return store.parties.find((p) => p.id === store.activeId) || null;
  }
  /** アクティブパーティ切替(新規/複製/削除/選択変更/インポート)時に選択枠・提案系の一時状態を破棄する。
   * H1: fillProposals/fillEmptyIdxを持ち越すと、切替後の別パーティの空き枠を古いインデックスで
   * 上書きしうるため必ずここでクリアする(採用ボタン自体もH1で現在の空き枠を再計算する方式に修正済み)。 */
  function resetPartyUiState() {
    selectedIdx = null;
    fillLoading = false;
    fillFailed = false;
    fillProposals = null;
    fillEmptyIdx = [];
    slotFillLoading = false;
    slotFillProposals = null;
    slotFillFailed = false;
    tuneResults = null;
    activeMuTab = null;
    muEdit = null;
    renamingParty = false;
    holeFillResult = null;
    holeFillLoading = false;
    clearPendingUndo();
  }
  function resolveSlotSafe(slot) {
    if (!slot || !core) return null;
    try { return resolveSlot(slot, core.species, core.moves); } catch (e) { return null; }
  }
  function resolvedPartyList() {
    const p = activeParty();
    if (!p || !core) return [];
    const out = [];
    for (const slot of p.slots) {
      const rb = resolveSlotSafe(slot);
      if (rb) out.push(rb);
    }
    return out;
  }
  function moveType(name) {
    if (!core || !name) return null;
    const m = core.moves[name];
    return m ? m[0] : null;
  }
  function typeIcoForMove(name) { return typeIcoByName(moveType(name)); }
  /**
   * マトリクスの相手列。相手1ラベルにつき想定型(≤3、targets.jsonのbuilds全部)を全てresolveTargetする。
   * scripts/_explain.py matchup_grid() と同じく「代表型1固定」ではなく複数型を集約評価するための材料。
   * ポケモン相性タブ・穴判定(findHoles)はこのbuilds配列をjudgeVsBuildsに渡して集約する。
   * 素早さタブは従来どおり代表型1体(builds[0])のみを見るため、そちらはこの配列の先頭要素を使う。
   */
  /** buildOppCols()の計算結果キャッシュ。customTargets変更時(saveMuEdit/deleteMuBuild/resetMuDefault)にのみ
   * invalidateOppColsCache()で無効化する(M3: EVスライダー連打時にrenderBalance毎回の再計算を避ける)。 */
  let oppColsCache = null;
  function invalidateOppColsCache() { oppColsCache = null; }
  function buildOppCols() {
    if (!core) return [];
    ensureNameUrlMapLoaded();
    if (oppColsCache) return oppColsCache;
    oppColsCache = effectiveTargets()
      .map((g) => ({
        icon: g.icon,
        label: g.label,
        sp: g.sp, // (1) 紹介ページリンク解決用(labelはメガ名の場合があるため、base種名のspで引く)
        builds: (g.builds || [])
          .map((b) => resolveTargetSafe(g.sp, g.label, g.icon, b, core.moves))
          .filter((b) => b !== null),
      }))
      .filter((g) => g.builds.length);
    return oppColsCache;
  }

  // ---- (1) ポケモン相性・素早さタブの相手ヘッダのリンク化 ----
  /** search-index.json のロードは相性/素早さタブが初めて描画される(=buildOppCols初回呼び出し)時でよい。
   * 完了後、その時点で相性/素早さタブを表示中ならリンクを反映するため再描画する。 */
  let nameUrlMapLoadStarted = false;
  function ensureNameUrlMapLoaded() {
    if (nameUrlMapLoadStarted) return;
    nameUrlMapLoadStarted = true;
    loadNameUrlMap().then(() => {
      if (balanceTab === 'mu' || balanceTab === 'speed') {
        const pane = document.getElementById('pb-balance-pane');
        if (!pane) return;
        pane.innerHTML = balancePaneHtml(resolvedPartyList(), balanceTab);
        bindMtxPopovers(pane);
        bindHoleFillButton(pane);
      }
    }).catch((e) => console.warn('[ensureNameUrlMapLoaded] search-index.jsonの取得に失敗しました', e));
  }
  /** sp(種の和名)から紹介ページURLを引く。ページが存在しない種・未ロード時はnull。 */
  function oppPageUrl(sp) {
    if (!sp) return null;
    const map = nameUrlMapSync();
    if (!map) return null;
    const e = map.get(sp);
    if (!e) return null;
    return lang === 'en' ? e.ue : lang === 'ko' ? e.uk : e.u;
  }
  /** 相手列ヘッダ(スプライト+名前)。紹介ページがあればaでリンク化し、無ければ従来通りの非リンク表示。
   * ポケモン相性・素早さタブで共有する(セルのポップオーバーとは別要素のため誤爆しない)。 */
  function oppHeaderCellHtml(o, extraCls) {
    const inner = `${icoImg(o.icon, o.label, 'mtx-ico')}<div class="mtx-name">${esc(tPoke(o.label))}</div>`;
    const url = oppPageUrl(o.sp);
    const body = url ? `<a class="mtx-opp-link" href="${esc(url)}">${inner}</a>` : inner;
    return `<th class="${extraCls || ''}">${body}</th>`;
  }

  /** targets.json由来の仮想敵一覧を、store.customTargets(仮想敵の型のユーザー編集)で差し替えた「効果的builds」で返す。
   * マトリクス・穴判定・仮想敵パネルはすべてこれ経由で仮想敵を参照する(core.targetsを直接見ない)。 */
  function effectiveTargets() {
    if (!core || !store) return [];
    return getEffectiveTargets(store, core.targets);
  }

  const MU_SYM_RANK = { '◎': 4, '○': 3, '△': 2, '▲': 1, '×': 0 };
  /** (7) 仮想敵タブ用の最悪判定バッジ。grpの全型(≤3)についてjudge1v1(rb, opp)を回し、
   * 最も悪いsymが×/▲のときだけそのsymを返す(◎/○/△なら表示しない=null)。選択枠の仮想敵のみが
   * 対象で型数も≤3のため、タブ描画のたびに回しても軽量。 */
  function muTabBadge(rb, grp) {
    if (!rb || !grp || !grp.builds.length || !core) return null;
    let worst = null;
    let worstRank = 99;
    for (const b of grp.builds) {
      const opp = resolveTargetSafe(grp.sp, grp.label, grp.icon, b, core.moves);
      if (!opp) continue;
      const v = judge1v1(rb, opp);
      const r = MU_SYM_RANK[v.sym];
      if (r < worstRank) { worstRank = r; worst = v.sym; }
    }
    return worst === '×' || worst === '▲' ? worst : null;
  }

  /** label(仮想敵ラベル)に対応する種のmon jsonをloadMonで取得する。sp→species.icon経由(メガ型ラベルのicon誤用を避ける)。 */
  async function loadMonForTargetLabel(label) {
    const grp = effectiveTargets().find((g) => g.label === label);
    if (!grp) throw new Error(`target group not found: ${label}`);
    const sm = core.species.find((s) => s.n === grp.sp);
    if (!sm) throw new Error(`species not found for target: ${grp.sp}`);
    return loadMon(sm.icon);
  }

  /** customTargets未編集のラベルを初回編集時にtargets.jsonのデフォルトでmaterializeする。 */
  function materializeCustomTarget(label) {
    if (!store.customTargets) store.customTargets = {};
    if (!store.customTargets[label] || !store.customTargets[label].length) {
      const grp = core.targets.find((g) => g.label === label);
      store.customTargets[label] = grp ? JSON.parse(JSON.stringify(grp.builds)) : [];
    }
  }

  function targetBuildSpec(sp, b) {
    return `${sp}@${b.item || ''}:${b.nature || ''}:${(b.moves || []).filter(Boolean).join('|')}:${b.ev.join('/')}:${b.ability || ''}`;
  }

  // =========================================================
  // 描画
  // =========================================================
  /** M3: EVスライダー連打時にrenderBalance()(マトリクス再計算)をtrailingデバウンスするためのタイマー。
   * scheduleRenderBalance()で予約し、renderBalance()を直接呼ぶ経路(render()等)では即時実行に統一する
   * ため、その際は保留中の予約をキャンセルする(二重計算防止)。 */
  let balanceDebounceTimer = null;
  function cancelScheduledRenderBalance() {
    if (balanceDebounceTimer) { clearTimeout(balanceDebounceTimer); balanceDebounceTimer = null; }
  }
  function scheduleRenderBalance() {
    cancelScheduledRenderBalance();
    balanceDebounceTimer = setTimeout(() => {
      balanceDebounceTimer = null;
      renderBalance();
    }, 80);
  }
  function render() {
    cancelScheduledRenderBalance();
    renderPartyBar();
    renderValidate();
    renderTray();
    renderEmptyGuide();
    updateFillBtnVisibility();
    renderFillOut();
    renderSlotSearch();
    renderEditor();
    renderTargetsPanel();
    renderBalance();
  }

  // ---- (1) モバイル固定判定ミニバー / ボトムシート ----
  /** 選択中枠が仮想敵ありのとき、画面下部に固定表示する。collapsed(既定)は型ごとの判定を超コンパクト表示。
   * タップ(✕以外のどこでも)でボトムシート(高さ約45vh・上限50vh)に展開し、仮想敵パネル(renderTargetsPanel)
   * の型カード(chips/cardsBlockHtml/addResetRow)とそのイベント紐付け(bindMuSection)をsheetCtx経由で
   * そのまま再利用する(二重実装を避けるため、シート専用のHTML生成/イベント処理は持たない)。
   * grp/rows/sheetCtxはrenderTargetsPanel()が算出済みのものをそのまま渡す(二重計算しない)。 */
  function renderMiniBar(grp, rows, sheetCtx) {
    const el = document.getElementById('pb-minibar');
    if (!el) return;
    if (miniBarDismissed || !grp || !rows || !rows.length) {
      el.classList.remove('pb-minibar-show', 'pb-sheet-expanded');
      el.innerHTML = '';
      document.body.classList.remove('pb-minibar-active', 'pb-sheet-open');
      sheetExpanded = false;
      return;
    }
    el.classList.add('pb-minibar-show');
    el.classList.toggle('pb-sheet-expanded', sheetExpanded);
    document.body.classList.add('pb-minibar-active');
    document.body.classList.toggle('pb-sheet-open', sheetExpanded);

    const collapse = () => { sheetExpanded = false; renderMiniBar(grp, rows, sheetCtx); };
    const expand = () => { sheetExpanded = true; renderMiniBar(grp, rows, sheetCtx); };

    if (!sheetExpanded) {
      const items = rows.slice(0, 3).map((r) => `<button type="button" class="pb-minibar-item">${icoImg(grp.icon, grp.label, 'pb-minibar-ico')}<span>S${r.mySpeed}vs${r.oppSpeed} ${r.verdict.sym}${r.myHitsTxt}/${r.oppHitsTxt}</span></button>`).join('');
      el.innerHTML = `<div class="pb-minibar-inner" id="pb-minibar-tap" role="button" tabindex="0" aria-expanded="false" aria-label="${esc(I18N.miniBarExpandAria)}">
          <div class="pb-minibar-scroll">${items}</div>
          <span class="pb-minibar-caret">${esc(I18N.sheetExpandCaret)}</span>
          <button type="button" class="pb-minibar-x" id="pb-minibar-x" aria-label="${esc(I18N.close)}">✕</button>
        </div>`;
      const tapEl = document.getElementById('pb-minibar-tap');
      tapEl.addEventListener('click', (e) => { if (e.target.closest('#pb-minibar-x')) return; expand(); });
      tapEl.addEventListener('keydown', (e) => {
        if (e.target.closest('#pb-minibar-x')) return;
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); expand(); }
      });
      document.getElementById('pb-minibar-x').addEventListener('click', (e) => {
        e.stopPropagation();
        miniBarDismissed = true;
        renderMiniBar(null, null);
      });
      return;
    }

    el.innerHTML = `
      <div class="pb-minibar-head">
        <span class="pb-minibar-title">${icoImg(grp.icon, grp.label, 'pb-minibar-ico')}${esc(tPoke(grp.label))}</span>
        <button type="button" class="pb-btn-sub" id="pb-sheet-collapse" aria-expanded="true">${esc(I18N.sheetCollapseBtn)}</button>
      </div>
      <div class="pb-sheet-body" id="pb-sheet-body">
        <div class="filter-chips">${sheetCtx.chips}</div>
        ${sheetCtx.cardsBlockHtml}
        ${sheetCtx.addResetRow}
      </div>`;
    document.getElementById('pb-sheet-collapse').addEventListener('click', collapse);
    const sheetBodyEl = document.getElementById('pb-sheet-body');
    if (sheetBodyEl) sheetCtx.bindMuSection(sheetBodyEl);
  }

  /** (11) 0体(空パーティ)のときだけ6枠トレイ直下に3ステップの初見ガイドを表示する。1体追加で消える。 */
  function renderEmptyGuide() {
    const el = document.getElementById('pb-empty-guide');
    if (!el) return;
    const p = activeParty();
    const filledCount = p ? p.slots.filter(Boolean).length : 0;
    if (!p || filledCount > 0) { el.innerHTML = ''; return; }
    el.innerHTML = `<div class="pb-empty-guide">
        <div class="pb-empty-guide-step">${esc(I18N.emptyGuideStep1)}</div>
        <div class="pb-empty-guide-step">${esc(I18N.emptyGuideStep2)}</div>
        <div class="pb-empty-guide-step">${esc(I18N.emptyGuideStep3)}</div>
      </div>`;
  }

  /** 空き枠がない(6匹満員)時は「空き枠を提案で埋める」ボタンを非表示にする。空きができたら再表示。 */
  function updateFillBtnVisibility() {
    const btn = document.getElementById('pb-fill-btn');
    if (!btn) return;
    const p = activeParty();
    const hasEmpty = !!p && p.slots.some((s) => !s);
    btn.style.display = hasEmpty ? '' : 'none';
    if (!hasEmpty && (fillProposals || fillFailed)) {
      fillProposals = null;
      fillFailed = false;
      renderFillOut();
    }
  }

  // ---- 構成ルールエラーバナー ----
  function renderValidate() {
    const el = document.getElementById('pb-validate');
    if (!el) return;
    const p = activeParty();
    if (!p || !core) { el.innerHTML = ''; return; }
    const issues = validateParty(p, core.species);
    if (!issues.length) { el.innerHTML = ''; return; }
    el.innerHTML = `<div class="pb-valid-banner"><ul>${issues.map((i) => `<li>⚠ ${esc(i.message)}</li>`).join('')}</ul></div>`;
  }

  function renderPartyBar() {
    const el = document.getElementById('pb-partybar');
    const p = activeParty();
    if (!p) renamingParty = false; // (12b) パーティが無いのに編集状態が残らないようにする
    const options = store.parties.map((pp) => `<option value="${esc(pp.id)}" ${pp.id === store.activeId ? 'selected' : ''}>${esc(pp.name)}</option>`).join('');
    const nameFieldHtml = renamingParty && p
      ? `<input type="text" id="pb-party-rename-input" class="inp" value="${esc(p.name)}" style="max-width:11em">`
      : `<select id="pb-party-select" class="inp">${options}</select>`;
    el.innerHTML = `
      <div class="row pb-partybar-row">
        ${nameFieldHtml}
        <button class="pb-btn-sub" id="pb-p-new" ${renamingParty ? 'disabled' : ''}>${esc(I18N.partyNew)}</button>
        <button class="pb-btn-sub" id="pb-p-dup" ${p && !renamingParty ? '' : 'disabled'}>${esc(I18N.partyDup)}</button>
        <button class="pb-btn-sub" id="pb-p-ren" ${p && !renamingParty ? '' : 'disabled'}>${esc(I18N.partyRen)}</button>
        <button class="pb-btn-sub pb-danger" id="pb-p-del" ${p && !renamingParty ? '' : 'disabled'}>${esc(I18N.partyDel)}</button>
        <button class="pb-btn-sub" id="pb-p-exp" ${p && !renamingParty ? '' : 'disabled'}>${esc(I18N.partyExp)}</button>
        <button class="pb-btn-sub" id="pb-p-imp" ${renamingParty ? 'disabled' : ''}>${esc(I18N.partyImp)}</button>
      </div>
      <div class="muted pb-storage-note">${esc(I18N.storageNote)}</div>`;
    if (renamingParty && p) {
      // (12b) prompt()の代わりにインライン編集。Enter/blurで確定・Escで取消(esc()はvalue属性側で適用済み)。
      const input = document.getElementById('pb-party-rename-input');
      let settled = false;
      const commit = () => {
        if (settled) return;
        settled = true;
        const name = input.value.trim();
        if (name) renameParty(store, p.id, name);
        renamingParty = false;
        render();
      };
      const cancel = () => {
        if (settled) return;
        settled = true;
        renamingParty = false;
        renderPartyBar();
      };
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); commit(); }
        else if (e.key === 'Escape') { e.preventDefault(); cancel(); }
      });
      input.addEventListener('blur', () => commit());
      input.focus();
      input.select();
    } else {
      document.getElementById('pb-party-select').addEventListener('change', (e) => {
        store.activeId = e.target.value;
        resetPartyUiState();
        saveStore(store);
        render();
      });
    }
    document.getElementById('pb-p-new').addEventListener('click', () => {
      if (renamingParty) return;
      createParty(store);
      resetPartyUiState();
      render();
    });
    document.getElementById('pb-p-dup').addEventListener('click', () => {
      if (!p || renamingParty) return;
      duplicateParty(store, p.id);
      resetPartyUiState();
      render();
    });
    document.getElementById('pb-p-ren').addEventListener('click', () => {
      if (!p || renamingParty) return;
      renamingParty = true;
      renderPartyBar();
    });
    document.getElementById('pb-p-del').addEventListener('click', () => {
      if (!p || renamingParty) return;
      if (confirm(I18N.deleteConfirm(p.name))) {
        deleteParty(store, p.id);
        resetPartyUiState();
        render();
      }
    });
    document.getElementById('pb-p-exp').addEventListener('click', () => { if (p && !renamingParty) openExportModal(p); });
    document.getElementById('pb-p-imp').addEventListener('click', () => { if (!renamingParty) openImportModal(); });
  }

  function renderTray() {
    const el = document.getElementById('pb-tray');
    const p = activeParty();
    if (!p) { el.innerHTML = ''; return; }
    el.innerHTML = p.slots.map((slot, i) => {
      const active = selectedIdx === i ? ' active' : '';
      if (!slot) {
        return `<button class="montab pb-slot-empty${active}" data-slot="${i}"><span class="pb-plus">＋</span></button>`;
      }
      const rb = resolveSlotSafe(slot);
      const sm = core ? core.species.find((s) => s.n === slot.sp) : null;
      const name = rb ? rb.label : slot.sp;
      const icon = rb ? rb.icon : (sm ? sm.icon : null);
      return `<button class="montab${active}" data-slot="${i}" draggable="true">
          <span class="pb-slot-x" data-slot-x="${i}" title="${esc(I18N.slotRemoveTitle)}">✕</span>
          ${icoImg(icon, name, 'monicon')}
          <span class="mname">${esc(tPoke(name))}</span>
          <span class="mitem">${esc(tItem(slot.item)) || '—'}</span>
        </button>`;
    }).join('');
    el.querySelectorAll('.montab').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedIdx = +btn.dataset.slot;
        tuneResults = null;
        slotFillProposals = null;
        slotFillFailed = false;
        activeMuTab = null;
        muEdit = null;
        document.querySelectorAll('#pb-tray .montab').forEach((b) => b.classList.toggle('active', +b.dataset.slot === selectedIdx));
        renderSlotSearch();
        renderEditor();
        renderTargetsPanel();
      });
    });
    el.querySelectorAll('.pb-slot-x').forEach((x) => {
      x.addEventListener('click', (e) => {
        e.stopPropagation();
        removeSlotAt(+x.dataset.slotX);
      });
    });
    // DnD並べ替え（充填枠のみドラッグ可。モバイルタッチは対象外）
    el.querySelectorAll('.montab[draggable="true"]').forEach((btn) => {
      btn.addEventListener('dragstart', (e) => {
        dragSrcIdx = +btn.dataset.slot;
        e.dataTransfer.effectAllowed = 'move';
        try { e.dataTransfer.setData('text/plain', String(dragSrcIdx)); } catch (err) { /* noop */ }
        btn.classList.add('pb-dragging');
      });
      btn.addEventListener('dragend', () => {
        btn.classList.remove('pb-dragging');
        dragSrcIdx = null;
        el.querySelectorAll('.montab').forEach((b) => b.classList.remove('pb-drop-target'));
      });
    });
    el.querySelectorAll('.montab').forEach((btn) => {
      btn.addEventListener('dragover', (e) => {
        if (dragSrcIdx === null) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        btn.classList.add('pb-drop-target');
      });
      btn.addEventListener('dragleave', () => btn.classList.remove('pb-drop-target'));
      btn.addEventListener('drop', (e) => {
        e.preventDefault();
        btn.classList.remove('pb-drop-target');
        const destIdx = +btn.dataset.slot;
        if (dragSrcIdx === null || dragSrcIdx === destIdx) return;
        reorderSlots(dragSrcIdx, destIdx);
      });
    });
  }

  /** ✕で外す: 左詰めを維持したまま該当枠を除去する(migrateと同じcompact方式)。(9) 除去前の枠オブジェクト
   * (targets込み)をそのままpendingUndoに保持し、Undoトーストから完全復元できるようにする。 */
  function removeSlotAt(i) {
    const p = activeParty();
    if (!p) return;
    const selectedSlotObj = selectedIdx !== null ? p.slots[selectedIdx] : null;
    const filled = p.slots.filter((s) => s !== null);
    if (i >= filled.length) return;
    const [removed] = filled.splice(i, 1);
    const out = [...filled];
    while (out.length < 6) out.push(null);
    p.slots = out;
    p.updatedAt = Date.now();
    if (selectedSlotObj) {
      const newIdx = p.slots.indexOf(selectedSlotObj);
      selectedIdx = newIdx === -1 ? null : newIdx;
    } else {
      selectedIdx = null;
    }
    tuneResults = null;
    slotFillProposals = null;
    slotFillFailed = false;
    saveStore(store);
    const rb = resolveSlotSafe(removed);
    showUndoToast(tPoke(rb ? rb.label : removed.sp), p.id, i, removed);
    render();
  }

  // ---- (9) 枠✕のUndoトースト ----
  /** 新規除去のたびに前回分を上書きする(=最後の1件のみUndo可能)。5秒後に自動消滅する。
   * mode='remove'(既定): 枠✕での除去。左詰め後のindexへslotDataを挿入し直す(既存挙動)。
   * mode='replace': 「穴を埋める候補」の入れ替え適用。indexの枠へslotDataをそのまま戻す(左詰めしない)。
   * msgを渡すとI18N.undoRemoved(name)の代わりにその文言をそのまま表示する(入れ替え用の文言を使うため)。 */
  function showUndoToast(name, partyId, index, slotData, mode, msg) {
    if (pendingUndo && pendingUndo.timer) clearTimeout(pendingUndo.timer);
    const timer = setTimeout(() => { pendingUndo = null; renderUndoToast(); }, 5000);
    pendingUndo = { name, partyId, index, slotData, timer, mode: mode || 'remove', msg };
    renderUndoToast();
  }
  function clearPendingUndo() {
    if (pendingUndo && pendingUndo.timer) clearTimeout(pendingUndo.timer);
    pendingUndo = null;
    renderUndoToast();
  }
  function renderUndoToast() {
    const el = document.getElementById('pb-undo-toast');
    if (!el) return;
    if (!pendingUndo) { el.style.display = 'none'; el.innerHTML = ''; return; }
    el.style.display = 'flex';
    const msg = pendingUndo.msg || I18N.undoRemoved(pendingUndo.name);
    el.innerHTML = `<span>${esc(msg)}</span><button type="button" class="pb-undo-toast-btn" id="pb-undo-btn">${esc(I18N.undoBtn)}</button>`;
    document.getElementById('pb-undo-btn').addEventListener('click', undoRemoveSlot);
  }
  /** 復元: mode='remove'は除去時の位置(左詰め後のインデックス)へSlot全体(targets込み)を挿入し直す。
   * mode='replace'はindexの枠へslotDataをそのまま(左詰めせず)戻す。 */
  function undoRemoveSlot() {
    if (!pendingUndo) return;
    const { partyId, index, slotData, timer, mode } = pendingUndo;
    clearTimeout(timer);
    pendingUndo = null;
    renderUndoToast();
    const party = store.parties.find((pp) => pp.id === partyId);
    if (!party) return;
    if (mode === 'replace') {
      party.slots[index] = slotData;
      party.updatedAt = Date.now();
      saveStore(store);
      if (activeParty() && activeParty().id === partyId) render();
      return;
    }
    const filled = party.slots.filter((s) => s !== null);
    const insertAt = Math.min(index, filled.length);
    filled.splice(insertAt, 0, slotData);
    const out = [...filled];
    while (out.length < 6) out.push(null);
    party.slots = out.slice(0, 6);
    party.updatedAt = Date.now();
    saveStore(store);
    if (activeParty() && activeParty().id === partyId) render();
  }

  /** DnD並べ替え: 充填枠だけを対象にした配列移動＋左詰め維持。選択中の枠はオブジェクト同一性で追従。 */
  function reorderSlots(from, to) {
    const p = activeParty();
    if (!p) return;
    const filled = p.slots.filter((s) => s !== null);
    if (from >= filled.length) return;
    const destIdx = Math.min(to, filled.length - 1);
    const selectedSlotObj = selectedIdx !== null ? p.slots[selectedIdx] : null;
    const [moving] = filled.splice(from, 1);
    filled.splice(destIdx, 0, moving);
    const out = [...filled];
    while (out.length < 6) out.push(null);
    p.slots = out;
    p.updatedAt = Date.now();
    if (selectedSlotObj) {
      const newIdx = p.slots.indexOf(selectedSlotObj);
      selectedIdx = newIdx === -1 ? null : newIdx;
    }
    saveStore(store);
    render();
  }

  // ---- 型エディタ ----
  let editorRenderToken = 0;
  async function renderEditor() {
    const el = document.getElementById('pb-editor');
    const p = activeParty();
    if (!p) { el.innerHTML = `<div class="muted">${esc(I18N.createPartyPrompt)}</div>`; return; }
    if (selectedIdx === null) {
      el.innerHTML = `<h2>${esc(I18N.editorTitle)}</h2><div class="muted">${esc(I18N.editorSelectPrompt)}</div>`;
      return;
    }
    const slot = p.slots[selectedIdx];
    if (!slot) { el.innerHTML = `<h2>${esc(I18N.editorTitle)}</h2><div class="muted">${esc(I18N.editorAddPrompt)}</div>`; return; }
    const sm = core.species.find((s) => s.n === slot.sp);
    if (!sm) { el.innerHTML = `<div class="muted">${esc(I18N.speciesDataMissing)}</div>`; return; }
    const token = ++editorRenderToken;
    el.innerHTML = `<h2>${esc(I18N.editorHeading(selectedIdx + 1))}</h2><div class="muted">${esc(I18N.loading)}</div>`;
    let detail = null;
    try { detail = await loadMon(sm.icon); } catch (e) { detail = null; }
    if (token !== editorRenderToken) return;
    currentMonDetail = detail;
    buildEditorFilledDom(el, slot, sm, detail || { items: [], abilities: [], natures: [], evs: [], moves: [], learnset: [], builds: [] });
  }

  /** (4) 空き枠検索カードの吹き出し矢印の左位置。トレイが3列(モバイル)か6列(PC)かに応じて列基準で算出する。 */
  function computeArrowLeft(idx) {
    const columns = mqMobileTray.matches ? 3 : 6;
    const col = idx % columns;
    return `calc((${col} + 0.5) / ${columns} * 100%)`;
  }
  mqMobileTray.addEventListener('change', () => { if (selectedIdx !== null) renderSlotSearch(); });

  /** 空き枠選択時に「6枠編成」カード内・トレイ直下へ検索UIを展開する（枠外は空にする）。 */
  function renderSlotSearch() {
    const el = document.getElementById('pb-slot-search');
    if (!el) return;
    const p = activeParty();
    if (!p || selectedIdx === null || p.slots[selectedIdx]) { el.innerHTML = ''; return; }
    const idx = selectedIdx;
    const arrowLeft = computeArrowLeft(idx);
    el.innerHTML = `
      <div class="pb-slotsearch" style="--pb-arrow-left:${arrowLeft}">
        <div class="pb-slotsearch-head">
          <span class="pb-slotsearch-title">${esc(I18N.slotSearchTitle(idx + 1))}</span>
          <button type="button" class="pb-slotsearch-close" id="pb-slotsearch-close" aria-label="${esc(I18N.close)}">${esc(I18N.slotSearchClose)}</button>
        </div>
        <div class="filter-wrap">
          <input type="text" id="pb-sp-search" class="filter-inp" placeholder="${esc(I18N.slotSearchPlaceholder)}" autocomplete="off">
          <div class="filter-sug" id="pb-sp-sug" style="display:none"></div>
        </div>
        <div class="row" style="margin-top:.6em">
          <button class="pb-btn-sub" id="pb-slot-fill-btn">${esc(I18N.slotFillBtn)}</button>
        </div>
        <div id="pb-slot-fill-out"></div>
      </div>`;
    const input = el.querySelector('#pb-sp-search');
    input.addEventListener('input', (e) => onSpSearchInput(e.target.value));
    input.addEventListener('keydown', onSpSearchKey);
    input.focus();
    el.querySelector('#pb-slot-fill-btn').addEventListener('click', onSlotFillClick);
    el.querySelector('#pb-slotsearch-close').addEventListener('click', () => {
      selectedIdx = null;
      document.querySelectorAll('#pb-tray .montab').forEach((b) => b.classList.remove('active'));
      renderSlotSearch();
      renderEditor();
      renderTargetsPanel();
    });
    if (slotFillProposals) renderSlotFillArea();
  }

  function onSpSearchInput(val) {
    const sug = document.getElementById('pb-sp-sug');
    if (!sug || !core) return;
    spSugActive = -1;
    const q = val.trim();
    if (!q) { sug.style.display = 'none'; return; }
    const qk = toKatakana(q);
    const hits = core.species.filter((s) => matchesQuery(s.n, q, qk)).slice(0, 12);
    if (!hits.length) { sug.innerHTML = `<div class="sug-item added">${esc(I18N.noHit)}</div>`; sug.style.display = 'block'; return; }
    sug.innerHTML = hits.map((s) => `<div class="sug-item" data-sp="${esc(s.n)}">${icoImg(s.icon, s.n, '')}<span>${hlSug(s.n, q)}</span><span class="rk">${esc(I18N.rankLbl(s.rank))}</span></div>`).join('');
    sug.querySelectorAll('[data-sp]').forEach((it) => it.addEventListener('click', () => pickSpecies(it.dataset.sp)));
    sug.style.display = 'block';
  }
  function onSpSearchKey(e) {
    const sug = document.getElementById('pb-sp-sug');
    if (!sug || sug.style.display === 'none') return;
    const items = [...sug.querySelectorAll('[data-sp]')];
    if (e.key === 'ArrowDown') { e.preventDefault(); spSugActive = Math.min(spSugActive + 1, items.length - 1); items.forEach((it, i) => it.classList.toggle('act', i === spSugActive)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); spSugActive = Math.max(spSugActive - 1, 0); items.forEach((it, i) => it.classList.toggle('act', i === spSugActive)); }
    else if (e.key === 'Enter') { e.preventDefault(); if (spSugActive >= 0 && items[spSugActive]) pickSpecies(items[spSugActive].dataset.sp); else if (items.length === 1) pickSpecies(items[0].dataset.sp); }
    else if (e.key === 'Escape') { sug.style.display = 'none'; spSugActive = -1; }
  }
  async function pickSpecies(name) {
    if (!core) return;
    const sm = core.species.find((s) => s.n === name);
    const p = activeParty();
    if (!sm || !p) return;
    const idx = selectedIdx;
    let newSlot = { sp: name, item: '', ability: '', nature: '', evs: [0, 0, 0, 0, 0, 0], moves: [], targets: [] };
    try {
      const detail = await loadMon(sm.icon);
      if (detail.builds && detail.builds.length) {
        const parsed = fromSpec(detail.builds[0]);
        if (parsed) { parsed.targets = []; newSlot = parsed; }
      } else {
        newSlot.item = (detail.items[0] || {}).n || '';
        newSlot.ability = (detail.abilities[0] || {}).n || '';
        newSlot.nature = (detail.natures[0] || {}).n || '';
        newSlot.evs = (detail.evs[0] || {}).ev || [0, 0, 0, 0, 0, 0];
        newSlot.moves = detail.moves.slice(0, 4).map((m) => m.n);
      }
    } catch (e) { /* フェッチ失敗時は空の型のまま追加 */ }
    if (idx !== selectedIdx) return;
    p.slots[idx] = newSlot;
    p.updatedAt = Date.now();
    saveStore(store);
    render();
  }

  async function onSlotFillClick() {
    const p = activeParty();
    if (!p || !core) return;
    const idx = selectedIdx;
    slotFillLoading = true;
    slotFillFailed = false;
    renderSlotFillArea();
    let proposals = null;
    try {
      proposals = await suggestFill(p, [idx], { species: core.species, loadMon });
    } catch (e) {
      // M2: mon json取得失敗等でsuggestFillがrejectしてもスピナーが固まらないようにする
      console.warn('[onSlotFillClick] 提案の取得に失敗しました', e);
      if (idx !== selectedIdx) return;
      slotFillLoading = false;
      slotFillFailed = true;
      renderSlotFillArea();
      return;
    }
    if (idx !== selectedIdx) return;
    slotFillLoading = false;
    slotFillProposals = proposals;
    renderSlotFillArea();
  }
  function renderSlotFillArea() {
    const out = document.getElementById('pb-slot-fill-out');
    if (!out) return;
    if (slotFillLoading) { out.innerHTML = `<div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">${esc(I18N.fillCalculating)}</div></div>`; return; }
    if (slotFillFailed) { out.innerHTML = `<div class="muted">${esc(I18N.fillFailedMsg)}</div>`; return; }
    if (!slotFillProposals || !slotFillProposals.length) { out.innerHTML = ''; return; }
    out.innerHTML = slotFillProposals.map((cand, ci) => {
      const slotCand = cand[0];
      const sm = core.species.find((s) => s.n === slotCand.sp);
      return `<div class="pb-cand-card">
          ${icoImg(sm ? sm.icon : null, slotCand.sp, 'monicon')}
          <span class="mname" style="font-size:.82rem">${esc(tPoke(slotCand.sp))}</span>
          <button class="pb-btn-sub" data-slot-cand="${ci}">${esc(I18N.adoptBtn)}</button>
        </div>`;
    }).join('');
    out.querySelectorAll('[data-slot-cand]').forEach((btn) => btn.addEventListener('click', () => {
      const ci = +btn.dataset.slotCand;
      const cand = slotFillProposals[ci][0];
      const p = activeParty();
      // H1: onFillSpriteClickと同じく採用時点の枠状態を再確認してから書き込む(提案表示後に
      // 別経路で当該枠が埋まっていた場合の無警告上書きを防ぐ)。
      if (!p || selectedIdx === null || p.slots[selectedIdx]) {
        slotFillProposals = null;
        renderSlotFillArea();
        return;
      }
      p.slots[selectedIdx] = cand;
      p.updatedAt = Date.now();
      saveStore(store);
      slotFillProposals = null;
      render();
    }));
  }

  /** value属性は常に和名(生データ)。表示テキストのみtAbil()で翻訳する。 */
  function fieldOptions(entries, current, emptyLabel) {
    const list = entries || [];
    const names = new Set(list.map((x) => x.n));
    let html = '';
    if (emptyLabel !== undefined) html += `<option value="" ${!current ? 'selected' : ''}>${esc(emptyLabel)}</option>`;
    if (current && !names.has(current)) html += `<option value="${esc(current)}" selected>${esc(tAbil(current))}</option>`;
    html += list.map((x) => `<option value="${esc(x.n)}" ${x.n === current ? 'selected' : ''}>${esc(tAbil(x.n))}${x.pct != null ? ` (${x.pct}%)` : ''}</option>`).join('');
    return html;
  }

  /** 持ち物select: 「なし」+使用率つき(上段)+その他(下段・五十音順、items.json由来)の2段構成。
   * value属性は常に和名(生データ)。表示テキストのみtItem()で翻訳する。 */
  function itemSelectOptions(entries, current, allItems) {
    const list = entries || [];
    const topNames = new Set(list.map((x) => x.n));
    const rest = (allItems || []).filter((n) => !topNames.has(n));
    const known = new Set([...topNames, ...(allItems || [])]);
    let html = `<option value="" ${!current ? 'selected' : ''}>${esc(I18N.noneOpt)}</option>`;
    if (current && !known.has(current)) html += `<option value="${esc(current)}" selected>${esc(tItem(current))}</option>`;
    const topOpts = list.map((x) => `<option value="${esc(x.n)}" ${x.n === current ? 'selected' : ''}>${esc(tItem(x.n))} (${x.pct}%)</option>`).join('');
    html += `<optgroup label="${esc(I18N.usageGroup)}">${topOpts}</optgroup>`;
    if (rest.length) {
      const restOpts = rest.map((n) => `<option value="${esc(n)}" ${n === current ? 'selected' : ''}>${esc(tItem(n))}</option>`).join('');
      html += `<optgroup label="${esc(I18N.otherGroup)}">${restOpts}</optgroup>`;
    }
    return html;
  }

  /** 性格select: 使用率つき(上段・%付き)+残り(下段・その他)の2段構成。表示は natureDisp() で統一。
   * 無補正5性格(まじめ/きまぐれ/てれや/がんばりや/すなお)は簡単化のため「がんばりや」のみ候補にする。
   * ただし現在値が別の無補正性格(インポート・既存データ由来)の場合は壊さないようその値も選択肢に残す。
   * stats.ts の NATURE_MODS/ALL_NATURES 自体はここでは変更しない(計算・fromSpec互換のため)。表示は tNatureDisp() で翻訳する。 */
  function natureSelectOptions(entries, current) {
    const keepNeutral = (n) => !NEUTRAL_NATURES.includes(n) || n === 'がんばりや' || n === current;
    const list = (entries || []).filter((x) => keepNeutral(x.n));
    const topNames = new Set(list.map((x) => x.n));
    const restPool = ALL_NATURES.filter((n) => !topNames.has(n) && keepNeutral(n));
    const rest = sortJa(restPool);
    let html = '';
    if (current && !topNames.has(current) && !restPool.includes(current)) html += `<option value="${esc(current)}" selected>${esc(tNatureDisp(current) || tNature(current))}</option>`;
    const topOpts = list.map((x) => `<option value="${esc(x.n)}" ${x.n === current ? 'selected' : ''}>${esc(tNatureDisp(x.n))} (${x.pct}%)</option>`).join('');
    html += `<optgroup label="${esc(I18N.usageGroup)}">${topOpts}</optgroup>`;
    const restOpts = rest.map((n) => `<option value="${esc(n)}" ${n === current ? 'selected' : ''}>${esc(tNatureDisp(n))}</option>`).join('');
    html += `<optgroup label="${esc(I18N.otherGroup)}">${restOpts}</optgroup>`;
    return html;
  }

  /** 技select: 空(「—」)+使用率順(上段・%付き、mon.moves全件)+その他(下段・全習得技のうち使用率外、五十音順)の2段構成。
   * value属性は常に和名(生データ)。表示テキストのみtMove()で翻訳する。 */
  function moveSelectOptions(detail, current) {
    const top = detail.moves || [];
    const topNames = new Set(top.map((x) => x.n));
    const learnset = detail.learnset || [];
    const rest = sortJa(learnset.filter((n) => !topNames.has(n)));
    const known = new Set([...topNames, ...learnset]);
    let html = `<option value="" ${!current ? 'selected' : ''}>${esc(I18N.dashOpt)}</option>`;
    if (current && !known.has(current)) html += `<option value="${esc(current)}" selected>${esc(tMove(current))}</option>`;
    const topOpts = top.map((x) => `<option value="${esc(x.n)}" ${x.n === current ? 'selected' : ''}>${esc(tMove(x.n))} (${x.pct}%)</option>`).join('');
    html += `<optgroup label="${esc(I18N.usageRankGroup)}">${topOpts}</optgroup>`;
    if (rest.length) {
      const restOpts = rest.map((n) => `<option value="${esc(n)}" ${n === current ? 'selected' : ''}>${esc(tMove(n))}</option>`).join('');
      html += `<optgroup label="${esc(I18N.otherGroupMoves)}">${restOpts}</optgroup>`;
    }
    return html;
  }


  function buildEditorFilledDom(el, slot, sm, detail) {
    const rb = resolveSlotSafe(slot);
    const megaOpt = slot.item ? sm.mega.find((m) => m.stone === slot.item) : undefined;
    const itemOpts = itemSelectOptions(detail.items, slot.item, core.items);
    const abilityOpts = megaOpt
      ? `<option value="${esc(megaOpt.ability)}" selected>${esc(tAbil(megaOpt.ability))}</option>`
      : fieldOptions(detail.abilities, slot.ability);
    const natureOpts = natureSelectOptions(detail.natures, slot.nature);

    const tplBtn = (detail.builds || []).length
      ? `<button type="button" class="pb-btn-sub pb-head-tpl" id="pb-preset-open">${esc(I18N.templateBtn)}</button>`
      : '';
    const head = rb ? `<div class="pb-editor-head">
        ${icoImg(rb.icon, rb.label, 'monicon')}
        <div>
          <div class="pb-editor-name">${esc(tPoke(rb.label))}${rb.mega ? `<span class="mmega-tag">${esc(I18N.megaTag)}</span>` : ''}</div>
          <div class="pb-editor-types">${typeIcoByName(rb.t1)}${rb.t2 ? typeIcoByName(rb.t2) : ''}</div>
        </div>
        ${tplBtn}
      </div>` : '';

    const evRows = EVK.map((label, si) => {
      const v = Number(slot.evs[si]) || 0;
      return `<div class="pb-ev-row" data-ev-i="${si}">
        <span class="pb-ev-lbl ev-${label}">${label}</span>
        <button type="button" class="pb-ev-step" data-ev-step="-1" data-ev-i="${si}" aria-label="${esc(I18N.evDownAria(label))}" ${v <= 0 ? 'disabled' : ''}>−</button>
        <input type="range" min="0" max="${EV_STAT_MAX}" value="${v}" class="pb-ev-range" data-ev-i="${si}">
        <button type="button" class="pb-ev-step" data-ev-step="1" data-ev-i="${si}" aria-label="${esc(I18N.evUpAria(label))}" ${v >= EV_STAT_MAX ? 'disabled' : ''}>＋</button>
        <input type="number" min="0" max="${EV_STAT_MAX}" value="${v}" class="pb-ev-num" data-ev-i="${si}">
        <span class="pb-ev-stat" data-ev-stat="${si}">${rb ? rb.stats[si] : '—'}</span>
      </div>`;
    }).join('');

    const evPresetBtn = (detail.evs || []).length
      ? `<button type="button" class="pb-btn-sub" id="pb-evpreset-open">${esc(I18N.evPresetBtn)}</button>`
      : '';

    const moveRows = [0, 1, 2, 3].map((mi) => {
      const val = slot.moves[mi] || '';
      return `<div class="pb-mv-wrap" data-mv-wrap="${mi}">
          <span class="pb-mv-ico">${typeIcoForMove(val)}</span>
          <select class="inp pb-mv-select" data-mv-i="${mi}">${moveSelectOptions(detail, val)}</select>
        </div>`;
    }).join('');

    el.innerHTML = `
      <div class="pb-editor-titlebar">
        <h2>${esc(I18N.editorHeading(selectedIdx + 1))}</h2>
      </div>
      ${head}
      <div class="dgrid pb-select-row">
        <div class="dcell"><span class="lbl item">${esc(I18N.itemLbl)}</span><select class="inp" id="pb-f-item">${itemOpts}</select></div>
        <div class="dcell"><span class="lbl abil">${esc(I18N.abilLbl)}</span><select class="inp" id="pb-f-ability" ${megaOpt ? 'disabled' : ''}>${abilityOpts}</select>${megaOpt ? `<span class="pb-mega-note">${esc(I18N.megaFixedNote)}</span>` : ''}</div>
        <div class="dcell"><span class="lbl nat">${esc(I18N.natLbl)}</span><select class="inp" id="pb-f-nature">${natureOpts}</select></div>
      </div>
      <div class="pb-ev-editor">
        ${evRows}
        <div class="pb-ev-foot"><div class="pb-ev-remain" id="pb-ev-remain">${evRemainText(slot.evs)}</div>${evPresetBtn}</div>
      </div>
      <div class="pb-moves">${moveRows}</div>
    `;

    el.querySelector('#pb-f-item').addEventListener('change', (e) => {
      slot.item = e.target.value;
      commitAndReflow();
    });
    if (!megaOpt) {
      el.querySelector('#pb-f-ability').addEventListener('change', (e) => { slot.ability = e.target.value; commitAndReflow(); });
    }
    el.querySelector('#pb-f-nature').addEventListener('change', (e) => { slot.nature = e.target.value; commitAndReflow(); });

    el.querySelectorAll('.pb-ev-range, .pb-ev-num').forEach((inp) => inp.addEventListener('input', onEvInput));
    el.querySelectorAll('.pb-ev-num').forEach((inp) => inp.addEventListener('focus', (e) => e.target.select())); // (12a) フォーカスで全選択
    el.querySelectorAll('.pb-ev-step').forEach((btn) => btn.addEventListener('click', () => onEvStepClick(+btn.dataset.evI, +btn.dataset.evStep)));
    const evPresetOpenBtn = el.querySelector('#pb-evpreset-open');
    if (evPresetOpenBtn) {
      evPresetOpenBtn.addEventListener('click', () => {
        openEvPresetListPopover(sm ? sm.n : slot.sp, (detail.evs || []).slice(0, 5), (evs) => {
          slot.evs = evs;
          commitAndReflow();
        });
      });
    }

    el.querySelectorAll('.pb-mv-select').forEach((sel) => {
      const mi = +sel.dataset.mvI;
      sel.addEventListener('change', (e) => onMoveSelect(mi, e.target.value));
    });

    // (5) 型テンプレはタップ即上書きせず、まずポップオーバーで候補一覧の内容を確認→
    // 候補ごとの「この型を適用」で確定する
    const presetOpenBtn = el.querySelector('#pb-preset-open');
    if (presetOpenBtn) {
      presetOpenBtn.addEventListener('click', () => {
        openPresetListPopover(sm ? sm.n : slot.sp, (detail.builds || []).slice(0, 5), (parsed) => {
          const targets = slot.targets;
          slot.item = parsed.item; slot.ability = parsed.ability; slot.nature = parsed.nature; slot.evs = parsed.evs; slot.moves = parsed.moves;
          slot.targets = targets;
          commitAndReflow();
        });
      });
    }

    function persist() {
      const p = activeParty();
      if (p) p.updatedAt = Date.now();
      saveStore(store);
    }
    function commitAndReflow() {
      persist();
      renderValidate();
      renderEditor();
      renderTray();
      renderTargetsPanel();
      renderBalance();
    }
  }

  function evRemainText(evs) {
    const sum = evs.reduce((a, b) => a + b, 0);
    const remain = EV_TOTAL_MAX - sum;
    return remain < 0 ? `<span class="pb-ev-over">${esc(I18N.evRemainOver(remain))}</span>` : esc(I18N.evRemain(remain));
  }
  /** EV変更の共通処理(スライダー/数値入力/±ステッパーの3経路から呼ぶ)。値を[0,32]にクランプし、
   * スライダー・数値入力・±ボタンのdisabled状態・実数値・残りポイント表示を同期する。 */
  function applyEvChange(si, rawV, sourceEl) {
    const p = activeParty();
    if (!p || selectedIdx === null) return;
    const slot = p.slots[selectedIdx];
    if (!slot) return;
    let v = Math.round(Number(rawV));
    if (Number.isNaN(v)) v = 0;
    v = Math.max(0, Math.min(EV_STAT_MAX, v));
    slot.evs[si] = v;
    p.updatedAt = Date.now();
    saveStore(store);
    const editorEl = document.getElementById('pb-editor');
    if (editorEl) {
      editorEl.querySelectorAll(`.pb-ev-range[data-ev-i="${si}"], .pb-ev-num[data-ev-i="${si}"]`).forEach((inp) => { if (inp !== sourceEl) inp.value = v; });
      editorEl.querySelectorAll(`.pb-ev-step[data-ev-i="${si}"]`).forEach((btn) => {
        const delta = +btn.dataset.evStep;
        btn.disabled = delta < 0 ? v <= 0 : v >= EV_STAT_MAX;
      });
      const rb = resolveSlotSafe(slot);
      const statEl = editorEl.querySelector(`[data-ev-stat="${si}"]`);
      if (statEl) statEl.textContent = rb ? rb.stats[si] : '—';
      const remainEl = document.getElementById('pb-ev-remain');
      if (remainEl) remainEl.innerHTML = evRemainText(slot.evs);
    }
    renderValidate();
    renderTargetsPanel();
    scheduleRenderBalance();
  }
  function onEvInput(e) {
    applyEvChange(+e.target.dataset.evI, e.target.value, e.target);
  }
  /** (2) EVステッパー「−」「＋」: タップで±1。0/32では該当ボタンをdisabledにしてある(再クランプもここで行う)。 */
  function onEvStepClick(si, delta) {
    const p = activeParty();
    if (!p || selectedIdx === null) return;
    const slot = p.slots[selectedIdx];
    if (!slot) return;
    const cur = Number(slot.evs[si]) || 0;
    applyEvChange(si, cur + delta, null);
  }

  function onMoveSelect(mi, name) {
    const p = activeParty();
    if (!p || selectedIdx === null) return;
    const slot = p.slots[selectedIdx];
    if (!slot) return;
    slot.moves[mi] = name;
    p.updatedAt = Date.now();
    saveStore(store);
    const wrap = document.querySelector(`[data-mv-wrap="${mi}"]`);
    if (wrap) { const ico = wrap.querySelector('.pb-mv-ico'); if (ico) ico.innerHTML = typeIcoForMove(name); }
    renderTargetsPanel();
    renderBalance();
  }

  // ---- 仮想敵パネル ----

  /** 仮想敵の型 ミニエディタのHTML(読み込み中はプレースホルダ)。編集対象は持ち物/特性/性格/EV/技のみ(t1/t2/bs/idxは維持)。 */
  function muEditorHtml(grp, draft, detail, loading) {
    if (loading || !detail) {
      return `<div class="pb-mu-card"><div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">${esc(I18N.loading)}</div></div></div>`;
    }
    const itemOpts = itemSelectOptions(detail.items, draft.item, core.items);
    const abilityOpts = fieldOptions(detail.abilities, draft.ability);
    const natureOpts = natureSelectOptions(detail.natures, draft.nature);
    const evRows = EVK.map((label, si) => `<div class="pb-mu-ev-row" data-mu-ev-i="${si}">
        <span class="pb-ev-lbl ev-${label}">${label}</span>
        <input type="number" min="0" max="${EV_STAT_MAX}" value="${Number(draft.ev[si]) || 0}" class="inp pb-mu-ev-num" data-mu-ev-i="${si}">
      </div>`).join('');
    const moveRows = [0, 1, 2, 3].map((mi) => {
      const val = draft.moves[mi] || '';
      return `<div class="pb-mv-wrap" data-mu-mv-wrap="${mi}">
          <span class="pb-mv-ico">${typeIcoForMove(val)}</span>
          <select class="inp pb-mv-select" data-mu-mv-i="${mi}">${moveSelectOptions(detail, val)}</select>
        </div>`;
    }).join('');
    return `<div class="pb-mu-card">
        <div class="pb-mu-head"><b>${esc(I18N.muEditHeading(tPoke(grp.label)))}</b></div>
        <div class="dgrid pb-select-row">
          <div class="dcell"><span class="lbl item">${esc(I18N.itemLbl)}</span><select class="inp" id="pb-mu-e-item">${itemOpts}</select></div>
          <div class="dcell"><span class="lbl abil">${esc(I18N.abilLbl)}</span><select class="inp" id="pb-mu-e-ability">${abilityOpts}</select></div>
          <div class="dcell"><span class="lbl nat">${esc(I18N.natLbl)}</span><select class="inp" id="pb-mu-e-nature">${natureOpts}</select></div>
        </div>
        <div class="pb-mu-ev-grid">${evRows}</div>
        <div class="pb-ev-remain" id="pb-mu-ev-remain">${evRemainText(draft.ev)}</div>
        <div class="pb-moves">${moveRows}</div>
        <div class="row" style="margin-top:.5em">
          <button class="btn" id="pb-mu-save">${esc(I18N.muSaveBtn)}</button>
          <button class="pb-btn-sub" id="pb-mu-cancel">${esc(I18N.muCancelBtn)}</button>
        </div>
      </div>`;
  }

  /** 「編集」「＋型を追加」開始。bi='new'は既定値=型1のコピー(idxは既存最大+1)。 */
  async function startMuEdit(label, bi) {
    const grp = effectiveTargets().find((g) => g.label === label);
    if (!grp) return;
    const src = bi === 'new' ? grp.builds[0] : grp.builds[bi];
    if (!src) return;
    const draft = JSON.parse(JSON.stringify(src));
    if (bi === 'new') draft.idx = Math.max(0, ...grp.builds.map((b) => b.idx)) + 1;
    muEdit = { label, bi, draft, detail: null, loading: true };
    renderTargetsPanel();
    try {
      const detail = await loadMonForTargetLabel(label);
      if (!muEdit || muEdit.label !== label || muEdit.bi !== bi) return;
      muEdit.detail = detail;
      muEdit.loading = false;
      renderTargetsPanel();
    } catch (e) {
      if (!muEdit || muEdit.label !== label || muEdit.bi !== bi) return;
      muEdit.detail = { items: [], abilities: [], natures: [], evs: [], moves: [], learnset: [], builds: [] };
      muEdit.loading = false;
      renderTargetsPanel();
    }
  }
  function cancelMuEdit() {
    muEdit = null;
    renderTargetsPanel();
  }
  /** 保存: 初回編集時にtargets.jsonデフォルトをcustomTargetsへmaterializeしてから反映する。 */
  function saveMuEdit() {
    if (!muEdit) return;
    const { label, bi, draft } = muEdit;
    const grp = effectiveTargets().find((g) => g.label === label);
    if (!grp) { muEdit = null; renderTargetsPanel(); return; }
    materializeCustomTarget(label);
    // ユーザーが型を編集した場合、指定した4技を判定に使う（デフォルト型に付いている
    // 採用率TOP10の技プールmpoolはここで捨てる）。捨てないと技を変えても判定が
    // プール側の最大打点で決まってしまい、編集が反映されないように見える。
    delete draft.mpool;
    draft.spec = targetBuildSpec(grp.sp, draft);
    if (bi === 'new') store.customTargets[label].push(draft);
    else store.customTargets[label][bi] = draft;
    saveStore(store);
    invalidateOppColsCache();
    muEdit = null;
    tuneResults = null;
    renderTargetsPanel();
    renderBalance();
  }
  /** 型の削除。最後の1型は削除不可(呼び出し側でボタンをdisabledにして防ぐ)。 */
  function deleteMuBuild(label, bi) {
    const grp = effectiveTargets().find((g) => g.label === label);
    if (!grp || grp.builds.length <= 1) return;
    materializeCustomTarget(label);
    store.customTargets[label].splice(bi, 1);
    saveStore(store);
    invalidateOppColsCache();
    if (muEdit && muEdit.label === label) muEdit = null;
    tuneResults = null;
    renderTargetsPanel();
    renderBalance();
  }
  /** 「デフォルトに戻す」: customTargetsのエントリを削除しtargets.json由来のデフォルトへ戻す。 */
  function resetMuDefault(label) {
    if (!store.customTargets || !store.customTargets[label]) return;
    delete store.customTargets[label];
    saveStore(store);
    invalidateOppColsCache();
    if (muEdit && muEdit.label === label) muEdit = null;
    tuneResults = null;
    renderTargetsPanel();
    renderBalance();
  }

  function renderTargetsPanel() {
    const el = document.getElementById('pb-targets');
    const p = activeParty();
    if (!p) { el.innerHTML = ''; muEdit = null; renderMiniBar(null, null); return; }
    if (selectedIdx === null) { el.innerHTML = `<h2>${esc(I18N.targetsHeading)}</h2><div class="muted">${esc(I18N.targetsSelectPrompt)}</div>`; muEdit = null; renderMiniBar(null, null); return; }
    const slot = p.slots[selectedIdx];
    if (!slot) { el.innerHTML = `<h2>${esc(I18N.targetsHeading)}</h2><div class="muted">${esc(I18N.targetsSetPrompt)}</div>`; muEdit = null; renderMiniBar(null, null); return; }
    const rb = resolveSlotSafe(slot);
    if (!rb) { el.innerHTML = `<h2>${esc(I18N.targetsHeading)}</h2><div class="muted">${esc(I18N.muCalcError)}</div>`; muEdit = null; renderMiniBar(null, null); return; }

    // ポケモン単位タブ: 選択中枠の仮想敵(追加済み種族)を切り替えて表示する。表示状態のみで保存はしない。
    if (!slot.targets.length) activeMuTab = null;
    else if (!activeMuTab || !slot.targets.includes(activeMuTab)) activeMuTab = slot.targets[0];
    if (muEdit && muEdit.label !== activeMuTab) muEdit = null;

    const targetsList = effectiveTargets();
    const chips = slot.targets.map((label) => {
      const grp = targetsList.find((g) => g.label === label);
      const act = label === activeMuTab ? ' act' : '';
      const badge = grp ? muTabBadge(rb, grp) : null;
      const badgeHtml = badge ? `<span class="pb-mu-badge ${badge === '×' ? 'pb-mu-badge-x' : 'pb-mu-badge-tri'}" title="${esc(I18N.muBadgeTitle)}">${badge}</span>` : '';
      return `<span class="filter-chip pb-mu-tab${act}" data-mu-tab="${esc(label)}">${grp ? icoImg(grp.icon, grp.label, '') : ''}${esc(tPoke(label))}${badgeHtml}<button class="filter-chip-x" data-rm-target="${esc(label)}">✕</button></span>`;
    }).join('');

    const activeGrp = activeMuTab ? targetsList.find((g) => g.label === activeMuTab) : null;
    const editingThis = !!(muEdit && activeGrp && muEdit.label === activeGrp.label);
    const canDelete = !!(activeGrp && activeGrp.builds.length > 1);
    const isCustomized = !!(activeGrp && store.customTargets && store.customTargets[activeGrp.label] && store.customTargets[activeGrp.label].length);
    const rows = [];
    if (activeGrp) {
      activeGrp.builds.forEach((b, bi) => {
        const opp = resolveTargetSafe(activeGrp.sp, activeGrp.label, activeGrp.icon, b, core.moves);
        if (!opp) return; // H3: 不整合buildはスキップ(型データが壊れていてもパネル全体はクラッシュさせない)
        const verdict = judge1v1(rb, opp);
        // 素早さは判定と同じ実効値(天候・エレキフィールド込み)を使う。ここだけ素の値にすると
        // 「先手と表示されているのに判定は後手扱い」という食い違いが出る。
        const mySpeed = verdict.myS;
        const oppSpeed = verdict.oppS;
        const speedTag = mySpeed > oppSpeed ? `<span class="spd-tag t-out">${esc(I18N.speedFaster)}</span>` : mySpeed < oppSpeed ? `<span class="spd-tag t-in">${esc(I18N.speedSlower)}</span>` : `<span class="spd-tag t-eq">${esc(I18N.speedEq)}</span>`;
        const myHitsTxt = verdict.myHits == null ? '—' : I18N.hitsFmt(verdict.myHits);
        const oppHitsTxt = verdict.oppHits == null ? '—' : I18N.hitsFmt(verdict.oppHits);
        const mb = moveBreakdown(rb, opp);
        // 被ダメ行: 相手の最大打点技(verdict.oppMoveと同一選定基準)の自分への与ダメレンジ・HP比。
        // 与ダメ行と同じ場の前提で出すため、向きを入れ替えて呼ぶのではなく対で取る。
        const od = pairHitDetails(rb, opp).opp;
        const oppDmg = od && od.dmgLo != null && od.dmgHi != null
          ? { name: od.n, dLo: od.dmgLo, dHi: od.dmgHi, pLo: od.pctLo, pHi: od.pctHi }
          : null;
        rows.push({ grp: activeGrp, b, bi, opp, mySpeed, oppSpeed, speedTag, verdict, myHitsTxt, oppHitsTxt, mb, oppDmg });
      });
    }

    mbPopData = [];
    const cardsHtml = rows.map((r) => {
      if (editingThis && muEdit.bi === r.bi) {
        return muEditorHtml(r.grp, muEdit.draft, muEdit.detail, muEdit.loading);
      }
      const mbDamaging = r.mb.filter((m) => m.hits != null);
      const mbChips = mbDamaging.length
        ? mbDamaging.map((m) => {
            const hitsTxt = m.certain ? I18N.hitsFmt(m.hits) : I18N.randHitsFmt(m.hits, fmtKoProbPct(m.prob));
            const dmgTxt = dmgRangeTxt(m.dmgLo, m.dmgHi, m.pctLo, m.pctHi);
            const mvName = tMove(m.n);
            const popIdx = mbPopData.push({ name: m.n, hitsTxt, dmgTxt }) - 1;
            return `<button type="button" class="pb-mb-chip" data-mb-pop="${popIdx}" title="${esc(mvName)}：${esc(I18N.popDmgLbl(dmgTxt))}">
                <span class="pb-mb-top">${esc(mvName)} ${hitsTxt}</span>
                <span class="pb-mb-dmg">${dmgTxt}</span>
              </button>`;
          }).join('')
        : `<span class="muted">${r.mb.length ? esc(I18N.noEffectiveMove) : esc(I18N.noMovesSet)}</span>`;
      const oppDmgHtml = r.oppDmg
        ? `<div class="pb-mu-row pb-mu-hit">${esc(I18N.takenDmgLbl(tMove(r.oppDmg.name), dmgRangeTxt(r.oppDmg.dLo, r.oppDmg.dHi, r.oppDmg.pLo, r.oppDmg.pHi)))}</div>`
        : '';
      const actionsHtml = editingThis ? '' : `<div class="pb-mu-actions">
          <button class="pb-btn-sub" data-mu-edit="${r.bi}">${esc(I18N.muEditBtn)}</button>
          <button class="pb-btn-sub pb-danger" data-mu-del="${r.bi}" ${canDelete ? '' : `disabled title="${esc(I18N.muDeleteLastTitle)}"`}>${esc(I18N.muDeleteBtn)}</button>
        </div>`;
      return `<div class="pb-mu-card">
          <div class="pb-mu-head"><div class="dtl-tname">${icoImg(r.grp.icon, r.grp.label, 'dtl-ico')}${esc(tPoke(r.grp.label))} ${esc(I18N.buildLabel(Number(r.b.idx) || 0))}</div>${actionsHtml}</div>
          <div class="pb-mu-sub">${esc(I18N.hpLbl(r.opp.stats[0]))}</div>
          ${muDetailHtml(r.b)}
          <div class="pb-mu-row" title="${esc(I18N.speedTipTitle)}">S ${r.mySpeed} vs ${r.oppSpeed} ${r.speedTag}</div>
          <div class="pb-mu-row"><b style="font-size:1.05em">${r.verdict.sym}</b> ${esc(I18N.hitsSelfOpp(r.myHitsTxt, r.oppHitsTxt))}${r.verdict.stub ? '<span class="pb-beta-badge">β</span>' : ''}</div>
          <div class="pb-mb-row">${mbChips}</div>
          ${oppDmgHtml}
        </div>`;
    }).join('') + (editingThis && muEdit.bi === 'new' ? muEditorHtml(activeGrp, muEdit.draft, muEdit.detail, muEdit.loading) : '');

    const addResetRow = activeGrp && !editingThis
      ? `<div class="row" style="margin-top:.5em">
          <button class="pb-btn-sub" id="pb-mu-add-build">${esc(I18N.muAddBuildBtn)}</button>
          ${isCustomized ? `<button class="pb-btn-sub" id="pb-mu-reset-default">${esc(I18N.muResetDefaultBtn)}</button>` : ''}
        </div>`
      : '';
    // モバイルのボトムシート(renderMiniBar)にもそのまま渡す共通ブロック(型カード一覧+空メッセージ)。
    const cardsBlockHtml = rows.length || editingThis
      ? `<div class="pb-mu-list">${cardsHtml}</div>`
      : slot.targets.length ? '' : `<div class="muted" style="margin-top:.6em">${esc(I18N.addTargetsPrompt)}</div>`;

    el.innerHTML = `
      <h2>${esc(I18N.targetsHeading)}</h2>
      <div class="filter-chips" id="pb-target-chips">${chips}</div>
      <div class="filter-wrap">
        <input type="text" id="pb-target-search" class="filter-inp" placeholder="${esc(I18N.targetSearchPlaceholder)}" autocomplete="off">
        <div class="filter-sug" id="pb-target-sug" style="display:none"></div>
      </div>
      ${cardsBlockHtml}
      ${addResetRow}
      <div class="row" style="margin-top:.7em">
        <button class="pb-btn-sub" id="pb-tune-btn" ${slot.targets.length ? '' : 'disabled'}>${esc(I18N.tuneBtn)}</button>
      </div>
      <div id="pb-tune-out"></div>
    `;

    /** chips/cardsBlockHtml/addResetRow(=型カード・タブ・編集フォーム一式)のイベント紐付け。
     * 仮想敵パネル本体(el)とモバイルのボトムシート(#pb-sheet-body)の両方から同じ内容で呼ばれるため、
     * ここを共通化することでシート側の二重実装(別のクリックハンドラ群)を避ける。rootはid付き要素を
     * root.querySelector(...)で探すため、同じidを持つ2つのDOM(パネル/シート)が同時に存在していても
     * 互いのイベントを誤って拾わない。 */
    function bindMuSection(root) {
      root.querySelectorAll('[data-mb-pop]').forEach((btn) => btn.addEventListener('click', () => {
        const d = mbPopData[+btn.dataset.mbPop];
        if (!d) return;
        openInfoPopover(tMove(d.name), `<div class="mvwrap" style="margin-bottom:.6em">${typeIcoForMove(d.name)}<span class="mvchip">${esc(tMove(d.name))}</span></div><div>${esc(I18N.popHitsLbl(d.hitsTxt))}</div><div>${esc(I18N.popDmgLbl(d.dmgTxt))}</div>`);
      }));

      root.querySelectorAll('[data-mu-tab]').forEach((chip) => chip.addEventListener('click', (e) => {
        if (e.target.closest('[data-rm-target]')) return;
        activeMuTab = chip.dataset.muTab;
        muEdit = null;
        renderTargetsPanel();
      }));
      root.querySelectorAll('[data-rm-target]').forEach((btn) => btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const removed = btn.dataset.rmTarget;
        slot.targets = slot.targets.filter((l) => l !== removed);
        p.updatedAt = Date.now();
        saveStore(store);
        tuneResults = null;
        if (activeMuTab === removed) activeMuTab = null;
        if (muEdit && muEdit.label === removed) muEdit = null;
        renderTargetsPanel();
      }));

      // 型の編集/追加/削除/デフォルトに戻す
      root.querySelectorAll('[data-mu-edit]').forEach((btn) => btn.addEventListener('click', () => startMuEdit(activeGrp.label, +btn.dataset.muEdit)));
      root.querySelectorAll('[data-mu-del]').forEach((btn) => btn.addEventListener('click', () => {
        if (btn.disabled) return;
        deleteMuBuild(activeGrp.label, +btn.dataset.muDel);
      }));
      const addBtn = root.querySelector('#pb-mu-add-build');
      if (addBtn) addBtn.addEventListener('click', () => startMuEdit(activeGrp.label, 'new'));
      const resetBtn = root.querySelector('#pb-mu-reset-default');
      if (resetBtn) resetBtn.addEventListener('click', () => resetMuDefault(activeGrp.label));

      if (editingThis && !muEdit.loading && muEdit.detail) {
        const itemSel = root.querySelector('#pb-mu-e-item');
        if (itemSel) itemSel.addEventListener('change', (e) => { muEdit.draft.item = e.target.value; });
        const abilSel = root.querySelector('#pb-mu-e-ability');
        if (abilSel) abilSel.addEventListener('change', (e) => { muEdit.draft.ability = e.target.value; });
        const natSel = root.querySelector('#pb-mu-e-nature');
        if (natSel) natSel.addEventListener('change', (e) => { muEdit.draft.nature = e.target.value; });
        root.querySelectorAll('[data-mu-ev-i]').forEach((inp) => {
          inp.addEventListener('input', (e) => {
            const si = +e.target.dataset.muEvI;
            let v = Math.round(Number(e.target.value));
            if (Number.isNaN(v)) v = 0;
            v = Math.max(0, Math.min(EV_STAT_MAX, v));
            muEdit.draft.ev[si] = v;
            const remainEl = root.querySelector('#pb-mu-ev-remain');
            if (remainEl) remainEl.innerHTML = evRemainText(muEdit.draft.ev);
          });
          inp.addEventListener('focus', (e) => e.target.select()); // (12a) フォーカスで全選択
        });
        root.querySelectorAll('[data-mu-mv-i]').forEach((sel) => {
          const mi = +sel.dataset.muMvI;
          sel.addEventListener('change', (e) => {
            muEdit.draft.moves[mi] = e.target.value;
            const wrap = root.querySelector(`[data-mu-mv-wrap="${mi}"]`);
            if (wrap) { const ico = wrap.querySelector('.pb-mv-ico'); if (ico) ico.innerHTML = typeIcoForMove(e.target.value); }
          });
        });
        const saveBtn = root.querySelector('#pb-mu-save');
        if (saveBtn) saveBtn.addEventListener('click', saveMuEdit);
        const cancelBtn = root.querySelector('#pb-mu-cancel');
        if (cancelBtn) cancelBtn.addEventListener('click', cancelMuEdit);
      }
    }

    bindMuSection(el);
    renderMiniBar(activeGrp, rows, { chips, cardsBlockHtml, addResetRow, bindMuSection });

    const searchInput = el.querySelector('#pb-target-search');
    searchInput.addEventListener('input', (e) => onTargetSearchInput(e.target.value));
    searchInput.addEventListener('keydown', onTargetSearchKey);

    el.querySelector('#pb-tune-btn').addEventListener('click', onTuneClick);
    if (tuneResults) renderTuneOut();
  }

  function onTargetSearchInput(val) {
    const sug = document.getElementById('pb-target-sug');
    if (!sug || !core) return;
    targetSugActive = -1;
    const q = val.trim();
    if (!q) { sug.style.display = 'none'; return; }
    const qk = toKatakana(q);
    const hits = effectiveTargets().filter((g) => matchesQuery(g.label, q, qk)).slice(0, 12);
    const p = activeParty();
    const slot = p.slots[selectedIdx];
    if (!hits.length) { sug.innerHTML = `<div class="sug-item added">${esc(I18N.noHit)}</div>`; sug.style.display = 'block'; return; }
    sug.innerHTML = hits.map((g) => {
      const already = slot.targets.includes(g.label);
      return `<div class="sug-item${already ? ' added' : ''}" data-target-pick="${esc(g.label)}">${icoImg(g.icon, g.label, '')}<span>${hlSug(g.label, q)}</span></div>`;
    }).join('');
    sug.querySelectorAll('[data-target-pick]:not(.added)').forEach((it) => it.addEventListener('click', () => pickTarget(it.dataset.targetPick)));
    sug.style.display = 'block';
  }
  function pickTarget(label) {
    const p = activeParty();
    const slot = p.slots[selectedIdx];
    if (!slot.targets.includes(label)) slot.targets.push(label);
    p.updatedAt = Date.now();
    saveStore(store);
    const input = document.getElementById('pb-target-search');
    if (input) { input.value = ''; input.focus(); }
    targetSugActive = -1;
    tuneResults = null;
    activeMuTab = label;
    renderTargetsPanel();
  }
  function onTargetSearchKey(e) {
    const sug = document.getElementById('pb-target-sug');
    if (!sug || sug.style.display === 'none') return;
    const items = [...sug.querySelectorAll('[data-target-pick]:not(.added)')];
    if (e.key === 'ArrowDown') { e.preventDefault(); targetSugActive = Math.min(targetSugActive + 1, items.length - 1); items.forEach((it, i) => it.classList.toggle('act', i === targetSugActive)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); targetSugActive = Math.max(targetSugActive - 1, 0); items.forEach((it, i) => it.classList.toggle('act', i === targetSugActive)); }
    else if (e.key === 'Enter') { e.preventDefault(); if (targetSugActive >= 0 && items[targetSugActive]) pickTarget(items[targetSugActive].dataset.targetPick); else if (items.length === 1) pickTarget(items[0].dataset.targetPick); }
    else if (e.key === 'Escape') { sug.style.display = 'none'; }
  }

  function onTuneClick() {
    const p = activeParty();
    const slot = p.slots[selectedIdx];
    const rb = resolveSlotSafe(slot);
    if (!rb) return;
    const oppResolved = [];
    const targetsList = effectiveTargets();
    slot.targets.forEach((label) => {
      const grp = targetsList.find((g) => g.label === label);
      if (!grp) return;
      grp.builds.forEach((b) => {
        const resolved = resolveTargetSafe(grp.sp, grp.label, grp.icon, b, core.moves);
        if (resolved) oppResolved.push(resolved);
      });
    });
    tuneResults = tuneForTargets(slot, rb, oppResolved);
    renderTuneOut();
  }
  const TUNE_KIND_LABEL = { speed: I18N.tuneKindSpeed, ko: I18N.tuneKindKo, survive: I18N.tuneKindSurvive };
  const TUNE_KIND_ICON = { speed: '⚡', ko: '⚔️', survive: '🛡️' };
  function renderTuneOut() {
    const out = document.getElementById('pb-tune-out');
    if (!out) return;
    if (!tuneResults || !tuneResults.length) { out.innerHTML = ''; return; }
    let lastKind = null;
    out.innerHTML = tuneResults.map((t, i) => {
      const headHtml = t.kind !== lastKind
        ? `<div class="pb-tune-head">${TUNE_KIND_ICON[t.kind] || ''} ${esc(TUNE_KIND_LABEL[t.kind] || t.kind)}</div>`
        : '';
      lastKind = t.kind;
      return `${headHtml}<div class="pb-tune-item">
        <span>${esc(t.text)}</span>${t.stub ? '<span class="pb-beta-badge">β</span>' : ''}
        ${t.evs ? `<button class="pb-btn-sub" data-tune-apply="${i}">${esc(I18N.applyBtn)}</button>` : ''}
      </div>`;
    }).join('');
    out.querySelectorAll('[data-tune-apply]').forEach((btn) => btn.addEventListener('click', () => {
      const i = +btn.dataset.tuneApply;
      const sugg = tuneResults[i];
      if (!sugg || !sugg.evs) return;
      const p = activeParty();
      const slot = p.slots[selectedIdx];
      slot.evs = sugg.evs;
      p.updatedAt = Date.now();
      saveStore(store);
      tuneResults = null;
      renderValidate();
      renderEditor();
      renderTargetsPanel();
      renderBalance();
      renderTray();
    }));
  }

  /** サマリー行「苦手」の内訳表示: 名前(＋小アイコン)を列挙。0体は「なし」、3体超は先頭3体+「…」でtitleに全列挙。 */
  function holeNamesHtml(holeLabels) {
    if (!holeLabels.length) return esc(I18N.holeNone);
    const withIcon = (label) => {
      const grp = effectiveTargets().find((g) => g.label === label);
      return `${grp ? icoImg(grp.icon, label, 'pb-hole-ico') : ''}${esc(tPoke(label))}`;
    };
    if (holeLabels.length <= 3) return holeLabels.map(withIcon).join('、');
    return `<span title="${esc(holeLabels.map(tPoke).join('、'))}">${holeLabels.slice(0, 3).map(withIcon).join('、')}…</span>`;
  }

  // ---- パーティバランス ----
  function renderBalance() {
    const el = document.getElementById('pb-balance');
    const resolvedParty = resolvedPartyList();
    if (!resolvedParty.length) {
      el.innerHTML = `<h2>${esc(I18N.balanceHeading)}</h2><div class="muted">${esc(I18N.addPokemonPrompt)}</div>`;
      return;
    }
    const sum = partySummary(resolvedParty);
    const holeInfo = findHoles(resolvedParty, buildOppCols());
    el.innerHTML = `
      <h2>${esc(I18N.balanceHeading)}</h2>
      <div class="bd-strip">
        <span class="bd-lb">${esc(I18N.physAtk)}</span><span class="bd-seg">${sum.physical}</span>
        <span class="bd-lb">${esc(I18N.specAtk)}</span><span class="bd-seg">${sum.special}</span>
        <span class="bd-lb">${esc(I18N.megaLbl)}</span><span class="bd-seg">${sum.mega}</span>
        <span class="bd-lb">${esc(I18N.scarfLbl)}</span><span class="bd-seg">${sum.scarf}</span>
        <span class="bd-lb">${esc(I18N.avgSpeedLbl)}</span><span class="bd-seg">${Math.round(sum.avgSpeed)}</span>
        <span class="bd-lb">${esc(I18N.weakOverlapLbl)}</span><span class="bd-seg">${esc(I18N.weakOverlapVal(tType(sum.weakOverlap.type), sum.weakOverlap.count))}</span>
      </div>
      ${holeInfo.holeLabels.length
        ? `<div class="pb-hole-summary"><span>${esc(I18N.holeSummary(''))}${holeNamesHtml(holeInfo.holeLabels)}</span><button type="button" class="pb-btn-sub pb-holefill-btn" id="pb-holefill-btn">${esc(I18N.holeFillBtn)}</button></div>`
        : `<div class="pb-hole-summary pb-hole-ok"><span>${esc(I18N.holeOkMsg)}</span></div>`}
      <div class="tabbar">
        <button class="tb${balanceTab === 'atk' ? ' active' : ''}" data-t="atk">${esc(I18N.tabAtk)}</button>
        <button class="tb${balanceTab === 'def' ? ' active' : ''}" data-t="def">${esc(I18N.tabDef)}</button>
        <button class="tb${balanceTab === 'speed' ? ' active' : ''}" data-t="speed">${esc(I18N.tabSpeed)}</button>
        <button class="tb${balanceTab === 'mu' ? ' active' : ''}" data-t="mu">${esc(I18N.tabMu)}</button>
      </div>
      <div class="pane" id="pb-balance-pane">${balancePaneHtml(resolvedParty, balanceTab)}</div>
    `;
    bindMtxPopovers(document.getElementById('pb-balance-pane'));
    bindHoleFillButton(el);
    el.querySelectorAll('.tb').forEach((btn) => btn.addEventListener('click', () => {
      balanceTab = btn.dataset.t;
      el.querySelectorAll('.tb').forEach((b) => b.classList.toggle('active', b.dataset.t === balanceTab));
      const pane = document.getElementById('pb-balance-pane');
      pane.innerHTML = balancePaneHtml(resolvedParty, balanceTab);
      bindMtxPopovers(pane);
    }));
  }
  function balancePaneHtml(resolvedParty, tab) {
    if (tab === 'def') return typeMatrixHtml(resolvedParty, 'def');
    if (tab === 'speed') return speedMatrixHtml(resolvedParty);
    if (tab === 'mu') return matchupMatrixHtml(resolvedParty);
    return typeMatrixHtml(resolvedParty, 'atk');
  }
  function typeMatrixHtml(resolvedParty, kind) {
    const am = attackMatrix(resolvedParty);
    const dm = defenseMatrix(resolvedParty);
    const gapIdx = kind === 'def' ? findWeakGapTypeIdx(resolvedParty) : null;
    const corner = kind === 'atk' ? I18N.selfVsAtk : I18N.selfVsHit;
    const head = `<tr><th class="mtx-corner mtx-stick">${esc(corner)}</th>` + TYPES.map((t, ti) => `<th class="${gapIdx && gapIdx.has(ti) ? 'mtx-gap' : ''}" title="${esc(t)}">${typeIcoByName(t)}</th>`).join('') + `</tr>`;
    const rows = resolvedParty.map((b, mi) => {
      const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(b.icon, b.label, 'mtx-ico')}<div class="mtx-name">${esc(tPoke(b.label))}</div></div></th>`;
      const cells = TYPES.map((t, ti) => {
        if (kind === 'atk') {
          const mult = am.cells[mi][ti];
          const inner = mult == null ? '–' : (DEFG(mult) || '・');
          const cls = mult == null ? 'ao-none' : mult >= 2 ? 'ao-good' : mult === 1 ? 'ao-neu' : 'ao-bad';
          return `<td class="${cls}">${inner}</td>`;
        }
        const mult = dm.cells[mi][ti];
        return `<td class="${DEFC(mult)}">${DEFG(mult) || '・'}</td>`;
      }).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    const legend = kind === 'atk'
      ? `<div class="mtx-legend"><span>${I18N.atkLegend}</span></div>`
      : `<div class="mtx-legend"><span>${I18N.defLegend}</span></div>`;
    return `${legend}<div class="mg"><table class="mtx">${head}${rows}</table></div>`;
  }
  function speedMatrixHtml(resolvedParty) {
    const oppCols = buildOppCols();
    const rows = speedOrder(resolvedParty);
    const byLabel = new Map(resolvedParty.map((b) => [b.label, b]));
    const head = `<tr><th class="mtx-corner mtx-stick">${esc(I18N.selfVsOppRep)}</th>` + oppCols.map((o) => oppHeaderCellHtml(o)).join('') + `</tr>`;
    const bodyRows = rows.map((r) => {
      const b = byLabel.get(r.label);
      const scarf = b && b.item === 'こだわりスカーフ';
      const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(b ? b.icon : null, r.label, 'mtx-ico')}<div class="mtx-name">${esc(tPoke(r.label))}<br><span class="sp-val">S${r.speed}${scarf ? '⚡' : ''}</span></div></div></th>`;
      const cells = oppCols.map((o) => {
        const rep = o.builds[0];
        const oppSpeed = effectiveSpeed(rep.stats[5], rep.item);
        const sym = r.speed > oppSpeed ? 'win' : r.speed < oppSpeed ? 'lose' : 'may';
        const label2 = { win: '◎', may: '△', lose: '×' }[sym];
        const cls = { win: 'bg-cc', may: 'bg-cn', lose: 'bg-cx' }[sym];
        return `<td class="${cls}">${label2}</td>`;
      }).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    return `<div class="mtx-legend"><span>${I18N.speedMatrixLegend}</span></div>
      <div class="mg"><table class="mtx">${head}${bodyRows}</table></div>`;
  }
  /** 型ごとの内訳を1件ずつの配列で返す(タップポップオーバーはリスト表示、titleはこれをjoinした文字列を使う)。
   * 移植元: scripts/_explain.py matchup_grid() の集約対象そのもの。 */
  function muBreakdownLines(agg, builds) {
    return agg.verdicts.map((v, vi) => {
      const build = builds[vi];
      const myTxt = v.myHits == null ? '—' : I18N.selfHitsFmt(v.myHits);
      const oppTxt = v.oppHits == null ? '—' : I18N.oppHitsFmt(v.oppHits);
      const item = build.item ? tItem(build.item) : I18N.noItem;
      return I18N.muBreakdownLine(vi + 1, item, v.sym, myTxt, oppTxt, v.fast ? I18N.turnFirst : I18N.turnSecond);
    });
  }
  function muBreakdownTitle(agg, builds) {
    return muBreakdownLines(agg, builds).join(' / ');
  }
  /** EV文字列「H4 A28 ...」(0のstatは省略)。移植元: scripts/_explain.py _ev_str()。値は32スケールのまま(表示上の変換なし)。 */
  function pbEvStr(evs) {
    return EVK.map((k, i) => (Number(evs[i]) ? `${k}${evs[i]}` : null)).filter(Boolean).join(' ');
  }
  /** 相性マトリクスのセル詳細ポップオーバー用の確定数表示。「簡単構築」(PartySuggestApp.astro
   * matchupDetailHtml/tKo)の表記(確N/乱N/圏外)に合わせる(工房本来の「乱数N発(P%)」形式とは別表記)。
   * pairHitDetails()のhitsは確定時=最低乱数の確定数・不確定時=最大乱数の発数を返すため、
   * その値をそのまま閾値判定に使えば scripts/_explain.py _dmg_line() の「n_lo>=5→圏外」と一致する
   * (詳細はmatchup.tsの_detailのコメント参照)。 */
  function pbMuDetailKoTxt(d) {
    if (!d || d.hits == null || d.hits >= 5) return I18N.muDetailKoOOR;
    return d.certain ? I18N.hitsFmt(d.hits) : I18N.muDetailKoRoll(d.hits);
  }
  /** 常に同じ前提は既定で畳んで出す。列挙をヘッダーに直書きすると増えるたびに伸びるため。
   * 文言は assumptions.ts に1箇所で持つ（ポップアップが3実装あり、片方だけ直す事故が起きた）。 */
  function assumptionsHtml() {
    const items = (MATCHUP_ASSUMPTIONS[lang] || MATCHUP_ASSUMPTIONS.ja).map((a) => `<li>${esc(a)}</li>`).join('');
    return `<details class="pb-pop-assume"><summary>${esc(ASSUMPTIONS_LABEL[lang] || ASSUMPTIONS_LABEL.ja)}</summary><ul>${items}</ul></details>`;
  }
  /** 与ダメ内訳1件。「簡単構築」のdmgRow相当(与ダメ%レンジ+確定数+技名)。 */
  function pbMuDetailLine(d) {
    if (!d) return { moveTxt: I18N.dashOpt, pctTxt: '0%', koTxt: I18N.muDetailKoOOR, noteTxt: '' };
    const pctTxt = `${Math.round(d.pctLo)}〜${Math.round(d.pctHi)}%`;
    return { moveTxt: tMove(d.n), pctTxt, koTxt: pbMuDetailKoTxt(d),
             // 発数が素の計算より増えた要因（ばけのかわ/タスキ/たべのこし等）と、
             // ダメージ計算に効いた場の条件（天候・フィールド・いかく）。
             noteTxt: [d.reason ? I18N.muNoteHits(d.reason) : '', d.conds ? I18N.muNoteConds(d.conds) : ''].filter(Boolean).join(' / ') };
  }
  /** 相性マトリクスのセルをタップした時の詳細ポップオーバー本体。PartySuggestApp.astroの
   * matchupDetailHtml()と同じ列構成(型ごとの列・与ダメ/被ダメ/素早さ/判定の4行)・体裁(pb-pop-*)で、
   * クライアント計算値(pairHitDetails/judge1v1)から生成する(APIは叩かない)。
   * 数値は仮想敵パネルの技別チップ(moveBreakdown)・判定バッジ(judge1v1)と同一関数を使うため一致する。 */
  function matchupCellDetailHtml(b, o) {
    const builds = (o.builds || []).slice(0, 3);
    const cols = builds.map((opp, i) => `<th>${esc(I18N.buildLabel(i + 1))}<span class="pb-pop-types">${typeIcoByName(opp.t1)}${opp.t2 ? typeIcoByName(opp.t2) : ''}</span><span class="pb-pop-col-sub">${esc(tItem(opp.item)) || esc(I18N.noItem)}<br>${esc(tNature(opp.nature))}<br>${esc(pbEvStr(opp.evs))}</span></th>`).join('');
    // 与ダメ・被ダメは同じ場の前提で出す（向きごとに呼ぶと天候が食い違う）
    const pairs = builds.map((opp) => pairHitDetails(b, opp));
    const meLines = pairs.map((d) => pbMuDetailLine(d.my));
    const opLines = pairs.map((d) => pbMuDetailLine(d.opp));
    const verdicts = builds.map((opp) => judge1v1(b, opp));
    const dmgRow = (label, lines) => `<tr><td class="lft">${esc(label)}</td>${lines.map((c) => `<td><span class="pb-pop-pct">${esc(c.pctTxt)}</span> <span class="pb-pop-ko">${esc(c.koTxt)}</span><br><span class="pb-pop-ko">${esc(c.moveTxt)}</span>${c.noteTxt ? `<br><span class="pb-pop-note">${esc(c.noteTxt)}</span>` : ''}</td>`).join('')}</tr>`;
    const spRow = `<tr><td class="lft">${esc(I18N.muSpeedRowLbl)}</td>${verdicts.map((v) => `<td class="${v.fast ? 'sp-win' : 'sp-lose'}">${esc(I18N.muDetailSpdTxt(v.fast ? I18N.turnFirst : I18N.turnSecond, v.myS, v.oppS))}</td>`).join('')}</tr>`;
    const jRow = `<tr><td class="lft">${esc(I18N.muJudgeRowLbl)}</td>${verdicts.map((v, i) => `<td class="${symCls(v.sym)}"><b style="font-size:1.05em">${v.sym}</b><br><span class="pb-pop-ko">${esc(I18N.muDetailJudgeTxt(v.win ? I18N.muDetailJudgeWin : I18N.muDetailJudgeLoss, meLines[i].koTxt, opLines[i].koTxt, v.fast ? I18N.turnFirst : I18N.turnSecond))}</span></td>`).join('')}</tr>`;
    const table = `<div style="overflow-x:auto"><table class="pb-pop-t"><tr><th class="lft"> </th>${cols}</tr>${dmgRow(I18N.muDmgSelfLbl, meLines)}${dmgRow(I18N.muDmgOppLbl, opLines)}${spRow}${jRow}</table></div>`;
    return `<div class="pb-pop-hd">${icoImg(b.icon, b.label, '')}${esc(tPoke(b.label))}<span class="pb-arw">vs</span>${icoImg(o.icon, o.label, '')}${esc(tPoke(o.label))}</div>
      <div class="pb-pop-sub">${esc(MATCHUP_LEAD[lang] || MATCHUP_LEAD.ja)}</div>
      ${assumptionsHtml()}
      ${table}
      ${addTargetButtonHtml(o.label)}`;
  }
  function matchupMatrixHtml(resolvedParty) {
    const oppCols = buildOppCols();
    const holeInfo = findHoles(resolvedParty, oppCols);
    const summary = '';
    // 行見出しをアイコンだけにしたぶん、コーナーも同じ幅に詰める。
    // 軸の説明（各味方 vs 相手）は表の上の説明文にあるので、ここは短縮表記でよい。
    const head = `<tr><th class="mtx-corner mtx-stick mtx-stick-ico" title="${esc(I18N.selfVsOppAgg)}">${esc(I18N.selfVsOppShort || '自＼相')}</th>` + oppCols.map((o, ci) => oppHeaderCellHtml(o, holeInfo.holeIdx.has(ci) ? 'mtx-hole' : '')).join('') + `</tr>`;
    mtxPopData = [];
    const rows = resolvedParty.map((b) => {
      // 1v1判定は列が多く、スマホでは横幅が足りない。自分側はアイコンだけで判別できるので
      // 名前を出さない（アイコンの alt/title に名前は残るのでホバー・読み上げでは分かる）。
      const hd = `<th class="mtx-stick mtx-stick-ico">${icoImg(b.icon, b.label, 'mtx-ico')}</th>`;
      const cells = oppCols.map((o) => {
        const agg = judgeVsBuilds(b, o.builds);
        const lines = muBreakdownLines(agg, o.builds);
        const title = lines.join(' / ');
        const popIdx = mtxPopData.push({ b, o }) - 1;
        return `<td class="${symCls(agg.sym)}" title="${esc(title)}" data-mtx-pop="${popIdx}">${agg.sym}${agg.dep ? '<span class="mu-dep">*</span>' : ''}</td>`;
      }).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    return `${summary}<div class="mtx-legend"><span>${I18N.muMatrixLegend}</span></div>
      <div class="mg"><table class="mtx">${head}${rows}</table></div>`;
  }
  /** (8) ポップオーバー内「この相手を枠Xの仮想敵に追加」ボタンのHTML。枠未選択・既追加はdisabled。 */
  function addTargetButtonHtml(oppLabel) {
    const p = activeParty();
    const slot = p && selectedIdx !== null ? p.slots[selectedIdx] : null;
    if (!slot) {
      return `<div class="row" style="margin-top:.8em"><button class="pb-btn-sub" disabled title="${esc(I18N.addTargetDisabledTitle)}">${esc(I18N.addTargetDisabled)}</button></div>`;
    }
    const already = slot.targets.includes(oppLabel);
    return `<div class="row" style="margin-top:.8em"><button type="button" class="pb-btn-sub" id="pb-mtx-add-target" ${already ? 'disabled' : ''}>${esc(I18N.addTargetToSlot(selectedIdx + 1))}${already ? esc(I18N.addedSuffix) : ''}</button></div>`;
  }
  /** (8) 追加確定: 選択中枠のtargetsにラベルを足し、仮想敵パネルを再描画してポップオーバーを閉じる。 */
  function addTargetFromMatrix(label) {
    const p = activeParty();
    if (!p || selectedIdx === null) return;
    const slot = p.slots[selectedIdx];
    if (!slot || slot.targets.includes(label)) return;
    slot.targets.push(label);
    p.updatedAt = Date.now();
    saveStore(store);
    tuneResults = null;
    activeMuTab = label;
    hideModal();
    renderTargetsPanel();
  }
  /** (5) ポケモン相性マトリクスのセルはタップ/クリックで内訳をポップオーバー表示する(titleはPCのホバー用に併存)。
   * (8) ポップオーバー内に「この相手を枠Xの仮想敵に追加」ボタンを併設する。 */
  function bindMtxPopovers(paneEl) {
    if (!paneEl) return;
    paneEl.querySelectorAll('[data-mtx-pop]').forEach((td) => td.addEventListener('click', () => {
      const d = mtxPopData[+td.dataset.mtxPop];
      if (!d) return;
      openInfoPopover('', matchupCellDetailHtml(d.b, d.o));
      const addBtn = document.getElementById('pb-mtx-add-target');
      if (addBtn && !addBtn.disabled) addBtn.addEventListener('click', () => addTargetFromMatrix(d.o.label));
    }));
  }

  // ---- (2) 穴を埋める候補 ----
  /** ポケモン相性タブの穴サマリー行のボタンをクリック可能にする(穴0の時はボタン自体が無い)。 */
  function bindHoleFillButton(paneEl) {
    if (!paneEl) return;
    const btn = paneEl.querySelector('#pb-holefill-btn');
    if (btn) btn.addEventListener('click', onHoleFillClick);
  }
  /** 候補の代表型Slotを組み立てる。mon/{icon}.json の builds[0](使用率最多の型spec)を優先し、
   * builds が空(データ欠落)の種のみ items/abilities/natures/evs/moves それぞれの使用率最頻値から
   * 組み立てるフォールバックを使う。 */
  /** 候補種の型を採用率順で返す。メガ石持ちの型と非メガの型が両方あるとき、入れ替え相手の
   * メガ有無に合わせて選べるようにするため単一の代表型ではなく候補列を返す。 */
  function candidateSlotsForCandidate(spName, detail) {
    const out = [];
    if (detail && Array.isArray(detail.builds)) {
      detail.builds.forEach((spec) => {
        const slot = fromSpec(spec);
        if (slot) out.push(slot);
      });
    }
    out.push(representativeSlotForCandidate(spName, detail));
    return out;
  }
  function representativeSlotForCandidate(spName, detail) {
    const item = detail && detail.items && detail.items[0] ? detail.items[0].n : '';
    const ability = detail && detail.abilities && detail.abilities[0] ? detail.abilities[0].n : '';
    const nature = detail && detail.natures && detail.natures[0] ? detail.natures[0].n : '';
    const evs = detail && detail.evs && detail.evs[0] ? [...detail.evs[0].ev] : [0, 0, 0, 0, 0, 0];
    const moves = detail && Array.isArray(detail.moves) ? detail.moves.slice(0, 4).map((m) => m.n) : [];
    return { sp: spName, item, ability, nature, evs, moves, targets: [] };
  }
  /** 現在のパーティ・仮想敵の状態を表す軽量な文字列。同じ状態ならholeFillResultを再利用する
   * (「パーティ・仮想敵編集で無効化されるまでキャッシュ」の判定に、キャッシュ無効化フラグを
   * 各所に仕込む代わりにこの署名比較を使う)。 */
  function holeFillSignature(resolvedParty, oppCols) {
    const buildSig = (b) => `${b.sp}|${b.item}|${b.ability}|${b.nature}|${b.evs.join(',')}|${b.moves.map((m) => m.n).join(',')}`;
    const partySig = resolvedParty.map(buildSig).join(';');
    const oppSig = oppCols.map((o) => `${o.label}:${o.builds.map(buildSig).join('/')}`).join(';');
    return `${partySig}##${oppSig}`;
  }
  /**
   * 穴を埋める候補の計算本体。候補プール(使用率上位~50種、パーティと図鑑番号重複除外)を
   * mon/{icon}.json 並列fetchし、各候補×oppCols(≤30列)の集約判定(judgeVsBuilds)を1回だけ
   * coverageSet()で計算してカバレッジ集合を作る(party各メンバーの被覆も同様)。
   * 入れ替え探索(6メンバー×候補数)はholesAfterSwap()の集合演算のみで行い、
   * judgeVsBuildsを6×候補数だけ追加で呼ぶことはしない。
   */
  async function computeHoleFillSuggestions(party, oppCols, holeInfo) {
    const filledIdx = [];
    const resolvedParty = [];
    party.slots.forEach((slot, i) => {
      const rb = resolveSlotSafe(slot);
      if (rb) { filledIdx.push(i); resolvedParty.push(rb); }
    });
    const emptySlotIdx = party.slots.map((s, i) => (s ? null : i)).filter((i) => i !== null);

    const usedDex = new Set(resolvedParty.map((b) => (b.icon || '').split('-')[0]));
    const pool = [...core.species]
      .filter((s) => !usedDex.has((s.icon || '').split('-')[0]))
      .sort((a, b) => a.rank - b.rank)
      .slice(0, 50);

    const monDetails = await Promise.all(pool.map((s) => loadMon(s.icon).catch(() => null)));

    // メガは1体しか進化できないため、3体以上積むと選出パターンが減る。候補はメガ型・非メガ型を
    // 最大1つずつ持ち、追加はメガ2体まで、入れ替えはメガ有無が一致する組み合わせのみに絞る。
    // 同一種でもメガ型/非メガ型・持ち物違いを最大3型まで持つ(もちもの重複フィルタが効いたときに
    // 同じ種の別の型へ落とせるように)。
    const megaCount = resolvedParty.filter((b) => b.mega).length;
    const candidates = [];
    pool.forEach((sp, i) => {
      const seen = new Set();
      let nMega = 0, nPlain = 0;
      candidateSlotsForCandidate(sp.n, monDetails[i]).forEach((slot) => {
        if (nMega + nPlain >= 3) return;
        const rb = resolveSlotSafe(slot);
        if (!rb) return;
        const key = `${rb.mega ? 'M' : 'P'}|${rb.item}`;
        if (seen.has(key) || (rb.mega ? nMega >= 2 : nPlain >= 2)) return;
        seen.add(key);
        if (rb.mega) nMega++; else nPlain++;
        candidates.push({ sp: sp.n, icon: sp.icon, slot, build: rb, mega: rb.mega, cov: coverageSet(rb, oppCols) });
      });
    });

    const partyCoverage = resolvedParty.map((b) => coverageSet(b, oppCols));
    return {
      candidates,
      members: resolvedParty.map((b, mi) => ({ label: b.label, icon: b.icon, mega: b.mega, item: b.item, slotIdx: filledIdx[mi] })),
      holeIdx: holeInfo.holeIdx,
      exposed: exposedOnRemoval(partyCoverage, oppCols.length),
      megaCount,
      emptySlotIdx,
      oppCols,
      poolSize: pool.length,
    };
  }
  /** 計算済みの候補群から、表示用の追加候補・入れ替え提案を選ぶ。もちもの重複フィルタの
   * 切り替えは再計算せずここだけ通し直す(coverageSetの計算はcomputeHoleFillSuggestions側で完了済み)。 */
  function selectHoleFillLists(raw, allowDupItem) {
    const MEGA_MAX = 2;
    const { candidates, members, holeIdx, exposed, megaCount } = raw;
    const dupNg = (item, forbidden) => !allowDupItem && item && forbidden.has(item);

    const partyItems = new Set(members.map((m) => m.item).filter(Boolean));
    const bestAdd = new Map();
    candidates.forEach((c) => {
      if (c.mega && megaCount >= MEGA_MAX) return;
      if (dupNg(c.build.item, partyItems)) return;
      const covered = [...c.cov].filter((ci) => holeIdx.has(ci));
      if (!covered.length) return;
      const cur = bestAdd.get(c.sp);
      if (!cur || covered.length > cur.covered.length) bestAdd.set(c.sp, { cand: c, covered });
    });
    const additions = [...bestAdd.values()].sort((a, b) => b.covered.length - a.covered.length).slice(0, 8);

    const swaps = [];
    members.forEach((member, mi) => {
      const others = new Set(members.filter((_, j) => j !== mi).map((m) => m.item).filter(Boolean));
      const bestForMember = new Map();
      candidates.forEach((c) => {
        if (c.mega !== member.mega) return;
        if (dupNg(c.build.item, others)) return;
        const after = holesAfterSwap(holeIdx, exposed[mi], c.cov);
        const decrease = holeIdx.size - after.size;
        if (decrease <= 0) return;
        const cur = bestForMember.get(c.sp);
        if (!cur || decrease > cur.decrease) {
          bestForMember.set(c.sp, { slotIdx: member.slotIdx, removeLabel: member.label, removeIcon: member.icon, cand: c, holesBefore: holeIdx.size, holesAfter: after.size, decrease });
        }
      });
      bestForMember.forEach((v) => swaps.push(v));
    });
    swaps.sort((a, b) => b.decrease - a.decrease);

    return { additions, swaps: swaps.slice(0, 5) };
  }
  async function onHoleFillClick() {
    const p = activeParty();
    if (!p || !core) return;
    const resolvedParty = resolvedPartyList();
    const oppCols = buildOppCols();
    const holeInfo = findHoles(resolvedParty, oppCols);
    if (!holeInfo.holeLabels.length) return;
    const sig = holeFillSignature(resolvedParty, oppCols);
    if (holeFillResult && holeFillResult.sig === sig) {
      openHoleFillPopover();
      return;
    }
    holeFillLoading = true;
    openHoleFillPopover();
    const t0 = performance.now();
    let result;
    try {
      result = await computeHoleFillSuggestions(p, oppCols, holeInfo);
    } catch (e) {
      console.warn('[onHoleFillClick] 穴を埋める候補の計算に失敗しました', e);
      holeFillLoading = false;
      holeFillResult = { sig, candidates: [], members: [], holeIdx: new Set(), exposed: [], megaCount: 0, emptySlotIdx: [], oppCols };
      renderHoleFillBody();
      return;
    }
    const elapsed = Math.round(performance.now() - t0);
    console.info(`[pb-holefill] 候補${result.poolSize}種 計算時間: ${elapsed}ms`);
    holeFillResult = { sig, ...result };
    holeFillLoading = false;
    renderHoleFillBody();
  }
  function openHoleFillPopover() {
    const body = document.getElementById('pb-modal-body');
    body.innerHTML = `<h3 style="margin-top:0">${esc(I18N.holeFillBtn)}</h3><div id="pb-holefill-body"></div>`;
    showModal();
    renderHoleFillBody();
  }
  function renderHoleFillBody() {
    const el = document.getElementById('pb-holefill-body');
    if (!el) return;
    if (holeFillLoading) {
      el.innerHTML = `<div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">${esc(I18N.holeFillCalculating)}</div></div>`;
      return;
    }
    if (!holeFillResult) { el.innerHTML = ''; return; }
    const { emptySlotIdx, oppCols } = holeFillResult;
    const { additions, swaps } = selectHoleFillLists(holeFillResult, holeFillAllowDup);
    holeFillView = { additions, swaps };
    const hasEmpty = emptySlotIdx.length > 0;
    const coverLabels = (covered) => covered.map((ci) => tPoke(oppCols[ci].label)).join('、');
    const addCards = additions.map((a, i) => `<div class="pb-hf-card">
        ${icoImg(a.cand.icon, a.cand.build.label, 'mtx-ico')}
        <div class="pb-hf-info">
          <div class="pb-hf-name">${esc(tPoke(a.cand.build.label))}</div>
          <div class="pb-hf-covers">${esc(I18N.holeFillCoversLbl(coverLabels(a.covered)))}</div>
        </div>
        <button type="button" class="pb-btn-sub" data-hf-add="${i}" ${hasEmpty ? '' : 'disabled'} title="${hasEmpty ? '' : esc(I18N.noEmptySlots)}">${esc(I18N.holeFillAddBtn)}</button>
        ${hfBuildHtml(a.cand.slot)}
      </div>`).join('');
    const swapCards = swaps.map((s, i) => `<div class="pb-hf-card">
        ${icoImg(s.removeIcon, s.removeLabel, 'mtx-ico')}
        <span class="pb-hf-swap-arrow">→</span>
        ${icoImg(s.cand.icon, s.cand.build.label, 'mtx-ico')}
        <div class="pb-hf-info">
          <div class="pb-hf-name">${esc(I18N.holeFillSwapLine(tPoke(s.removeLabel), tPoke(s.cand.build.label), s.holesBefore, s.holesAfter))}</div>
        </div>
        <button type="button" class="pb-btn-sub" data-hf-swap="${i}">${esc(I18N.applyBtn)}</button>
        ${hfBuildHtml(s.cand.slot)}
      </div>`).join('');
    el.innerHTML = `
      <label class="pb-hf-filter"><input type="checkbox" id="pb-hf-allowdup" ${holeFillAllowDup ? 'checked' : ''}>${esc(I18N.holeFillAllowDupLbl)}</label>
      <div class="pb-hf-section">
        <h4>${esc(I18N.holeFillAddHeading)}</h4>
        ${addCards || `<div class="muted">${esc(I18N.holeFillAddNone)}</div>`}
      </div>
      <div class="pb-hf-section">
        <h4>${esc(I18N.holeFillSwapHeading)}</h4>
        ${swapCards || `<div class="muted">${esc(I18N.holeFillSwapNone)}</div>`}
      </div>`;
    const dupChk = el.querySelector('#pb-hf-allowdup');
    if (dupChk) dupChk.addEventListener('change', (e) => { holeFillAllowDup = e.target.checked; renderHoleFillBody(); });
    el.querySelectorAll('[data-hf-add]').forEach((btn) => { if (!btn.disabled) btn.addEventListener('click', () => applyHoleFillAdd(+btn.dataset.hfAdd)); });
    el.querySelectorAll('[data-hf-swap]').forEach((btn) => btn.addEventListener('click', () => applyHoleFillSwap(+btn.dataset.hfSwap)));
  }
  /** 追加候補の適用: 先頭の空き枠に候補の代表型をそのまま追加する(空き枠が無ければ何もしない。
   * ボタン自体がその場合disabledなので通常ここには来ない)。空き枠追加は失う情報が無いためUndo不要
   * (onFillSpriteClickと同じ設計)。 */
  function applyHoleFillAdd(i) {
    if (!holeFillResult) return;
    const a = holeFillView.additions[i];
    if (!a) return;
    const p = activeParty();
    if (!p) return;
    const idx = p.slots.findIndex((s) => !s);
    if (idx === -1) return;
    p.slots[idx] = { ...a.cand.slot, evs: [...a.cand.slot.evs], moves: [...a.cand.slot.moves], targets: [] };
    p.updatedAt = Date.now();
    saveStore(store);
    hideModal();
    render();
  }
  /** 入れ替え提案の適用: 対象枠を候補の代表型Slotに置換する。除去される元の枠はUndoトースト
   * (既存の枠✕と同じ#pb-undo-toast、mode='replace')で5秒間だけ復元可能にする。 */
  function applyHoleFillSwap(i) {
    if (!holeFillResult) return;
    const s = holeFillView.swaps[i];
    if (!s) return;
    const p = activeParty();
    if (!p) return;
    const prevSlot = p.slots[s.slotIdx];
    if (!prevSlot) return;
    p.slots[s.slotIdx] = { ...s.cand.slot, evs: [...s.cand.slot.evs], moves: [...s.cand.slot.moves], targets: [] };
    p.updatedAt = Date.now();
    saveStore(store);
    hideModal();
    showUndoToast(null, p.id, s.slotIdx, prevSlot, 'replace', I18N.holeFillSwappedMsg(tPoke(s.removeLabel), tPoke(s.cand.sp)));
    render();
  }

  // ---- 空き枠を提案で埋める ----
  async function onFillClick() {
    const p = activeParty();
    if (!p || !core) return;
    const emptyIdx = p.slots.map((s, i) => (s ? null : i)).filter((i) => i !== null);
    const out = document.getElementById('pb-fill-out');
    if (!emptyIdx.length) { out.innerHTML = `<div class="muted">${esc(I18N.noEmptySlots)}</div>`; return; }
    fillEmptyIdx = emptyIdx;
    fillLoading = true;
    fillFailed = false;
    renderFillOut();
    let proposals = null;
    try {
      proposals = await suggestFill(p, emptyIdx, { species: core.species, loadMon });
    } catch (e) {
      // M2: mon json取得失敗等でsuggestFillがrejectしてもスピナーが固まらないようにする
      console.warn('[onFillClick] 提案の取得に失敗しました', e);
      fillLoading = false;
      fillFailed = true;
      renderFillOut();
      return;
    }
    fillLoading = false;
    fillProposals = proposals;
    renderFillOut();
  }
  function speciesInParty(party, spName) {
    return party.slots.some((s) => s && s.sp === spName);
  }
  function firstEmptySlotIdx(party) {
    return party.slots.findIndex((s) => !s);
  }
  function renderFillOut() {
    const out = document.getElementById('pb-fill-out');
    if (fillLoading) { out.innerHTML = `<div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">${esc(I18N.fillCalcAll)}</div></div>`; return; }
    if (fillFailed) { out.innerHTML = `<div class="muted">${esc(I18N.fillFailedMsg)}</div>`; return; }
    if (!fillProposals || !fillProposals.length) { out.innerHTML = ''; return; }
    const p = activeParty();
    const head = `<div class="pb-fill-head"><span class="muted">${esc(I18N.fillResultHead(fillProposals.length))}</span><button class="pb-btn-sub" id="pb-fill-close">${esc(I18N.fillClearBtn)}</button></div>`;
    const cards = fillProposals.map((cand, ci) => {
      const sprites = cand.map((slotCand, si) => {
        const sm = core.species.find((s) => s.n === slotCand.sp);
        const disabled = !p || speciesInParty(p, slotCand.sp) || firstEmptySlotIdx(p) === -1;
        const title = !p ? '' : speciesInParty(p, slotCand.sp) ? I18N.alreadyAdded : firstEmptySlotIdx(p) === -1 ? I18N.noEmptySlots : I18N.addToEmptySlot(tPoke(slotCand.sp));
        return `<button type="button" class="pb-fill-sprite${disabled ? ' pb-fill-disabled' : ''}" data-fill-ci="${ci}" data-fill-si="${si}" ${disabled ? 'disabled' : ''} title="${esc(title)}">${icoImg(sm ? sm.icon : null, slotCand.sp, '')}</button>`;
      }).join('');
      return `<div class="pb-cand-card">
          <div class="pb-cand-sprites">${sprites}</div>
          <button class="pb-btn-sub" data-fill-cand="${ci}">${esc(I18N.adoptBtn)}</button>
        </div>`;
    }).join('');
    out.innerHTML = head + cards;
    document.getElementById('pb-fill-close').addEventListener('click', () => {
      fillProposals = null;
      renderFillOut();
    });
    out.querySelectorAll('[data-fill-cand]').forEach((btn) => btn.addEventListener('click', () => {
      const ci = +btn.dataset.fillCand;
      const cand = fillProposals[ci];
      const pp = activeParty();
      if (!pp) return;
      // H1: 提案生成時にキャプチャしたfillEmptyIdxは使わず、採用時点のアクティブパーティの空き枠を
      // 再計算して埋める。提案表示後に手動追加・パーティ切替があっても古いインデックスで
      // 無警告上書きしないようにするため。空きが提案数より少なければ入る分だけ入れ、過剰分は破棄する。
      const emptyNow = pp.slots.map((s, i) => (s ? null : i)).filter((i) => i !== null);
      if (!emptyNow.length) { fillProposals = null; renderFillOut(); return; }
      const n = Math.min(emptyNow.length, cand.length);
      for (let i = 0; i < n; i++) pp.slots[emptyNow[i]] = cand[i];
      pp.updatedAt = Date.now();
      saveStore(store);
      fillProposals = null;
      render();
    }));
    out.querySelectorAll('.pb-fill-sprite:not(.pb-fill-disabled)').forEach((btn) => btn.addEventListener('click', () => {
      const ci = +btn.dataset.fillCi;
      const si = +btn.dataset.fillSi;
      onFillSpriteClick(ci, si);
    }));
  }
  function onFillSpriteClick(ci, si) {
    const pp = activeParty();
    if (!pp || !fillProposals) return;
    const cand = fillProposals[ci] && fillProposals[ci][si];
    if (!cand) return;
    if (speciesInParty(pp, cand.sp)) return;
    const idx = firstEmptySlotIdx(pp);
    if (idx === -1) return;
    pp.slots[idx] = { ...cand, evs: [...cand.evs], moves: [...cand.moves], targets: [] };
    pp.updatedAt = Date.now();
    saveStore(store);
    render();
    renderFillOut();
  }
  document.getElementById('pb-fill-btn').addEventListener('click', onFillClick);

  // ---- エクスポート/インポート モーダル ----
  function showModal() { document.getElementById('pb-modal').style.display = 'flex'; }
  function hideModal() { document.getElementById('pb-modal').style.display = 'none'; }

  /** (5) title属性の内容をタップでも見られるようにするための共通ポップオーバー(既存.pop-overlayを流用)。 */
  function openInfoPopover(titleText, bodyHtml) {
    const body = document.getElementById('pb-modal-body');
    const hd = titleText ? `<h3 style="margin-top:0">${esc(titleText)}</h3>` : '';
    body.innerHTML = `${hd}${bodyHtml}`;
    showModal();
  }
  /** (5) 型テンプレ用ポップオーバー。候補(≤5件)をカード一覧表示し、各カードの内容確認後に
   * 「この型を適用」で個別に確定する(タップ即上書きの事故を防ぐ従来の安全設計を複数候補へ拡張)。 */
  function openPresetListPopover(spName, specs, onApply) {
    const parsedList = (specs || []).map((spec) => fromSpec(spec)).filter((p) => p !== null);
    const cardsHtml = parsedList.length
      ? parsedList.map((parsed, i) => {
          const movesHtml = parsed.moves.filter(Boolean).map((x) => `<span class="mvchip">${typeIcoForMove(x)}${esc(tMove(x))}</span>`).join('') || '—';
          return `<div class="pb-cand-card" style="flex-direction:column;align-items:stretch;gap:.4em">
              <div class="dgrid">
                <div class="dcell"><span class="lbl item">${esc(I18N.itemLbl)}</span><span class="dval">${esc(tItem(parsed.item)) || esc(I18N.noneOpt)}</span></div>
                <div class="dcell"><span class="lbl nat">${esc(I18N.natLbl)}</span><span class="dval">${parsed.nature ? esc(tNatureDisp(parsed.nature)) : '—'}</span></div>
              </div>
              <div class="drow"><span class="lbl mv">${esc(I18N.moveLbl)}</span><span class="mvwrap">${movesHtml}</span></div>
              <div class="drow"><span class="lbl ev">${esc(I18N.evLbl)}</span><span class="mvwrap">${evChipsArr(parsed.evs)}</span></div>
              <button type="button" class="btn" data-preset-list-apply="${i}" style="align-self:flex-end">${esc(I18N.applyThisBuildBtn)}</button>
            </div>`;
        }).join('')
      : `<div class="muted">${esc(I18N.noCandidates)}</div>`;
    openInfoPopover(I18N.presetHeading(tPoke(spName)), cardsHtml);
    document.querySelectorAll('#pb-modal-body [data-preset-list-apply]').forEach((btn) => btn.addEventListener('click', () => {
      const parsed = parsedList[+btn.dataset.presetListApply];
      if (parsed) { onApply(parsed); hideModal(); }
    }));
  }
  function openEvPresetListPopover(spName, evList, onApply) {
    const cardsHtml = evList.length
      ? evList.map((e, i) => `<div class="pb-cand-card" style="align-items:center;gap:.6em">
            <span class="mvwrap">${evChipsArr(e.ev)}</span>
            <b style="white-space:nowrap">${Number(e.pct) || 0}%</b>
            <button type="button" class="btn" data-evpreset-apply="${i}" style="margin-left:auto">${esc(I18N.applyBtn)}</button>
          </div>`).join('')
      : `<div class="muted">${esc(I18N.noCandidates)}</div>`;
    openInfoPopover(I18N.evPresetHeading(tPoke(spName)), cardsHtml);
    document.querySelectorAll('#pb-modal-body [data-evpreset-apply]').forEach((btn) => btn.addEventListener('click', () => {
      const e = evList[+btn.dataset.evpresetApply];
      if (e) { onApply(e.ev.map(Number)); hideModal(); }
    }));
  }
  function openExportModal(p) {
    const body = document.getElementById('pb-modal-body');
    const text = exportParty(p);
    body.innerHTML = `<h3>${esc(I18N.exportHeading(p.name))}</h3>
      <textarea id="pb-export-ta" class="pb-textarea" readonly>${esc(text)}</textarea>
      <div class="row" style="margin-top:.6em"><button class="btn" id="pb-export-copy">${esc(I18N.copyBtn)}</button></div>
      <div class="muted" id="pb-export-msg" style="margin-top:.4em"></div>`;
    document.getElementById('pb-export-copy').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(text); document.getElementById('pb-export-msg').textContent = I18N.copiedMsg; }
      catch (e) { document.getElementById('pb-export-msg').textContent = I18N.copyFailedMsg; }
    });
    showModal();
  }
  function openImportModal() {
    const body = document.getElementById('pb-modal-body');
    body.innerHTML = `<h3>${esc(I18N.importHeading)}</h3>
      <div class="muted" style="margin-bottom:.4em">${esc(I18N.importHint)}</div>
      <textarea id="pb-import-ta" class="pb-textarea" placeholder="${esc(I18N.importPlaceholder)}"></textarea>
      <div class="row" style="margin-top:.6em"><button class="btn" id="pb-import-go">${esc(I18N.importBtn)}</button></div>
      <div class="muted" id="pb-import-msg" style="margin-top:.4em;color:#dc2626"></div>`;
    document.getElementById('pb-import-go').addEventListener('click', () => {
      const text = document.getElementById('pb-import-ta').value;
      const party = importParty(text);
      if (!party) { document.getElementById('pb-import-msg').textContent = I18N.importFailedMsg; return; }
      store.parties.push(party);
      store.activeId = party.id;
      saveStore(store);
      hideModal();
      resetPartyUiState();
      render();
    });
    showModal();
  }
  document.getElementById('pb-modal-x').addEventListener('click', hideModal);
  document.getElementById('pb-modal').addEventListener('click', (e) => { if (e.target.id === 'pb-modal') hideModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    hideModal();
    const p = activeParty();
    if (selectedIdx !== null && p && !p.slots[selectedIdx]) {
      selectedIdx = null;
      document.querySelectorAll('#pb-tray .montab').forEach((b) => b.classList.remove('active'));
      renderSlotSearch();
      renderEditor();
      renderTargetsPanel();
    }
  });

  // 検索サジェスト: 外側クリックで閉じる
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.filter-wrap')) {
      document.querySelectorAll('.filter-sug').forEach((s) => { s.style.display = 'none'; });
    }
  });

  // ---- 「軸から簡単構築」からの引き継ぎインポート ----
  const SUGGEST_HANDOFF_KEY = 'pn-builder-import';
  /** /party-suggest の「パーティ工房で保存・微調整」ボタンが localStorage 経由で渡す
   * {name, specs} を新規パーティとして取り込み、アクティブ化する。キーはリロードでの
   * 二重インポートを防ぐため、成否に関わらず読み取り直後に必ず削除する。全specが不正な
   * 場合のみモーダルでエラー表示し、1件でも解決できればパーティは作成する(部分成功OK)。 */
  function importFromSuggestHandoff() {
    let raw;
    try { raw = localStorage.getItem(SUGGEST_HANDOFF_KEY); } catch (e) { return; }
    if (!raw) return;
    try { localStorage.removeItem(SUGGEST_HANDOFF_KEY); } catch (e) { /* noop */ }
    let data;
    try { data = JSON.parse(raw); } catch (e) { data = null; }
    const specs = data && Array.isArray(data.specs) ? data.specs : null;
    if (!specs || !specs.length) return;
    const slots = specs.map((s) => { try { return fromSuggestSpec(s); } catch (e) { return null; } }).filter((s) => s !== null);
    if (!slots.length) {
      openInfoPopover(I18N.handoffHeading, `<div class="pb-valid-banner" style="margin:0"><ul><li>${esc(I18N.handoffFailed)}</li></ul></div>`);
      return;
    }
    const name = data && typeof data.name === 'string' && data.name.trim() ? data.name.trim() : undefined;
    createPartyFromSlots(store, slots, name);
    resetPartyUiState();
  }

  // ---- 初期化 ----
  /** M1: loadCore()失敗時(fetch失敗・不正レスポンス等)に「読み込み中…」のまま止まらないよう、
   * 「6枠編成」カード直上に失敗表示+再試行ボタンを出す。再試行はページ再読み込みで単純化する。 */
  function renderInitError() {
    const bar = document.getElementById('pb-partybar');
    if (bar) {
      bar.innerHTML = `<div class="pb-valid-banner">${esc(I18N.initErrorMsg)}
        <button class="pb-btn-sub" id="pb-init-retry" style="margin-left:.6em">${esc(I18N.retryBtn)}</button></div>`;
      const retryBtn = document.getElementById('pb-init-retry');
      if (retryBtn) retryBtn.addEventListener('click', () => location.reload());
    }
    const editor = document.getElementById('pb-editor');
    if (editor) editor.innerHTML = '';
  }
  async function init() {
    store = loadStore();
    importFromSuggestHandoff();
    if (store.parties.length === 0) createParty(store);
    try {
      // 1v1判定は対戦エンジン(wasm)が行う。描画前に必ず読み込む
      await Promise.all([
        loadCore().then((c) => { core = c; }),
        initEngine('/engine/engine_wasm.wasm', '/builder-data/engine.pack.json'),
      ]);
    } catch (e) {
      console.warn('[init] 初期化に失敗しました', e);
      renderInitError();
      return;
    }
    render();
  }
  init();
</script>
