  // ---- (2) 穴を埋める候補 ----
  /** ポケモン相性タブの穴サマリー行のボタンをクリック可能にする(穴0の時はボタン自体が無い)。 */
  function bindHoleFillButton(paneEl) {
    if (!paneEl) return;
    const btn = paneEl.querySelector('#pb-holefill-btn');
    if (btn) btn.addEventListener('click', onHoleFillClick);
  }
  /** 候補の代表型Slotを組み立てる。mon/{icon}.json の builds[0](使用率最多の型spec)を優先し、
   * builds が空(データ欠落)の種のみ items/abilities/natures/evs/moves それぞれの使用率最頻値から
   * 組み立てるフォールバックを使う。 */
  /** 候補種の型を採用率順で返す。メガ石持ちの型と非メガの型が両方あるとき、入れ替え相手の
   * メガ有無に合わせて選べるようにするため単一の代表型ではなく候補列を返す。 */
  function candidateSlotsForCandidate(spName, detail) {
    const out = [];
    if (detail && Array.isArray(detail.builds)) {
      detail.builds.forEach((spec) => {
        const slot = fromSpec(spec);
        if (slot) out.push(slot);
      });
    }
    out.push(representativeSlotForCandidate(spName, detail));
    return out;
  }
  function representativeSlotForCandidate(spName, detail) {
    const item = detail && detail.items && detail.items[0] ? detail.items[0].n : '';
    const ability = detail && detail.abilities && detail.abilities[0] ? detail.abilities[0].n : '';
    const nature = detail && detail.natures && detail.natures[0] ? detail.natures[0].n : '';
    const evs = detail && detail.evs && detail.evs[0] ? [...detail.evs[0].ev] : [0, 0, 0, 0, 0, 0];
    const moves = detail && Array.isArray(detail.moves) ? detail.moves.slice(0, 4).map((m) => m.n) : [];
    return { sp: spName, item, ability, nature, evs, moves, targets: [] };
  }
  /** 現在のパーティ・仮想敵の状態を表す軽量な文字列。同じ状態ならholeFillResultを再利用する
   * (「パーティ・仮想敵編集で無効化されるまでキャッシュ」の判定に、キャッシュ無効化フラグを
   * 各所に仕込む代わりにこの署名比較を使う)。 */
  function holeFillSignature(resolvedParty, oppCols) {
    const buildSig = (b) => `${b.sp}|${b.item}|${b.ability}|${b.nature}|${b.evs.join(',')}|${b.moves.map((m) => m.n).join(',')}`;
    const partySig = resolvedParty.map(buildSig).join(';');
    const oppSig = oppCols.map((o) => `${o.label}:${o.builds.map(buildSig).join('/')}`).join(';');
    return `${partySig}##${oppSig}`;
  }
  /**
   * 穴を埋める候補の計算本体。候補プール(使用率上位~50種、パーティと図鑑番号重複除外)を
   * mon/{icon}.json 並列fetchし、各候補×oppCols(≤30列)の集約判定(judgeVsBuilds)を1回だけ
   * coverageSet()で計算してカバレッジ集合を作る(party各メンバーの被覆も同様)。
   * 入れ替え探索(6メンバー×候補数)はholesAfterSwap()の集合演算のみで行い、
   * judgeVsBuildsを6×候補数だけ追加で呼ぶことはしない。
   */
  /** (B26) Promise.allでの一括fetch(最大50件)はSlow回線で同時接続数の奪い合いになり、
   * 逆に完了が遅くなる。同時実行数を絞ったプールで順次消化する(結果順序はitemsと一致させる)。 */
  async function mapPool(items, limit, fn) {
    const results = new Array(items.length);
    let next = 0;
    async function worker() {
      while (next < items.length) {
        const idx = next++;
        results[idx] = await fn(items[idx], idx);
      }
    }
    await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
    return results;
  }
  /** 候補の型プールを作る。使用率上位50種について、メガ型・非メガ型を最大3型ずつ解決し、
   * 相手列ごとの「◎/○を取れるか」(coverageSet)まで済ませて返す。
   * 穴埋め提案と空き枠埋めの両方がこの同じプールを使う。 */
  async function buildCandidatePool(usedDex, oppCols) {
    const pool = [...core.species]
      .filter((s) => !usedDex.has((s.icon || '').split('-')[0]))
      .sort((a, b) => (a.off ? 1 : 0) - (b.off ? 1 : 0) || a.rank - b.rank)
      .slice(0, 50);
    const monDetails = await mapPool(pool, 6, (s) => loadMon(s.icon).catch(() => null));
    // メガは1体しか進化できないため、3体以上積むと選出パターンが減る。候補はメガ型・非メガ型を
    // 最大1つずつ持ち、追加はメガ2体まで、入れ替えはメガ有無が一致する組み合わせのみに絞る。
    // 同一種でもメガ型/非メガ型・持ち物違いを最大3型まで持つ(もちもの重複フィルタが効いたときに
    // 同じ種の別の型へ落とせるように)。
    const candidates = [];
    pool.forEach((sp, i) => {
      const seen = new Set();
      let nMega = 0, nPlain = 0;
      candidateSlotsForCandidate(sp.n, monDetails[i]).forEach((slot) => {
        if (nMega + nPlain >= 3) return;
        const rb = resolveSlotSafe(slot);
        if (!rb) return;
        const key = `${rb.mega ? 'M' : 'P'}|${rb.item}`;
        if (seen.has(key) || (rb.mega ? nMega >= 2 : nPlain >= 2)) return;
        seen.add(key);
        if (rb.mega) nMega++; else nPlain++;
        candidates.push({ sp: sp.n, icon: sp.icon, rank: sp.rank, slot, build: rb, mega: rb.mega,
                          cov: coverageSet(rb, oppCols) });
      });
    });
    return { pool, candidates };
  }

  async function computeHoleFillSuggestions(party, oppCols, holeInfo) {
    const filledIdx = [];
    const resolvedParty = [];
    party.slots.forEach((slot, i) => {
      const rb = resolveSlotSafe(slot);
      if (rb) { filledIdx.push(i); resolvedParty.push(rb); }
    });
    const emptySlotIdx = party.slots.map((s, i) => (s ? null : i)).filter((i) => i !== null);

    const usedDex = new Set(resolvedParty.map((b) => (b.icon || '').split('-')[0]));
    const megaCount = resolvedParty.filter((b) => b.mega).length;
    const { pool, candidates } = await buildCandidatePool(usedDex, oppCols);

    const partyCoverage = resolvedParty.map((b) => coverageSet(b, oppCols));
    return {
      candidates,
      members: resolvedParty.map((b, mi) => ({ label: b.label, icon: b.icon, mega: b.mega, item: b.item, slotIdx: filledIdx[mi] })),
      holeIdx: holeInfo.holeIdx,
      exposed: exposedOnRemoval(partyCoverage, oppCols.length),
      megaCount,
      emptySlotIdx,
      oppCols,
      poolSize: pool.length,
    };
  }
  /** 計算済みの候補群から、表示用の追加候補・入れ替え提案を選ぶ。もちもの重複フィルタの
   * 切り替えは再計算せずここだけ通し直す(coverageSetの計算はcomputeHoleFillSuggestions側で完了済み)。 */
  function selectHoleFillLists(raw, allowDupItem) {
    const MEGA_MAX = 2;
    const { candidates, members, holeIdx, exposed, megaCount } = raw;
    const dupNg = (item, forbidden) => !allowDupItem && item && forbidden.has(item);

    const partyItems = new Set(members.map((m) => m.item).filter(Boolean));
    const bestAdd = new Map();
    candidates.forEach((c) => {
      if (c.mega && megaCount >= MEGA_MAX) return;
      if (dupNg(c.build.item, partyItems)) return;
      const covered = [...c.cov].filter((ci) => holeIdx.has(ci));
      if (!covered.length) return;
      const cur = bestAdd.get(c.sp);
      if (!cur || covered.length > cur.covered.length) bestAdd.set(c.sp, { cand: c, covered });
    });
    const additions = [...bestAdd.values()].sort((a, b) => b.covered.length - a.covered.length).slice(0, 8);

    const swaps = [];
    members.forEach((member, mi) => {
      const others = new Set(members.filter((_, j) => j !== mi).map((m) => m.item).filter(Boolean));
      const bestForMember = new Map();
      candidates.forEach((c) => {
        if (c.mega !== member.mega) return;
        if (dupNg(c.build.item, others)) return;
        const after = holesAfterSwap(holeIdx, exposed[mi], c.cov);
        const decrease = holeIdx.size - after.size;
        if (decrease <= 0) return;
        const cur = bestForMember.get(c.sp);
        if (!cur || decrease > cur.decrease) {
          bestForMember.set(c.sp, { slotIdx: member.slotIdx, removeLabel: member.label, removeIcon: member.icon, cand: c, holesBefore: holeIdx.size, holesAfter: after.size, decrease });
        }
      });
      bestForMember.forEach((v) => swaps.push(v));
    });
    swaps.sort((a, b) => b.decrease - a.decrease);

    return { additions, swaps: swaps.slice(0, 5) };
  }
  async function onHoleFillClick() {
    const p = activeParty();
    if (!p || !core) return;
    // 穴の再計算・署名づくりもエンジンを回すので、ダイアログを先に出してから行う。
    holeFillLoading = true;
    openHoleFillPopover();
    await yieldToPaint();
    const resolvedParty = resolvedPartyList();
    const oppCols = buildOppCols();
    const holeInfo = findHolesMemo(resolvedParty, oppCols);
    if (!holeInfo.holeLabels.length) { holeFillLoading = false; hideModal(); return; }
    const sig = holeFillSignature(resolvedParty, oppCols);
    if (holeFillResult && holeFillResult.sig === sig) {
      holeFillLoading = false;
      renderHoleFillBody();
      return;
    }
    const t0 = performance.now();
    let result;
    try {
      result = await computeHoleFillSuggestions(p, oppCols, holeInfo);
    } catch (e) {
      console.warn('[onHoleFillClick] 穴を埋める候補の計算に失敗しました', e);
      holeFillLoading = false;
      holeFillResult = { sig, candidates: [], members: [], holeIdx: new Set(), exposed: [], megaCount: 0, emptySlotIdx: [], oppCols };
      renderHoleFillBody();
      return;
    }
    const elapsed = Math.round(performance.now() - t0);
    if (import.meta.env.DEV) {
      console.info(`[pb-holefill] 候補${result.poolSize}種 計算時間: ${elapsed}ms`);
    }
    holeFillResult = { sig, ...result };
    holeFillLoading = false;
    renderHoleFillBody();
  }
  function openHoleFillPopover() {
    const body = document.getElementById('pb-modal-body');
    body.innerHTML = `<h3 style="margin-top:0">${esc(I18N.holeFillBtn)}</h3><div id="pb-holefill-body"></div>`;
    showModal();
    renderHoleFillBody();
  }
  function renderHoleFillBody() {
    const el = document.getElementById('pb-holefill-body');
    if (!el) return;
    if (holeFillLoading) {
      el.innerHTML = `<div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">${esc(I18N.holeFillCalculating)}</div></div>`;
      return;
    }
    if (!holeFillResult) { el.innerHTML = ''; return; }
    const { emptySlotIdx, oppCols } = holeFillResult;
    const { additions, swaps } = selectHoleFillLists(holeFillResult, holeFillAllowDup);
    holeFillView = { additions, swaps };
    const hasEmpty = emptySlotIdx.length > 0;
    const coverLabels = (covered) => covered.map((ci) => tPoke(oppCols[ci].label)).join('、');
    const addCards = additions.map((a, i) => `<div class="pb-hf-card">
        ${icoImg(a.cand.icon, a.cand.build.label, 'mtx-ico')}
        <div class="pb-hf-info">
          <div class="pb-hf-name">${esc(tPoke(a.cand.build.label))}</div>
          <div class="pb-hf-covers">${esc(I18N.holeFillCoversLbl(coverLabels(a.covered)))}</div>
        </div>
        <button type="button" class="pb-btn-sub" data-hf-add="${i}" ${hasEmpty ? '' : 'disabled'} title="${hasEmpty ? '' : esc(I18N.noEmptySlots)}">${esc(I18N.holeFillAddBtn)}</button>
        ${hfBuildHtml(a.cand.slot)}
      </div>`).join('');
    const swapCards = swaps.map((s, i) => `<div class="pb-hf-card">
        ${icoImg(s.removeIcon, s.removeLabel, 'mtx-ico')}
        <span class="pb-hf-swap-arrow">→</span>
        ${icoImg(s.cand.icon, s.cand.build.label, 'mtx-ico')}
        <div class="pb-hf-info">
          <div class="pb-hf-name">${esc(I18N.holeFillSwapLine(tPoke(s.removeLabel), tPoke(s.cand.build.label), s.holesBefore, s.holesAfter))}</div>
        </div>
        <button type="button" class="pb-btn-sub" data-hf-swap="${i}">${esc(I18N.applyBtn)}</button>
        ${hfBuildHtml(s.cand.slot)}
      </div>`).join('');
    el.innerHTML = `
      <label class="pb-hf-filter"><input type="checkbox" id="pb-hf-allowdup" ${holeFillAllowDup ? 'checked' : ''}>${esc(I18N.holeFillAllowDupLbl)}</label>
      <div class="pb-hf-section">
        <h4>${esc(I18N.holeFillAddHeading)}</h4>
        ${addCards || `<div class="muted">${esc(I18N.holeFillAddNone)}</div>`}
      </div>
      <div class="pb-hf-section">
        <h4>${esc(I18N.holeFillSwapHeading)}</h4>
        ${swapCards || `<div class="muted">${esc(I18N.holeFillSwapNone)}</div>`}
      </div>`;
    const dupChk = el.querySelector('#pb-hf-allowdup');
    if (dupChk) dupChk.addEventListener('change', (e) => { holeFillAllowDup = e.target.checked; renderHoleFillBody(); });
    el.querySelectorAll('[data-hf-add]').forEach((btn) => { if (!btn.disabled) btn.addEventListener('click', () => applyHoleFillAdd(+btn.dataset.hfAdd)); });
    el.querySelectorAll('[data-hf-swap]').forEach((btn) => btn.addEventListener('click', () => applyHoleFillSwap(+btn.dataset.hfSwap)));
  }
  /** 追加候補の適用: 先頭の空き枠に候補の代表型をそのまま追加する(空き枠が無ければ何もしない。
   * ボタン自体がその場合disabledなので通常ここには来ない)。空き枠追加は失う情報が無いためUndo不要
   * (onFillSpriteClickと同じ設計)。 */
  function applyHoleFillAdd(i) {
    if (!holeFillResult) return;
    const a = holeFillView.additions[i];
    if (!a) return;
    const p = activeParty();
    if (!p) return;
    const idx = p.slots.findIndex((s) => !s);
    if (idx === -1) return;
    p.slots[idx] = { ...a.cand.slot, evs: [...a.cand.slot.evs], moves: [...a.cand.slot.moves], targets: [] };
    p.updatedAt = Date.now();
    saveStore(store);
    hideModal();
    render();
  }
  /** 入れ替え提案の適用: 対象枠を候補の代表型Slotに置換する。除去される元の枠はUndoトースト
   * (既存の枠✕と同じ#pb-undo-toast、mode='replace')で5秒間だけ復元可能にする。 */
  function applyHoleFillSwap(i) {
    if (!holeFillResult) return;
    const s = holeFillView.swaps[i];
    if (!s) return;
    const p = activeParty();
    if (!p) return;
    const prevSlot = p.slots[s.slotIdx];
    if (!prevSlot) return;
    p.slots[s.slotIdx] = { ...s.cand.slot, evs: [...s.cand.slot.evs], moves: [...s.cand.slot.moves], targets: [] };
    p.updatedAt = Date.now();
    saveStore(store);
    hideModal();
    showUndoToast(null, p.id, s.slotIdx, prevSlot, 'replace', I18N.holeFillSwappedMsg(tPoke(s.removeLabel), tPoke(s.cand.sp)));
    render();
  }

  // ---- 空き枠を提案で埋める ----
  /**
   * 空き枠を「今の穴を一番埋める候補」から順に選ぶ。
   *
   * 以前はサーバ(Cloud Run /complete)に問い合わせていたが、押すたびに課金が発生するうえ、
   * 返ってくるのは6匹の並びだけで採用理由が分からなかった。穴埋め提案と同じ材料
   * （相手上位30体に対して◎/○を取れるか）を使い、1枠ごとに「どの穴が埋まるか」を
   * 示しながら貪欲に埋める。計算はすべてブラウザ内のエンジンで完結する。
   */
  async function computeFillRaw(party, oppCols) {
    const resolved = [];
    party.slots.forEach((slot) => { const rb = resolveSlotSafe(slot); if (rb) resolved.push(rb); });
    const emptyIdx = party.slots.map((s, i) => (s ? null : i)).filter((i) => i !== null);
    const usedDex = new Set(resolved.map((b) => (b.icon || '').split('-')[0]));
    const { candidates } = await buildCandidatePool(usedDex, oppCols);
    return { candidates, resolved, emptyIdx, oppCols,
             megaCount: resolved.filter((b) => b.mega).length,
             items: resolved.map((b) => b.item).filter(Boolean) };
  }

  /**
   * 空き枠を「今の穴を一番埋める候補」から順に選ぶ。
   *
   * 1枠ごとにその時点の穴を数え直し、選んだ体を仮想的に加えてから次の枠を選ぶ。
   * もちもの重複の許可だけは計算し直さずここで通すので、穴埋め提案の
   * selectHoleFillLists と同じ操作感になる。
   */
  function selectFillPicks(raw, allowDup) {
    const { candidates, oppCols, emptyIdx } = raw;
    const resolved = [...raw.resolved];
    const usedDex = new Set(resolved.map((b) => (b.icon || '').split('-')[0]));
    const usedItems = new Set(raw.items);
    let megaCount = raw.megaCount;

    const rank = (holeIdx) => {
      const bySp = new Map();
      for (const c of candidates) {
        if (usedDex.has((c.icon || '').split('-')[0])) continue;
        if (c.mega && megaCount >= 2) continue;           // メガ3体以上は選出が窮屈になる
        if (!allowDup && c.build.item && usedItems.has(c.build.item)) continue;
        const covered = [...c.cov].filter((ci) => holeIdx.has(ci));
        const cur = bySp.get(c.sp);
        if (!cur || covered.length > cur.covered.length) bySp.set(c.sp, { cand: c, covered });
      }
      return [...bySp.values()].sort((a, b) =>
        b.covered.length - a.covered.length || a.cand.rank - b.cand.rank);
    };

    // 画面に並べるのは「いまの穴」に対する候補一覧（穴埋め提案の追加候補と同じ作り）。
    // まとめて追加はここから貪欲に1枠ずつ選んでいく。
    const holesNow = findHolesMemo(resolved, oppCols).holeIdx;
    const list = rank(holesNow).slice(0, 8);

    const picks = [];
    for (const slotIdx of emptyIdx) {
      const holeInfo = findHolesMemo(resolved, oppCols);
      const best = rank(holeInfo.holeIdx)[0];
      if (!best) break;
      picks.push({ slotIdx, cand: best.cand, covered: best.covered,
                   holesBefore: holeInfo.holeIdx.size });
      usedDex.add((best.cand.icon || '').split('-')[0]);
      if (best.cand.build.item) usedItems.add(best.cand.build.item);
      if (best.cand.mega) megaCount++;
      resolved.push(best.cand.build);
    }
    return { list, picks, oppCols, holesBefore: holesNow.size,
             holesAfter: findHolesMemo(resolved, oppCols).holeIdx.size };
  }

  async function onFillClick() {
    const p = activeParty();
    if (!p || !core) return;
    if (!p.slots.some((s) => !s)) return;
    fillLoading = true;
    fillFailed = false;
    openFillPopover();
    await yieldToPaint();
    const t0 = performance.now();
    try {
      fillRaw = await computeFillRaw(p, buildOppCols());
    } catch (e) {
      console.warn('[onFillClick] 空き枠候補の計算に失敗しました', e);
      fillLoading = false;
      fillFailed = true;
      renderFillBody();
      return;
    }
    if (import.meta.env.DEV) {
      console.info(`[pb-fill] 候補${fillRaw.candidates.length}型 計算時間: ${Math.round(performance.now() - t0)}ms`);
    }
    fillLoading = false;
    renderFillBody();
  }
  /** 穴埋め提案と同じモーダルに出す（2つの提案で操作が食い違わないように揃える）。 */
  /** ダイアログを出してから重い計算を始めるための1拍。
   * showModal() の直後に同期処理を続けると、描画されないまま固まって見える
   * （押しても無反応に感じる）。setTimeout を挟んでブラウザに描かせる。 */
  function yieldToPaint() {
    return new Promise((r) => setTimeout(r, 0));
  }
  function openFillPopover() {
    const body = document.getElementById('pb-modal-body');
    body.innerHTML = `<h3 style="margin-top:0">${esc(I18N.fillBtn)}</h3><div id="pb-fill-body"></div>`;
    showModal();
    renderFillBody();
  }
  function speciesInParty(party, spName) {
    return party.slots.some((s) => s && s.sp === spName);
  }
  function firstEmptySlotIdx(party) {
    return party.slots.findIndex((s) => !s);
  }
  function renderFillBody() {
    const el = document.getElementById('pb-fill-body');
    if (!el) return;
    if (fillLoading) {
      el.innerHTML = `<div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">${esc(I18N.fillCalcAll)}</div></div>`;
      return;
    }
    if (fillFailed) { el.innerHTML = `<div class="muted">${esc(I18N.fillFailedMsg)}</div>`; return; }
    if (!fillRaw) { el.innerHTML = ''; return; }
    const { list, picks, oppCols, holesBefore, holesAfter } = selectFillPicks(fillRaw, fillAllowDup);
    fillView = { list, picks };
    if (!list.length) { el.innerHTML = `<div class="muted">${esc(I18N.holeFillAddNone)}</div>`; return; }
    const coverLabels = (covered) => covered.map((ci) => tPoke(oppCols[ci].label)).join('、');
    const cards = list.map((a, i) => `<div class="pb-hf-card">
        ${icoImg(a.cand.icon, a.cand.build.label, 'mtx-ico')}
        <div class="pb-hf-info">
          <div class="pb-hf-name">${esc(tPoke(a.cand.build.label))}</div>
          <div class="pb-hf-covers">${esc(a.covered.length
            ? I18N.holeFillCoversLbl(coverLabels(a.covered))
            : I18N.fillNoHoleReason)}</div>
        </div>
        <button type="button" class="pb-btn-sub" data-fill-add="${i}">${esc(I18N.holeFillAddBtn)}</button>
        ${hfBuildHtml(a.cand.slot)}
      </div>`).join('');
    el.innerHTML = `
      <label class="pb-hf-filter"><input type="checkbox" id="pb-fill-allowdup" ${fillAllowDup ? 'checked' : ''}>${esc(I18N.holeFillAllowDupLbl)}</label>
      <div class="pb-hf-section">
        <h4>${esc(I18N.holeFillAddHeading)}</h4>
        ${cards}
      </div>
      ${picks.length ? `<div class="row" style="margin-top:.6em">
        <button class="pb-btn-sub" id="pb-fill-all">${esc(I18N.fillAdoptAllBtn)}</button>
        <span class="muted">${esc(I18N.fillAdoptAllHint(picks.length, holesBefore, holesAfter))}</span>
      </div>` : ''}`;
    const dupChk = el.querySelector('#pb-fill-allowdup');
    if (dupChk) dupChk.addEventListener('change', (e) => { fillAllowDup = e.target.checked; renderFillBody(); });
    const allBtn = el.querySelector('#pb-fill-all');
    if (allBtn) allBtn.addEventListener('click', () => adoptFillList(null));
    el.querySelectorAll('[data-fill-add]').forEach((btn) =>
      btn.addEventListener('click', () => adoptFillList(+btn.dataset.fillAdd)));
  }
  /** only が数値なら一覧のその1件、null ならまとめて（貪欲に選んだ並び）を空き枠へ入れる。
   * 提案表示後に手動追加やパーティ切替があっても壊れないよう、採用時点の空き枠を数え直す。 */
  function adoptFillList(only) {
    const p = activeParty();
    if (!p || !fillView) return;
    const src = only === null ? fillView.picks : [fillView.list[only]];
    for (const a of src) {
      if (!a) continue;
      if (speciesInParty(p, a.cand.sp)) continue;
      const idx = firstEmptySlotIdx(p);
      if (idx === -1) break;
      const c = a.cand.slot;
      p.slots[idx] = { ...c, evs: [...c.evs], moves: [...c.moves], targets: [] };
    }
    p.updatedAt = Date.now();
    saveStore(store);
    fillRaw = null;
    fillView = null;
    hideModal();
    render();
  }

  document.getElementById('pb-fill-btn').addEventListener('click', onFillClick);

  // ---- エクスポート/インポート モーダル ----
  function showModal() { document.getElementById('pb-modal').style.display = 'flex'; }
  function hideModal() { document.getElementById('pb-modal').style.display = 'none'; }

  /** (5) title属性の内容をタップでも見られるようにするための共通ポップオーバー(既存.pop-overlayを流用)。 */
  function openInfoPopover(titleText, bodyHtml) {
    const body = document.getElementById('pb-modal-body');
    const hd = titleText ? `<h3 style="margin-top:0">${esc(titleText)}</h3>` : '';
    body.innerHTML = `${hd}${bodyHtml}`;
    showModal();
  }
  /** (5) 型テンプレ用ポップオーバー。候補(≤5件)をカード一覧表示し、各カードの内容確認後に
   * 「この型を適用」で個別に確定する(タップ即上書きの事故を防ぐ従来の安全設計を複数候補へ拡張)。 */
  function openPresetListPopover(spName, specs, onApply) {
    const parsedList = (specs || []).map((spec) => fromSpec(spec)).filter((p) => p !== null);
    const cardsHtml = parsedList.length
      ? parsedList.map((parsed, i) => {
          const movesHtml = parsed.moves.filter(Boolean).map((x) => `<span class="mvchip">${typeIcoForMove(x)}${esc(tMove(x))}</span>`).join('') || '—';
          return `<div class="pb-cand-card" style="flex-direction:column;align-items:stretch;gap:.4em">
              <div class="dgrid">
                <div class="dcell"><span class="lbl item">${esc(I18N.itemLbl)}</span><span class="dval">${esc(tItem(parsed.item)) || esc(I18N.noneOpt)}</span></div>
                <div class="dcell"><span class="lbl nat">${esc(I18N.natLbl)}</span><span class="dval">${parsed.nature ? esc(tNatureDisp(parsed.nature)) : '—'}</span></div>
              </div>
              <div class="drow"><span class="lbl mv">${esc(I18N.moveLbl)}</span><span class="mvwrap">${movesHtml}</span></div>
              <div class="drow"><span class="lbl ev">${esc(I18N.evLbl)}</span><span class="mvwrap">${evChipsArr(parsed.evs)}</span></div>
              <button type="button" class="btn" data-preset-list-apply="${i}" style="align-self:flex-end">${esc(I18N.applyThisBuildBtn)}</button>
            </div>`;
        }).join('')
      : `<div class="muted">${esc(I18N.noCandidates)}</div>`;
    openInfoPopover(I18N.presetHeading(tPoke(spName)), cardsHtml);
    document.querySelectorAll('#pb-modal-body [data-preset-list-apply]').forEach((btn) => btn.addEventListener('click', () => {
      const parsed = parsedList[+btn.dataset.presetListApply];
      if (parsed) { onApply(parsed); hideModal(); }
    }));
  }
  function openEvPresetListPopover(spName, evList, onApply) {
    const cardsHtml = evList.length
      ? evList.map((e, i) => `<div class="pb-cand-card" style="align-items:center;gap:.6em">
            <span class="mvwrap">${evChipsArr(e.ev)}</span>
            <b style="white-space:nowrap">${Number(e.pct) || 0}%</b>
            <button type="button" class="btn" data-evpreset-apply="${i}" style="margin-left:auto">${esc(I18N.applyBtn)}</button>
          </div>`).join('')
      : `<div class="muted">${esc(I18N.noCandidates)}</div>`;
    openInfoPopover(I18N.evPresetHeading(tPoke(spName)), cardsHtml);
    document.querySelectorAll('#pb-modal-body [data-evpreset-apply]').forEach((btn) => btn.addEventListener('click', () => {
      const e = evList[+btn.dataset.evpresetApply];
      if (e) { onApply(e.ev.map(Number)); hideModal(); }
    }));
  }
  function openExportModal(p) {
    const body = document.getElementById('pb-modal-body');
    const text = exportParty(p);
    body.innerHTML = `<h3>${esc(I18N.exportHeading(p.name))}</h3>
      <textarea id="pb-export-ta" class="pb-textarea" readonly>${esc(text)}</textarea>
      <div class="row" style="margin-top:.6em"><button class="btn" id="pb-export-copy">${esc(I18N.copyBtn)}</button></div>
      <div class="muted" id="pb-export-msg" style="margin-top:.4em"></div>`;
    document.getElementById('pb-export-copy').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(text); document.getElementById('pb-export-msg').textContent = I18N.copiedMsg; }
      catch (e) { document.getElementById('pb-export-msg').textContent = I18N.copyFailedMsg; }
    });
    showModal();
  }
  function openImportModal() {
    const body = document.getElementById('pb-modal-body');
    body.innerHTML = `<h3>${esc(I18N.importHeading)}</h3>
      <div class="muted" style="margin-bottom:.4em">${esc(I18N.importHint)}</div>
      <textarea id="pb-import-ta" class="pb-textarea" placeholder="${esc(I18N.importPlaceholder)}"></textarea>
      <div class="row" style="margin-top:.6em"><button class="btn" id="pb-import-go">${esc(I18N.importBtn)}</button></div>
      <div class="muted" id="pb-import-msg" style="margin-top:.4em;color:#dc2626"></div>`;
    document.getElementById('pb-import-go').addEventListener('click', () => {
      const text = document.getElementById('pb-import-ta').value;
      const party = importParty(text);
      if (!party) { document.getElementById('pb-import-msg').textContent = I18N.importFailedMsg; return; }
      store.parties.push(party);
      store.activeId = party.id;
      saveStore(store);
      hideModal();
      resetPartyUiState();
      render();
    });
    showModal();
  }
  document.getElementById('pb-modal-x').addEventListener('click', hideModal);
  document.getElementById('pb-modal').addEventListener('click', (e) => { if (e.target.id === 'pb-modal') hideModal(); });
  // (B07) 最小化中の再展開ピル。直前にrenderMiniBar()へ渡された内容をキャッシュ(lastMiniBarArgs)からそのまま再現する。
  document.getElementById('pb-minibar-reopen').addEventListener('click', () => {
    miniBarMinimized = false;
    if (lastMiniBarArgs) renderMiniBar(lastMiniBarArgs.activeGrp, lastMiniBarArgs.allTabs, lastMiniBarArgs.sheetCtx);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    hideModal();
    const p = activeParty();
    if (selectedIdx !== null && p && !p.slots[selectedIdx]) {
      selectedIdx = null;
      document.querySelectorAll('#pb-tray .montab').forEach((b) => b.classList.remove('active'));
      renderSlotSearch();
      renderEditor();
      renderTargetsPanel();
    }
  });

  // 検索サジェスト: 外側クリックで閉じる
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.filter-wrap')) {
      document.querySelectorAll('.filter-sug').forEach((s) => { s.style.display = 'none'; });
    }
  });

  // ---- 「軸から簡単構築」からの引き継ぎインポート ----
  const SUGGEST_HANDOFF_KEY = 'pn-builder-import';
  /** /party-suggest の「パーティ工房で保存・微調整」ボタンが localStorage 経由で渡す
   * {name, specs} を新規パーティとして取り込み、アクティブ化する。キーはリロードでの
   * 二重インポートを防ぐため、成否に関わらず読み取り直後に必ず削除する。全specが不正な
   * 場合のみモーダルでエラー表示し、1件でも解決できればパーティは作成する(部分成功OK)。 */
  function importFromSuggestHandoff() {
    let raw;
    try { raw = localStorage.getItem(SUGGEST_HANDOFF_KEY); } catch (e) { return; }
    if (!raw) return;
    try { localStorage.removeItem(SUGGEST_HANDOFF_KEY); } catch (e) { /* noop */ }
    let data;
    try { data = JSON.parse(raw); } catch (e) { data = null; }
    const specs = data && Array.isArray(data.specs) ? data.specs : null;
    if (!specs || !specs.length) return;
    const slots = specs.map((s) => { try { return fromSuggestSpec(s); } catch (e) { return null; } }).filter((s) => s !== null);
    if (!slots.length) {
      openInfoPopover(I18N.handoffHeading, `<div class="pb-valid-banner" style="margin:0"><ul><li>${esc(I18N.handoffFailed)}</li></ul></div>`);
      return;
    }
    const name = data && typeof data.name === 'string' && data.name.trim() ? data.name.trim() : undefined;
    const prevActiveId = store.activeId;
    const party = createPartyFromSlots(store, slots, name);
    resetPartyUiState();
    // (S02) 取り込み直後にUndoトーストを出す。取り消すと新規パーティを削除し、直前のアクティブパーティに戻す。
    // renderTray/renderEditor等はcore(種族データ)読み込み後でないと呼べないため、init()内のこの時点では
    // まだcoreがnullのことがある。その場合は無理にrenderせず、init()自身の最後のrender()に任せる
    // (storeは同じ参照を書き換えているため、直後のrender()で復元後の状態がそのまま反映される)。
    showUndoToast(null, null, null, null, 'custom', I18N.handoffImportedMsg, () => {
      store.parties = store.parties.filter((pp) => pp.id !== party.id);
      if (!store.parties.length) createParty(store); // 唯一のパーティだった場合、空のまま(0件)にはしない
      store.activeId = store.parties.some((pp) => pp.id === prevActiveId) ? prevActiveId : store.parties[0].id;
      saveStore(store);
      resetPartyUiState();
      if (core) render();
    });
  }

  // ---- (B20/B21) 選択枠・タブの復元 ----
  /** ?party=&slot=&tab=(B21)があれば優先し、無ければsessionStorage(B20)から復元する。
   * 簡単構築の?core=と同じくhistory.replaceStateで反映済みのURLを再読み込みしても崩れない。 */
  function restoreUiState() {
    const params = new URLSearchParams(location.search);
    const partyParam = params.get('party');
    const slotParam = params.get('slot');
    const tabParam = params.get('tab');
    const hasUrlState = partyParam || slotParam !== null || tabParam;
    let restoredScrollY = null;
    if (hasUrlState) {
      if (partyParam && store.parties.some((pp) => pp.id === partyParam)) store.activeId = partyParam;
      if (slotParam !== null && /^\d+$/.test(slotParam)) selectedIdx = +slotParam;
      if (tabParam && ['atk', 'def', 'speed', 'mu'].includes(tabParam)) balanceTab = tabParam;
    } else {
      const ui = loadUiState();
      if (ui) {
        if (typeof ui.selectedIdx === 'number') selectedIdx = ui.selectedIdx;
        if (typeof ui.balanceTab === 'string') balanceTab = ui.balanceTab;
        if (typeof ui.activeMuTab === 'string') activeMuTab = ui.activeMuTab;
        if (ui.selTab === 'editor' || ui.selTab === 'targets') selTab = ui.selTab;
        if (typeof ui.scrollY === 'number') restoredScrollY = ui.scrollY;
      }
    }
    // selectedIdxが埋まっていない枠を指す場合(パーティ切替・枠削除後の不整合)は無効化する
    const p = activeParty();
    if (selectedIdx !== null && (!p || !p.slots[selectedIdx])) selectedIdx = null;
    if (selectedIdx === null) { activeMuTab = null; selTab = 'editor'; }
    return restoredScrollY;
  }

  // ---- 初期化 ----
  /** M1: loadCore()失敗時(fetch失敗・不正レスポンス等)に「読み込み中…」のまま止まらないよう、
   * 「6枠編成」カード直上に失敗表示+再試行ボタンを出す。再試行はページ再読み込みで単純化する。 */
  function renderInitError() {
    const bar = document.getElementById('pb-partybar');
    if (bar) {
      bar.innerHTML = `<div class="pb-valid-banner">${esc(I18N.initErrorMsg)}
        <button class="pb-btn-sub" id="pb-init-retry" style="margin-left:.6em">${esc(I18N.retryBtn)}</button></div>`;
      const retryBtn = document.getElementById('pb-init-retry');
      if (retryBtn) retryBtn.addEventListener('click', () => location.reload());
    }
    const editor = document.getElementById('pb-editor');
    if (editor) editor.innerHTML = '';
  }
  async function init() {
    store = loadStore();
    importFromSuggestHandoff();
    // (B22) 共有リンクの取り込みは「保存パーティが0件なら空パーティを1つ作る」より先に行う。
    // 先に空パーティを作ってしまうと、初めて開くユーザーが共有リンクを踏んだだけで
    // 中身の無い「無題」パーティが1つ余分に残ってしまう。
    if (store.parties.length === 0) createParty(store);
    const restoredScrollY = restoreUiState(); // (B20/B21)
    try {
      // 1v1判定は対戦エンジン(wasm)が行う。描画前に必ず読み込む
      await Promise.all([
        loadCore().then((c) => { core = c; }),
        initEngine('/engine/engine_wasm.wasm', '/builder-data/engine.pack.json'),
      ]);
    } catch (e) {
      console.warn('[init] 初期化に失敗しました', e);
      renderInitError();
      return;
    }
    render();
    if (restoredScrollY !== null) requestAnimationFrame(() => window.scrollTo(0, restoredScrollY));
  }
  init();
</script>
