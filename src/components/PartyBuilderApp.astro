  function renderTray() {
    const el = document.getElementById('pb-tray');
    const p = activeParty();
    if (!p) { el.innerHTML = ''; return; }
    el.innerHTML = p.slots.map((slot, i) => {
      const active = selectedIdx === i ? ' active' : '';
      if (!slot) {
        return `<button class="montab pb-slot-empty${active}" data-slot="${i}"><span class="pb-plus">＋</span></button>`;
      }
      const rb = resolveSlotSafe(slot);
      const sm = core ? core.species.find((s) => s.n === slot.sp) : null;
      const name = rb ? rb.label : slot.sp;
      const icon = rb ? rb.icon : (sm ? sm.icon : null);
      return `<button class="montab${active}" data-slot="${i}" draggable="true">
          <span class="pb-slot-x" data-slot-x="${i}" title="${esc(I18N.slotRemoveTitle)}">✕</span>
          ${icoImg(icon, name, 'monicon')}
          <span class="mname">${esc(tPoke(name))}</span>
          <span class="mitem">${esc(tItem(slot.item)) || '—'}</span>
        </button>`;
    }).join('');
    el.querySelectorAll('.montab').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedIdx = +btn.dataset.slot;
        tuneResults = null;
        activeMuTab = null;
        muEdit = null;
        selTab = 'editor'; // (B15) 枠を選び直したら常に型エディタタブから開く
        document.querySelectorAll('#pb-tray .montab').forEach((b) => b.classList.toggle('active', +b.dataset.slot === selectedIdx));
        renderSlotSearch();
        renderSelectedHead();
        renderEditor();
        renderTargetsPanel();
        scrollToSelectedSection(); // (B01)
      });
    });
    el.querySelectorAll('.pb-slot-x').forEach((x) => {
      x.addEventListener('click', (e) => {
        e.stopPropagation();
        removeSlotAt(+x.dataset.slotX);
      });
    });
    // DnD並べ替え（充填枠のみドラッグ可。モバイルタッチは対象外）
    el.querySelectorAll('.montab[draggable="true"]').forEach((btn) => {
      btn.addEventListener('dragstart', (e) => {
        dragSrcIdx = +btn.dataset.slot;
        e.dataTransfer.effectAllowed = 'move';
        try { e.dataTransfer.setData('text/plain', String(dragSrcIdx)); } catch (err) { /* noop */ }
        btn.classList.add('pb-dragging');
      });
      btn.addEventListener('dragend', () => {
        btn.classList.remove('pb-dragging');
        dragSrcIdx = null;
        el.querySelectorAll('.montab').forEach((b) => b.classList.remove('pb-drop-target'));
      });
    });
    el.querySelectorAll('.montab').forEach((btn) => {
      btn.addEventListener('dragover', (e) => {
        if (dragSrcIdx === null) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        btn.classList.add('pb-drop-target');
      });
      btn.addEventListener('dragleave', () => btn.classList.remove('pb-drop-target'));
      btn.addEventListener('drop', (e) => {
        e.preventDefault();
        btn.classList.remove('pb-drop-target');
        const destIdx = +btn.dataset.slot;
        if (dragSrcIdx === null || dragSrcIdx === destIdx) return;
        reorderSlots(dragSrcIdx, destIdx);
      });
    });
  }

  /** ✕で外す: 左詰めを維持したまま該当枠を除去する(migrateと同じcompact方式)。(9) 除去前の枠オブジェクト
   * (targets込み)をそのままpendingUndoに保持し、Undoトーストから完全復元できるようにする。 */
  function removeSlotAt(i) {
    const p = activeParty();
    if (!p) return;
    const selectedSlotObj = selectedIdx !== null ? p.slots[selectedIdx] : null;
    const filled = p.slots.filter((s) => s !== null);
    if (i >= filled.length) return;
    const [removed] = filled.splice(i, 1);
    const out = [...filled];
    while (out.length < 6) out.push(null);
    p.slots = out;
    p.updatedAt = Date.now();
    if (selectedSlotObj) {
      const newIdx = p.slots.indexOf(selectedSlotObj);
      selectedIdx = newIdx === -1 ? null : newIdx;
    } else {
      selectedIdx = null;
    }
    tuneResults = null;
    saveStore(store);
    const rb = resolveSlotSafe(removed);
    showUndoToast(tPoke(rb ? rb.label : removed.sp), p.id, i, removed);
    render();
  }

  // ---- (9) 枠✕のUndoトースト ----
  /** 新規除去のたびに前回分を上書きする(=最後の1件のみUndo可能)。5秒後に自動消滅する。
   * mode='remove'(既定): 枠✕での除去。左詰め後のindexへslotDataを挿入し直す(既存挙動)。
   * mode='replace': 「穴を埋める候補」の入れ替え適用。indexの枠へslotDataをそのまま戻す(左詰めしない)。
   * msgを渡すとI18N.undoRemoved(name)の代わりにその文言をそのまま表示する(入れ替え用の文言を使うため)。
   * mode='custom'はslotData等を使わず、fn(復元処理)をそのまま呼ぶ(S02: 簡単構築からの取り込み取消用)。 */
  function showUndoToast(name, partyId, index, slotData, mode, msg, fn) {
    if (pendingUndo && pendingUndo.timer) clearTimeout(pendingUndo.timer);
    const timer = setTimeout(() => { pendingUndo = null; renderUndoToast(); }, 5000);
    pendingUndo = { name, partyId, index, slotData, timer, mode: mode || 'remove', msg, fn };
    renderUndoToast();
  }
  function clearPendingUndo() {
    if (pendingUndo && pendingUndo.timer) clearTimeout(pendingUndo.timer);
    pendingUndo = null;
    renderUndoToast();
  }
  function renderUndoToast() {
    const el = document.getElementById('pb-undo-toast');
    if (!el) return;
    if (!pendingUndo) { el.style.display = 'none'; el.innerHTML = ''; return; }
    el.style.display = 'flex';
    const msg = pendingUndo.msg || I18N.undoRemoved(pendingUndo.name);
    el.innerHTML = `<span>${esc(msg)}</span><button type="button" class="pb-undo-toast-btn" id="pb-undo-btn">${esc(I18N.undoBtn)}</button>`;
    document.getElementById('pb-undo-btn').addEventListener('click', undoRemoveSlot);
  }
  /** 復元: mode='remove'は除去時の位置(左詰め後のインデックス)へSlot全体(targets込み)を挿入し直す。
   * mode='replace'はindexの枠へslotDataをそのまま(左詰めせず)戻す。 */
  function undoRemoveSlot() {
    if (!pendingUndo) return;
    const { partyId, index, slotData, timer, mode, fn } = pendingUndo;
    clearTimeout(timer);
    pendingUndo = null;
    renderUndoToast();
    if (mode === 'custom') { fn(); return; }
    const party = store.parties.find((pp) => pp.id === partyId);
    if (!party) return;
    if (mode === 'replace') {
      party.slots[index] = slotData;
      party.updatedAt = Date.now();
      saveStore(store);
      if (activeParty() && activeParty().id === partyId) render();
      return;
    }
    const filled = party.slots.filter((s) => s !== null);
    const insertAt = Math.min(index, filled.length);
    filled.splice(insertAt, 0, slotData);
    const out = [...filled];
    while (out.length < 6) out.push(null);
    party.slots = out.slice(0, 6);
    party.updatedAt = Date.now();
    saveStore(store);
    if (activeParty() && activeParty().id === partyId) render();
  }

  /** DnD並べ替え: 充填枠だけを対象にした配列移動＋左詰め維持。選択中の枠はオブジェクト同一性で追従。 */
  function reorderSlots(from, to) {
    const p = activeParty();
    if (!p) return;
    const filled = p.slots.filter((s) => s !== null);
    if (from >= filled.length) return;
    const destIdx = Math.min(to, filled.length - 1);
    const selectedSlotObj = selectedIdx !== null ? p.slots[selectedIdx] : null;
    const [moving] = filled.splice(from, 1);
    filled.splice(destIdx, 0, moving);
    const out = [...filled];
    while (out.length < 6) out.push(null);
    p.slots = out;
    p.updatedAt = Date.now();
    if (selectedSlotObj) {
      const newIdx = p.slots.indexOf(selectedSlotObj);
      selectedIdx = newIdx === -1 ? null : newIdx;
    }
    saveStore(store);
    render();
  }

  // ---- 型エディタ ----
  let editorRenderToken = 0;
  async function renderEditor() {
    const el = document.getElementById('pb-editor');
    const p = activeParty();
    if (!p) { el.innerHTML = `<div class="muted">${esc(I18N.createPartyPrompt)}</div>`; return; }
    if (selectedIdx === null) {
      el.innerHTML = `<h2>${esc(I18N.editorTitle)}</h2><div class="muted">${esc(I18N.editorSelectPrompt)}</div>`;
      return;
    }
    const slot = p.slots[selectedIdx];
    if (!slot) { el.innerHTML = `<h2>${esc(I18N.editorTitle)}</h2><div class="muted">${esc(I18N.editorAddPrompt)}</div>`; return; }
    const sm = core.species.find((s) => s.n === slot.sp);
    if (!sm) { el.innerHTML = `<div class="muted">${esc(I18N.speciesDataMissing)}</div>`; return; }
    const token = ++editorRenderToken;
    el.innerHTML = `<h2>${esc(I18N.editorHeading(selectedIdx + 1))}</h2><div class="muted">${esc(I18N.loading)}</div>`;
    let detail = null;
    try { detail = await loadMon(sm.icon); } catch (e) { detail = null; }
    if (token !== editorRenderToken) return;
    currentMonDetail = detail;
    buildEditorFilledDom(el, slot, sm, detail || { items: [], abilities: [], natures: [], evs: [], moves: [], learnset: [], builds: [] });
  }

  /** (4) 空き枠検索カードの吹き出し矢印の左位置。トレイが3列(モバイル)か6列(PC)かに応じて列基準で算出する。 */
  function computeArrowLeft(idx) {
    const columns = mqMobileTray.matches ? 3 : 6;
    const col = idx % columns;
    return `calc((${col} + 0.5) / ${columns} * 100%)`;
  }
  mqMobileTray.addEventListener('change', () => { if (selectedIdx !== null) renderSlotSearch(); });

  /** 空き枠選択時に「6枠編成」カード内・トレイ直下へ検索UIを展開する（枠外は空にする）。 */
  function renderSlotSearch() {
    const el = document.getElementById('pb-slot-search');
    if (!el) return;
    const p = activeParty();
    if (!p || selectedIdx === null || p.slots[selectedIdx]) { el.innerHTML = ''; return; }
    const idx = selectedIdx;
    const arrowLeft = computeArrowLeft(idx);
    el.innerHTML = `
      <div class="pb-slotsearch" style="--pb-arrow-left:${arrowLeft}">
        <div class="pb-slotsearch-head">
          <span class="pb-slotsearch-title">${esc(I18N.slotSearchTitle(idx + 1))}</span>
          <button type="button" class="pb-slotsearch-close" id="pb-slotsearch-close" aria-label="${esc(I18N.close)}">${esc(I18N.slotSearchClose)}</button>
        </div>
        <div class="filter-wrap">
          <input type="text" id="pb-sp-search" class="filter-inp" placeholder="${esc(I18N.slotSearchPlaceholder)}" autocomplete="off">
          <div class="filter-sug" id="pb-sp-sug" style="display:none"></div>
        </div>
      </div>`;
    const input = el.querySelector('#pb-sp-search');
    input.addEventListener('input', (e) => onSpSearchInput(e.target.value));
    input.addEventListener('keydown', onSpSearchKey);
    input.focus();
    el.querySelector('#pb-slotsearch-close').addEventListener('click', () => {
      selectedIdx = null;
      document.querySelectorAll('#pb-tray .montab').forEach((b) => b.classList.remove('active'));
      renderSlotSearch();
      renderEditor();
      renderTargetsPanel();
    });
  }

  function onSpSearchInput(val) {
    const sug = document.getElementById('pb-sp-sug');
    if (!sug || !core) return;
    spSugActive = -1;
    const q = val.trim();
    if (!q) { sug.style.display = 'none'; return; }
    const qk = toKatakana(q);
    const hits = core.species.filter((s) => matchesQuery(s.n, q, qk)).slice(0, 12);
    if (!hits.length) { sug.innerHTML = `<div class="sug-item added">${esc(I18N.noHit)}</div>`; sug.style.display = 'block'; return; }
    sug.innerHTML = hits.map((s) => `<div class="sug-item" data-sp="${esc(s.n)}">${icoImg(s.icon, s.n, '')}<span>${hlSug(s.n, q)}</span><span class="rk">${esc(s.off ? I18N.offRankLbl : I18N.rankLbl(s.rank))}</span></div>`).join('');
    sug.querySelectorAll('[data-sp]').forEach((it) => it.addEventListener('click', () => pickSpecies(it.dataset.sp)));
    sug.style.display = 'block';
  }
  function onSpSearchKey(e) {
    const sug = document.getElementById('pb-sp-sug');
    if (!sug || sug.style.display === 'none') return;
    const items = [...sug.querySelectorAll('[data-sp]')];
    if (e.key === 'ArrowDown') { e.preventDefault(); spSugActive = Math.min(spSugActive + 1, items.length - 1); items.forEach((it, i) => it.classList.toggle('act', i === spSugActive)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); spSugActive = Math.max(spSugActive - 1, 0); items.forEach((it, i) => it.classList.toggle('act', i === spSugActive)); }
    else if (e.key === 'Enter') { e.preventDefault(); if (spSugActive >= 0 && items[spSugActive]) pickSpecies(items[spSugActive].dataset.sp); else if (items.length === 1) pickSpecies(items[0].dataset.sp); }
    else if (e.key === 'Escape') { sug.style.display = 'none'; spSugActive = -1; }
  }
  async function pickSpecies(name) {
    if (!core) return;
    const sm = core.species.find((s) => s.n === name);
    const p = activeParty();
    if (!sm || !p) return;
    const idx = selectedIdx;
    let newSlot = { sp: name, item: '', ability: '', nature: '', evs: [0, 0, 0, 0, 0, 0], moves: [], targets: [] };
    try {
      const detail = await loadMon(sm.icon);
      if (detail.builds && detail.builds.length) {
        const parsed = fromSpec(detail.builds[0]);
        if (parsed) { parsed.targets = []; newSlot = parsed; }
      } else {
        newSlot.item = (detail.items[0] || {}).n || '';
        newSlot.ability = (detail.abilities[0] || {}).n || '';
        newSlot.nature = (detail.natures[0] || {}).n || '';
        newSlot.evs = (detail.evs[0] || {}).ev || [0, 0, 0, 0, 0, 0];
        newSlot.moves = detail.moves.slice(0, 4).map((m) => m.n);
      }
    } catch (e) { /* フェッチ失敗時は空の型のまま追加 */ }
    if (idx !== selectedIdx) return;
    p.slots[idx] = newSlot;
    p.updatedAt = Date.now();
    saveStore(store);
    selTab = 'editor'; // (B15) ポケモン追加直後は型エディタから
    render();
  }



  /** value属性は常に和名(生データ)。表示テキストのみtAbil()で翻訳する。 */
  function fieldOptions(entries, current, emptyLabel) {
    const list = entries || [];
    const names = new Set(list.map((x) => x.n));
    let html = '';
    if (emptyLabel !== undefined) html += `<option value="" ${!current ? 'selected' : ''}>${esc(emptyLabel)}</option>`;
    if (current && !names.has(current)) html += `<option value="${esc(current)}" selected>${esc(tAbil(current))}</option>`;
    html += list.map((x) => `<option value="${esc(x.n)}" ${x.n === current ? 'selected' : ''}>${esc(tAbil(x.n))}${x.pct != null ? ` (${x.pct}%)` : ''}</option>`).join('');
    return html;
  }

  /** 持ち物select: 「なし」+使用率つき(上段)+その他(下段・五十音順、items.json由来)の2段構成。
   * value属性は常に和名(生データ)。表示テキストのみtItem()で翻訳する。 */
  function itemSelectOptions(entries, current, allItems) {
    const list = entries || [];
    const topNames = new Set(list.map((x) => x.n));
    const rest = (allItems || []).filter((n) => !topNames.has(n));
    const known = new Set([...topNames, ...(allItems || [])]);
    let html = `<option value="" ${!current ? 'selected' : ''}>${esc(I18N.noneOpt)}</option>`;
    if (current && !known.has(current)) html += `<option value="${esc(current)}" selected>${esc(tItem(current))}</option>`;
    const topOpts = list.map((x) => `<option value="${esc(x.n)}" ${x.n === current ? 'selected' : ''}>${esc(tItem(x.n))} (${x.pct}%)</option>`).join('');
    html += `<optgroup label="${esc(I18N.usageGroup)}">${topOpts}</optgroup>`;
    if (rest.length) {
      const restOpts = rest.map((n) => `<option value="${esc(n)}" ${n === current ? 'selected' : ''}>${esc(tItem(n))}</option>`).join('');
      html += `<optgroup label="${esc(I18N.otherGroup)}">${restOpts}</optgroup>`;
    }
    return html;
  }

  /** 性格select: 使用率つき(上段・%付き)+残り(下段・その他)の2段構成。表示は natureDisp() で統一。
   * 無補正5性格(まじめ/きまぐれ/てれや/がんばりや/すなお)は簡単化のため「がんばりや」のみ候補にする。
   * ただし現在値が別の無補正性格(インポート・既存データ由来)の場合は壊さないようその値も選択肢に残す。
   * stats.ts の NATURE_MODS/ALL_NATURES 自体はここでは変更しない(計算・fromSpec互換のため)。表示は tNatureDisp() で翻訳する。 */
  function natureSelectOptions(entries, current) {
    const keepNeutral = (n) => !NEUTRAL_NATURES.includes(n) || n === 'がんばりや' || n === current;
    const list = (entries || []).filter((x) => keepNeutral(x.n));
    const topNames = new Set(list.map((x) => x.n));
    const restPool = ALL_NATURES.filter((n) => !topNames.has(n) && keepNeutral(n));
    const rest = sortJa(restPool);
    let html = '';
    if (current && !topNames.has(current) && !restPool.includes(current)) html += `<option value="${esc(current)}" selected>${esc(tNatureDisp(current) || tNature(current))}</option>`;
    const topOpts = list.map((x) => `<option value="${esc(x.n)}" ${x.n === current ? 'selected' : ''}>${esc(tNatureDisp(x.n))} (${x.pct}%)</option>`).join('');
    html += `<optgroup label="${esc(I18N.usageGroup)}">${topOpts}</optgroup>`;
    const restOpts = rest.map((n) => `<option value="${esc(n)}" ${n === current ? 'selected' : ''}>${esc(tNatureDisp(n))}</option>`).join('');
    html += `<optgroup label="${esc(I18N.otherGroup)}">${restOpts}</optgroup>`;
    return html;
  }

  /** 技select: 空(「—」)+使用率順(上段・%付き、mon.moves全件)+その他(下段・全習得技のうち使用率外、五十音順)の2段構成。
   * value属性は常に和名(生データ)。表示テキストのみtMove()で翻訳する。 */
  function moveSelectOptions(detail, current) {
    const top = detail.moves || [];
    const topNames = new Set(top.map((x) => x.n));
    const learnset = detail.learnset || [];
    const rest = sortJa(learnset.filter((n) => !topNames.has(n)));
    const known = new Set([...topNames, ...learnset]);
    let html = `<option value="" ${!current ? 'selected' : ''}>${esc(I18N.dashOpt)}</option>`;
    if (current && !known.has(current)) html += `<option value="${esc(current)}" selected>${esc(tMove(current))}</option>`;
    const topOpts = top.map((x) => `<option value="${esc(x.n)}" ${x.n === current ? 'selected' : ''}>${esc(tMove(x.n))} (${x.pct}%)</option>`).join('');
    html += `<optgroup label="${esc(I18N.usageRankGroup)}">${topOpts}</optgroup>`;
    if (rest.length) {
      const restOpts = rest.map((n) => `<option value="${esc(n)}" ${n === current ? 'selected' : ''}>${esc(tMove(n))}</option>`).join('');
      html += `<optgroup label="${esc(I18N.otherGroupMoves)}">${restOpts}</optgroup>`;
    }
    return html;
  }


  function buildEditorFilledDom(el, slot, sm, detail) {
    const rb = resolveSlotSafe(slot);
    const megaOpt = slot.item ? sm.mega.find((m) => m.stone === slot.item) : undefined;
    const itemOpts = itemSelectOptions(detail.items, slot.item, core.items);
    const abilityOpts = megaOpt
      ? `<option value="${esc(megaOpt.ability)}" selected>${esc(tAbil(megaOpt.ability))}</option>`
      : fieldOptions(detail.abilities, slot.ability);
    const natureOpts = natureSelectOptions(detail.natures, slot.nature);

    const tplBtn = (detail.builds || []).length
      ? `<button type="button" class="pb-btn-sub pb-head-tpl" id="pb-preset-open">${esc(I18N.templateBtn)}</button>`
      : '';
    const head = rb ? `<div class="pb-editor-head">
        ${icoImg(rb.icon, rb.label, 'monicon')}
        <div>
          <div class="pb-editor-name">${esc(tPoke(rb.label))}${rb.mega ? `<span class="mmega-tag">${esc(I18N.megaTag)}</span>` : ''}</div>
          <div class="pb-editor-types">${typeIcoByName(rb.t1)}${rb.t2 ? typeIcoByName(rb.t2) : ''}</div>
        </div>
        ${tplBtn}
      </div>` : '';

    const evRows = EVK.map((label, si) => {
      const v = Number(slot.evs[si]) || 0;
      return `<div class="pb-ev-row" data-ev-i="${si}">
        <span class="pb-ev-lbl ev-${label}">${label}</span>
        <button type="button" class="pb-ev-step" data-ev-step="-1" data-ev-i="${si}" aria-label="${esc(I18N.evDownAria(label))}" ${v <= 0 ? 'disabled' : ''}>−</button>
        <input type="range" min="0" max="${EV_STAT_MAX}" value="${v}" class="pb-ev-range" data-ev-i="${si}">
        <button type="button" class="pb-ev-step" data-ev-step="1" data-ev-i="${si}" aria-label="${esc(I18N.evUpAria(label))}" ${v >= EV_STAT_MAX ? 'disabled' : ''}>＋</button>
        <input type="number" min="0" max="${EV_STAT_MAX}" value="${v}" class="pb-ev-num" data-ev-i="${si}">
        <span class="pb-ev-stat" data-ev-stat="${si}">${rb ? rb.stats[si] : '—'}</span>
      </div>`;
    }).join('');

    const evPresetBtn = (detail.evs || []).length
      ? `<button type="button" class="pb-btn-sub" id="pb-evpreset-open">${esc(I18N.evPresetBtn)}</button>`
      : '';

    const moveRows = [0, 1, 2, 3].map((mi) => {
      const val = slot.moves[mi] || '';
      return `<div class="pb-mv-wrap" data-mv-wrap="${mi}">
          <span class="pb-mv-ico">${typeIcoForMove(val)}</span>
          <select class="inp pb-mv-select" data-mv-i="${mi}">${moveSelectOptions(detail, val)}</select>
        </div>`;
    }).join('');

    el.innerHTML = `
      <div class="pb-editor-titlebar">
        <h2>${esc(I18N.editorHeading(selectedIdx + 1))}</h2>
      </div>
      ${head}
      <div class="dgrid pb-select-row">
        <div class="dcell"><span class="lbl item">${esc(I18N.itemLbl)}</span><select class="inp" id="pb-f-item">${itemOpts}</select></div>
        <div class="dcell"><span class="lbl abil">${esc(I18N.abilLbl)}</span><select class="inp" id="pb-f-ability" ${megaOpt ? 'disabled' : ''}>${abilityOpts}</select>${megaOpt ? `<span class="pb-mega-note">${esc(I18N.megaFixedNote)}</span>` : ''}</div>
        <div class="dcell"><span class="lbl nat">${esc(I18N.natLbl)}</span><select class="inp" id="pb-f-nature">${natureOpts}</select></div>
      </div>
      <div class="pb-ev-editor">
        ${evRows}
        <div class="pb-ev-foot"><div class="pb-ev-remain" id="pb-ev-remain">${evRemainText(slot.evs)}</div>${evPresetBtn}</div>
      </div>
      <div class="pb-moves">${moveRows}</div>
    `;

    el.querySelector('#pb-f-item').addEventListener('change', (e) => {
      slot.item = e.target.value;
      commitAndReflow();
    });
    if (!megaOpt) {
      el.querySelector('#pb-f-ability').addEventListener('change', (e) => { slot.ability = e.target.value; commitAndReflow(); });
    }
    el.querySelector('#pb-f-nature').addEventListener('change', (e) => { slot.nature = e.target.value; commitAndReflow(); });

    el.querySelectorAll('.pb-ev-range, .pb-ev-num').forEach((inp) => inp.addEventListener('input', onEvInput));
    el.querySelectorAll('.pb-ev-range').forEach((inp) => {
      inp.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;
        inp.dataset.evBefore = inp.value;
      });
      // 縦スクロールに転じるとブラウザがポインタ列を取り消す。触れた瞬間に飛んだ値を戻す。
      inp.addEventListener('pointercancel', () => {
        const before = inp.dataset.evBefore;
        if (before === undefined || before === inp.value) return;
        inp.value = before;
        applyEvChange(+inp.dataset.evI, before, inp);
      });
      inp.addEventListener('pointerup', () => { delete inp.dataset.evBefore; });
    });
    el.querySelectorAll('.pb-ev-num').forEach((inp) => inp.addEventListener('focus', (e) => e.target.select())); // (12a) フォーカスで全選択
    el.querySelectorAll('.pb-ev-step').forEach((btn) => btn.addEventListener('click', () => onEvStepClick(+btn.dataset.evI, +btn.dataset.evStep)));
    const evPresetOpenBtn = el.querySelector('#pb-evpreset-open');
    if (evPresetOpenBtn) {
      evPresetOpenBtn.addEventListener('click', () => {
        openEvPresetListPopover(sm ? sm.n : slot.sp, (detail.evs || []).slice(0, 5), (evs) => {
          slot.evs = evs;
          commitAndReflow();
        });
      });
    }

    el.querySelectorAll('.pb-mv-select').forEach((sel) => {
      const mi = +sel.dataset.mvI;
      sel.addEventListener('change', (e) => onMoveSelect(mi, e.target.value));
    });

    // (5) 型テンプレはタップ即上書きせず、まずポップオーバーで候補一覧の内容を確認→
    // 候補ごとの「この型を適用」で確定する
    const presetOpenBtn = el.querySelector('#pb-preset-open');
    if (presetOpenBtn) {
      presetOpenBtn.addEventListener('click', () => {
        openPresetListPopover(sm ? sm.n : slot.sp, (detail.builds || []).slice(0, 5), (parsed) => {
          const targets = slot.targets;
          slot.item = parsed.item; slot.ability = parsed.ability; slot.nature = parsed.nature; slot.evs = parsed.evs; slot.moves = parsed.moves;
          slot.targets = targets;
          commitAndReflow();
        });
      });
    }

    function persist() {
      const p = activeParty();
      if (p) p.updatedAt = Date.now();
      saveStore(store);
    }
    function commitAndReflow() {
      persist();
      renderValidate();
      renderEditor();
      renderTray();
      renderTargetsPanel();
      renderBalance();
    }
  }

  function evRemainText(evs) {
    const sum = evs.reduce((a, b) => a + b, 0);
    const remain = EV_TOTAL_MAX - sum;
    return remain < 0 ? `<span class="pb-ev-over">${esc(I18N.evRemainOver(remain))}</span>` : esc(I18N.evRemain(remain));
  }
  /** EV変更の共通処理(スライダー/数値入力/±ステッパーの3経路から呼ぶ)。値を[0,32]にクランプし、
   * スライダー・数値入力・±ボタンのdisabled状態・実数値・残りポイント表示を同期する。 */
  function applyEvChange(si, rawV, sourceEl) {
    const p = activeParty();
    if (!p || selectedIdx === null) return;
    const slot = p.slots[selectedIdx];
    if (!slot) return;
    let v = Math.round(Number(rawV));
    if (Number.isNaN(v)) v = 0;
    v = Math.max(0, Math.min(EV_STAT_MAX, v));
    slot.evs[si] = v;
    p.updatedAt = Date.now();
    saveStore(store);
    const editorEl = document.getElementById('pb-editor');
    if (editorEl) {
      editorEl.querySelectorAll(`.pb-ev-range[data-ev-i="${si}"], .pb-ev-num[data-ev-i="${si}"]`).forEach((inp) => { if (inp !== sourceEl) inp.value = v; });
      editorEl.querySelectorAll(`.pb-ev-step[data-ev-i="${si}"]`).forEach((btn) => {
        const delta = +btn.dataset.evStep;
        btn.disabled = delta < 0 ? v <= 0 : v >= EV_STAT_MAX;
      });
      const rb = resolveSlotSafe(slot);
      const statEl = editorEl.querySelector(`[data-ev-stat="${si}"]`);
      if (statEl) statEl.textContent = rb ? rb.stats[si] : '—';
      const remainEl = document.getElementById('pb-ev-remain');
      if (remainEl) remainEl.innerHTML = evRemainText(slot.evs);
    }
    renderValidate();
    scheduleRenderTargets();
    scheduleRenderBalance();
  }
  function onEvInput(e) {
    applyEvChange(+e.target.dataset.evI, e.target.value, e.target);
  }
  /** (2) EVステッパー「−」「＋」: タップで±1。0/32では該当ボタンをdisabledにしてある(再クランプもここで行う)。 */
  function onEvStepClick(si, delta) {
    const p = activeParty();
    if (!p || selectedIdx === null) return;
    const slot = p.slots[selectedIdx];
    if (!slot) return;
    const cur = Number(slot.evs[si]) || 0;
    applyEvChange(si, cur + delta, null);
  }

  function onMoveSelect(mi, name) {
    const p = activeParty();
    if (!p || selectedIdx === null) return;
    const slot = p.slots[selectedIdx];
    if (!slot) return;
    slot.moves[mi] = name;
    p.updatedAt = Date.now();
    saveStore(store);
    const wrap = document.querySelector(`[data-mv-wrap="${mi}"]`);
    if (wrap) { const ico = wrap.querySelector('.pb-mv-ico'); if (ico) ico.innerHTML = typeIcoForMove(name); }
    renderTargetsPanel();
    renderBalance();
  }

  // ---- 仮想敵パネル ----

  /** 仮想敵の型 ミニエディタのHTML(読み込み中はプレースホルダ)。編集対象は持ち物/特性/性格/EV/技のみ(t1/t2/bs/idxは維持)。 */
  function muEditorHtml(grp, draft, detail, loading) {
    if (loading || !detail) {
      return `<div class="pb-mu-card"><div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">${esc(I18N.loading)}</div></div></div>`;
    }
    const itemOpts = itemSelectOptions(detail.items, draft.item, core.items);
    const abilityOpts = fieldOptions(detail.abilities, draft.ability);
    const natureOpts = natureSelectOptions(detail.natures, draft.nature);
    const evRows = EVK.map((label, si) => `<div class="pb-mu-ev-row" data-mu-ev-i="${si}">
        <span class="pb-ev-lbl ev-${label}">${label}</span>
        <input type="number" min="0" max="${EV_STAT_MAX}" value="${Number(draft.ev[si]) || 0}" class="inp pb-mu-ev-num" data-mu-ev-i="${si}">
      </div>`).join('');
    const moveRows = [0, 1, 2, 3].map((mi) => {
      const val = draft.moves[mi] || '';
      return `<div class="pb-mv-wrap" data-mu-mv-wrap="${mi}">
          <span class="pb-mv-ico">${typeIcoForMove(val)}</span>
          <select class="inp pb-mv-select" data-mu-mv-i="${mi}">${moveSelectOptions(detail, val)}</select>
        </div>`;
    }).join('');
    return `<div class="pb-mu-card">
        <div class="pb-mu-head"><b>${esc(I18N.muEditHeading(tPoke(grp.label)))}</b></div>
        <div class="dgrid pb-select-row">
          <div class="dcell"><span class="lbl item">${esc(I18N.itemLbl)}</span><select class="inp" id="pb-mu-e-item">${itemOpts}</select></div>
          <div class="dcell"><span class="lbl abil">${esc(I18N.abilLbl)}</span><select class="inp" id="pb-mu-e-ability">${abilityOpts}</select></div>
          <div class="dcell"><span class="lbl nat">${esc(I18N.natLbl)}</span><select class="inp" id="pb-mu-e-nature">${natureOpts}</select></div>
        </div>
        <div class="pb-mu-ev-grid">${evRows}</div>
        <div class="pb-ev-remain" id="pb-mu-ev-remain">${evRemainText(draft.ev)}</div>
        <div class="pb-moves">${moveRows}</div>
        <div class="row" style="margin-top:.5em">
          <button class="btn" id="pb-mu-save">${esc(I18N.muSaveBtn)}</button>
          <button class="pb-btn-sub" id="pb-mu-cancel">${esc(I18N.muCancelBtn)}</button>
        </div>
      </div>`;
  }

  /** 「編集」「＋型を追加」開始。bi='new'は既定値=型1のコピー(idxは既存最大+1)。 */
  async function startMuEdit(label, bi) {
    const grp = effectiveTargets().find((g) => g.label === label);
    if (!grp) return;
    const src = bi === 'new' ? grp.builds[0] : grp.builds[bi];
    if (!src) return;
    const draft = JSON.parse(JSON.stringify(src));
    if (bi === 'new') draft.idx = Math.max(0, ...grp.builds.map((b) => b.idx)) + 1;
    muEdit = { label, bi, draft, detail: null, loading: true };
    renderTargetsPanel();
    try {
      const detail = await loadMonForTargetLabel(label);
      if (!muEdit || muEdit.label !== label || muEdit.bi !== bi) return;
      muEdit.detail = detail;
      muEdit.loading = false;
      renderTargetsPanel();
    } catch (e) {
      if (!muEdit || muEdit.label !== label || muEdit.bi !== bi) return;
      muEdit.detail = { items: [], abilities: [], natures: [], evs: [], moves: [], learnset: [], builds: [] };
      muEdit.loading = false;
      renderTargetsPanel();
    }
  }
  function cancelMuEdit() {
    muEdit = null;
    renderTargetsPanel();
  }
  /** 保存: 初回編集時にtargets.jsonデフォルトをcustomTargetsへmaterializeしてから反映する。 */
  function saveMuEdit() {
    if (!muEdit) return;
    const { label, bi, draft } = muEdit;
    const grp = effectiveTargets().find((g) => g.label === label);
    if (!grp) { muEdit = null; renderTargetsPanel(); return; }
    materializeCustomTarget(label);
    // ユーザーが型を編集した場合、指定した4技を判定に使う（デフォルト型に付いている
    // 採用率TOP10の技プールmpoolはここで捨てる）。捨てないと技を変えても判定が
    // プール側の最大打点で決まってしまい、編集が反映されないように見える。
    delete draft.mpool;
    draft.spec = targetBuildSpec(grp.sp, draft);
    if (bi === 'new') store.customTargets[label].push(draft);
    else store.customTargets[label][bi] = draft;
    saveStore(store);
    invalidateOppColsCache();
    muEdit = null;
    tuneResults = null;
    renderTargetsPanel();
    renderBalance();
  }
  /** 型の削除。最後の1型は削除不可(呼び出し側でボタンをdisabledにして防ぐ)。 */
  function deleteMuBuild(label, bi) {
    const grp = effectiveTargets().find((g) => g.label === label);
    if (!grp || grp.builds.length <= 1) return;
    materializeCustomTarget(label);
    store.customTargets[label].splice(bi, 1);
    saveStore(store);
    invalidateOppColsCache();
    if (muEdit && muEdit.label === label) muEdit = null;
    tuneResults = null;
    renderTargetsPanel();
    renderBalance();
  }
  /** 「デフォルトに戻す」: customTargetsのエントリを削除しtargets.json由来のデフォルトへ戻す。 */
  function resetMuDefault(label) {
    if (!store.customTargets || !store.customTargets[label]) return;
    delete store.customTargets[label];
    saveStore(store);
    invalidateOppColsCache();
    if (muEdit && muEdit.label === label) muEdit = null;
    tuneResults = null;
    renderTargetsPanel();
    renderBalance();
  }

  const WEATHER_OPTS = ['晴れ', '雨', 'すなあらし', 'あられ'];
  const TERRAIN_OPTS = ['エレキフィールド', 'グラスフィールド', 'サイコフィールド', 'ミストフィールド'];
  let setupMoveSet = null;
  /** 積み技(自分の能力を上げる変化技)の一覧。判定に使う表をエンジンから取るので、
   * 「積み回数を出したのに計算が動かない」技が混ざらない。 */
  function setupMoves() {
    if (!setupMoveSet) {
      try { setupMoveSet = new Set(setupMoveNames()); } catch (e) { setupMoveSet = new Set(); }
    }
    return setupMoveSet;
  }
  /** この枠の技欄にある積み技(先頭の1つ)。エンジンが積みに使う技と同じ選び方。 */
  function slotSetupMove(slot) {
    const set = setupMoves();
    return (slot.moves || []).find((m) => m && set.has(m)) || null;
  }
  function scenarioOf(slot, label) {
    const sc = slot && slot.scenarios ? slot.scenarios[label] : null;
    return { w: (sc && sc.w) || '', t: (sc && sc.t) || '', n: (sc && sc.n) || 0 };
  }
  function scenarioIsDefault(sc) {
    return !sc.w && !sc.t && !sc.n;
  }
  /** エンジンへ渡す形。ラベル文字列はエンジン側の対応表と同じものだけ通す。 */
  function applyScenario(sc) {
    setScenario(scenarioIsDefault(sc) ? null : { weather: sc.w || null, terrain: sc.t || null, boost: sc.n });
  }
  function saveScenario(slot, label, patch) {
    const cur = scenarioOf(slot, label);
    const next = { ...cur, ...patch };
    if (!slot.scenarios) slot.scenarios = {};
    if (scenarioIsDefault(next)) delete slot.scenarios[label];
    else slot.scenarios[label] = next;
    if (!Object.keys(slot.scenarios).length) delete slot.scenarios;
    const p = activeParty();
    if (p) p.updatedAt = Date.now();
    saveStore(store);
    tuneResults = null;
    renderTargetsPanel();
  }
  /** 前提を人が読める短い文字列にする（ツールチップ用）。積みは技名で書く。 */
  function scenarioText(sc, moveNames) {
    const parts = [];
    if (sc.w) parts.push(tWeather(sc.w));
    if (sc.t) parts.push(tWeather(sc.t));
    if (sc.n) {
      const set = setupMoves();
      const mv = (moveNames || []).find((m) => m && set.has(m));
      parts.push(`${mv ? tMove(mv) : I18N.scBoost}${I18N.scBoostTimes(sc.n)}`);
    }
    return parts.join('・');
  }
  /** 天候・フィールドの表示名。辞書に無ければ日本語のまま出す（判定には使わない文字列）。 */
  function tWeather(name) {
    return (I18N.fieldNames && I18N.fieldNames[name]) || name;
  }
  /** この味方×この相手に前提が設定されていれば、前提つきの集約判定も返す。
   * 素の判定は必ず残す（前提で勝てても素で勝てるわけではない）。 */
  function condAgg(b, label, builds, baseAgg) {
    const sc = b && b.sc ? b.sc[label] : null;
    if (!sc || scenarioIsDefault(sc)) return null;
    applyScenario(sc);
    let agg;
    try { agg = judgeVsBuilds(b, builds); } finally { setScenario(null); }
    if (agg.sym === baseAgg.sym) return null;
    return { sym: agg.sym, text: scenarioText(sc, (b.moves || []).map((m) => m.n)) };
  }
  /** 前提つきで結果が変わる対面に付ける印。記号そのものは素の判定のまま。 */
  function condMarkHtml(cond, baseSym) {
    if (!cond) return '';
    return `<span class="mu-cond" title="${esc(I18N.scCondTitle(cond.text, baseSym, cond.sym))}">${esc(I18N.scCondMark)}</span>`;
  }

  /** 仮想敵ごとの前提(天候・フィールド・積み)の操作列。 */
  function scenarioRowHtml(slot, label) {
    const sc = scenarioOf(slot, label);
    const mv = slotSetupMove(slot);
    const opt = (v, cur, txt) => `<option value="${esc(v)}"${v === cur ? ' selected' : ''}>${esc(txt)}</option>`;
    const wSel = `<label class="pb-sc-f">${esc(I18N.scWeather)}
        <select class="pb-sc-sel" id="pb-sc-w">${opt('', sc.w, I18N.scAuto)}${WEATHER_OPTS.map((o) => opt(o, sc.w, tWeather(o))).join('')}</select></label>`;
    const tSel = `<label class="pb-sc-f">${esc(I18N.scTerrain)}
        <select class="pb-sc-sel" id="pb-sc-t">${opt('', sc.t, I18N.scNone)}${TERRAIN_OPTS.map((o) => opt(o, sc.t, tWeather(o))).join('')}</select></label>`;
    const nSel = mv
      ? `<label class="pb-sc-f">${esc(I18N.scBoost)}
          <select class="pb-sc-sel" id="pb-sc-n">${[0, 1, 2, 3, 4, 5, 6].map((n) => opt(String(n), String(sc.n), n === 0 ? I18N.scNone : `${tMove(mv)} ${I18N.scBoostTimes(n)}`)).join('')}</select></label>`
      : `<span class="pb-sc-f muted">${esc(I18N.scBoost)} ${esc(I18N.scBoostNoMove)}</span>`;
    const reset = scenarioIsDefault(sc) ? '' : `<button type="button" class="pb-btn-sub" id="pb-sc-reset">${esc(I18N.scReset)}</button>`;
    return `<div class="pb-sc-row${scenarioIsDefault(sc) ? '' : ' pb-sc-on'}">
        <span class="pb-sc-hd">${esc(I18N.scHd)}</span>${wSel}${tSel}${nSel}${reset}
      </div>`;
  }
  function bindScenarioRow(el, slot, label) {
    const w = el.querySelector('#pb-sc-w');
    if (w) w.addEventListener('change', () => saveScenario(slot, label, { w: w.value }));
    const t = el.querySelector('#pb-sc-t');
    if (t) t.addEventListener('change', () => saveScenario(slot, label, { t: t.value }));
    const n = el.querySelector('#pb-sc-n');
    if (n) n.addEventListener('change', () => saveScenario(slot, label, { n: Number(n.value) || 0 }));
    const r = el.querySelector('#pb-sc-reset');
    if (r) r.addEventListener('click', () => saveScenario(slot, label, { w: '', t: '', n: 0 }));
  }

  function renderTargetsPanel() {
    const el = document.getElementById('pb-targets');
    const p = activeParty();
    if (!p) { el.innerHTML = ''; muEdit = null; renderMiniBar(null, null); persistUi(); return; }
    if (selectedIdx === null) { el.innerHTML = `<h2>${esc(I18N.targetsHeading)}</h2><div class="muted">${esc(I18N.targetsSelectPrompt)}</div>`; muEdit = null; renderMiniBar(null, null); persistUi(); return; }
    const slot = p.slots[selectedIdx];
    if (!slot) { el.innerHTML = `<h2>${esc(I18N.targetsHeading)}</h2><div class="muted">${esc(I18N.targetsSetPrompt)}</div>`; muEdit = null; renderMiniBar(null, null); persistUi(); return; }
    const rb = resolveSlotSafe(slot);
    if (!rb) { el.innerHTML = `<h2>${esc(I18N.targetsHeading)}</h2><div class="muted">${esc(I18N.muCalcError)}</div>`; muEdit = null; renderMiniBar(null, null); persistUi(); return; }

    // ポケモン単位タブ: 選択中枠の仮想敵(追加済み種族)を切り替えて表示する。表示状態のみで保存はしない。
    if (!slot.targets.length) activeMuTab = null;
    else if (!activeMuTab || !slot.targets.includes(activeMuTab)) activeMuTab = slot.targets[0];
    if (muEdit && muEdit.label !== activeMuTab) muEdit = null;

    const targetsList = effectiveTargets();
    const chips = slot.targets.map((label) => {
      const grp = targetsList.find((g) => g.label === label);
      const act = label === activeMuTab ? ' act' : '';
      const badge = grp ? muTabBadge(rb, grp, scenarioOf(slot, label)) : null;
      const badgeHtml = badge
        ? `<span class="pb-mu-badge ${badge.sym === '×' ? 'pb-mu-badge-x' : 'pb-mu-badge-tri'}`
          + `${badge.cond ? ' pb-mu-badge-cond' : ''}" title="${esc(badge.cond
              ? I18N.scCondTitle(badge.cond.text, badge.sym, badge.cond.sym) : I18N.muBadgeTitle)}">`
          + `${badge.sym}${badge.cond ? esc(I18N.scCondMark) : ''}</span>`
        : '';
      return `<span class="filter-chip pb-mu-tab${act}" data-mu-tab="${esc(label)}">${grp ? icoImg(grp.icon, grp.label, '') : ''}${esc(tPoke(label))}${badgeHtml}<button class="filter-chip-x" data-rm-target="${esc(label)}">✕</button></span>`;
    }).join('');
    // (B10) ミニバー折りたたみ時: 選択枠が持つ全仮想敵について、アクティブなタブに絞らず1体1チップで
    // 最悪判定の記号を出す(worstMuSymはmuTabBadgeと同じ判定ロジックを共有・ここで確定数計算をやり直さない)。
    const miniBarTabs = slot.targets.map((label) => {
      const grp = targetsList.find((g) => g.label === label);
      if (!grp) return null;
      const w = worstMuSym(rb, grp, scenarioOf(slot, label));
      return { label, icon: grp.icon, sym: w ? w.sym : null };
    }).filter(Boolean);

    const activeGrp = activeMuTab ? targetsList.find((g) => g.label === activeMuTab) : null;
    const editingThis = !!(muEdit && activeGrp && muEdit.label === activeGrp.label);
    const canDelete = !!(activeGrp && activeGrp.builds.length > 1);
    const isCustomized = !!(activeGrp && store.customTargets && store.customTargets[activeGrp.label] && store.customTargets[activeGrp.label].length);
    const rows = [];
    // 仮想敵ごとの前提(天候・フィールド・積み)はこのカードの計算にだけ効かせる。
    // 戻し忘れるとパーティバランス側まで同じ前提で計算されてしまう。
    const scenario = activeGrp ? scenarioOf(slot, activeGrp.label) : null;
    if (activeGrp) applyScenario(scenario);
    try {
    if (activeGrp) {
      activeGrp.builds.forEach((b, bi) => {
        const opp = resolveTargetSafe(activeGrp.sp, activeGrp.label, activeGrp.icon, b, core.moves);
        if (!opp) return; // H3: 不整合buildはスキップ(型データが壊れていてもパネル全体はクラッシュさせない)
        const verdict = judge1v1(rb, opp);
        // 素早さは判定と同じ実効値(天候・エレキフィールド込み)を使う。ここだけ素の値にすると
        // 「先手と表示されているのに判定は後手扱い」という食い違いが出る。
        const mySpeed = verdict.myS;
        const oppSpeed = verdict.oppS;
        const speedTag = mySpeed > oppSpeed ? `<span class="spd-tag t-out">${esc(I18N.speedFaster)}</span>` : mySpeed < oppSpeed ? `<span class="spd-tag t-in">${esc(I18N.speedSlower)}</span>` : `<span class="spd-tag t-eq">${esc(I18N.speedEq)}</span>`;
        const stallSide = verdict.stall && verdict.stall.side;
        const myHitsTxt = stallSide === 'me' ? stallTurnsTxt(verdict.stall.turns)
          : verdict.myHits == null ? '—' : I18N.hitsFmt(verdict.myHits);
        const oppHitsTxt = stallSide === 'opp' ? stallTurnsTxt(verdict.stall.turns)
          : verdict.oppHits == null ? '—' : I18N.hitsFmt(verdict.oppHits);
        const mb = moveBreakdown(rb, opp);
        // 被ダメ行: 相手の最大打点技(verdict.oppMoveと同一選定基準)の自分への与ダメレンジ・HP比。
        // 与ダメ行と同じ場の前提で出すため、向きを入れ替えて呼ぶのではなく対で取る。
        const od = pairHitDetails(rb, opp).opp;
        const oppDmg = od && od.dmgLo != null && od.dmgHi != null
          ? { name: od.n, dLo: od.dmgLo, dHi: od.dmgHi, pLo: od.pctLo, pHi: od.pctHi }
          : null;
        rows.push({ grp: activeGrp, b, bi, opp, mySpeed, oppSpeed, speedTag, verdict, myHitsTxt, oppHitsTxt, mb, oppDmg });
      });
    }
    } finally {
      if (activeGrp) setScenario(null);
    }

    mbPopData = [];
    const cardsHtml = rows.map((r) => {
      if (editingThis && muEdit.bi === r.bi) {
        return muEditorHtml(r.grp, muEdit.draft, muEdit.detail, muEdit.loading);
      }
      const mbDamaging = r.mb.filter((m) => m.hits != null);
      const mbChips = mbDamaging.length
        ? mbDamaging.map((m) => {
            const hitsTxt = m.certain ? I18N.hitsFmt(m.hits) : I18N.randHitsFmt(m.hits, fmtKoProbPct(m.prob));
            const dmgTxt = dmgRangeTxt(m.dmgLo, m.dmgHi, m.pctLo, m.pctHi);
            const mvName = tMove(m.n);
            const popIdx = mbPopData.push({ name: m.n, hitsTxt, dmgTxt }) - 1;
            return `<button type="button" class="pb-mb-chip" data-mb-pop="${popIdx}" title="${esc(mvName)}：${esc(I18N.popDmgLbl(dmgTxt))}">
                <span class="pb-mb-top">${esc(mvName)} ${hitsTxt}</span>
                <span class="pb-mb-dmg">${dmgTxt}</span>
              </button>`;
          }).join('')
        : `<span class="muted">${r.mb.length ? esc(I18N.noEffectiveMove) : esc(I18N.noMovesSet)}</span>`;
      // 同じ技の連打では最短にならない対面(であいがしら等の初手限定技・ふうせん割り)で、
      // 毎ターン選び直した場合の手順を出す。
      const seqHtml = (r.verdict.mySeq || []).length
        ? `<div class="pb-mu-row pb-mu-seq">${esc(I18N.seqLbl((r.verdict.mySeq || []).map(tMove).join(' → '), r.verdict.myHits))}</div>`
        : '';
      const stallHtml = r.verdict.stall && r.verdict.stall.side
        ? `<div class="pb-mu-row pb-mu-seq">${esc(stallRouteTxt(r.verdict.stall))}</div>` : '';
      const oppDmgHtml = r.oppDmg
        ? `<div class="pb-mu-row pb-mu-hit">${esc(I18N.takenDmgLbl(tMove(r.oppDmg.name), dmgRangeTxt(r.oppDmg.dLo, r.oppDmg.dHi, r.oppDmg.pLo, r.oppDmg.pHi)))}</div>`
        : '';
      const actionsHtml = editingThis ? '' : `<div class="pb-mu-actions">
          <button class="pb-btn-sub" data-mu-edit="${r.bi}">${esc(I18N.muEditBtn)}</button>
          <button class="pb-btn-sub pb-danger" data-mu-del="${r.bi}" ${canDelete ? '' : `disabled title="${esc(I18N.muDeleteLastTitle)}"`}>${esc(I18N.muDeleteBtn)}</button>
        </div>`;
      return `<div class="pb-mu-card">
          <div class="pb-mu-head"><div class="dtl-tname">${icoImg(r.grp.icon, r.grp.label, 'dtl-ico')}${esc(tPoke(r.grp.label))} ${esc(I18N.buildLabel(Number(r.b.idx) || 0))}</div>${actionsHtml}</div>
          <div class="pb-mu-sub">${esc(I18N.hpLbl(r.opp.stats[0]))}</div>
          ${muDetailHtml(r.b)}
          <div class="pb-mu-row" title="${esc(I18N.speedTipTitle)}">S ${r.mySpeed} vs ${r.oppSpeed} ${r.speedTag}</div>
          <div class="pb-mu-row"><b style="font-size:1.05em">${r.verdict.sym}</b> ${esc(I18N.hitsSelfOpp(r.myHitsTxt, r.oppHitsTxt))}${r.verdict.stub ? '<span class="pb-beta-badge">β</span>' : ''}</div>
          <div class="pb-mb-row">${mbChips}</div>
          ${seqHtml}${stallHtml}${oppDmgHtml}
        </div>`;
    }).join('') + (editingThis && muEdit.bi === 'new' ? muEditorHtml(activeGrp, muEdit.draft, muEdit.detail, muEdit.loading) : '');

    const addResetRow = activeGrp && !editingThis
      ? `<div class="row" style="margin-top:.5em">
          <button class="pb-btn-sub" id="pb-mu-add-build">${esc(I18N.muAddBuildBtn)}</button>
          ${isCustomized ? `<button class="pb-btn-sub" id="pb-mu-reset-default">${esc(I18N.muResetDefaultBtn)}</button>` : ''}
        </div>`
      : '';
    const scenarioHtml = activeGrp ? scenarioRowHtml(slot, activeGrp.label) : '';
    // モバイルのボトムシート(renderMiniBar)にもそのまま渡す共通ブロック(型カード一覧+空メッセージ)。
    // (B28) 仮想敵が1体も無い空状態は検索を促すだけだと離脱しやすいので、使用率上位5体を
    // ワンタップで追加できるボタンを併設する(targetsListは使用率順=core.targets/customTargetsの並び)。
    const cardsBlockHtml = rows.length || editingThis
      ? `<div class="pb-mu-list">${cardsHtml}</div>`
      : slot.targets.length ? '' : `<div class="pb-empty-targets">
          <div class="muted">${esc(I18N.addTargetsPrompt)}</div>
          <button type="button" class="pb-btn-sub" id="pb-target-add-top5">${esc(I18N.addTop5TargetsBtn)}</button>
        </div>`;

    el.innerHTML = `
      <h2>${esc(I18N.targetsHeading)}</h2>
      <div class="filter-chips" id="pb-target-chips">${chips}</div>
      <div class="filter-wrap">
        <input type="text" id="pb-target-search" class="filter-inp" placeholder="${esc(I18N.targetSearchPlaceholder)}" autocomplete="off">
        <div class="filter-sug" id="pb-target-sug" style="display:none"></div>
      </div>
      ${scenarioHtml}
      ${cardsBlockHtml}
      ${addResetRow}
      <div class="row" style="margin-top:.7em">
        <button class="pb-btn-sub" id="pb-tune-btn" ${slot.targets.length ? '' : 'disabled'}>${esc(I18N.tuneBtn)}</button>
      </div>
      <div id="pb-tune-out"></div>
    `;

    /** chips/cardsBlockHtml/addResetRow(=型カード・タブ・編集フォーム一式)のイベント紐付け。
     * 仮想敵パネル本体(el)とモバイルのボトムシート(#pb-sheet-body)の両方から同じ内容で呼ばれるため、
     * ここを共通化することでシート側の二重実装(別のクリックハンドラ群)を避ける。rootはid付き要素を
     * root.querySelector(...)で探すため、同じidを持つ2つのDOM(パネル/シート)が同時に存在していても
     * 互いのイベントを誤って拾わない。 */
    function bindMuSection(root) {
      if (activeGrp) bindScenarioRow(root, slot, activeGrp.label);
      const addTop5Btn = root.querySelector('#pb-target-add-top5');
      if (addTop5Btn) addTop5Btn.addEventListener('click', () => {
        const top5 = targetsList.slice(0, 5).map((g) => g.label).filter((l) => !slot.targets.includes(l));
        if (!top5.length) return;
        slot.targets.push(...top5);
        p.updatedAt = Date.now();
        saveStore(store);
        tuneResults = null;
        activeMuTab = top5[0];
        renderTargetsPanel();
      });
      root.querySelectorAll('[data-mb-pop]').forEach((btn) => btn.addEventListener('click', () => {
        const d = mbPopData[+btn.dataset.mbPop];
        if (!d) return;
        openInfoPopover(tMove(d.name), `<div class="mvwrap" style="margin-bottom:.6em">${typeIcoForMove(d.name)}<span class="mvchip">${esc(tMove(d.name))}</span></div><div>${esc(I18N.popHitsLbl(d.hitsTxt))}</div><div>${esc(I18N.popDmgLbl(d.dmgTxt))}</div>`);
      }));

      root.querySelectorAll('[data-mu-tab]').forEach((chip) => chip.addEventListener('click', (e) => {
        if (e.target.closest('[data-rm-target]')) return;
        activeMuTab = chip.dataset.muTab;
        muEdit = null;
        renderTargetsPanel();
      }));
      root.querySelectorAll('[data-rm-target]').forEach((btn) => btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const removed = btn.dataset.rmTarget;
        slot.targets = slot.targets.filter((l) => l !== removed);
        p.updatedAt = Date.now();
        saveStore(store);
        tuneResults = null;
        if (activeMuTab === removed) activeMuTab = null;
        if (muEdit && muEdit.label === removed) muEdit = null;
        renderTargetsPanel();
      }));

      // 型の編集/追加/削除/デフォルトに戻す
      root.querySelectorAll('[data-mu-edit]').forEach((btn) => btn.addEventListener('click', () => startMuEdit(activeGrp.label, +btn.dataset.muEdit)));
      root.querySelectorAll('[data-mu-del]').forEach((btn) => btn.addEventListener('click', () => {
        if (btn.disabled) return;
        deleteMuBuild(activeGrp.label, +btn.dataset.muDel);
      }));
      const addBtn = root.querySelector('#pb-mu-add-build');
      if (addBtn) addBtn.addEventListener('click', () => startMuEdit(activeGrp.label, 'new'));
      const resetBtn = root.querySelector('#pb-mu-reset-default');
      if (resetBtn) resetBtn.addEventListener('click', () => resetMuDefault(activeGrp.label));

      if (editingThis && !muEdit.loading && muEdit.detail) {
        const itemSel = root.querySelector('#pb-mu-e-item');
        if (itemSel) itemSel.addEventListener('change', (e) => { muEdit.draft.item = e.target.value; });
        const abilSel = root.querySelector('#pb-mu-e-ability');
        if (abilSel) abilSel.addEventListener('change', (e) => { muEdit.draft.ability = e.target.value; });
        const natSel = root.querySelector('#pb-mu-e-nature');
        if (natSel) natSel.addEventListener('change', (e) => { muEdit.draft.nature = e.target.value; });
        root.querySelectorAll('[data-mu-ev-i]').forEach((inp) => {
          inp.addEventListener('input', (e) => {
            const si = +e.target.dataset.muEvI;
            let v = Math.round(Number(e.target.value));
            if (Number.isNaN(v)) v = 0;
            v = Math.max(0, Math.min(EV_STAT_MAX, v));
            muEdit.draft.ev[si] = v;
            const remainEl = root.querySelector('#pb-mu-ev-remain');
            if (remainEl) remainEl.innerHTML = evRemainText(muEdit.draft.ev);
          });
          inp.addEventListener('focus', (e) => e.target.select()); // (12a) フォーカスで全選択
        });
        root.querySelectorAll('[data-mu-mv-i]').forEach((sel) => {
          const mi = +sel.dataset.muMvI;
          sel.addEventListener('change', (e) => {
            muEdit.draft.moves[mi] = e.target.value;
            const wrap = root.querySelector(`[data-mu-mv-wrap="${mi}"]`);
            if (wrap) { const ico = wrap.querySelector('.pb-mv-ico'); if (ico) ico.innerHTML = typeIcoForMove(e.target.value); }
          });
        });
        const saveBtn = root.querySelector('#pb-mu-save');
        if (saveBtn) saveBtn.addEventListener('click', saveMuEdit);
        const cancelBtn = root.querySelector('#pb-mu-cancel');
        if (cancelBtn) cancelBtn.addEventListener('click', cancelMuEdit);
      }
    }

    bindMuSection(el);
    renderMiniBar(activeGrp, miniBarTabs, { chips, cardsBlockHtml, addResetRow, bindMuSection, scenarioHtml });

    const searchInput = el.querySelector('#pb-target-search');
    searchInput.addEventListener('input', (e) => onTargetSearchInput(e.target.value));
    searchInput.addEventListener('keydown', onTargetSearchKey);

    el.querySelector('#pb-tune-btn').addEventListener('click', onTuneClick);
    if (tuneResults) renderTuneOut();
    persistUi(); // (B20/B21)
  }

  function onTargetSearchInput(val) {
    const sug = document.getElementById('pb-target-sug');
    if (!sug || !core) return;
    targetSugActive = -1;
    const q = val.trim();
    if (!q) { sug.style.display = 'none'; return; }
    const qk = toKatakana(q);
    const hits = effectiveTargets().filter((g) => matchesQuery(g.label, q, qk)).slice(0, 12);
    const p = activeParty();
    const slot = p.slots[selectedIdx];
    if (!hits.length) { sug.innerHTML = `<div class="sug-item added">${esc(I18N.noHit)}</div>`; sug.style.display = 'block'; return; }
    sug.innerHTML = hits.map((g) => {
      const already = slot.targets.includes(g.label);
      return `<div class="sug-item${already ? ' added' : ''}" data-target-pick="${esc(g.label)}">${icoImg(g.icon, g.label, '')}<span>${hlSug(g.label, q)}</span></div>`;
    }).join('');
    sug.querySelectorAll('[data-target-pick]:not(.added)').forEach((it) => it.addEventListener('click', () => pickTarget(it.dataset.targetPick)));
    sug.style.display = 'block';
  }
  function pickTarget(label) {
    const p = activeParty();
    const slot = p.slots[selectedIdx];
    if (!slot.targets.includes(label)) slot.targets.push(label);
    p.updatedAt = Date.now();
    saveStore(store);
    const input = document.getElementById('pb-target-search');
    if (input) { input.value = ''; input.focus(); }
    targetSugActive = -1;
    tuneResults = null;
    activeMuTab = label;
    renderTargetsPanel();
  }
  function onTargetSearchKey(e) {
    const sug = document.getElementById('pb-target-sug');
    if (!sug || sug.style.display === 'none') return;
    const items = [...sug.querySelectorAll('[data-target-pick]:not(.added)')];
    if (e.key === 'ArrowDown') { e.preventDefault(); targetSugActive = Math.min(targetSugActive + 1, items.length - 1); items.forEach((it, i) => it.classList.toggle('act', i === targetSugActive)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); targetSugActive = Math.max(targetSugActive - 1, 0); items.forEach((it, i) => it.classList.toggle('act', i === targetSugActive)); }
    else if (e.key === 'Enter') { e.preventDefault(); if (targetSugActive >= 0 && items[targetSugActive]) pickTarget(items[targetSugActive].dataset.targetPick); else if (items.length === 1) pickTarget(items[0].dataset.targetPick); }
    else if (e.key === 'Escape') { sug.style.display = 'none'; }
  }

  function onTuneClick() {
    const p = activeParty();
    const slot = p.slots[selectedIdx];
    const rb = resolveSlotSafe(slot);
    if (!rb) return;
    const oppResolved = [];
    // 逆算も仮想敵ごとの前提(天候・フィールド・積み)で行う。型ごとに1件ずつ並ぶので、
    // 前提も同じ並びで渡す(ラベルはメガ型で別名になるため、添字で対応付ける)。
    const oppScenarios = [];
    const targetsList = effectiveTargets();
    slot.targets.forEach((label) => {
      const grp = targetsList.find((g) => g.label === label);
      if (!grp) return;
      grp.builds.forEach((b) => {
        const resolved = resolveTargetSafe(grp.sp, grp.label, grp.icon, b, core.moves);
        if (resolved) { oppResolved.push(resolved); oppScenarios.push(scenarioOf(slot, label)); }
      });
    });
    tuneResults = tuneForTargets(slot, rb, oppResolved, oppScenarios);
    renderTuneOut();
  }
  const TUNE_KIND_LABEL = { speed: I18N.tuneKindSpeed, ko: I18N.tuneKindKo, survive: I18N.tuneKindSurvive };
  const TUNE_KIND_ICON = { speed: '⚡', ko: '⚔️', survive: '🛡️' };
  function renderTuneOut() {
    const out = document.getElementById('pb-tune-out');
    if (!out) return;
    if (!tuneResults || !tuneResults.length) { out.innerHTML = ''; return; }

    let lastKind = null;
    out.innerHTML = tuneResults.map((t, i) => {
      const headHtml = t.kind !== lastKind
        ? `<div class="pb-tune-head">${TUNE_KIND_ICON[t.kind] || ''} ${esc(TUNE_KIND_LABEL[t.kind] || t.kind)}</div>`
        : '';
      lastKind = t.kind;
      return `${headHtml}<div class="pb-tune-item">
        <span>${esc(t.text)}</span>${t.stub ? '<span class="pb-beta-badge">β</span>' : ''}
        ${t.evs ? `<button class="pb-btn-sub" data-tune-apply="${i}">${esc(I18N.applyBtn)}</button>` : ''}
      </div>`;
    }).join('');
    out.querySelectorAll('[data-tune-apply]').forEach((btn) => btn.addEventListener('click', () => {
      const i = +btn.dataset.tuneApply;
      const sugg = tuneResults[i];
      if (!sugg || !sugg.evs) return;
      const p = activeParty();
      const slot = p.slots[selectedIdx];
      slot.evs = sugg.evs;
      p.updatedAt = Date.now();
      saveStore(store);
      tuneResults = null;
      renderValidate();
      renderEditor();
      renderTargetsPanel();
      renderBalance();
      renderTray();
    }));
  }

  /** サマリー行「苦手」の内訳表示: 名前(＋小アイコン)を列挙。0体は「なし」、3体超は先頭3体+「…」でtitleに全列挙。 */
  function holeNamesHtml(holeLabels) {
    if (!holeLabels.length) return esc(I18N.holeNone);
    const withIcon = (label) => {
      const grp = effectiveTargets().find((g) => g.label === label);
      return `${grp ? icoImg(grp.icon, label, 'pb-hole-ico') : ''}${esc(tPoke(label))}`;
    };
    if (holeLabels.length <= 3) return holeLabels.map(withIcon).join('、');
    return `<span title="${esc(holeLabels.map(tPoke).join('、'))}">${holeLabels.slice(0, 3).map(withIcon).join('、')}…</span>`;
  }

  // ---- パーティバランス ----
  /**
   * 6枠編成カードに「いまの穴」を出す。
   *
   * 「空き枠を提案で埋める」は穴を埋める順に候補を選ぶので、押す前に何が穴なのかが
   * 同じ画面に無いと結果の理由が読めない。判定はパーティバランス側と同じ holeInfo を
   * 使い回すので、2箇所で食い違わない。タップでその相性表まで飛ぶ。
   */
  function renderTeamHoles(holeInfo) {
    const el = document.getElementById('pb-team-holes');
    if (!el) return;
    if (!holeInfo) { el.innerHTML = ''; return; }
    if (!holeInfo.holeLabels.length) {
      el.innerHTML = `<div class="pb-team-holes pb-hole-ok"><span>${esc(I18N.holeOkMsg)}</span></div>`;
      return;
    }
    el.innerHTML = `<button type="button" class="pb-team-holes pb-team-holes-btn" id="pb-team-holes-btn">
        <span class="pb-th-lead">${esc(I18N.holeSummary(''))}${esc(I18N.holeCountLbl(holeInfo.holeLabels.length))}</span>
        <span class="pb-th-names">${holeNamesHtml(holeInfo.holeLabels)}</span>
        <span class="pb-th-hint">${esc(I18N.holeJumpHint)} ›</span>
      </button>`;
    document.getElementById('pb-team-holes-btn').addEventListener('click', jumpToMatchupTab);
  }
  /** パーティバランスのポケモン相性タブを開いてそこまでスクロールする。
   * (B17) 着地位置はカード先頭(bd-strip等)ではなく表の直上(#pb-balance-pane)。
   * (C12) 穴サマリからの遷移は「この穴を見に行く」文脈なので、穴だけ表示を強制ONにして
   * 32列の表がそのまま出ないようにする(すでにONならno-op、既にmuタブでもholesOnlyがOFFなら作り直す)。 */
  function jumpToMatchupTab() {
    const card = document.getElementById('pb-balance');
    if (!card) return;
    const needsRerender = balanceTab !== 'mu' || !matchupHolesOnly;
    balanceTab = 'mu';
    matchupHolesOnly = true;
    if (needsRerender) renderBalance();
    // 相性表の描画でカード内のDOMを丸ごと入れ替えるため、同じフレームで
    // スクロールを始めると打ち消される。描画が済んでから動かす。
    // requestAnimationFrame は非表示タブでは発火しないので setTimeout を使う。
    setTimeout(() => {
      const target = document.getElementById('pb-balance-pane') || card;
      const top = target.getBoundingClientRect().top + window.scrollY - 8;
      const from = window.scrollY;
      window.scrollTo({ top, behavior: 'smooth' });
      // smooth を無視する環境（設定・埋め込みブラウザ）だと1pxも動かないので、
      // 少し待って動いていなければ即時で飛ばす。
      setTimeout(() => {
        if (Math.abs(window.scrollY - from) < 2) window.scrollTo(0, top);
      }, 350);
    }, 0);
  }

  function renderBalance() {
    const el = document.getElementById('pb-balance');
    const resolvedParty = resolvedPartyList();
    if (!resolvedParty.length) {
      el.innerHTML = `<h2>${esc(I18N.balanceHeading)}</h2><div class="muted">${esc(I18N.addPokemonPrompt)}</div>`;
      renderTeamHoles(null);
      return;
    }
    const sum = partySummary(resolvedParty);
    const holeInfo = findHolesMemo(resolvedParty, buildOppCols());
    el.innerHTML = `
      <h2>${esc(I18N.balanceHeading)}</h2>
      <div class="bd-strip">
        <span class="bd-lb">${esc(I18N.physAtk)}</span><span class="bd-seg">${sum.physical}</span>
        <span class="bd-lb">${esc(I18N.specAtk)}</span><span class="bd-seg">${sum.special}</span>
        <span class="bd-lb">${esc(I18N.megaLbl)}</span><span class="bd-seg">${sum.mega}</span>
        <span class="bd-lb">${esc(I18N.scarfLbl)}</span><span class="bd-seg">${sum.scarf}</span>
        <span class="bd-lb">${esc(I18N.avgSpeedLbl)}</span><span class="bd-seg">${Math.round(sum.avgSpeed)}</span>
        <span class="bd-lb">${esc(I18N.weakOverlapLbl)}</span><span class="bd-seg">${esc(I18N.weakOverlapVal(tType(sum.weakOverlap.type), sum.weakOverlap.count))}</span>
      </div>
      ${holeInfo.holeLabels.length
        ? `<div class="pb-hole-summary"><span>${esc(I18N.holeSummary(''))}${holeNamesHtml(holeInfo.holeLabels)}</span><button type="button" class="pb-btn-sub pb-holefill-btn" id="pb-holefill-btn">${esc(I18N.holeFillBtn)}</button></div>`
        : `<div class="pb-hole-summary pb-hole-ok"><span>${esc(I18N.holeOkMsg)}</span></div>`}
      <div class="tabbar">
        <button class="tb${balanceTab === 'atk' ? ' active' : ''}" data-t="atk">${esc(I18N.tabAtk)}</button>
        <button class="tb${balanceTab === 'def' ? ' active' : ''}" data-t="def">${esc(I18N.tabDef)}</button>
        <button class="tb${balanceTab === 'speed' ? ' active' : ''}" data-t="speed">${esc(I18N.tabSpeed)}</button>
        <button class="tb${balanceTab === 'mu' ? ' active' : ''}" data-t="mu">${esc(I18N.tabMu)}</button>
      </div>
      <div class="pane" id="pb-balance-pane">${balancePaneHtml(resolvedParty, balanceTab)}</div>
    `;
    renderTeamHoles(holeInfo);
    bindMtxPopovers(document.getElementById('pb-balance-pane'));
    bindMatchupHolesToggle(document.getElementById('pb-balance-pane'), resolvedParty);
    bindHoleFillButton(el);
    initMgHints();
    el.querySelectorAll('.tb').forEach((btn) => btn.addEventListener('click', () => {
      balanceTab = btn.dataset.t;
      el.querySelectorAll('.tb').forEach((b) => b.classList.toggle('active', b.dataset.t === balanceTab));
      const pane = document.getElementById('pb-balance-pane');
      pane.innerHTML = balancePaneHtml(resolvedParty, balanceTab);
      bindMtxPopovers(pane);
      bindMatchupHolesToggle(pane, resolvedParty);
      initMgHints();
      persistUi(); // (B20/B21)
    }));
  }
  function balancePaneHtml(resolvedParty, tab) {
    if (tab === 'def') return typeMatrixHtml(resolvedParty, 'def');
    if (tab === 'speed') return speedMatrixHtml(resolvedParty);
    if (tab === 'mu') {
      // 1v1マトリクスだけ計算量が桁違いなので、所要時間とキャッシュの当たりを残す
      const t0 = performance.now();
      const h0 = pairCacheStats.hit, m0 = pairCacheStats.miss;
      const html = matchupMatrixHtml(resolvedParty);
      window.__pbPairCache = pairCacheStats;
      if (import.meta.env.DEV) {
        console.info(`[pb-mu] ${Math.round(performance.now() - t0)}ms `
          + `(キャッシュ ヒット${pairCacheStats.hit - h0} / 計算${pairCacheStats.miss - m0})`);
      }
      return html;
    }
    return typeMatrixHtml(resolvedParty, 'atk');
  }
  function typeMatrixHtml(resolvedParty, kind) {
    const am = attackMatrix(resolvedParty);
    const dm = defenseMatrix(resolvedParty);
    const gapIdx = kind === 'def' ? findWeakGapTypeIdx(resolvedParty) : null;
    const corner = kind === 'atk' ? I18N.selfVsAtk : I18N.selfVsHit;
    const head = `<tr><th class="mtx-corner mtx-stick">${esc(corner)}</th>` + TYPES.map((t, ti) => `<th class="${gapIdx && gapIdx.has(ti) ? 'mtx-gap' : ''}" title="${esc(t)}">${typeIcoByName(t)}</th>`).join('') + `</tr>`;
    const rows = resolvedParty.map((b, mi) => {
      const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(b.icon, b.label, 'mtx-ico')}<div class="mtx-name">${esc(tPoke(b.label))}</div></div></th>`;
      const cells = TYPES.map((t, ti) => {
        if (kind === 'atk') {
          const mult = am.cells[mi][ti];
          const inner = mult == null ? '–' : (DEFG(mult) || '・');
          const cls = mult == null ? 'ao-none' : mult >= 2 ? 'ao-good' : mult === 1 ? 'ao-neu' : 'ao-bad';
          return `<td class="${cls}">${inner}</td>`;
        }
        const mult = dm.cells[mi][ti];
        return `<td class="${DEFC(mult)}">${DEFG(mult) || '・'}</td>`;
      }).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    const legend = kind === 'atk'
      ? `<div class="mtx-legend"><span>${I18N.atkLegend}</span></div>`
      : `<div class="mtx-legend"><span>${I18N.defLegend}</span></div>`;
    return `${legend}${mgWrapHtml(`<table class="mtx">${head}${rows}</table>`)}`;
  }
  function speedMatrixHtml(resolvedParty) {
    const oppCols = buildOppCols();
    const rows = speedOrder(resolvedParty);
    const byLabel = new Map(resolvedParty.map((b) => [b.label, b]));
    const head = `<tr><th class="mtx-corner mtx-stick">${esc(I18N.selfVsOppRep)}</th>` + oppCols.map((o) => oppHeaderCellHtml(o)).join('') + `</tr>`;
    const bodyRows = rows.map((r) => {
      const b = byLabel.get(r.label);
      const scarf = b && b.item === 'こだわりスカーフ';
      const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(b ? b.icon : null, r.label, 'mtx-ico')}<div class="mtx-name">${esc(tPoke(r.label))}<br><span class="sp-val">S${r.speed}${scarf ? '⚡' : ''}</span></div></div></th>`;
      const cells = oppCols.map((o) => {
        const rep = o.builds[0];
        const oppSpeed = effectiveSpeed(rep.stats[5], rep.item);
        const sym = r.speed > oppSpeed ? 'win' : r.speed < oppSpeed ? 'lose' : 'may';
        const label2 = { win: '◎', may: '△', lose: '×' }[sym];
        const cls = { win: 'bg-cc', may: 'bg-cn', lose: 'bg-cx' }[sym];
        return `<td class="${cls}">${label2}</td>`;
      }).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    return `<div class="mtx-legend"><span>${I18N.speedMatrixLegend}</span></div>
      ${mgWrapHtml(`<table class="mtx">${head}${bodyRows}</table>`)}`;
  }
  /** どくどく＋回復技の持久戦で決着する対面の、確定数の代わりの表示。 */
  function stallTurnsTxt(turns) {
    return lang === 'en' ? `stall ${turns}T` : lang === 'ko' ? `지구전${turns}턴` : `持久戦${turns}T`;
  }
  function stallHitsTxt(side, turns) {
    const who = { ja: ['自分', '相手'], en: ['You', 'Opponent'], ko: ['나', '상대'] }[lang] || ['', ''];
    const w = side === 'me' ? who[0] : who[1];
    return lang === 'ja' ? `${w}${stallTurnsTxt(turns)}` : `${w}: ${stallTurnsTxt(turns)}`;
  }
  /** 持久戦の手順(連続する同じ技は「技×n」にまとめる)。 */
  function stallRouteTxt(stall) {
    const runs = [];
    (stall.seq || []).forEach((n) => {
      const last = runs[runs.length - 1];
      if (last && last.n === n) last.c += 1; else runs.push({ n, c: 1 });
    });
    const route = runs.map((r) => (r.c > 1 ? `${tMove(r.n)}×${r.c}` : tMove(r.n))).join(' → ');
    const head = { ja: '持久戦の手順', en: 'Stall route', ko: '지구전 수순' }[lang] || '';
    const note = { ja: `${stall.turns}ターン・相手が交代しない前提`, en: `${stall.turns} turns, assuming no switch`, ko: `${stall.turns}턴・상대가 교체하지 않는 전제` }[lang] || '';
    return `${head}: ${route}（${note}）`;
  }
  /** 型ごとの内訳を1件ずつの配列で返す(タップポップオーバーはリスト表示、titleはこれをjoinした文字列を使う)。
   * 移植元: scripts/_explain.py matchup_grid() の集約対象そのもの。 */
  function muBreakdownLines(agg, builds) {
    return agg.verdicts.map((v, vi) => {
      const build = builds[vi];
      let myTxt = v.myHits == null ? '—' : I18N.selfHitsFmt(v.myHits);
      let oppTxt = v.oppHits == null ? '—' : I18N.oppHitsFmt(v.oppHits);
      if (v.stall && v.stall.side) {
        if (v.stall.side === 'me') myTxt = stallHitsTxt('me', v.stall.turns);
        else oppTxt = stallHitsTxt('opp', v.stall.turns);
      }
      const item = build.item ? tItem(build.item) : I18N.noItem;
      return I18N.muBreakdownLine(vi + 1, item, v.sym, myTxt, oppTxt, v.koFirst ? I18N.turnFirst : I18N.turnSecond);
    });
  }
  function muBreakdownTitle(agg, builds) {
    return muBreakdownLines(agg, builds).join(' / ');
  }
  /** EV文字列「H4 A28 ...」(0のstatは省略)。移植元: scripts/_explain.py _ev_str()。値は32スケールのまま(表示上の変換なし)。 */
  function pbEvStr(evs) {
    return EVK.map((k, i) => (Number(evs[i]) ? `${k}${evs[i]}` : null)).filter(Boolean).join(' ');
  }
  /** 相性マトリクスのセル詳細ポップオーバー用の確定数表示。「簡単構築」(PartySuggestApp.astro
   * matchupDetailHtml/tKo)の表記(確N/乱N/圏外)に合わせる(工房本来の「乱数N発(P%)」形式とは別表記)。
   * pairHitDetails()のhitsは確定時=最低乱数の確定数・不確定時=最大乱数の発数を返すため、
   * その値をそのまま閾値判定に使えば scripts/_explain.py _dmg_line() の「n_lo>=5→圏外」と一致する
   * (詳細はmatchup.tsの_detailのコメント参照)。 */
  function pbMuDetailKoTxt(d) {
    if (!d || d.hits == null || d.hits >= 5) return I18N.muDetailKoOOR;
    return d.certain ? I18N.hitsFmt(d.hits) : I18N.muDetailKoRoll(d.hits);
  }
  /** 与ダメ内訳1件。「簡単構築」のdmgRow相当(与ダメ%レンジ+確定数+技名)。 */
  function pbMuDetailLine(d) {
    if (!d) return { moveTxt: I18N.dashOpt, pctTxt: '0%', koTxt: I18N.muDetailKoOOR, noteTxt: '' };
    const pctTxt = `${Math.round(d.pctLo)}〜${Math.round(d.pctHi)}%`;
    return { moveTxt: tMove(d.n), pctTxt, koTxt: pbMuDetailKoTxt(d),
             // 発数が素の計算より増えた要因（ばけのかわ/タスキ/たべのこし等）と、
             // ダメージ計算に効いた場の条件（天候・フィールド・いかく）。
             noteTxt: [d.reason ? I18N.muNoteHits(d.reason) : '', d.conds ? I18N.muNoteConds(d.conds) : ''].filter(Boolean).join(' / ') };
  }
  /** 相性マトリクスのセルをタップした時の詳細ポップオーバー本体。PartySuggestApp.astroの
   * matchupDetailHtml()と同じ列構成(型ごとの列・与ダメ/被ダメ/素早さ/判定の4行)・体裁(pb-pop-*)で、
   * クライアント計算値(pairHitDetails/judge1v1)から生成する(APIは叩かない)。
   * 数値は仮想敵パネルの技別チップ(moveBreakdown)・判定バッジ(judge1v1)と同一関数を使うため一致する。 */
  function matchupCellDetailHtml(b, o) {
    const builds = (o.builds || []).slice(0, 3);
    // 与ダメ・被ダメは同じ場の前提で出す（向きごとに呼ぶと天候が食い違う）
    const pairs = builds.map((opp) => pairHitDetails(b, opp));
    const verdicts = builds.map((opp) => judge1v1(b, opp));
    // 表そのものはポケモン情報ページ・簡単構築と同じ共有レンダラで組む。
    // ここで独自に組むと罫線・行見出し・桁数が食い違う（実際に食い違った）。
    const vm = {
      myName: tPoke(b.label), oppName: tPoke(o.label),
      myIconUrl: spriteUrl(b.icon) || '', oppIconUrl: spriteUrl(o.icon) || '',
      columns: builds.map((opp, i) => ({
        label: I18N.buildLabel(i + 1),
        meta: [tItem(opp.item) || I18N.noItem, tNature(opp.nature), pbEvStr(opp.evs)],
        my: pairs[i].my, opp: pairs[i].opp, verdict: verdicts[i],
        myMoveText: tMove(pairs[i].my?.n ?? verdicts[i].myMove),
        oppMoveText: tMove(pairs[i].opp?.n ?? verdicts[i].oppMove),
        mySteps: pairs[i].mySteps.map((s) => ({ ...s, n: tMove(s.n) })),
        oppSteps: pairs[i].oppSteps.map((s) => ({ ...s, n: tMove(s.n) })),
        stallSeq: verdicts[i].stall?.seq.map((n) => tMove(n)),
      })),
    };
    return `<div class="pb-pop-hd">${icoImg(b.icon, b.label, '')}${esc(tPoke(b.label))}<span class="pb-arw">vs</span>${icoImg(o.icon, o.label, '')}${esc(tPoke(o.label))}</div>
      <div class="pb-pop-sub">${esc(matchupLead(lang))}</div>
      ${renderAssumptions(lang)}
      ${renderMatchupTable(vm, lang)}
      ${addTargetButtonHtml(o.label)}`;
  }
  /** (C12) 「穴だけ表示」トグルのHTML。checked状態はmatchupHolesOnlyをそのまま反映する
   * (再描画のたびに作り直すため、チェック操作自体の反映はbindMatchupHolesToggle側で行う)。 */
  function matchupHolesToggleHtml() {
    return `<label class="pb-mtx-holes-toggle"><input type="checkbox" id="pb-mtx-holes-toggle" ${matchupHolesOnly ? 'checked' : ''}>${esc(I18N.holesOnlyToggle)}</label>`;
  }
  /** (B18/C12) 32列(使用率上位30体相当)の相性表は幅が広すぎるため、「穴だけ表示」ONのときは
   * findHoles().holeIdx(誰も集合的に有利を取れていない列)だけに絞る。穴が0件のときは絞りようが
   * ないので表自体を出さず、「穴なし」＋「全列を見る」(matchupHolesOnly解除)に差し替える。 */
  function matchupMatrixHtml(resolvedParty) {
    const oppCols = buildOppCols();
    const holeInfo = findHolesMemo(resolvedParty, oppCols);
    const toggleRow = `<div class="pb-mtx-toolbar">${matchupHolesToggleHtml()}</div>`;
    if (matchupHolesOnly && !holeInfo.holeLabels.length) {
      return `${toggleRow}<div class="pb-mtx-noholes"><span>✓ ${esc(I18N.matchupNoHolesMsg)}</span>`
        + `<a href="#" id="pb-mtx-show-all">${esc(I18N.showAllColumnsLink)} ›</a></div>`;
    }
    const cols = oppCols.map((o, ci) => ({ o, hole: holeInfo.holeIdx.has(ci) }));
    const visibleCols = matchupHolesOnly ? cols.filter((c) => c.hole) : cols;
    const summary = '';
    // 行見出しをアイコンだけにしたぶん、コーナーも同じ幅に詰める。
    // 軸の説明（各味方 vs 相手）は表の上の説明文にあるので、ここは短縮表記でよい。
    const head = `<tr><th class="mtx-corner mtx-stick mtx-stick-ico" title="${esc(I18N.selfVsOppAgg)}">${esc(I18N.selfVsOppShort || '自＼相')}</th>` + visibleCols.map((c) => oppHeaderCellHtml(c.o, c.hole ? 'mtx-hole' : '')).join('') + `</tr>`;
    mtxPopData = [];
    const rows = resolvedParty.map((b) => {
      // 1v1判定は列が多く、スマホでは横幅が足りない。自分側はアイコンだけで判別できるので
      // 名前を出さない（アイコンの alt/title に名前は残るのでホバー・読み上げでは分かる）。
      const hd = `<th class="mtx-stick mtx-stick-ico">${icoImg(b.icon, b.label, 'mtx-ico')}</th>`;
      const cells = visibleCols.map((c) => {
        const o = c.o;
        const agg = judgeVsBuilds(b, o.builds);
        const lines = muBreakdownLines(agg, o.builds);
        // 仮想敵に前提(天候・フィールド・積み)を設定していて結果が変わる対面は印を付ける。
        // 記号は素の判定のままにする（前提つきで勝てても素で勝てるわけではない）。
        const cond = condAgg(b, o.label, o.builds, agg);
        const title = [...lines, cond ? I18N.scCondTitle(cond.text, agg.sym, cond.sym) : ''].filter(Boolean).join(' / ');
        const popIdx = mtxPopData.push({ b, o }) - 1;
        return `<td class="${symCls(agg.sym)}${cond ? ' mtx-cond' : ''}" title="${esc(title)}" data-mtx-pop="${popIdx}">`
          + `${agg.sym}${agg.dep ? '<span class="mu-dep">*</span>' : ''}${condMarkHtml(cond, agg.sym)}</td>`;
      }).join('');
      return `<tr>${hd}${cells}</tr>`;
    }).join('');
    const condLegend = resolvedParty.some((b) => b.sc && Object.keys(b.sc).length)
      ? `<span>${esc(I18N.scCondLegend)}</span>` : '';
    return `${toggleRow}${summary}<div class="mtx-legend"><span>${I18N.muMatrixLegend}</span>${condLegend}</div>
      ${mgWrapHtml(`<table class="mtx">${head}${rows}</table>`)}`;
  }
  /** matchupMatrixHtml()内のトグル/「全列を見る」リンクのイベント紐付け。tab==='mu'描画のたびに
   * bindMtxPopoversと並べて呼ぶ(該当要素が無いタブでは何もしない)。 */
  function bindMatchupHolesToggle(paneEl, resolvedParty) {
    if (!paneEl) return;
    const rerender = () => {
      paneEl.innerHTML = matchupMatrixHtml(resolvedParty);
      bindMtxPopovers(paneEl);
      bindMatchupHolesToggle(paneEl, resolvedParty);
      initMgHints();
    };
    const cb = paneEl.querySelector('#pb-mtx-holes-toggle');
    if (cb) cb.addEventListener('change', () => { matchupHolesOnly = cb.checked; rerender(); });
    const showAll = paneEl.querySelector('#pb-mtx-show-all');
    if (showAll) showAll.addEventListener('click', (e) => { e.preventDefault(); matchupHolesOnly = false; rerender(); });
  }
  /** (8) ポップオーバー内「この相手を枠Xの仮想敵に追加」ボタンのHTML。枠未選択・既追加はdisabled。 */
  function addTargetButtonHtml(oppLabel) {
