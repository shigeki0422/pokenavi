  function renderPartyBar() {
    const el = document.getElementById('pb-partybar');
    const p = activeParty();
    if (!p) renamingParty = false; // (12b) パーティが無いのに編集状態が残らないようにする
    const options = store.parties.map((pp) => `<option value="${esc(pp.id)}" ${pp.id === store.activeId ? 'selected' : ''}>${esc(pp.name)}</option>`).join('');
    const nameFieldHtml = renamingParty && p
      ? `<input type="text" id="pb-party-rename-input" class="inp" value="${esc(p.name)}" style="flex:1 1 15em;min-width:12em;max-width:26em">`
      : `<select id="pb-party-select" class="inp">${options}</select>`;
    el.innerHTML = `
      <div class="row pb-partybar-row">
        ${nameFieldHtml}
        <button class="pb-btn-sub" id="pb-p-new" ${renamingParty ? 'disabled' : ''}>${esc(I18N.partyNew)}</button>
        <button class="pb-btn-sub" id="pb-p-dup" ${p && !renamingParty ? '' : 'disabled'}>${esc(I18N.partyDup)}</button>
        <button class="pb-btn-sub" id="pb-p-ren" ${p && !renamingParty ? '' : 'disabled'}>${esc(I18N.partyRen)}</button>
        <button class="pb-btn-sub pb-danger" id="pb-p-del" ${p && !renamingParty ? '' : 'disabled'}>${esc(I18N.partyDel)}</button>
        <button class="pb-btn-sub" id="pb-p-exp" ${p && !renamingParty ? '' : 'disabled'}>${esc(I18N.partyExp)}</button>
        <button class="pb-btn-sub" id="pb-p-imp" ${renamingParty ? 'disabled' : ''}>${esc(I18N.partyImp)}</button>
      </div>
      <div class="muted pb-storage-note">${esc(I18N.storageNote)}</div>`;
    if (renamingParty && p) {
      // (12b) prompt()の代わりにインライン編集。Enter/blurで確定・Escで取消(esc()はvalue属性側で適用済み)。
      const input = document.getElementById('pb-party-rename-input');
      let settled = false;
      const commit = () => {
        if (settled) return;
        settled = true;
        const name = input.value.trim();
        if (name) renameParty(store, p.id, name);
        renamingParty = false;
        render();
      };
      const cancel = () => {
        if (settled) return;
        settled = true;
        renamingParty = false;
        renderPartyBar();
      };
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); commit(); }
        else if (e.key === 'Escape') { e.preventDefault(); cancel(); }
      });
      input.addEventListener('blur', () => commit());
      input.focus();
      input.select();
    } else {
      document.getElementById('pb-party-select').addEventListener('change', (e) => {
        store.activeId = e.target.value;
        resetPartyUiState();
        saveStore(store);
        render();
