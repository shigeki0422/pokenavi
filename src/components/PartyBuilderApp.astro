    targetSearchPlaceholder: '추가할 가상의 적 검색', addTargetsPrompt: '가상의 적을 추가해 주세요',
    muEditHeading: label => `${label} 빌드 편집`, muSaveBtn: '저장', muCancelBtn: '취소',
    muEditBtn: '편집', muDeleteBtn: '삭제', muDeleteLastTitle: '마지막 남은 빌드는 삭제할 수 없습니다',
    muAddBuildBtn: '＋ 빌드 추가', muResetDefaultBtn: '기본값으로 되돌리기',
    speedFaster: '이김', speedSlower: '당함', speedEq: '동속',
    buildLabel: n => `빌드${n}`, hpLbl: n => `HP 실수치 ${n}`,
    takenDmgLbl: (name, range) => `받는 대미지: ${name} ${range}`,
    noEffectiveMove: '유효타 없음(변화기・무효만 있음)', noMovesSet: '기술이 설정되지 않았습니다',
    hitsSelfOpp: (my, opp) => `나 ${my}／상대 ${opp}`, hitsFmt: n => `확정${n}`,
    randHitsFmt: (n, p) => `난수 ${n}발(${p}%)`, muBadgeTitle: '이 가상의 적에 대한 최악의 빌드 판정',
    selfHitsFmt: n => `나 확정${n}`, oppHitsFmt: n => `상대 확정${n}`,
    popHitsLbl: t => `확정타: ${t}`, popDmgLbl: t => `주는 대미지: ${t}`,
    speedTipTitle: '나의 스피드 실수치 vs 상대의 스피드 실수치(스카프 포함)',
    tuneBtn: 'EV 역산(스피드・화력・내구)', applyBtn: '적용',
    tuneKindSpeed: '스피드', tuneKindKo: '화력', tuneKindSurvive: '내구',
    holeNone: '없음',
    balanceHeading: '파티 밸런스', addPokemonPrompt: '포켓몬을 추가해 주세요',
    physAtk: '물리 어태커', specAtk: '특수 어태커', megaLbl: '메가', scarfLbl: '스카프',
    avgSpeedLbl: '평균 스피드', weakOverlapLbl: '약점 중복', weakOverlapVal: (type, count) => `${type}×${count}`,
    weakAgainstLbl: '약한 상대',
    tabAtk: '공격 상성', tabDef: '방어 상성', tabSpeed: '스피드', tabMu: '포켓몬 상성',
    selfVsAtk: '나 ＼ 공격', selfVsHit: '나 ＼ 피격',
    selfVsOppRep: '나 ＼ 상대(대표 빌드)', selfVsOppAgg: '나 ＼ 상대(빌드1~3 종합)', selfVsOppShort: '나＼상',
    atkLegend: '각 아군이 <b>해당 타입을 공격할 때의 최대 배율</b>. <b class="ao-good">×2</b>=효과가 굉장함 <b class="ao-bad">½/0</b>=잘 통하지 않음.',
    defLegend: '각 아군이 <b>해당 타입 기술을 받을 때의 피격 배율</b>. <b class="df-w1">×2/×4</b>=약점 <b class="df-r1">½ 이하</b>=반감 <b class="df-imm">0</b>=무효. <b class="mtx-gap" style="padding:0 4px">연노랑</b>=파티 내에 반감 이하로 받는 멤버가 없는 타입.',
    speedMatrixLegend: '아군（왼쪽·스피드 순）이 사용률 상위 30마리의 대표 빌드보다 빠른지（스카프 포함）. <b>◎</b>＝빠름 <b>△</b>＝동속 <b>×</b>＝느림.',
    muMatrixLegend: '각 아군 vs 사용률 상위 30마리의 예상 빌드（채용률 상위≤3빌드）을 종합한 1v1 판정. ◎유리 ○약간유리 △반반 ▲약간불리 ×불리. <b class="mu-dep-leg">*</b>＝빌드에 따라 유불리가 달라짐. <b class="mtx-hole" style="padding:0 4px">빨강</b>=아무도 종합 ◎/○를 얻지 못하는 「약점」. 셀 클릭(호버 가능한 PC에서는 마우스오버도)으로 빌드별 상세（확정타·스피드）를 확인할 수 있습니다.',
    holeSummary: labels => `⚠ 약점: ${labels}`,
    muBreakdownLine: (idx, item, sym, my, opp, turn) => `빌드${idx}(${item}): ${sym} ${my}/${opp}·${turn}`,
    noItem: '도구 없음', turnFirst: '선공', turnSecond: '후공',
    addTargetDisabled: '이 상대를 가상의 적에 추가', addTargetDisabledTitle: '먼저 위의 6칸에서 칸을 선택해 주세요',
    addTargetToSlot: n => `이 상대를 칸${n}의 가상의 적에 추가`, addedSuffix: '（추가됨）',
    noEmptySlots: '빈 칸이 없습니다', fillCalcAll: '빈 칸의 제안을 계산 중…',
    fillClearBtn: '✕ 제안 지우기', alreadyAdded: '추가됨', addToEmptySlot: sp => `${sp}을(를) 빈 칸에 추가`,
    exportHeading: name => `내보내기 — ${name}`, copyBtn: '복사', copiedMsg: '복사했습니다',
    copyFailedMsg: '복사에 실패했습니다. 텍스트를 선택하여 수동으로 복사해 주세요',
    importHeading: '가져오기', importHint: '6줄의 spec 텍스트를 붙여넣어 주세요（내보내기 형식）',
    importPlaceholder: '여기에 붙여넣기', importBtn: '가져오기',
    importFailedMsg: '가져오기에 실패했습니다. 형식을 확인해 주세요（6줄, spec 형식）',
    presetHeading: sp => `${sp} 빌드 템플릿`, noCandidates: '후보가 없습니다', applyThisBuildBtn: '이 빌드 적용',
    evPresetHeading: sp => `${sp} EV 프리셋（사용률순）`,
    handoffHeading: '파티 공방으로 가져오기',
    handoffFailed: '제안 데이터를 가져오지 못했습니다. 빌드를 해석할 수 없었습니다',
    initErrorMsg: '데이터를 불러오지 못했습니다. 다시 불러와 주세요.', retryBtn: '재시도',
    miniBarExpandAria: '가상의 적 상세 펼치기', sheetCollapseBtn: '▼ 닫기', sheetExpandCaret: '▲ 상세',
    miniBarMinimizeAria: '최소화', miniBarReopenAria: '미니바 다시 표시',
  },
} as const;
const I18N = I18N_ALL[lang];
---

<main>
  <h1>{I18N.title}</h1>
  <PartyToolsNav current="builder" lang={lang} />
  <p class="lead">{I18N.leadShort}</p>
  <OnboardingGuide
    storageKey="builder"
    lang={lang}
    steps={[
      { icon: '➕', title: I18N.obStep1Title, desc: I18N.obStep1Desc },
      { icon: '🔧', title: I18N.obStep2Title, desc: I18N.obStep2Desc },
      { icon: '⚖️', title: I18N.obStep3Title, desc: I18N.obStep3Desc },
    ]}
  />

  <!-- (B24) 初期化は806KB相当のwasm+データ待ちのため、テキストだけでなくスピナーを出す -->
  <div class="card" id="pb-partybar"><div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">{I18N.loading}</div></div></div>

  <div id="pb-validate"></div>

  <div class="card">
    <div class="row" style="justify-content:space-between;align-items:center">
      <h2 style="margin:0">{I18N.teamHead}<span class="pb-dnd-hint muted">{I18N.teamDndHint}</span></h2>
      <button id="pb-fill-btn" class="btn">{I18N.fillBtn}</button>
    </div>
    <div id="pb-team-holes"></div>
    <div class="iconrow" id="pb-tray"></div>
    <div id="pb-slot-search"></div>
  </div>

  <section class="pb-selected">
    <div class="pb-selected-head" id="pb-selected-head"></div>
    <div class="pb-split">
      <div class="card" id="pb-editor"><div class="ps-loading"><div class="ps-spinner"></div><div class="ps-lmsg">{I18N.loading}</div></div></div>
      <div class="card" id="pb-targets"></div>
    </div>
  </section>

  <div class="card" id="pb-balance"></div>
  <slot />
</main>

<div class="pop-overlay" id="pb-modal" style="display:none">
  <div class="pop-card"><button class="pop-x" id="pb-modal-x" aria-label={I18N.close}>✕</button><div id="pb-modal-body"></div></div>
</div>

<div class="pb-minibar" id="pb-minibar"></div>
<button type="button" class="pb-minibar-reopen" id="pb-minibar-reopen" aria-label={I18N.miniBarReopenAria}>▲</button>
<div class="pb-undo-toast" id="pb-undo-toast" style="display:none"></div>

<style is:global>
  main{width:auto;max-width:1040px;margin:0 auto;padding:1.4em 1em 4em;color:rgb(var(--gray-dark));overflow-x:clip}
  html{scrollbar-gutter:stable}
  /* (B14) ボトムナビ分の余白に、notch端末のホームインジケータ分を追加 */
  @media (max-width:1023.98px){ main{padding-bottom:calc(4em + env(safe-area-inset-bottom))} }
  h1{font-size:1.5rem;margin:0 0 .2em}
  h2{font-size:1.05rem;margin:0 0 .5em}
  .lead{font-size:.88rem;color:rgb(var(--gray));margin:0 0 1.1em}
  .card{background:#fff;border:1px solid rgb(var(--gray-light));border-radius:12px;box-shadow:0 1px 3px rgba(var(--black),.05);padding:1em;margin-bottom:1.1em}
  .muted{font-size:.8rem;color:rgb(var(--gray))}
  .row{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
  .btn{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:.55em 1.2em;font-weight:700;font-size:.85rem;cursor:pointer;font-family:var(--font-atkinson)}
  .btn:disabled{opacity:.5;cursor:default}
  @media(hover:hover){.btn:hover{background:var(--accent-dark)}}
  button{touch-action:manipulation}
  /* (C01) iOSはinput/selectのfont-size<16pxでオートズームする */
  input,.inp,select.inp{font-size:1rem;padding:.5em .6em;border:1px solid rgb(var(--gray-light));border-radius:8px;font-family:inherit}
  /* (B04) selectはpadding+行高だけでは44pxに届かない */
  select.inp{min-height:44px}
  .filter-wrap{position:relative}
  .filter-inp{width:100%;box-sizing:border-box;min-height:44px;padding:.5em .7em;border:1px solid rgb(var(--gray-light));border-radius:8px;font-size:1rem;outline:none;font-family:var(--font-atkinson)}
  .filter-inp:focus{border-color:var(--accent)}
  .filter-sug{position:absolute;top:calc(100% + 2px);left:0;right:0;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,.12);z-index:200;overflow:hidden;max-height:280px;overflow-y:auto}
  .sug-item{display:flex;align-items:center;gap:8px;padding:6px 12px;cursor:pointer;font-size:.85rem;border-bottom:1px solid #f8fafc}
  .sug-item:last-child{border-bottom:none}
  .sug-item:hover,.sug-item.act{background:#fff7ed}
  .sug-item img{width:30px;height:30px;object-fit:contain;flex-shrink:0}
  .sug-item .rk{margin-left:auto;font-size:.7rem;color:rgb(var(--gray))}
  .sug-item mark{background:#fef9c3;color:inherit;border-radius:2px;padding:0 1px}
  .sug-item.added{opacity:.4;pointer-events:none}
  .filter-chips{display:flex;flex-wrap:wrap;gap:5px;align-items:center;margin-bottom:.4em}
  .filter-chip{display:inline-flex;align-items:center;gap:2px;padding:2px 4px 2px 3px;background:#eef2ff;border:1px solid #c7d2fe;border-radius:999px;font-size:.74rem;font-weight:700;color:#3730a3}
  .filter-chip img{width:26px;height:26px;object-fit:contain;flex-shrink:0}
  .filter-chip-x{position:relative;background:none;border:none;cursor:pointer;color:#94a3b8;font-size:.75rem;line-height:1;padding:0 3px;display:flex;align-items:center}
  /* (C02) 見た目は変えずタップ領域だけ拡張 */
  .filter-chip-x::before{content:'';position:absolute;inset:-8px}
  .filter-chip-x:hover{color:#dc2626}
  .pb-mu-tab{cursor:pointer;opacity:.5}
  .pb-mu-tab:hover{opacity:.8}
  .pb-mu-tab.act{opacity:1;box-shadow:0 0 0 2px var(--accent) inset}

  /* 構成カード（SimPartyCard/PartySuggestApp準拠） */
  .iconrow{display:grid;grid-template-columns:repeat(6,1fr);gap:4px;margin-bottom:.5em}
  .montab{position:relative;display:flex;flex-direction:column;align-items:center;padding:.25em .1em;border:1.5px solid rgb(var(--gray-light));border-radius:8px;background:#fff;cursor:pointer;font-family:var(--font-atkinson);overflow:hidden;transition:border-color .12s,background .12s;min-height:84px}
  .montab:hover{border-color:#94a3b8;background:#f8fafc}
  .montab.active{border-color:var(--accent);background:#eef2ff}
  .monicon{width:40px;height:40px;object-fit:contain}
  .mname{font-size:.62rem;font-weight:700;text-align:center;color:rgb(var(--gray-dark));line-height:1.15;overflow-wrap:anywhere}
  .mitem{font-size:.54rem;color:rgb(var(--gray));text-align:center;line-height:1.15}
  .dgrid{display:flex;flex-wrap:wrap;gap:.35em .8em;margin-bottom:.35em;align-items:center}
  .dcell{font-size:.82rem;display:inline-flex;align-items:center;gap:.3em}
  .drow{display:flex;align-items:flex-start;gap:.35em;margin:.35em 0}
  .dval{font-weight:600;color:rgb(var(--gray-dark))}
  .mvwrap{display:inline-flex;flex-wrap:wrap;gap:.25em;align-items:center}
  .lbl{display:inline-block;font-size:.62rem;font-weight:800;padding:.1em .45em;border-radius:5px;color:#fff;flex-shrink:0}
  .lbl.item{background:#0ea5e9}.lbl.abil{background:#8b5cf6}.lbl.nat{background:#f59e0b}.lbl.mv{background:#10b981}.lbl.ev{background:#64748b}
  .tic{width:14px;height:14px;vertical-align:-2px}
  .iic{width:20px;height:20px;object-fit:contain;vertical-align:-5px}
  .mvchip{display:inline-flex;align-items:center;gap:.15em;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:9999px;padding:.08em .5em;font-size:.72rem;font-weight:600}
  .evchip{display:inline-flex;align-items:center;gap:.1em;color:#fff;font-size:.68rem;font-weight:700;padding:.06em .5em;border-radius:5px}
  .dtl-ico{width:24px;height:24px;object-fit:contain;vertical-align:-6px}
  .ev-H{background:#16a34a}.ev-A{background:#dc2626}.ev-B{background:#2563eb}.ev-C{background:#7c3aed}.ev-D{background:#0d9488}.ev-S{background:#db2777}

  /* 1v1グリッド（simulator mtx準拠） */
  .bg-cc{background:#dcfce7;color:#15803d}.bg-cb{background:#d1fae5;color:#15803d}.bg-cn{background:rgb(var(--gray-light));color:rgb(var(--gray))}.bg-cw{background:#ffedd5;color:#c2410c}.bg-cx{background:#fee2e2;color:#b91c1c}
  .mu-dep{color:#7c3aed;font-weight:900;font-size:.6rem;vertical-align:2px}
  .mu-dep-leg{color:#7c3aed}
  .mg{overflow-x:auto;margin-top:.4em;overscroll-behavior-x:contain}
  /* (C03) 横スクロールヒント(簡単構築PartySuggestApp.astroと同じ見た目。ロジックはmg-hints.tsを共有) */
  .mg-wrap{position:relative}
  .mg-hint{position:absolute;top:.4em;right:0;bottom:2px;width:36px;pointer-events:none;background:linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,.96) 55%);display:flex;align-items:center;justify-content:flex-end;padding-right:2px;font-weight:900;color:var(--accent);font-size:.9rem;opacity:1;transition:opacity .25s}
  .mg-wrap.mg-scrolled .mg-hint{opacity:0}
  table.mtx{font-size:.72rem;border-collapse:separate;border-spacing:2px}
  table.mtx th{font-size:.7rem;font-weight:700;padding:.2em;vertical-align:bottom;text-align:center}
  table.mtx td{text-align:center;border-radius:5px;font-weight:800;padding:.3em;min-width:34px;white-space:nowrap;font-size:.9rem}
  .mtx-ico{width:30px;height:30px;object-fit:contain;display:block;margin:0 auto}
  .mtx-name{font-size:.56rem;line-height:1.05;margin-top:1px;white-space:nowrap;color:rgb(var(--gray-dark));text-align:center}
  /* (C11) 相手列ヘッダの名前は列幅が狭いと端で切れる。行見出し(.mtx-rowh内)は対象外にして2行までは許可する */
  table.mtx th > .mtx-name{white-space:normal;overflow-wrap:anywhere;line-height:1.15}
  .mtx-corner{font-size:.56rem;color:rgb(var(--gray));text-align:center;line-height:1.15;white-space:nowrap;font-weight:700}
  .mtx-rowh{display:flex;align-items:center;gap:4px}
  .mtx-rowh .mtx-ico{width:26px;height:26px;margin:0}
  .mtx-rowh .mtx-name{margin-top:0;text-align:left}
  table.mtx th.mtx-stick{position:sticky;left:0;background:#fff;z-index:2;box-shadow:2px 0 3px -1px rgba(0,0,0,.14);width:96px;min-width:96px;max-width:96px;overflow:hidden}
  table.mtx th.mtx-stick .mtx-rowh{width:100%}
  table.mtx th.mtx-stick .mtx-rowh .mtx-ico{flex-shrink:0}
  table.mtx th.mtx-stick .mtx-name{white-space:normal;overflow-wrap:anywhere;line-height:1.05;flex:1;min-width:0}
  table.mtx th.mtx-corner.mtx-stick{z-index:3}
  /* 1v1判定の行見出しはアイコンのみ。名前ぶんの幅を列に回す */
  table.mtx th.mtx-stick-ico{width:38px;min-width:38px;max-width:38px;padding:2px}
  table.mtx th.mtx-corner.mtx-stick-ico{font-size:.5rem;white-space:normal;line-height:1.1}
  table.mtx th.mtx-stick-ico .mtx-ico{width:30px;height:30px;margin:0 auto}
  .sp-val{font-size:.56rem;font-weight:800;color:var(--accent);white-space:nowrap}
  .mtx-legend{display:flex;flex-wrap:wrap;gap:.5em .9em;font-size:.72rem;color:rgb(var(--gray-dark));margin-bottom:.4em;align-items:center}
  .mtx-legend b{padding:1px 5px;border-radius:4px}
  /* (C12) ポケモン相性表の「穴だけ表示」トグル */
  .pb-mtx-toolbar{margin-bottom:.5em}
  .pb-mtx-holes-toggle{display:inline-flex;align-items:center;gap:.4em;font-size:.8rem;font-weight:700;color:rgb(var(--gray-dark));cursor:pointer;min-height:32px}
  .pb-mtx-holes-toggle input{width:18px;height:18px}
  .pb-mtx-noholes{display:flex;flex-wrap:wrap;align-items:center;gap:.6em;font-size:.84rem;font-weight:700;color:#15803d;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:.6em .8em}
  .pb-mtx-noholes a{color:var(--accent);font-weight:700}

  /* タイプ相性マトリクス */
  table.mtx td.ao-good{background:#bbf7d0;color:#15803d;font-weight:800}
  table.mtx td.ao-neu{background:#fff;color:#cbd5e1}
  table.mtx td.ao-bad{background:#f1f5f9;color:#94a3b8}
  table.mtx td.ao-none{background:#f8fafc;color:#e2e8f0}
  table.mtx td.df-imm{background:#99f6e4;color:#0f766e}
  table.mtx td.df-r2{background:#bbf7d0;color:#15803d}
  table.mtx td.df-r1{background:#dcfce7;color:#15803d}
  table.mtx td.df-n{background:#fff;color:#cbd5e1}
  table.mtx td.df-w1{background:#fee2e2;color:#b91c1c}
  table.mtx td.df-w2{background:#fca5a5;color:#7f1d1d}

  /* タブ（(C08)簡単構築の.tabbarを移植: nowrap+横スクロール+sticky。--ps-sticky-topは簡単構築側のみ設定するため工房ではtop:0のまま） */
  .tabbar{display:flex;flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;gap:4px;border-bottom:2px solid rgb(var(--gray-light));margin-top:.7em;position:sticky;top:var(--ps-sticky-top,0px);background:#fff;z-index:5}
  .tabbar::-webkit-scrollbar{display:none}
  .tb{border:none;background:none;padding:.5em .8em;font-size:.8rem;font-weight:700;color:rgb(var(--gray));cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;font-family:var(--font-atkinson);border-radius:6px 6px 0 0;white-space:nowrap;flex-shrink:0}
  .tb:hover{background:#f8fafc;color:rgb(var(--gray-dark))}
  .tb.active{color:var(--accent);border-bottom-color:var(--accent)}
  .pane{padding-top:.6em}
  table.dtl{width:100%;border-collapse:collapse;font-size:.78rem}
  table.dtl th{text-align:left;font-size:.68rem;font-weight:800;color:rgb(var(--gray));background:#f8fafc;padding:.35em .5em;border-bottom:1px solid rgb(var(--gray-light));white-space:nowrap}
  table.dtl td{padding:.4em .5em;border-bottom:1px solid #f1f5f9;vertical-align:middle}
  .dtl-tname{display:inline-flex;align-items:center;gap:4px;white-space:nowrap;font-weight:700}
  .lft{text-align:left}

  /* 素早さ比較行 */
  .spd-tag{font-size:.68rem;font-weight:800;border-radius:5px;padding:1px 6px;margin-left:6px}
  .spd-tag.t-out{background:#dcfce7;color:#15803d}.spd-tag.t-in{background:#fee2e2;color:#b91c1c}.spd-tag.t-eq{background:#f1f5f9;color:#64748b}

  .bd-strip{display:flex;flex-wrap:wrap;align-items:center;gap:.35em .9em;font-size:.76rem;color:rgb(var(--gray-dark));background:#f8fafc;border:1px solid rgb(var(--gray-light));border-radius:8px;padding:.35em .6em;margin:0 0 .6em}
  .bd-lb{font-weight:800;color:rgb(var(--gray))}
  .bd-seg{font-weight:700}

  /* 詳細ポップアップ/モーダル */
  .pop-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1000;display:flex;align-items:center;justify-content:center;padding:1em}
  .pop-card{background:#fff;border-radius:14px;box-shadow:0 12px 48px rgba(0,0,0,.25);max-width:560px;width:100%;max-height:90dvh;overflow:auto;padding:1.1em 1.2em;position:relative}
  /* (C02/C09) 44pxタップ域化＋スクロールしても隠れないようsticky化（マイナスmarginで初期位置は見た目そのまま） */
  .pop-x{position:sticky;top:0;display:flex;align-items:center;justify-content:center;margin:-.6em -.7em -44px auto;width:44px;height:44px;background:none;border:none;font-size:1.1rem;color:rgb(var(--gray));cursor:pointer;line-height:1;z-index:5}
  .pop-x:hover{color:#dc2626}

  /* 相性マトリクスのセル詳細ポップオーバー（PartySuggestApp.astro matchupDetailHtml準拠、pb-名前空間で移植） */
  .pb-pop-hd{display:flex;align-items:center;gap:.4em;font-weight:800;font-size:.95rem;margin-bottom:.2em}
  .pb-pop-hd img{width:30px;height:30px;object-fit:contain}
  .pb-arw{color:rgb(var(--gray));font-weight:900}
  .pb-pop-sub{font-size:.76rem;color:rgb(var(--gray));margin-bottom:.35em}
  .pb-pop-assume{font-size:.74rem;color:rgb(var(--gray));margin-bottom:.7em}
  .pb-pop-assume summary{cursor:pointer}
  .pb-pop-assume ul{margin:.4em 0 0;padding-left:1.2em;line-height:1.6}
  table.pb-pop-t{width:100%;border-collapse:collapse;font-size:.8rem}
  table.pb-pop-t th{font-size:.66rem;font-weight:800;color:rgb(var(--gray));background:#f8fafc;padding:.4em .5em;border-bottom:1px solid rgb(var(--gray-light));text-align:center;white-space:nowrap}
  table.pb-pop-t td{padding:.4em .5em;border-bottom:1px solid #f1f5f9;text-align:center;white-space:nowrap}
  /* 型が横に並ぶので縦の区切りが要る。無いと隣の型の文がつながって読めた（スマホで報告） */
  table.pb-pop-t th+th,table.pb-pop-t td+td{border-left:1px solid rgb(var(--gray-light))}
  /* 横スクロールすると行の見出し（与ダメ/被ダメ/素早さ/判定）が流れて何の行か分からなくなる */
  table.pb-pop-t th.lft,table.pb-pop-t td.lft{position:sticky;left:0;z-index:1;background:#fff;
    box-shadow:2px 0 3px -1px rgba(0,0,0,.12)}
  table.pb-pop-t th.lft{background:#f8fafc}
  .pb-pop-pct{font-weight:700}
  .pb-pop-ko{font-size:.7rem;color:rgb(var(--gray))}
  /* 発数の要因（ばけのかわ等）と、ダメージ計算に効いた条件（天候・いかく等） */
  .pb-pop-note{font-size:.66rem;color:#b45309}
  .pb-pop-col-sub{font-size:.6rem;color:rgb(var(--gray));font-weight:600;display:block}
  .pb-pop-types{display:block;margin:2px 0}
  .pb-pop-types img{width:18px;height:18px;vertical-align:middle}

  /* pb- 新規クラス */
  .pb-beta{font-size:.65rem;background:#fef3c7;color:#92400e;border-radius:9999px;padding:.15em .6em;margin-left:.5em;vertical-align:middle;font-weight:800}
  .pb-beta-badge{display:inline-block;font-size:.6rem;font-weight:800;color:#7c3aed;background:#ede9fe;border-radius:4px;padding:0 .3em;margin-left:.3em;vertical-align:1px}
  .pb-partybar-row{flex-wrap:wrap;gap:.4em}
  .pb-partybar-row select.inp{flex:1 1 15em;min-width:12em;max-width:26em}
  @media(max-width:640px){.pb-partybar-row select.inp{flex:1 1 100%;max-width:none}}
  .pb-partybar-row .pb-btn-sub{padding:.4em .7em;font-size:.74rem}
  .pb-storage-note{margin-top:.6em}
  .pb-btn-sub{position:relative;min-height:40px;box-sizing:border-box;background:#eef2ff;color:#3730a3;border:1px solid #c7d2fe;border-radius:8px;padding:.45em .9em;font-weight:700;font-size:.8rem;cursor:pointer;font-family:var(--font-atkinson)}
  /* (C02) 実寸を40pxまで確保しつつ、隣接ボタンが多いため拡張ヒットは控えめに */
  .pb-btn-sub::before{content:'';position:absolute;inset:-6px}
  .pb-btn-sub:hover{background:#e0e7ff}
  .pb-btn-sub:disabled{opacity:.45;cursor:default}
  .pb-danger{background:#fee2e2;color:#b91c1c;border-color:#fecaca}
  .pb-danger:hover{background:#fecaca}
  .pb-slot-empty{display:flex;align-items:center;justify-content:center;border-style:dashed}
  .pb-plus{font-size:1.6rem;color:rgb(var(--gray));font-weight:300}
  .pb-slot-x{position:absolute;top:1px;right:3px;font-size:.65rem;color:rgb(var(--gray));cursor:pointer;line-height:1;z-index:2;padding:2px}
  /* (B06) 12×14→拡張ヒットで約28px。枠が密集するためinsetは控えめ */
  .pb-slot-x::before{content:'';position:absolute;inset:-8px}
  .pb-slot-x:hover{color:#dc2626}

  /* 空き枠クリック時の検索カード（6枠編成カード内・トレイ直下に展開、選択枠と吹き出し矢印でつながる） */
  .pb-slotsearch{position:relative;border:2px solid var(--accent);background:#eef2ff;border-radius:10px;padding:.7em .8em .8em;margin:10px 0 .5em}
  .pb-slotsearch::before{content:'';position:absolute;top:-7px;left:var(--pb-arrow-left,50%);width:12px;height:12px;background:#eef2ff;border-left:2px solid var(--accent);border-top:2px solid var(--accent);transform:translateX(-50%) rotate(45deg);border-radius:2px 0 0 0}
  .pb-slotsearch-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:.5em;gap:.5em}
  .pb-slotsearch-title{font-weight:800;font-size:.82rem;color:#3730a3}
  .pb-slotsearch-close{position:relative;background:none;border:none;color:rgb(var(--gray));cursor:pointer;font-size:.8rem;padding:.2em .4em;flex-shrink:0}
  .pb-slotsearch-close::before{content:'';position:absolute;inset:-12px}
  .pb-slotsearch-close:hover{color:#dc2626}
  .pb-editor-head{display:flex;align-items:center;gap:.6em;margin-bottom:.6em}
  .pb-editor-head .monicon{width:48px;height:48px;object-fit:contain}
  .pb-editor-name{font-weight:800;font-size:1rem}
  .pb-editor-types img{width:20px;height:20px;margin-right:2px}
  .mmega-tag{font-size:.6rem;background:#fde68a;color:#92400e;border-radius:5px;padding:0 .35em;margin-left:.3em;vertical-align:1px}
  .pb-select-row{margin-bottom:.6em}
  .pb-mega-note{font-size:.68rem;color:#92400e;margin-left:.3em}
  .pb-ev-editor{margin:.6em 0}
  .pb-ev-row{display:grid;grid-template-columns:26px 40px 1fr 40px 56px 48px;align-items:center;gap:.4em;margin-bottom:.3em;min-height:44px}
  .pb-ev-step{width:40px;height:40px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border:1px solid rgb(var(--gray-light));border-radius:8px;background:#f8fafc;color:rgb(var(--gray-dark));font-size:1.05rem;font-weight:800;cursor:pointer;font-family:var(--font-atkinson);padding:0}
  .pb-ev-step:disabled{opacity:.4;cursor:default}
  /* 仮想敵ごとの前提(天候・フィールド・積み)。既定のときは目立たせない */
  /* 6枠編成カードの穴サマリ。「空き枠を提案で埋める」の前提を同じ画面で見せる */
  .pb-team-holes{display:flex;flex-wrap:wrap;align-items:center;gap:6px;width:100%;margin:.6em 0;padding:8px 10px;border:1px solid #fecaca;border-radius:10px;background:#fef2f2;font-size:.84rem;text-align:left;font-family:var(--font-atkinson);color:rgb(var(--gray-dark))}
  .pb-team-holes.pb-hole-ok{border-color:#bbf7d0;background:#f0fdf4}
  .pb-team-holes-btn{cursor:pointer}
  @media(hover:hover){.pb-team-holes-btn:hover{border-color:#f87171;background:#fee2e2}}
  .pb-th-lead{font-weight:800;color:#b91c1c;white-space:nowrap}
  .pb-th-names{flex:1 1 auto;min-width:0;color:rgb(var(--gray-dark))}
  .pb-th-hint{margin-left:auto;white-space:nowrap;color:var(--accent);font-weight:700}
  /* 前提つきでのみ結果が変わる対面。記号は素の判定のままで、印と枠線だけ足す */
  .mu-cond{font-size:.72em;font-weight:800;color:#7c3aed;vertical-align:super;margin-left:1px}
  td.mtx-cond{box-shadow:inset 0 0 0 1.5px #c4b5fd}
  .pb-mu-badge-cond{outline:1.5px solid #c4b5fd;outline-offset:1px}
  .pb-sc-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:.5em 0;padding:8px 10px;border:1px solid rgb(var(--gray-light));border-radius:10px;background:#f8fafc;font-size:.86rem}
  .pb-sc-row.pb-sc-on{background:#eef2ff;border-color:var(--accent)}
  .pb-sc-hd{font-weight:800;color:rgb(var(--gray-dark))}
  .pb-sc-f{display:flex;align-items:center;gap:4px;color:rgb(var(--gray-dark))}
  .pb-sc-sel{min-height:44px;padding:4px 6px;border:1px solid rgb(var(--gray-light));border-radius:8px;background:#fff;font-family:var(--font-atkinson);font-size:1rem;max-width:11em}
  @media(max-width:640px){.pb-sc-row{gap:6px;padding:7px 8px}.pb-sc-sel{max-width:8.5em}}
  @media(hover:hover){.pb-ev-step:not(:disabled):hover{background:#eef2ff;border-color:var(--accent)}}
  .pb-ev-lbl{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:5px;color:#fff;font-weight:800;font-size:.72rem}
  /* スマホでスクロール中にEVバーへ指が触れると値が飛ぶ。pan-y で縦のパンはページに渡し、
     スライダーが拾うのは横方向の操作だけにする。touch-action だけでは触れた瞬間の
     ジャンプが残るので、スクロールに転じたら pointercancel で値を戻す(JS側)。 */
  /* (B02) 見た目のtrackは12pxのまま、当たり判定になる要素自体の高さを44pxにして掴みやすく */
  .pb-ev-range{-webkit-appearance:none;appearance:none;width:100%;height:44px;margin:0;padding:0;background:transparent;cursor:pointer;vertical-align:middle;touch-action:pan-y}
  .pb-ev-range::-webkit-slider-runnable-track{height:12px;border-radius:999px;background:rgb(var(--gray-light))}
  .pb-ev-range::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:28px;height:28px;margin-top:-8px;border:none;border-radius:50%;background:var(--accent);cursor:pointer}
  .pb-ev-range::-moz-range-track{height:12px;border-radius:999px;background:rgb(var(--gray-light))}
  .pb-ev-range::-moz-range-thumb{width:28px;height:28px;border:none;border-radius:50%;background:var(--accent);cursor:pointer}
  .pb-ev-num{width:100%;height:40px;box-sizing:border-box;padding:.25em .3em;font-size:1rem;text-align:center;-moz-appearance:textfield}
  .pb-ev-num::-webkit-outer-spin-button,.pb-ev-num::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .pb-ev-stat{font-weight:700;font-size:.85rem;text-align:right}
  .pb-ev-remain{font-size:.8rem;font-weight:700;margin:.4em 0}
  .pb-ev-over{color:#dc2626}
  .pb-ev-presets{display:flex;flex-wrap:wrap;gap:.35em;margin-bottom:.6em;align-items:center}
  .pb-chip{background:#f1f5f9;border:1px solid #e2e8f0;border-radius:9999px;padding:.3em .8em;font-size:.76rem;font-weight:700;cursor:pointer;font-family:var(--font-atkinson);color:rgb(var(--gray-dark))}
  .pb-chip:hover{background:#e2e8f0}
  .pb-moves{display:flex;flex-direction:column;gap:.4em;margin:.6em 0}
  .pb-mv-wrap{display:flex;align-items:center;gap:.4em}
  .pb-mv-ico{width:18px;display:inline-flex;flex-shrink:0}
  .pb-mv-input{width:100%;box-sizing:border-box}
  .pb-mv-clear{background:none;border:none;color:rgb(var(--gray));cursor:pointer;font-size:.85rem;padding:.2em .4em;flex-shrink:0}
  .pb-mv-clear:hover{color:#dc2626}
  .pb-presets{margin-top:.6em;display:flex;flex-wrap:wrap;gap:.4em;align-items:center}
  .pb-head-tpl{margin-left:auto;align-self:center;white-space:nowrap}
  .pb-ev-foot{display:flex;align-items:center;justify-content:space-between;gap:.6em;flex-wrap:wrap;margin-bottom:.6em}
  .pb-ev-foot .pb-ev-remain{margin-bottom:0}
  .pb-presets-lbl{font-size:.75rem;font-weight:800;color:rgb(var(--gray))}
  .pb-cand-card{display:flex;align-items:center;gap:.6em;border:1px solid rgb(var(--gray-light));border-radius:10px;padding:.5em .7em;margin-bottom:.5em;background:#fff;flex-wrap:wrap}
  .pb-cand-sprites{display:flex;gap:2px;flex-wrap:wrap}
  .pb-cand-sprites img{width:32px;height:32px;object-fit:contain}
  .pb-fill-sprite{position:relative;display:inline-flex;align-items:center;justify-content:center;border:2px solid transparent;border-radius:8px;background:none;padding:1px;cursor:pointer;font-family:inherit}
  .pb-fill-sprite img{width:32px;height:32px;object-fit:contain;display:block}
  @media(hover:hover){.pb-fill-sprite:not(.pb-fill-disabled):hover{border-color:var(--accent);background:#eef2ff}}
  .pb-fill-sprite:not(.pb-fill-disabled)::after{content:'＋';position:absolute;top:-5px;right:-5px;width:14px;height:14px;line-height:14px;border-radius:50%;background:var(--accent);color:#fff;font-size:.6rem;font-weight:800;text-align:center;opacity:0;transition:opacity .12s}
  @media(hover:hover){.pb-fill-sprite:not(.pb-fill-disabled):hover::after{opacity:1}}
  .pb-fill-sprite.pb-fill-disabled{cursor:default;opacity:.4}
  .pb-fill-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:.5em}
  .pb-valid-banner{background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:.6em .9em;margin-bottom:1.1em;color:#b91c1c;font-size:.82rem}
  .pb-valid-banner ul{margin:0;padding-left:1.15em}
  .pb-valid-banner li{margin:.15em 0}
  .pb-tune-item{display:flex;align-items:center;gap:.5em;flex-wrap:wrap;font-size:.82rem;border:1px solid #e2e8f0;border-radius:8px;padding:.5em .7em;margin-bottom:.4em;background:#f8fafc}
  .pb-tune-head{font-size:.76rem;font-weight:800;color:rgb(var(--gray));margin:.6em 0 .3em;display:flex;align-items:center;gap:.3em}
  .pb-tune-head:first-child{margin-top:0}
  .pb-textarea{width:100%;box-sizing:border-box;min-height:140px;font-family:monospace;font-size:1rem;padding:.6em;border:1px solid rgb(var(--gray-light));border-radius:8px}
  .ps-loading{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7em;padding:2.4em 1em;background:#fff;border:1px solid rgb(var(--gray-light));border-radius:12px}
  .ps-spinner{width:32px;height:32px;border:4px solid rgb(var(--gray-light));border-top-color:var(--accent);border-radius:50%;animation:ps-spin .8s linear infinite}
  @keyframes ps-spin{to{transform:rotate(360deg)}}
  .ps-lmsg{font-weight:700;color:rgb(var(--gray-dark));font-size:.9rem}
  @media (max-width:640px){
    .pb-ev-row{grid-template-columns:22px 40px 1fr 40px 56px 42px}
    table.mtx td{min-width:28px}
    .iconrow{grid-template-columns:repeat(3,1fr)}
    /* (C02) タブのタップ領域を44pxに */
    .tb{min-height:44px;box-sizing:border-box;display:inline-flex;align-items:center}
    /* (C07) 相性表の行見出しをアイコンのみにして横幅を稼ぐ（1v1判定は既にアイコンのみ） */
    table.mtx th.mtx-stick{width:44px;min-width:44px;max-width:44px}
    table.mtx th.mtx-stick .mtx-name{display:none}
  }

  /* 2カラムレイアウト（型エディタ／仮想敵） */
  .pb-split{display:flex;flex-direction:column}
  .pb-split > .card{min-width:0}
  @media (min-width:1024px){
    main{max-width:1220px}
    .pb-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1.1em;align-items:start}
    .pb-split > .card{margin-bottom:0}
    .pb-split{margin-bottom:1.1em}
  }

  /* (B15) ≤1023px: 「選択中のポケモン」の見出し＋2タブ（型エディタ／仮想敵）。
     data-tab属性は枠選択時のみ付与される(renderSelectedHead)ため、未選択時は両カードとも
     従来通り縦積みのプレースホルダーのまま。≥1024pxはこの見出しごと非表示にして
     .pb-splitの2カラムグリッドと両カードdisplay:blockを常に保つ(デスクトップの見た目は不変)。 */
  .pb-selected-head{margin-bottom:.7em}
  .pb-selected-head:empty{display:none}
  .pb-selected-title{display:flex;align-items:center;gap:.4em;font-weight:800;font-size:.85rem;color:rgb(var(--gray));margin-bottom:.35em}
  .pb-selected-title .monicon{width:32px;height:32px;flex-shrink:0}
  .pb-selected-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .pb-sel-tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:56px;padding:.4em .5em;border:1.5px solid #c7d2fe;border-radius:12px;background:#fff;color:var(--accent);cursor:pointer;font-family:var(--font-atkinson);box-sizing:border-box;touch-action:manipulation}
  .pb-sel-tab-main{display:inline-flex;align-items:center;gap:.4em;font-size:.95rem;font-weight:800}
  .pb-sel-tab-sub{font-size:.68rem;font-weight:600;color:rgb(var(--gray))}
  .pb-sel-count{min-width:1.3em;padding:0 .4em;border-radius:9999px;background:#e0e7ff;color:#3730a3;font-size:.72rem;font-weight:800;line-height:1.5}
  .pb-sel-tab.active{background:var(--accent);border-color:var(--accent);color:#fff;box-shadow:0 2px 6px rgba(35,55,255,.28)}
  .pb-sel-tab.active .pb-sel-tab-sub{color:rgba(255,255,255,.85)}
  .pb-sel-tab.active .pb-sel-count{background:rgba(255,255,255,.25);color:#fff}
  @media (max-width:1023.98px){
    .pb-selected[data-tab="editor"] #pb-targets{display:none}
    .pb-selected[data-tab="targets"] #pb-editor{display:none}
  }
  @media (min-width:1024px){
    .pb-selected-head{display:none}
  }

  /* 仮想敵カード（縦リスト） */
  .pb-mu-list{display:flex;flex-direction:column;gap:.5em;margin-top:.6em}
  .pb-mu-card{border:1px solid rgb(var(--gray-light));border-radius:10px;padding:.55em .7em;background:#fff}
  .pb-mu-head{display:flex;align-items:center;gap:.5em;flex-wrap:wrap}
  .pb-mu-sub{font-size:.7rem;color:rgb(var(--gray));margin:.1em 0 .3em}
  .pb-mu-row{display:flex;align-items:center;gap:.5em;flex-wrap:wrap;font-size:.82rem;margin-top:.15em}
  .pb-mb-row{display:flex;flex-wrap:wrap;gap:.3em;margin-top:.4em}
  .pb-mb-chip{display:inline-flex;flex-direction:column;align-items:flex-start;line-height:1.25;font-size:.68rem;font-weight:700;background:#f1f5f9;border-radius:6px;padding:.15em .5em;color:rgb(var(--gray-dark));white-space:nowrap}
