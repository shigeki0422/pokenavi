  .pb-minibar-item{display:flex;align-items:center;gap:.25em;flex-shrink:0;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:8px;padding:0 .55em;font-size:.72rem;font-weight:700;color:rgb(var(--gray-dark));font-family:var(--font-atkinson);white-space:nowrap;min-height:40px;box-sizing:border-box;cursor:pointer}
  .pb-minibar-ico{width:20px;height:20px;object-fit:contain}
