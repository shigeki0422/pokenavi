---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import meta from '../data/article-meta.json';

interface Props {
	currentSlug: string;
	max?: number;
}

const { currentSlug, max = 4 } = Astro.props;

type Meta = Record<string, { name: string; rank: number; types: string[] }>;
const m = meta as Meta;

// 公開済みブログ記事を取得（draft除外、現在の記事も除外）
const showDrafts = import.meta.env.INCLUDE_DRAFTS === 'true';
const allPosts = (await getCollection('blog')).filter(
	(p) => (showDrafts || !p.data.draft) && p.id !== currentSlug,
);

// 関連度スコア：タイプ共有数（×10）＋使用率順位の近さ。同点は新着順
const cur = m[currentSlug];
const scored = allPosts.map((p) => {
	const info = m[p.id];
	let score = 0;
	if (cur && info) {
		const shared = info.types.filter((t) => cur.types.includes(t)).length;
		score += shared * 10 + Math.max(0, 8 - Math.abs(info.rank - cur.rank) / 5);
	}
	return { post: p, score };
});
scored.sort(
	(a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf(),
);
const related = scored.slice(0, max).map((s) => s.post);
---

{related.length > 0 && (
	<aside class="related-posts">
		<h2>関連記事</h2>
		<ul>
			{related.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<div class="thumb">
								<Image
									width={200}
									height={100}
									src={post.data.heroImage}
									alt=""
									loading="lazy"
								/>
							</div>
						)}
						<div class="meta">
							<div class="title">{post.data.title}</div>
							<div class="date"><FormattedDate date={post.data.pubDate} /></div>
						</div>
					</a>
				</li>
			))}
		</ul>
	</aside>
)}

<style>
	.related-posts {
		margin: 3em 0 1em;
		padding: 1.5em 0 0;
		border-top: 1px solid #e2e8f0;
	}
	.related-posts h2 {
		font-size: 1.15rem;
		margin: 0 0 1em;
		color: rgb(var(--gray-dark));
	}
	.related-posts ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 12px;
	}
	.related-posts li {
		margin: 0;
	}
	.related-posts a {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		background: #fff;
		transition: background 0.15s, border-color 0.15s;
	}
	.related-posts a:hover {
		background: #f8fafc;
		border-color: #cbd5e1;
	}
	.related-posts .thumb {
		flex-shrink: 0;
		width: 100px;
	}
	.related-posts .thumb :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}
	.related-posts .meta {
		flex: 1;
		min-width: 0;
	}
	.related-posts .title {
		font-size: 0.82rem;
		font-weight: 600;
		line-height: 1.4;
		color: rgb(var(--gray-dark));
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.related-posts .date {
		font-size: 0.7rem;
		color: rgb(var(--gray));
		margin-top: 4px;
	}
</style>
