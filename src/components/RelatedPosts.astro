---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

interface Props {
	currentSlug: string;
	max?: number;
}

const { currentSlug, max = 4 } = Astro.props;

// 公開済みブログ記事を取得（draft除外、現在の記事も除外）
const showDrafts = import.meta.env.INCLUDE_DRAFTS === 'true';
const allPosts = (await getCollection('blog'))
	.filter((p) => (showDrafts || !p.data.draft) && p.id !== currentSlug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 単純に最新の公開記事から max 件
const related = allPosts.slice(0, max);
---

{related.length > 0 && (
	<aside class="related-posts">
		<h2>関連記事</h2>
		<ul>
			{related.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<div class="thumb">
								<Image
									width={200}
									height={100}
									src={post.data.heroImage}
									alt=""
									loading="lazy"
								/>
							</div>
						)}
						<div class="meta">
							<div class="title">{post.data.title}</div>
							<div class="date"><FormattedDate date={post.data.pubDate} /></div>
						</div>
					</a>
				</li>
			))}
		</ul>
	</aside>
)}

<style>
	.related-posts {
		margin: 3em 0 1em;
		padding: 1.5em 0 0;
		border-top: 1px solid #e2e8f0;
	}
	.related-posts h2 {
		font-size: 1.15rem;
		margin: 0 0 1em;
		color: rgb(var(--gray-dark));
	}
	.related-posts ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 12px;
	}
	.related-posts li {
		margin: 0;
	}
	.related-posts a {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		background: #fff;
		transition: background 0.15s, border-color 0.15s;
	}
	.related-posts a:hover {
		background: #f8fafc;
		border-color: #cbd5e1;
	}
	.related-posts .thumb {
		flex-shrink: 0;
		width: 100px;
	}
	.related-posts .thumb :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}
	.related-posts .meta {
		flex: 1;
		min-width: 0;
	}
	.related-posts .title {
		font-size: 0.82rem;
		font-weight: 600;
		line-height: 1.4;
		color: rgb(var(--gray-dark));
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.related-posts .date {
		font-size: 0.7rem;
		color: rgb(var(--gray));
		margin-top: 4px;
	}
</style>
