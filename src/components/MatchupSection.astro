---
import type { StaticMatchup } from '../scripts/party-builder/matchup-static';
import { getMatchupBreakdown } from '../scripts/party-builder/matchup-static';
import { MOVE_NAME_EN, MOVE_NAME_KO, ITEM_NAME_EN, ITEM_NAME_KO, NATURE_NAME_EN, NATURE_NAME_KO } from '../i18n/game-terms';

interface Props {
  matchups: StaticMatchup[];
  iconToSlug: Record<string, string>;
  nameMap: Record<string, string>;
  lang: 'ja' | 'en' | 'ko';
  ownIcon: string;
  ownName: string | null;
}
const { matchups, iconToSlug, nameMap, lang, ownIcon, ownName } = Astro.props;
const pfx = lang === 'ja' ? '' : `/${lang}`;

const T = {
  ja: {
    heading: '有利・不利な相手（使用率TOP30）',
    fav: '有利な相手',
    unfav: '不利な相手',
    note: '使用率上位30体の主流型同士の1v1事前計算による目安です（交代・補助技は非考慮）。*は相手の型により評価が変わります。',
    cta: '自分のパーティで詳しく判定 → パーティ工房',
    hits: (n: number | null) => (n == null || n >= 999 ? '圏外' : `確定${n}発`),
    basisHd: (myName: string, oppName: string, count: number) => `${myName}の主流型 vs ${oppName}の型プール（${count}種）:`,
    thOpp: (n: string) => `${n}の型`,
    thJudge: '判定',
    thMy: (n: string) => `${n}→`,
    thOppTo: (n: string) => `→${n}`,
    linkSelf: (n: string) => `${n}のページを見る →`,
  },
  en: {
    heading: 'Favorable / Unfavorable Matchups (Top 30)',
    fav: 'Favorable',
    unfav: 'Unfavorable',
    note: 'Estimated from precomputed 1v1s between the most common builds of the top 30 Pokémon (switching and status moves not considered). * = depends on the opponent’s build.',
    cta: 'Judge with your own party → Party Builder',
    hits: (n: number | null) => (n == null || n >= 999 ? 'out of range' : `KO in ${n}`),
    basisHd: (myName: string, oppName: string, count: number) => `${myName}'s main build vs ${oppName}'s build pool (${count}):`,
    thOpp: (n: string) => `${n}'s build`,
    thJudge: 'Verdict',
    thMy: (n: string) => `${n}→`,
    thOppTo: (n: string) => `→${n}`,
    linkSelf: (n: string) => `View ${n}'s page →`,
  },
  ko: {
    heading: '유리·불리한 상대 (사용률 TOP30)',
    fav: '유리한 상대',
    unfav: '불리한 상대',
    note: '사용률 상위 30마리의 주류 빌드 간 1v1 사전 계산에 따른 참고치입니다 (교체·보조 기술 미고려). *는 상대의 빌드에 따라 평가가 달라집니다.',
    cta: '내 파티로 자세히 판정 → 파티 공방',
    hits: (n: number | null) => (n == null || n >= 999 ? '범위 밖' : `확정 ${n}발`),
    basisHd: (myName: string, oppName: string, count: number) => `${myName}의 주류 빌드 vs ${oppName}의 빌드 풀(${count}종):`,
    thOpp: (n: string) => `${n}의 빌드`,
    thJudge: '판정',
    thMy: (n: string) => `${n}→`,
    thOppTo: (n: string) => `→${n}`,
    linkSelf: (n: string) => `${n} 페이지 보기 →`,
  },
}[lang];

const favorable = matchups.filter(m => m.sym === '◎' || m.sym === '○');
const unfavorable = matchups.filter(m => m.sym === '▲' || m.sym === '×');
const displayName = (n: string) => nameMap[n] ?? n;
const displayMove = (n: string | null) => {
  if (!n) return '—';
  if (lang === 'en') return MOVE_NAME_EN[n] ?? n;
  if (lang === 'ko') return MOVE_NAME_KO[n] ?? n;
  return n;
};
const displayItem = (n: string) => (lang === 'en' ? ITEM_NAME_EN[n] ?? n : lang === 'ko' ? ITEM_NAME_KO[n] ?? n : n);
const displayNature = (n: string) => (lang === 'en' ? NATURE_NAME_EN[n] ?? n : lang === 'ko' ? NATURE_NAME_KO[n] ?? n : n);

/**
 * getMatchupBreakdown()——/counters/ページと共有する唯一の集計元——から
 * 相手の型プール(最大3種)を取り出し、型ごとの持ち物・技構成・判定を
 * ポップアップのテーブルに並べる。「相手の型として何を採用するか」の
 * ロジックはmatchup-static.tsに一本化されているため、ここを直せば
 * /counters/側の表示も同時に直る。
 */
const basisRows = (opponentIcon: string) => {
  const breakdown = getMatchupBreakdown(ownIcon, opponentIcon);
  if (!breakdown || !ownName) return null;
  return breakdown.builds.map(({ build, verdict }) => ({
    item: displayItem(build.item),
    nature: displayNature(build.nature),
    moves: build.moves.map((mv) => displayMove(mv.n)).join('/'),
    sym: verdict.sym,
    myHits: T.hits(verdict.myHits),
    oppHits: T.hits(verdict.oppHits),
  }));
};
---

{(favorable.length > 0 || unfavorable.length > 0) && (
  <section class="mu-section">
    <h2>{T.heading}</h2>
    <div class="mu-groups">
      {favorable.length > 0 && (
        <div class="mu-group">
          <div class="mu-label mu-fav">{T.fav}</div>
          <div class="mu-grid">
            {favorable.map(m => {
              const slug = iconToSlug[m.icon];
              const name = displayName(m.name);
              const rows = ownName ? basisRows(m.icon) : null;
              const inner = (
                <>
                  <img src={`/images/pokemon/pokemon-${m.icon}.webp`} alt={name} width="44" height="44" loading="lazy" />
                  <span class={`mu-sym ${m.sym === '◎' ? 'mu-best' : ''}`}>{m.sym}{m.dep && <span class="mu-dep">*</span>}</span>
                  <span class="mu-name">{name}</span>
                </>
              );
              return rows ? (
                <details class="mu-cell mu-cell-pop">
                  <summary title={name}>{inner}</summary>
                  <div class="mu-pop">
                    <p class="mu-basis-hd">{T.basisHd(ownName!, name, rows.length)}</p>
                    <table class="mu-basis-table">
                      <tr><th class="lft">{T.thOpp(name)}</th><th>{T.thJudge}</th><th>{T.thMy(ownName!)}</th><th>{T.thOppTo(ownName!)}</th></tr>
                      {rows.map(r => (
                        <tr>
                          <td class="lft">{r.item}・{r.nature}<br />{r.moves}</td>
                          <td class={r.sym === '◎' ? 'sym-best' : r.sym === '○' ? 'sym-ok' : (r.sym === '▲' || r.sym === '×') ? 'sym-bad' : ''}>{r.sym}</td>
                          <td>{r.myHits}</td>
                          <td>{r.oppHits}</td>
                        </tr>
                      ))}
                    </table>
                    {slug && <a href={`${pfx}/pokemon/${slug}/`}>{T.linkSelf(name)}</a>}
                  </div>
                </details>
              ) : slug ? (
                <a href={`${pfx}/pokemon/${slug}/`} class="mu-cell" title={name}>{inner}</a>
              ) : (
                <div class="mu-cell" title={name}>{inner}</div>
              );
            })}
          </div>
        </div>
      )}
      {unfavorable.length > 0 && (
        <div class="mu-group">
          <div class="mu-label mu-unfav">{T.unfav}</div>
          <div class="mu-grid">
            {unfavorable.map(m => {
              const slug = iconToSlug[m.icon];
              const name = displayName(m.name);
              const rows = ownName ? basisRows(m.icon) : null;
              const inner = (
                <>
                  <img src={`/images/pokemon/pokemon-${m.icon}.webp`} alt={name} width="44" height="44" loading="lazy" />
                  <span class={`mu-sym mu-bad ${m.sym === '×' ? 'mu-worst' : ''}`}>{m.sym}{m.dep && <span class="mu-dep">*</span>}</span>
                  <span class="mu-name">{name}</span>
                </>
              );
              return rows ? (
                <details class="mu-cell mu-cell-pop">
                  <summary title={name}>{inner}</summary>
                  <div class="mu-pop">
                    <p class="mu-basis-hd">{T.basisHd(ownName!, name, rows.length)}</p>
                    <table class="mu-basis-table">
                      <tr><th class="lft">{T.thOpp(name)}</th><th>{T.thJudge}</th><th>{T.thMy(ownName!)}</th><th>{T.thOppTo(ownName!)}</th></tr>
                      {rows.map(r => (
                        <tr>
                          <td class="lft">{r.item}・{r.nature}<br />{r.moves}</td>
                          <td class={r.sym === '◎' ? 'sym-best' : r.sym === '○' ? 'sym-ok' : (r.sym === '▲' || r.sym === '×') ? 'sym-bad' : ''}>{r.sym}</td>
                          <td>{r.myHits}</td>
                          <td>{r.oppHits}</td>
                        </tr>
                      ))}
                    </table>
                    {slug && <a href={`${pfx}/pokemon/${slug}/`}>{T.linkSelf(name)}</a>}
                  </div>
                </details>
              ) : slug ? (
                <a href={`${pfx}/pokemon/${slug}/`} class="mu-cell" title={name}>{inner}</a>
              ) : (
                <div class="mu-cell" title={name}>{inner}</div>
              );
            })}
          </div>
        </div>
      )}
    </div>
    <p class="mu-note">{T.note}</p>
    <a class="mu-cta" href={`${pfx}/party-builder/`}>{T.cta}</a>
  </section>
)}

<style>
  .mu-section { margin: 1.5rem 0; }
  .mu-groups { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .mu-group { border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 12px; background: #fff; }
  .mu-label { font-size: 0.78rem; font-weight: 700; margin-bottom: 8px; }
  .mu-fav { color: #059669; }
  .mu-unfav { color: #dc2626; }
  .mu-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .mu-cell {
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    width: 62px; padding: 4px 0; border-radius: 8px; text-decoration: none;
  }
  a.mu-cell:hover { background: #f8fafc; }
  .mu-cell img { width: 44px; height: 44px; object-fit: contain; }
  details.mu-cell-pop { width: auto; padding: 0; }
  details.mu-cell-pop > summary {
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    width: 62px; padding: 4px 0; border-radius: 8px; cursor: pointer; list-style: none;
  }
  details.mu-cell-pop > summary::-webkit-details-marker { display: none; }
  details.mu-cell-pop > summary:hover { background: #f8fafc; }
  details.mu-cell-pop[open] > summary { background: #f8fafc; }
  .mu-pop {
    width: 260px; margin-top: 4px; padding: 8px 10px; border: 1px solid #e2e8f0; border-radius: 8px;
    background: #fff; box-shadow: 0 4px 12px rgba(0,0,0,.08);
  }
  .mu-basis-hd { font-size: .66rem; color: #64748b; margin: 0 0 6px; }
  .mu-basis-table { width: 100%; border-collapse: collapse; font-size: .62rem; margin-bottom: 6px; }
  .mu-basis-table th, .mu-basis-table td { border: 1px solid #e2e8f0; padding: 3px 4px; text-align: center; }
  .mu-basis-table th { background: #f8fafc; font-weight: 700; }
  .mu-basis-table td.lft, .mu-basis-table th.lft { text-align: left; }
  .mu-basis-table .sym-best { color: #15803d; font-weight: 800; }
  .mu-basis-table .sym-ok { color: #4d7c0f; font-weight: 800; }
  .mu-basis-table .sym-bad { color: #dc2626; font-weight: 800; }
  .mu-pop a { font-size: .74rem; font-weight: 700; color: var(--accent, #f97316); text-decoration: none; }
  .mu-pop a:hover { text-decoration: underline; }
  .mu-sym { font-size: 0.8rem; font-weight: 700; color: #059669; line-height: 1.1; }
  .mu-sym.mu-best { color: #047857; }
  .mu-sym.mu-bad { color: #dc2626; }
  .mu-sym.mu-worst { color: #b91c1c; }
  .mu-dep { color: #f59e0b; font-weight: 700; }
  .mu-name { font-size: 0.62rem; color: #475569; text-align: center; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 62px; }
  .mu-note { font-size: 0.72rem; color: #94a3b8; margin: 10px 0 6px; line-height: 1.5; }
  .mu-cta {
    display: inline-block; font-size: 0.82rem; font-weight: 700; color: var(--accent, #f97316);
    text-decoration: none;
  }
  .mu-cta:hover { text-decoration: underline; }
  @media (max-width: 720px) {
    .mu-groups { grid-template-columns: 1fr; }
  }
</style>
