---
import type { StaticMatchup } from '../scripts/party-builder/matchup-static';
import { getMatchupBreakdown } from '../scripts/party-builder/matchup-static';
import MatchupBreakdownPopup from './MatchupBreakdownPopup.astro';

interface Props {
  matchups: StaticMatchup[];
  iconToSlug: Record<string, string>;
  nameMap: Record<string, string>;
  lang: 'ja' | 'en' | 'ko';
  ownIcon: string;
  ownName: string | null;
  /** リザードンX/Yのように自分の型が複数系統ある場合、getMatchupBreakdown()の
   * 「自分側」をどの型で解決するか(石の名前)を指定する。単一系統ならundefined。 */
  ownPreferItem?: string;
  /** 複数系統がある種でセクションを複数並べる時の見出し区別用(例: メガリザードンX)。
   * 単一系統ならundefined(見出しは従来通り)。 */
  headingSuffix?: string;
}
const { matchups, iconToSlug, nameMap, lang, ownIcon, ownName, ownPreferItem, headingSuffix } = Astro.props;
const pfx = lang === 'ja' ? '' : `/${lang}`;

const T = {
  ja: { heading: '有利・不利な相手', fav: '有利な相手', unfav: '不利な相手', note: '使用率上位30体の主流型同士の1v1事前計算による目安です（交代・補助技は非考慮）。*は相手の型により評価が変わります。', cta: '自分のパーティで詳しく判定 → パーティ工房', linkSelf: (n: string) => `${n}のページを見る →` },
  en: { heading: 'Favorable / Unfavorable Matchups', fav: 'Favorable', unfav: 'Unfavorable', note: 'Estimated from precomputed 1v1s between the most common builds of the top 30 Pokémon (switching and status moves not considered). * = depends on the opponent’s build.', cta: 'Judge with your own party → Party Builder', linkSelf: (n: string) => `View ${n}'s page →` },
  ko: { heading: '유리·불리한 상대', fav: '유리한 상대', unfav: '불리한 상대', note: '사용률 상위 30마리의 주류 빌드 간 1v1 사전 계산에 따른 참고치입니다 (교체·보조 기술 미고려). *는 상대의 빌드에 따라 평가가 달라집니다.', cta: '내 파티로 자세히 판정 → 파티 공방', linkSelf: (n: string) => `${n} 페이지 보기 →` },
}[lang];

const favorable = matchups.filter(m => m.sym === '◎' || m.sym === '○');
const unfavorable = matchups.filter(m => m.sym === '▲' || m.sym === '×');
const displayName = (n: string) => nameMap[n] ?? n;

/**
 * /counters/ページと共有するMatchupBreakdownPopup.astroに渡すため、
 * getMatchupBreakdown()(matchup-static.tsの唯一の集計元)をここでも呼ぶ。
 * 「相手の型をどう集約するか」のロジックは1箇所(matchup-static.ts)にあるため、
 * ここを直せば/counters/側も同時に直る。
 */
const breakdownOf = (opponentIcon: string, opponentPreferItem?: string) =>
  ownName ? getMatchupBreakdown(ownIcon, opponentIcon, ownPreferItem, opponentPreferItem) : null;
---

{(favorable.length > 0 || unfavorable.length > 0) && (
  <section class="mu-section">
    <h2>{headingSuffix ? `${headingSuffix} ` : ''}{T.heading}</h2>
    <div class="mu-groups">
      {favorable.length > 0 && (
        <div class="mu-group">
          <div class="mu-label mu-fav">{T.fav}</div>
          <div class="mu-grid">
            {favorable.map(m => {
              const slug = iconToSlug[m.icon];
              const name = displayName(m.name);
              const breakdown = breakdownOf(m.icon, m.preferItem);
              const inner = (
                <>
                  <img src={`/images/pokemon/pokemon-${m.icon}.webp`} alt={name} width="44" height="44" loading="lazy" />
                  <span class={`mu-sym ${m.sym === '◎' ? 'mu-best' : ''}`}>{m.sym}{m.dep && <span class="mu-dep">*</span>}</span>
                  <span class="mu-name">{name}</span>
                </>
              );
              return breakdown ? (
                <details class="mu-cell mu-cell-pop">
                  <summary title={name}>{inner}</summary>
                  <div class="mu-pop">
                    <MatchupBreakdownPopup
                      lang={lang}
                      myName={ownName!}
                      myIcon={ownIcon}
                      oppName={name}
                      oppIcon={m.icon}
                      breakdown={breakdown}
                      otherHref={slug ? `${pfx}/pokemon/${slug}/` : null}
                      otherLabel={T.linkSelf(name)}
                    />
                  </div>
                </details>
              ) : slug ? (
                <a href={`${pfx}/pokemon/${slug}/`} class="mu-cell" title={name}>{inner}</a>
              ) : (
                <div class="mu-cell" title={name}>{inner}</div>
              );
            })}
          </div>
        </div>
      )}
      {unfavorable.length > 0 && (
        <div class="mu-group">
          <div class="mu-label mu-unfav">{T.unfav}</div>
          <div class="mu-grid">
            {unfavorable.map(m => {
              const slug = iconToSlug[m.icon];
              const name = displayName(m.name);
              const breakdown = breakdownOf(m.icon, m.preferItem);
              const inner = (
                <>
                  <img src={`/images/pokemon/pokemon-${m.icon}.webp`} alt={name} width="44" height="44" loading="lazy" />
                  <span class={`mu-sym mu-bad ${m.sym === '×' ? 'mu-worst' : ''}`}>{m.sym}{m.dep && <span class="mu-dep">*</span>}</span>
                  <span class="mu-name">{name}</span>
                </>
              );
              return breakdown ? (
                <details class="mu-cell mu-cell-pop">
                  <summary title={name}>{inner}</summary>
                  <div class="mu-pop">
                    <MatchupBreakdownPopup
                      lang={lang}
                      myName={ownName!}
                      myIcon={ownIcon}
                      oppName={name}
                      oppIcon={m.icon}
                      breakdown={breakdown}
                      otherHref={slug ? `${pfx}/pokemon/${slug}/` : null}
                      otherLabel={T.linkSelf(name)}
                    />
                  </div>
                </details>
              ) : slug ? (
                <a href={`${pfx}/pokemon/${slug}/`} class="mu-cell" title={name}>{inner}</a>
              ) : (
                <div class="mu-cell" title={name}>{inner}</div>
              );
            })}
          </div>
        </div>
      )}
    </div>
    <p class="mu-note">{T.note}</p>
    <a class="mu-cta" href={`${pfx}/party-builder/`}>{T.cta}</a>
  </section>
)}

<style>
  .mu-section { margin: 1.5rem 0; }
  .mu-groups { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .mu-group { border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 12px; background: #fff; }
  .mu-label { font-size: 0.78rem; font-weight: 700; margin-bottom: 8px; }
  .mu-fav { color: #059669; }
  .mu-unfav { color: #dc2626; }
  .mu-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .mu-cell {
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    width: 62px; padding: 4px 0; border-radius: 8px; text-decoration: none;
  }
  a.mu-cell:hover { background: #f8fafc; }
  .mu-cell img { width: 44px; height: 44px; object-fit: contain; }
  details.mu-cell-pop { width: auto; padding: 0; position: relative; }
  details.mu-cell-pop > summary {
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    width: 62px; padding: 4px 0; border-radius: 8px; cursor: pointer; list-style: none;
  }
  details.mu-cell-pop > summary::-webkit-details-marker { display: none; }
  details.mu-cell-pop > summary:hover { background: #f8fafc; }
  details.mu-cell-pop[open] > summary { background: #f8fafc; }
  /* 相手アイコンの真下に相対配置すると、グリッド端に近いカードで画面外にはみ出し
     見えなくなる(モバイルで報告された不具合)。常時position:fixedで画面中央に
     固定表示することで、カードの位置に関係なく確実に見える形にする。 */
  details.mu-cell-pop[open]::before {
    content: ''; position: fixed; inset: 0; background: rgba(15, 23, 42, .35); z-index: 19;
  }
  .mu-pop {
    position: fixed; z-index: 20; left: 50%; top: 50%; transform: translate(-50%, -50%);
    padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff;
    box-shadow: 0 12px 32px rgba(0,0,0,.2); width: max-content; max-width: 92vw; max-height: 82vh; overflow-y: auto;
  }
  .mu-sym { font-size: 0.8rem; font-weight: 700; color: #059669; line-height: 1.1; }
  .mu-sym.mu-best { color: #047857; }
  .mu-sym.mu-bad { color: #dc2626; }
  .mu-sym.mu-worst { color: #b91c1c; }
  .mu-dep { color: #f59e0b; font-weight: 700; }
  .mu-name { font-size: 0.62rem; color: #475569; text-align: center; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 62px; }
  .mu-note { font-size: 0.72rem; color: #94a3b8; margin: 10px 0 6px; line-height: 1.5; }
  .mu-cta {
    display: inline-block; font-size: 0.82rem; font-weight: 700; color: var(--accent, #f97316);
    text-decoration: none;
  }
  .mu-cta:hover { text-decoration: underline; }
  @media (max-width: 720px) {
    .mu-groups { grid-template-columns: 1fr; }
  }
</style>
