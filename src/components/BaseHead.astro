---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageUrl?: string;
	noOgImage?: boolean;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	alternates?: { lang: string; url: string }[];
	ogLocale?: string;
	/** ページ側で検索対象の可否を決める場合に渡す(未指定ならURLのルールで判定)。 */
	noindex?: boolean;
	/** AdSense をプレミアム会員には読み込まない（オファーウォールの対象ページ用。広告リクエストの停止だけではオファーウォールが出うるため） */
	adsSkipPremium?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, imageUrl, noOgImage = false, type = 'website', pubDate, updatedDate, alternates, ogLocale, noindex: noindexProp, adsSkipPremium = false } = Astro.props;
const ogImageUrl = imageUrl ? new URL(imageUrl, Astro.site) : new URL(image.src, Astro.url);

// サイト名・og:localeはURLのプレフィックスから判定する(呼び出し元がlang propを
// 渡さないページでも、en/ko版に日本語の「｜ポケナビ」やja_JPが付くのを防ぐ)。
const pagePath = Astro.url.pathname;
/** 未翻訳のen/ko複製は検索結果に出さない(followは残すのでリンク評価は流れる)。
 * party-suggestは213件中195件がインデックス済みで、Googleが薄いと判断していない
 * ため対象外。matchupはページ側がnoindex propで組み合わせごとに判断する
 * (使用率上位どうしだけ検索対象にする)。 */
const noindex = noindexProp ?? /^\/(en|ko)\//.test(pagePath);
const pageLang = pagePath.startsWith('/en') ? 'en' : pagePath.startsWith('/ko') ? 'ko' : 'ja';
const siteName = pageLang === 'en' ? 'PokeNavi' : pageLang === 'ko' ? '포케나비' : SITE_TITLE;
const resolvedOgLocale = ogLocale ?? (pageLang === 'en' ? 'en_US' : pageLang === 'ko' ? 'ko_KR' : 'ja_JP');

// 個別ページは「ページ名｜サイト名」、トップはサイト名のみ（重複回避）。
// 呼び出し元が既にサイト名(現地語表記のいずれか)を含めている場合は二重に付けない。
const alreadyBranded = title === SITE_TITLE || title.includes('PokeNavi') || title.includes('포케나비') || title.includes(SITE_TITLE);
const pageTitle = alreadyBranded ? title : `${title}｜${siteName}`;

const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteName}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{!noOgImage && <meta property="og:image" content={ogImageUrl} />}
{!noOgImage && !imageUrl && <meta property="og:image:width" content={String(image.width)} />}
{!noOgImage && !imageUrl && <meta property="og:image:height" content={String(image.height)} />}
{!noOgImage && <meta property="og:image:alt" content={title} />}
<meta property="og:locale" content={resolvedOgLocale} />
<meta property="og:site_name" content={siteName} />
{type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{type === 'article' && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{type === 'article' && <meta property="article:author" content={siteName} />}

<!-- Twitter -->
<meta property="twitter:card" content={noOgImage ? 'summary' : 'summary_large_image'} />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
{!noOgImage && <meta property="twitter:image" content={ogImageUrl} />}

<!-- プレミアム会員は広告を出さない: 会員期限の目印Cookie(pn_prem, /api/auth が発行)があれば広告リクエストを止め、広告枠を隠す。
     /api/auth/me は課金が有効な環境でだけ応答する。応答があれば html に pn-billing を付け、プレミアムへの導線(.pn-prem-cta)を
     未課金の利用者にだけ出す。結果は window.__pnMe で各ツールと共有する（期限切れの目印の更新もここで取り込まれる） -->
<script is:inline>try{var d=document.documentElement,m=document.cookie.match(/(?:^|; )pn_prem=(\d+)/);if(m&&+m[1]*1e3>Date.now()){d.classList.add('pn-premium');(window.adsbygoogle=window.adsbygoogle||[]).pauseAdRequests=1;}window.__pnMe=fetch('/api/auth/me').then(function(r){return r.ok?r.json():null}).catch(function(){return null}).then(function(me){if(me&&me.enabled){d.classList.add('pn-billing');if(me.premium)d.classList.add('pn-premium');}return me;});}catch(e){}</script>
<style is:inline>.pn-premium .ad-unit,.pn-premium .ps-ad-inline,.pn-premium .pb-ad,.pn-premium ins.adsbygoogle,.pn-premium .google-auto-placed{display:none!important}html:not(.pn-billing) .pn-prem-cta,html.pn-premium .pn-prem-cta{display:none!important}.pn-ad-remove{font-weight:600;margin-left:.6em;color:rgb(var(--gray));text-decoration:underline}</style>

<!-- Google AdSense -->
{adsSkipPremium
  ? <script is:inline>if(!document.documentElement.classList.contains('pn-premium')){var s=document.createElement('script');s.async=true;s.crossOrigin='anonymous';s.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6144860227440327';document.head.appendChild(s);}</script>
  : <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6144860227440327" crossorigin="anonymous"></script>}

<!-- Cloudflare Web Analytics -->
{cfBeaconToken && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}></script>
)}

<!-- Google Analytics 4 -->
{import.meta.env.PROD && <Fragment set:html={`<script async src="https://www.googletagmanager.com/gtag/js?id=G-B9BJX6K55T"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-B9BJX6K55T');</script>`} />}
