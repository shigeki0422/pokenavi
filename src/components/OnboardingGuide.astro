---
interface Props {
  storageKey: string;
  steps: { icon: string; title: string; desc: string }[];
  lang?: 'ja' | 'en' | 'ko';
}
const { storageKey, steps, lang = 'ja' } = Astro.props;
const T = {
  ja: { title: 'はじめての方へ', close: '閉じる（次回から表示しない）', reopen: '？ 使い方' },
  en: { title: 'First time here?', close: 'Close (don’t show again)', reopen: '? Help' },
  ko: { title: '처음이신가요?', close: '닫기 (다음부터 표시 안 함)', reopen: '? 사용법' },
}[lang];
---

<div class="ob-wrap" data-ob-key={storageKey}>
  <div class="ob-guide" hidden>
    <div class="ob-head">
      <span class="ob-title">{T.title}</span>
      <button class="ob-close" type="button">{T.close}</button>
    </div>
    <ol class="ob-steps">
      {steps.map((s, i) => (
        <li class="ob-step">
          <span class="ob-num">{i + 1}</span>
          <span class="ob-icon">{s.icon}</span>
          <span class="ob-body">
            <strong>{s.title}</strong>
            <span class="ob-desc">{s.desc}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
  <button class="ob-reopen" type="button" hidden>{T.reopen}</button>
</div>

<style>
  .ob-guide {
    margin: 0.75em 0 1em;
    border: 1px solid #c7d2fe;
    border-radius: 10px;
    background: #eef2ff;
    padding: 10px 14px 12px;
  }
  .ob-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .ob-title { font-size: 0.82rem; font-weight: 700; color: #4338ca; }
  .ob-close {
    border: none; background: none; padding: 4px;
    font-size: 0.72rem; color: #64748b; cursor: pointer; text-decoration: underline;
  }
  .ob-steps { display: flex; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .ob-step { flex: 1; display: flex; align-items: flex-start; gap: 8px; min-width: 0; }
  .ob-num {
    flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%;
    background: #4f46e5; color: #fff; font-size: 0.72rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center; margin-top: 1px;
  }
  .ob-icon { flex-shrink: 0; font-size: 1rem; }
  .ob-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .ob-body strong { font-size: 0.82rem; color: #1e293b; }
  .ob-desc { font-size: 0.74rem; color: #475569; line-height: 1.45; }
  .ob-reopen {
    border: 1px solid #e2e8f0; border-radius: 9999px; background: #fff;
    padding: 3px 12px; font-size: 0.74rem; font-weight: 700; color: #64748b;
    cursor: pointer; margin: 0.25em 0 0.75em;
  }
  .ob-reopen:hover { border-color: #4f46e5; color: #4f46e5; }
  @media (max-width: 720px) {
    .ob-steps { flex-direction: column; gap: 8px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ob-wrap').forEach(wrap => {
    const key = 'pn-onboard-' + wrap.dataset.obKey;
    const guide = wrap.querySelector<HTMLElement>('.ob-guide')!;
    const reopen = wrap.querySelector<HTMLElement>('.ob-reopen')!;
    const closed = (() => { try { return localStorage.getItem(key) === '1'; } catch { return false; } })();
    guide.hidden = closed;
    reopen.hidden = !closed;
    guide.querySelector('.ob-close')!.addEventListener('click', () => {
      try { localStorage.setItem(key, '1'); } catch {}
      guide.hidden = true;
      reopen.hidden = false;
    });
    reopen.addEventListener('click', () => {
      guide.hidden = false;
      reopen.hidden = true;
    });
  });
</script>
