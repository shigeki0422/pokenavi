---
const path = Astro.url.pathname;
const lang = path.startsWith('/en') ? 'en' : path.startsWith('/ko') ? 'ko' : 'ja';
const pfx = lang === 'ja' ? '' : `/${lang}`;
const navAria = lang === 'en' ? 'Mobile navigation' : lang === 'ko' ? '모바일 내비게이션' : 'モバイルナビゲーション';

const isActive = (href: string) => path.startsWith(href);
const LABELS = {
  ja: { research: '調べる', read: '読む', watch: '観る', battle: '戦う' },
  en: { research: 'Research', read: 'Read', watch: 'Watch', battle: 'Battle' },
  ko: { research: '조사', read: '읽기', watch: '관전', battle: '대전' },
}[lang];
const tabs = [
  { href: `${pfx}/pokemon/`, icon: '🔍', label: LABELS.research, active: isActive(`${pfx}/pokemon`) || isActive(`${pfx}/ranking`) },
  // 考察記事(読む)はen/ko版の翻訳記事が存在しないためja版のみ表示する
  ...(lang === 'ja' ? [{ href: '/blog/', icon: '📖', label: LABELS.read, active: isActive('/blog') }] : []),
  { href: `${pfx}/simulator-mb/`, icon: '🎬', label: LABELS.watch, active: isActive(`${pfx}/simulator`) || isActive(`${pfx}/battle-simulator`) },
  { href: `${pfx}/party-builder/`, icon: '⚔️', label: LABELS.battle, active: isActive(`${pfx}/party-builder`) || isActive(`${pfx}/party-suggest`) || isActive(`${pfx}/party-building`) },
];
---

<nav class="bottom-nav" aria-label={navAria}>
  {tabs.map(t => (
    <a href={t.href} class={t.active ? 'bn-tab active' : 'bn-tab'} aria-current={t.active ? 'page' : undefined}>
      <span class="bn-icon">{t.icon}</span>
      <span class="bn-label">{t.label}</span>
    </a>
  ))}
</nav>

<style>
  .bottom-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-top: 1px solid #e2e8f0;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .bn-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 7px 0 6px;
    text-decoration: none;
    color: #64748b;
  }
  .bn-icon { font-size: 1.05rem; line-height: 1.2; }
  .bn-label { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.02em; }
  .bn-tab.active { color: var(--accent, #f97316); }
  .bn-tab.active .bn-label { color: var(--accent, #f97316); }
  @media (min-width: 1024px) {
    .bottom-nav { display: none; }
  }
</style>
