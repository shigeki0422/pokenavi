---
import indexData from '../../public/sim-data/index.json';
import iconsData from '../../public/sim-data/icons.json';
import moveTypesData from '../../public/sim-data/move_types.json';

interface Props {
  pokemonName: string;
}
const { pokemonName } = Astro.props;

function parseSpec(s: string) {
  const name = s.split('@')[0].split(':')[0];
  const after = s.includes('@') ? s.split('@').slice(1).join('@') : '';
  const parts = after.split(':');
  return {
    name,
    item: parts[0] || '',
    nature: parts[1] || '',
    moves: (parts[2] || '').split('|').filter(Boolean),
    evs: (parts[3] || '').split('/'),
    ability: parts[4] || '',
  };
}

const regionalPrefix: [string, number][] = [['ヒスイ', 3], ['ガラル', 3], ['アローラ', 4]];
function iconUrl(name: string): string | null {
  const n = name.replace(' (', '(');
  const icons = iconsData as Record<string, string>;
  let id = icons[n] || icons[n.split('(')[0].trim()];
  if (!id) {
    for (const [p, l] of regionalPrefix) {
      if (n.startsWith(p)) { id = icons[n.slice(l) + '(' + p + ')']; if (id) break; }
    }
  }
  return id ? `/images/pokemon/pokemon-${id}.webp` : null;
}
function baseName(n: string) { return n.split('（')[0].split('(')[0].trim(); }

const NATURE: Record<string, string> = {いじっぱり:'A↑C↓',さみしがり:'A↑B↓',ゆうかん:'A↑S↓',やんちゃ:'A↑D↓',ずぶとい:'B↑A↓',わんぱく:'B↑C↓',のんき:'B↑S↓',のうてんき:'B↑D↓',ひかえめ:'C↑A↓',おっとり:'C↑B↓',れいせい:'C↑S↓',うっかりや:'C↑D↓',おだやか:'D↑A↓',おとなしい:'D↑B↓',なまいき:'D↑S↓',しんちょう:'D↑C↓',おくびょう:'S↑A↓',せっかち:'S↑B↓',ようき:'S↑C↓',むじゃき:'S↑D↓'};
const TYPEICON: Record<string, [string,string]> = {ノーマル:['00','normal'],かくとう:['01','fighting'],ひこう:['02','flying'],どく:['03','poison'],じめん:['04','ground'],いわ:['05','rock'],むし:['06','bug'],ゴースト:['07','ghost'],はがね:['08','steel'],ほのお:['09','fire'],みず:['10','water'],くさ:['11','grass'],でんき:['12','electric'],エスパー:['13','psychic'],こおり:['14','ice'],ドラゴン:['15','dragon'],あく:['16','dark'],フェアリー:['17','fairy']};
const MOVET = moveTypesData as Record<string, string>;
const ITEM_PNG: Record<string, string> = {きあいのタスキ:'item-0275-tasuki.png',こだわりスカーフ:'item-0287-scarf.png',オボンのみ:'item-0158-obon.png',ラムのみ:'item-0157-ram.png',ヤチェのみ:'item-0188-yache.png',ハバンのみ:'item-0197-haban.png'};

function typeIconHtml(move: string) {
  const t = MOVET[move];
  const e = t ? TYPEICON[t] : null;
  return e ? `<img class="spc-tic" src="/images/types/type-${e[0]}-${e[1]}.png" alt="${t}">` : '';
}
function itemIconHtml(item: string) {
  if (ITEM_PNG[item]) return `<img class="spc-iic" src="/images/items/${ITEM_PNG[item]}" alt="">`;
  return '';
}

function seasonLabel(label: string): string {
  const m = label?.match(/^(M-\d+)/);
  return m ? `${m[1]} シーズン` : '';
}

const EV_LABELS = ['H','A','B','C','D','S'];

const bn = baseName(pokemonName);
const subjects = (indexData as any).subjects as any[];

const candidates = subjects.filter((s: any) => s.party && s.party.some((spec: string) => {
  const n = parseSpec(spec).name; return n === pokemonName || baseName(n) === bn;
}));

// シーズン番号を抽出（M-2 → 2）
function seasonNum(label: string): number {
  const m = label?.match(/^M-(\d+)/); return m ? +m[1] : 0;
}
const allSeasons = [...new Set(candidates.map((s: any) => seasonNum(s.label ?? '')))].sort((a, b) => b - a);

// 最新シーズンを優先して2件取得。足りなければ次のシーズンで補完
const matches: any[] = [];
for (const season of allSeasons) {
  if (matches.length >= 2) break;
  const byWin = candidates
    .filter((s: any) => seasonNum(s.label ?? '') === season)
    .sort((a: any, b: any) => (b.win_rate || 0) - (a.win_rate || 0));
  for (const entry of byWin) {
    if (matches.length >= 2) break;
    matches.push(entry);
  }
}

if (matches.length === 0) return null;

function buildParty(match: any) {
  return match.party.map((s: string) => {
    const p = parseSpec(s);
    const natStr = p.nature ? `${p.nature}${NATURE[p.nature] ? ` (${NATURE[p.nature]})` : ''}` : '—';
    const evHtml = p.evs.map((v: string, i: number) => (+v > 0 ? `<span class="spc-evchip spc-ev-${EV_LABELS[i]}">${EV_LABELS[i]}<b>${v}</b></span>` : '')).join('');
    const movesHtml = p.moves.map((m: string) => `<span class="spc-mvchip">${typeIconHtml(m)}${m}</span>`).join('');
    return {
      ...p,
      iconUrl: iconUrl(p.name),
      natStr,
      evHtml,
      movesHtml,
      itemIconHtml: itemIconHtml(p.item),
    };
  });
}

const cards = matches.map((match: any, ci: number) => {
  const party = buildParty(match);
  const targetIdx = party.findIndex((p: any) => p.name === pokemonName || baseName(p.name) === bn);
  const t = party[targetIdx] ?? party[0];
  const uid = `spc-${ci}-${Math.random().toString(36).slice(2, 7)}`;
  const season = seasonLabel(match.label ?? '');
  const partyJson = JSON.stringify(party.map((p: any) => ({
    name: p.name, iconUrl: p.iconUrl, item: p.item, nature: p.natStr,
    ability: p.ability, movesHtml: p.movesHtml, evHtml: p.evHtml, itemIconHtml: p.itemIconHtml,
  })));
  return { party, targetIdx, t, uid, season, partyJson };
});

const simulatorUrl = `/simulator/?sf=${encodeURIComponent(pokemonName)}`;
---

<section class="spc-section">
  <h2 class="spc-h2">構築例</h2>
  <div class="spc-grid">
    {cards.map((card) => (
      <div class="spc-card" id={card.uid} data-party={card.partyJson} data-target={card.targetIdx}>
        {card.season && <div class="spc-season">{card.season}</div>}
        <div class="spc-iconrow">
          {card.party.map((p: any, i: number) => (
            <button class:list={['spc-montab', i === card.targetIdx && 'spc-active']} data-idx={i} aria-label={p.name}>
              {p.iconUrl && <img class="spc-monicon" src={p.iconUrl} alt={p.name} />}
              <span class="spc-mname">{p.name}</span>
              <span class="spc-mitem">{p.item || '—'}</span>
            </button>
          ))}
        </div>
        <div class="spc-compdetail">
          <div class="spc-cdgrid">
            <div class="spc-cdcell"><span class="spc-cdlabel spc-item">持ち物</span><span class="spc-cdval" set:html={`${card.t.itemIconHtml}${card.t.item || '—'}`} /></div>
            <div class="spc-cdcell"><span class="spc-cdlabel spc-abil">特性</span><span class="spc-cdval">{card.t.ability || '—'}</span></div>
            <div class="spc-cdcell"><span class="spc-cdlabel spc-nat">性格</span><span class="spc-cdval">{card.t.natStr}</span></div>
          </div>
          <div class="spc-cdrow spc-mvrow"><span class="spc-cdlabel spc-mv">技</span><span class="spc-mvwrap" set:html={card.t.movesHtml || '—'} /></div>
          <div class="spc-cdrow spc-mvrow"><span class="spc-cdlabel spc-ev">EV</span><span class="spc-mvwrap spc-evwrap" set:html={card.t.evHtml || '—'} /></div>
        </div>
      </div>
    ))}
  </div>
  <a class="spc-cta" href={simulatorUrl}>
    その他の構築や対戦での動きを確認
    <span class="spc-cta-arrow">→</span>
  </a>
</section>

<script>
  document.querySelectorAll('[data-party]').forEach(card => {
    const party = JSON.parse(card.getAttribute('data-party') ?? '[]');
    const buttons = card.querySelectorAll('.spc-montab');
    const detail = card.querySelector('.spc-compdetail');

    function renderDetail(p: any) {
      if (!detail || !p) return;
      detail.innerHTML = `
        <div class="spc-cdgrid">
          <div class="spc-cdcell"><span class="spc-cdlabel spc-item">持ち物</span><span class="spc-cdval">${p.itemIconHtml}${p.item || '—'}</span></div>
          <div class="spc-cdcell"><span class="spc-cdlabel spc-abil">特性</span><span class="spc-cdval">${p.ability || '—'}</span></div>
          <div class="spc-cdcell"><span class="spc-cdlabel spc-nat">性格</span><span class="spc-cdval">${p.nature || '—'}</span></div>
        </div>
        <div class="spc-cdrow spc-mvrow"><span class="spc-cdlabel spc-mv">技</span><span class="spc-mvwrap">${p.movesHtml || '—'}</span></div>
        <div class="spc-cdrow spc-mvrow"><span class="spc-cdlabel spc-ev">EV</span><span class="spc-mvwrap spc-evwrap">${p.evHtml || '—'}</span></div>`;
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b, j) => b.classList.toggle('spc-active', j === i));
        renderDetail(party[i]);
      });
    });
  });
</script>

<style is:global>
  .spc-section { margin: 1.8em 0 0.5em; }
  .spc-h2 {
    font-size: 1rem; font-weight: 700; color: rgb(var(--black));
    margin: 0 0 0.6rem; padding: 0.45rem 0.9rem;
    background: #f8fafc; border-left: 3px solid var(--accent, #f97316);
    border-radius: 0 6px 6px 0;
  }
  .spc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .spc-card {
    border: 1.5px solid #94a3b8; border-radius: 10px;
    background: #fff; overflow: hidden; padding: .5em .4em .6em;
    box-shadow: 0 1px 6px rgba(0,0,0,.07);
  }
  .spc-season {
    font-size: .68rem; font-weight: 800; color: var(--accent, #f97316);
    margin-bottom: .3em; letter-spacing: .03em;
  }
  .spc-iconrow { display: grid; grid-template-columns: repeat(6, 1fr); gap: 3px; margin-bottom: .4em; }
  .spc-montab {
    display: flex; flex-direction: column; align-items: center;
    padding: .2em .1em; border: 1px solid rgb(var(--gray-light));
    border-radius: 8px; background: #fff; cursor: pointer;
    font-family: var(--font-atkinson); overflow: hidden;
    transition: border-color .12s, background .12s;
  }
  .spc-montab:hover { border-color: #94a3b8; background: #f8fafc; }
  .spc-montab.spc-active { border-color: var(--accent); background: #eef2ff; }
  .spc-monicon { width: 36px; height: 36px; object-fit: contain; }
  .spc-mname { font-size: .55rem; font-weight: 700; text-align: center; color: rgb(var(--gray-dark)); line-height: 1.2; word-break: break-all; }
  .spc-mitem { font-size: .5rem; color: rgb(var(--gray)); text-align: center; line-height: 1.2; }
  .spc-compdetail { border-top: 1px solid rgb(var(--gray-light)); padding-top: .45em; }
  .spc-cdgrid { display: flex; flex-wrap: wrap; gap: .3em .7em; margin-bottom: .3em; }
  .spc-cdcell { font-size: .78rem; }
  .spc-cdrow.spc-mvrow { display: flex; align-items: flex-start; gap: .3em; margin: .3em 0; }
  .spc-cdlabel {
    display: inline-block; font-size: .62rem; font-weight: 800;
    padding: .07em .4em; border-radius: 5px; margin-right: .3em;
    color: #fff; vertical-align: 1px; flex-shrink: 0;
  }
  .spc-item { background: #0ea5e9; }
  .spc-abil { background: #8b5cf6; }
  .spc-nat  { background: #f59e0b; }
  .spc-mv   { background: #10b981; }
  .spc-ev   { background: #64748b; }
  .spc-cdval { font-weight: 600; color: rgb(var(--gray-dark)); }
  .spc-mvwrap { display: inline-flex; flex-wrap: wrap; gap: .2em; align-items: center; }
  .spc-mvchip {
    display: inline-flex; align-items: center; gap: .12em;
    background: #f1f5f9; border: 1px solid #e2e8f0;
    border-radius: 9999px; padding: .06em .45em;
    font-size: .7rem; font-weight: 600;
  }
  .spc-evchip {
    display: inline-flex; align-items: center; gap: .1em;
    color: #fff; font-size: .66rem; font-weight: 700;
    padding: .05em .45em; border-radius: 5px;
  }
  .spc-evchip b { font-weight: 800; }
  .spc-ev-H { background: #16a34a; }
  .spc-ev-A { background: #dc2626; }
  .spc-ev-B { background: #2563eb; }
  .spc-ev-C { background: #7c3aed; }
  .spc-ev-D { background: #0d9488; }
  .spc-ev-S { background: #db2777; }
  .spc-tic { width: 14px; height: 14px; vertical-align: -2px; }
  .spc-iic { width: 22px; height: 22px; object-fit: contain; vertical-align: -6px; margin-right: 2px; }
  .spc-cta {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    margin-top: 10px; padding: 13px 16px;
    background: var(--accent, #f97316); color: #fff;
    border-radius: 10px; text-decoration: none;
    font-weight: 800; font-size: .9rem;
    transition: opacity .15s, transform .1s;
  }
  .spc-cta:hover { opacity: .9; transform: translateY(-1px); color: #fff; }
  .spc-cta-arrow { font-size: 1.1em; font-weight: 900; }
  @media (max-width: 600px) {
    .spc-grid { grid-template-columns: 1fr; }
    .spc-monicon { width: 32px; height: 32px; }
    .spc-mname { font-size: .52rem; }
    .spc-mitem { font-size: .48rem; }
    .spc-cta { font-size: .84rem; padding: 12px 14px; }
  }
</style>
