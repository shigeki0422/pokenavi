---
import type { MatchupBreakdown } from '../scripts/party-builder/matchup-static';
import type { ResolvedBuild } from '../scripts/party-builder/types';
import type { MuPopupData, MuPopupRow } from '../scripts/party-builder/mu-card';
import { muPopupRow, buildTitle, buildShare } from '../scripts/party-builder/mu-cell-popup';
import '../styles/matchup-table.css';
import '../styles/mu-card.css';
import { MOVE_NAME_EN, MOVE_NAME_KO, ITEM_NAME_EN, ITEM_NAME_KO, NATURE_NAME_EN, NATURE_NAME_KO,
         ABILITY_NAME_EN, ABILITY_NAME_KO, itemNameOf } from '../i18n/game-terms';
import { POKEMON_NAME_EN, POKEMON_NAME_KO } from '../i18n/pokemon-names';

/**
 * 「対策」「有利・不利な相手」双方のポップアップで使う唯一の表示コンポーネント。
 * 表記はパーティ工房の仮想敵カードに揃える（判定の見出し・型のチップ・結論の帯・ダメージレースの棒・
 * 技ごとのダメージ・折りたたみの内訳。組み立ては scripts/party-builder/mu-card.ts）。
 * 相手の型(最大3)をタブで切り替え、自分の型が複数あれば自分の型も切り替えられる。
 * 既定のタブは自分・相手とも割合(share)が最大の型。タブ見出しは型の系統名(arch)と割合。
 * カードと再生は全ポップアップぶんを静的HTMLにするとページが数倍に膨らむため、判定結果だけをJSONで埋め込み、
 * ポップアップを開いたときにクライアントで組み立てる（mu-cell-popup.ts の renderMuDialog。他ページの1v1ダイアログと同じ関数）。
 */
interface Props {
  lang: 'ja' | 'en' | 'ko';
  myName: string;
  myIcon: string;
  oppName: string;
  oppIcon: string;
  /** 自分の主要な型ごとの内訳(通常1〜3件)。label例: 「きあいのタスキ・ようき」。 */
  myBreakdowns: { label: string; breakdown: MatchupBreakdown }[];
  otherHref: string | null;
  otherLabel: string;
}
const { lang, myName, myIcon, oppName, oppIcon, myBreakdowns, otherHref, otherLabel } = Astro.props;

function hashKey(s: string): string {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;
  return h.toString(36);
}
const uid = hashKey(`${myIcon}|${oppIcon}|${myName}|${oppName}|${myBreakdowns.map((b) => b.label).join(',')}`);

const pick = (en: Record<string, string>, ko: Record<string, string>) => (n: string) =>
  lang === 'en' ? en[n] ?? n : lang === 'ko' ? ko[n] ?? n : n;
const tMove = pick(MOVE_NAME_EN, MOVE_NAME_KO);
const pokeMap = lang === 'en' ? POKEMON_NAME_EN : POKEMON_NAME_KO;
const tItem = (n: string) => itemNameOf(n, lang, lang === 'en' ? ITEM_NAME_EN : ITEM_NAME_KO, pokeMap);
const tPoke = pick(POKEMON_NAME_EN, POKEMON_NAME_KO);
const tNature = pick(NATURE_NAME_EN, NATURE_NAME_KO);
const tAbility = pick(ABILITY_NAME_EN, ABILITY_NAME_KO);

const EV_LABELS = ['H', 'A', 'B', 'C', 'D', 'S'] as const;
const evText = (evs: ResolvedBuild['evs']) =>
  evs.map((v, i) => (v > 0 ? `${EV_LABELS[i]}${v}` : null)).filter((x): x is string => x !== null).join(' ');

const names = { tPoke, tMove, tItem, tAbil: tAbility, tNature };
const argmax = (xs: (number | undefined)[]) => xs.reduce<number>((bi, x, i) => ((x ?? -1) > (xs[bi] ?? -1) ? i : bi), 0);

/** 表示に使わない判定の項目 */
const DROP_V = new Set(['even', 'myPlan', 'oppPlan', 'myPrep', 'oppPrep', 'mySeq', 'oppSeq', 'score', 'stub']);
/** 埋め込むJSONを小さくする: null・false の項目を省き、小数は6桁に丸める（表示は最大2桁なので見た目は変わらない）。 */
function slim(x: unknown, drop?: Set<string>): unknown {
  if (Array.isArray(x)) return x.map((y) => slim(y));
  if (typeof x === 'number') return Number.isInteger(x) ? x : Math.round(x * 1e6) / 1e6;
  if (!x || typeof x !== 'object') return x;
  const o: Record<string, unknown> = {};
  for (const [k, v] of Object.entries(x)) {
    if (v == null || v === false || drop?.has(k)) continue;
    o[k] = slim(v);
  }
  return o;
}

/** 割合(%)がダメージとHPから同じ式で出せる項目は割合を省く（開いたときに renderMuDialog が計算し直す）。 */
type Dmg = { dmgLo?: number | null; dmgHi?: number | null; pctLo?: number | null; pctHi?: number | null };
function dropPct<T extends Dmg>(m: T | null, hp: number): T | null {
  if (!m || m.dmgLo == null || m.dmgHi == null) return m;
  return m.pctLo === (m.dmgLo / hp) * 100 && m.pctHi === (m.dmgHi / hp) * 100 ? { ...m, pctLo: undefined, pctHi: undefined } : m;
}
type St = { sides: { hp?: number; stg?: number[] }[] };
const noStg = (st: St): St => ({ ...st, sides: st.sides.map((sd) => (sd.stg?.every((x) => x === 0) ? { ...sd, stg: undefined } : sd)) });
/** 経過の各時点の状態は、直前と同じなら省き、HPは経過の hp と同じなら省き、能力変化が無ければ省く（renderMuDialog が戻す）。 */
function slimRace(v: MatchupBreakdown['builds'][number]['verdict']) {
  if (!v.race) return v;
  let prev = '';
  const race = v.race.map((e, k) => {
    const st = (e as { st?: St }).st;
    if (!st) return e;
    const key = JSON.stringify(st);
    const same = k > 0 && key === prev;
    prev = key;
    if (same) return { ...e, st: undefined };
    const hpSame = st.sides.every((sd, z) => sd.hp === e.hp[z]);
    return { ...e, st: noStg(hpSame ? { ...st, sides: st.sides.map((sd) => ({ ...sd, hp: undefined })) } : st) };
  });
  const init = (v as { raceInit?: St }).raceInit;
  return { ...v, race, ...(init ? { raceInit: noStg(init) } : {}) };
}

const moves = new Set<string>(), items = new Set<string>(), pokes = new Set<string>(), abils = new Set<string>();
const addMoves = (xs: ({ n: string } | null | undefined)[] | undefined) => xs?.forEach((x) => x && moves.add(x.n));
const data: MuPopupData = {
  def: argmax(myBreakdowns.map((mb) => mb.breakdown.me.weight)),
  mine: myBreakdowns.map((mb, i) => {
    const bd = mb.breakdown;
    return {
      t: buildTitle(bd.me, i, lang, names), sub: buildShare(bd.me) || evText(bd.me.evs),
      hp: bd.me.stats[0], ic: bd.me.icon || myIcon,
      def: argmax(bd.builds.map((r) => r.build.weight)),
      rows: bd.builds.map((r, j): MuPopupRow => {
        const v = r.verdict;
        addMoves(r.myTurns); addMoves(r.oppTurns); addMoves([r.myDmg, r.oppDmg]); addMoves(r.moves.my); addMoves(r.moves.opp);
        [v.myMove, v.oppMove, ...(v.stall?.seq ?? [])].forEach((n) => n && moves.add(n));
        for (const e of v.race ?? []) {
          if (e.move) moves.add(e.move);
          (e as { st?: { sides: { item: string | null }[] } }).st?.sides.forEach((sd) => sd.item && items.add(sd.item));
        }
        const init = (v as { raceInit?: { sides: { item: string | null }[]; mega?: ({ from: string; to: string; ability: string; stone: string } | null)[] } }).raceInit;
        init?.sides.forEach((sd) => sd.item && items.add(sd.item));
        init?.mega?.forEach((m) => { if (m) { pokes.add(m.from); pokes.add(m.to); abils.add(m.ability); items.add(m.stone); } });
        (init as { events?: { ability?: string | null; abilities?: (string | null)[] }[] } | undefined)?.events?.forEach((ev) => {
          if (ev.ability) abils.add(ev.ability);
          ev.abilities?.forEach((x) => x && abils.add(x));
        });
        const row = muPopupRow(bd.me, r.build, j, lang, names, {
          verdict: v, pair: { my: r.myDmg, opp: r.oppDmg, myTurns: r.myTurns, oppTurns: r.oppTurns }, moves: r.moves, ev: r.evLabel,
        });
        return {
          ...row, ic: r.build.icon || oppIcon,
          v: slim(slimRace(v), DROP_V) as MuPopupRow['v'],
          mt: slim(row.mt) as MuPopupRow['mt'], ot: slim(row.ot) as MuPopupRow['ot'],
          md: slim(dropPct(row.md ?? null, r.build.stats[0])) as MuPopupRow['md'], od: slim(dropPct(row.od ?? null, bd.me.stats[0])) as MuPopupRow['od'],
          mm: slim((row.mm ?? []).map((m) => dropPct(m, r.build.stats[0]))) as MuPopupRow['mm'],
          om: slim((row.om ?? []).map((m) => dropPct(m, bd.me.stats[0]))) as MuPopupRow['om'],
        };
      }),
    };
  }),
};
if (lang !== 'ja') {
  const dictOf = (xs: Set<string>, f: (n: string) => string) =>
    Object.fromEntries([...xs].map((n) => [n, f(n)]).filter(([n, t]) => n !== t));
  data.dict = { m: dictOf(moves, tMove), i: dictOf(items, tItem), p: dictOf(pokes, tPoke), a: dictOf(abils, tAbility) };
}
const json = JSON.stringify(slim(data)).replace(/</g, '\\u003c').replace(/&/g, '\\u0026');
---

<div class="mbp" data-mbp-uid={uid} data-mbp-lang={lang} data-mbp-my={myName} data-mbp-opp={oppName} data-mbp-myicon={myIcon} data-mbp-oppicon={oppIcon}>
  <button type="button" class="mbp-close" aria-label="閉じる">✕</button>
  <div class="mbp-hd">
    <img src={`/images/pokemon/pokemon-${myIcon}.webp`} alt={myName} />
    <span class="mbp-name">{myName}</span>
    <span class="mbp-vs">vs</span>
    <img src={`/images/pokemon/pokemon-${oppIcon}.webp`} alt={oppName} />
    <span class="mbp-name">{oppName}</span>
  </div>
  <div class="mbp-body"></div>
  <template class="mbp-data" set:html={json}></template>

  {otherHref && <a class="mbp-link" href={otherHref}>{otherLabel}</a>}
</div>

<script>
  import { bindMuCardClicks, type MuPopupData } from '../scripts/party-builder/mu-card';
  import { renderMuDialog } from '../scripts/party-builder/mu-cell-popup';
  // カードの棒のセグメントをタップすると、そのカードの詳細欄にターン・技名/原因・減ったHPを出す
  bindMuCardClicks(document);
  /** ポップアップを開いたとき、埋め込んだ判定結果から中身（タブ・カード・再生）を組み立てる（1回だけ）。 */
  function fillPopup(root: HTMLElement) {
    const src = root.querySelector<HTMLTemplateElement>(':scope > template.mbp-data');
    const body = root.querySelector<HTMLElement>(':scope > .mbp-body');
    if (!src || !body) return;
    const d = JSON.parse(src.content.textContent || '{}') as MuPopupData;
    const ds = root.dataset;
    body.innerHTML = renderMuDialog(d, (ds.mbpLang as 'ja' | 'en' | 'ko') || 'ja', {
      myName: ds.mbpMy ?? '', oppName: ds.mbpOpp ?? '', myIcon: ds.mbpMyicon ?? '', oppIcon: ds.mbpOppicon ?? '', uid: ds.mbpUid ?? '',
    });
    src.remove();
  }
  document.addEventListener('toggle', (e) => {
    const d = e.target as HTMLDetailsElement;
    if (!(d instanceof HTMLDetailsElement) || !d.open) return;
    d.querySelectorAll<HTMLElement>('.mbp').forEach(fillPopup);
  }, true);
  document.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((d) => d.querySelectorAll<HTMLElement>('.mbp').forEach(fillPopup));
  /**
   * /counters/・/pokemon/(有利・不利な相手)双方のポップアップ(details.ccard-wrap /
   * details.mu-cell-pop)を閉じる共通スクリプト。Astroが同一内容の<script>を
   * ページ内で自動的に1本へ重複排除するため、コンポーネントが何度使われても
   * このロジックは1回だけ登録される。
   * - ✕ボタンクリック / 画面外タップ / Escapeキーで閉じる
   */
  function closeAllMatchupPopups(except?: Element | null) {
    document.querySelectorAll('details.mu-cell-pop[open], details.ccard-wrap[open]').forEach((d) => {
      if (d !== except) d.removeAttribute('open');
    });
  }
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('.mbp-close')) {
      target.closest('details')?.removeAttribute('open');
      return;
    }
    // ポップアップ本体(表・リンクなど)の中をクリックした場合は何もしない
    // (中の要素を触っただけで意図せず閉じないようにする)。
    if (target.closest('.mu-pop, .ccard-pop')) return;
    // トリガー(summary)自体のクリックはネイティブのトグル動作に任せつつ、
    // 他に開いているポップアップがあれば閉じる(同時に複数開かない)。
    const summary = target.closest('details.mu-cell-pop > summary, details.ccard-wrap > summary');
    if (summary) {
      closeAllMatchupPopups(summary.closest('details'));
      return;
    }
    // それ以外(背景オーバーレイ・ページの他の場所)のクリックは全て閉じる。
    closeAllMatchupPopups();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllMatchupPopups();
  });
</script>

<style is:global>
  .mbp { position: relative; font-size: .78rem; width: min(34rem, 86vw); }
  .mbp-close {
    position: absolute; top: -6px; right: -6px; width: 26px; height: 26px; border-radius: 999px;
    border: none; background: #f1f5f9; color: #475569; font-size: .82rem; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center; z-index: 1;
  }
  .mbp-close:hover { background: #e2e8f0; }
  .mbp-hd { display: flex; align-items: center; gap: 6px; font-weight: 800; margin-bottom: 6px; padding-right: 22px; }
  .mbp-hd img { width: 28px; height: 28px; object-fit: contain; }
  .mbp-vs { color: #94a3b8; font-weight: 700; font-size: .74rem; }

  .mbp-link { display: inline-block; margin-top: 6px; font-size: .8rem; font-weight: 700; color: var(--accent, #f97316); text-decoration: none; }
  .mbp-link:hover { text-decoration: underline; }
</style>
