---
import type { MatchupBreakdown } from '../scripts/party-builder/matchup-static';
import { fmtKoProbPct, type MoveHitDetail } from '../scripts/party-builder/matchup';
import { MOVE_NAME_EN, MOVE_NAME_KO, ITEM_NAME_EN, ITEM_NAME_KO, NATURE_NAME_EN, NATURE_NAME_KO } from '../i18n/game-terms';

/**
 * 「対策」「有利・不利な相手」双方のポップアップで使う唯一の表示コンポーネント。
 * 簡単構築(PartySuggestApp)のmatchupDetailHtml(型を列に並べ、型ごとに与ダメ・被ダメ・
 * 素早さ・判定を通しで見せる)と同じ構造に合わせている。ここを直せば/counters/・
 * /pokemon/どちらの表示も同時に直る。
 *
 * 相手側は既にtargets.jsonの型プール(最大3種)を列で見せているのに、自分側は
 * mainBuild()の1型固定で「自分の型を変えたらどうなるか」が見えない、という
 * 指摘を受け、myBreakdowns(自分の主要な型ごとの内訳、最大3件)をタブ切り替えで
 * 見られるようにした(自分の型が1件のみなら従来通りタブなしで1枚だけ表示)。
 */
interface Props {
  lang: 'ja' | 'en' | 'ko';
  myName: string;
  myIcon: string;
  oppName: string;
  oppIcon: string;
  /** 自分の主要な型ごとの内訳(通常1〜3件)。label例: 「きあいのタスキ・ようき」。 */
  myBreakdowns: { label: string; breakdown: MatchupBreakdown }[];
  otherHref: string | null;
  otherLabel: string;
}
const { lang, myName, myIcon, oppName, oppIcon, myBreakdowns, otherHref, otherLabel } = Astro.props;
/**
 * タブ用ラジオボタンのname属性に使う一意キー。
 * 以前は `${myIcon}-${oppIcon}-${myName}` から英数字以外を除去していたため、
 * (1)日本語名が丸ごと消える (2)メガリザードンX/Yのように「同じicon・同じ相手種で
 * 石だけ違う」2つのポップアップが同一ページに並ぶ、の合わせ技でuidが完全に衝突し、
 * 2つのポップアップのラジオが同じグループになって片方のチェックが外れ、
 * どのパネルも表示されない(タブ見出しだけ出て表が空白)不具合が出た。
 * 文字列全体をハッシュ化して衝突しないようにする。
 */
function hashKey(s: string): string {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;
  return h.toString(36);
}
const uid = hashKey(`${myIcon}|${oppIcon}|${myName}|${oppName}|${myBreakdowns.map((b) => b.label).join(',')}`);

const tMove = (n: string | null) => {
  if (!n) return '—';
  if (lang === 'en') return MOVE_NAME_EN[n] ?? n;
  if (lang === 'ko') return MOVE_NAME_KO[n] ?? n;
  return n;
};
const tItem = (n: string) => (lang === 'en' ? ITEM_NAME_EN[n] ?? n : lang === 'ko' ? ITEM_NAME_KO[n] ?? n : n);
const tNature = (n: string) => (lang === 'en' ? NATURE_NAME_EN[n] ?? n : lang === 'ko' ? NATURE_NAME_KO[n] ?? n : n);

const EV_LABELS = ['H', 'A', 'B', 'C', 'D', 'S'] as const;
const meEvLabel = (me: MatchupBreakdown['me']) =>
  me.evs
    .map((v, i) => (v > 0 ? `${EV_LABELS[i]}${v}` : null))
    .filter((s): s is string => s !== null)
    .join(' ');

const T = {
  ja: {
    myTab: (i: number) => `自分の型${i}`,
    myBuild: (item: string, nature: string, ev: string) => `${myName}の型：${item}・${nature}・${ev}`,
    sub: (n: number) => `${oppName}の想定型${n}種に対する、互いが採用率上位の技プールから選んだ最大打点1発の確定数・素早さ・勝敗判定（実数値・天候・フィールド・いかく等の入場時効果を考慮）。`,
    buildLabel: (i: number) => `型${i}`,
    rowSpeed: '素早さ',
    rowJudge: '判定',
    hits: (n: number | null) => (n == null || n >= 999 ? '圏外' : `確定${n}`),
    hitsDetail: (d: MoveHitDetail | null) => {
      if (!d || d.hits == null) return '圏外';
      const base = d.certain ? `確定${d.hits}` : `乱数${d.hits}発（${fmtKoProbPct(d.prob)}%）`;
      return d.reason ? `${base}（${d.reason}込み）` : base;
    },
    condsLabel: (c: string) => `${c} 込みで計算`,
    fastLabel: (fast: boolean) => (fast ? '先手' : '後手'),
    judgeText: (win: boolean, myHits: string, oppHits: string, fast: boolean) =>
      `${win ? '勝ち' : '負け'}：${myHits}で倒す/${oppHits}で倒される・${fast ? '先手' : '後手'}`,
  },
  en: {
    myTab: (i: number) => `My build ${i}`,
    myBuild: (item: string, nature: string, ev: string) => `${myName}'s build: ${item}, ${nature}, ${ev}`,
    sub: (n: number) => `Hits-to-KO, Speed, and win/loss for each side's best move against ${n} known ${oppName} build(s) (actual stats).`,
    buildLabel: (i: number) => `Build ${i}`,
    rowSpeed: 'Speed',
    rowJudge: 'Verdict',
    hits: (n: number | null) => (n == null || n >= 999 ? 'out of range' : `KO in ${n}`),
    hitsDetail: (d: MoveHitDetail | null) => {
      if (!d || d.hits == null) return 'out of range';
      const base = d.certain ? `KO in ${d.hits}` : `${d.hits}-hit (${fmtKoProbPct(d.prob)}% chance)`;
      return d.reason ? `${base} (incl. ${d.reason})` : base;
    },
    condsLabel: (c: string) => `calculated with ${c}`,
    fastLabel: (fast: boolean) => (fast ? 'First' : 'Second'),
    judgeText: (win: boolean, myHits: string, oppHits: string, fast: boolean) =>
      `${win ? 'Win' : 'Lose'}: ${myHits} vs ${oppHits}, ${fast ? 'moves first' : 'moves second'}`,
  },
  ko: {
    myTab: (i: number) => `내 빌드 ${i}`,
    myBuild: (item: string, nature: string, ev: string) => `${myName}의 빌드: ${item}・${nature}・${ev}`,
    sub: (n: number) => `${oppName}의 예상 빌드 ${n}종에 대한, 서로의 최대 위력기 1발 확정 수・스피드・승패 판정(실수치 고려).`,
    buildLabel: (i: number) => `빌드${i}`,
    rowSpeed: '스피드',
    rowJudge: '판정',
    hits: (n: number | null) => (n == null || n >= 999 ? '범위 밖' : `확정 ${n}`),
    hitsDetail: (d: MoveHitDetail | null) => {
      if (!d || d.hits == null) return '범위 밖';
      const base = d.certain ? `확정 ${d.hits}` : `${d.hits}발 확률(${fmtKoProbPct(d.prob)}%)`;
      return d.reason ? `${base}(${d.reason} 포함)` : base;
    },
    condsLabel: (c: string) => `${c} 포함 계산`,
    fastLabel: (fast: boolean) => (fast ? '선공' : '후공'),
    judgeText: (win: boolean, myHits: string, oppHits: string, fast: boolean) =>
      `${win ? '승리' : '패배'}: ${myHits} / ${oppHits}・${fast ? '선공' : '후공'}`,
  },
}[lang];

const multi = myBreakdowns.length > 1;
---

<div class="mbp">
  <button type="button" class="mbp-close" aria-label="閉じる">✕</button>
  <div class="mbp-hd">
    <img src={`/images/pokemon/pokemon-${myIcon}.webp`} alt={myName} />
    <span class="mbp-name">{myName}</span>
    <span class="mbp-vs">vs</span>
    <img src={`/images/pokemon/pokemon-${oppIcon}.webp`} alt={oppName} />
    <span class="mbp-name">{oppName}</span>
  </div>

  {multi && myBreakdowns.map((_, i) => (
    <input type="radio" name={`mbp-tab-${uid}`} id={`mbp-tab-${uid}-${i}`} class="mbp-tab-radio" checked={i === 0} />
  ))}
  {multi && (
    <div class="mbp-tab-labels">
      {myBreakdowns.map((mb, i) => (
        <label for={`mbp-tab-${uid}-${i}`} class="mbp-tab-label">{T.myTab(i + 1)}<span class="mbp-tab-sub">{mb.label}</span></label>
      ))}
    </div>
  )}

  <div class={`mbp-tab-panels ${multi ? '' : 'single'}`}>
    {myBreakdowns.map((mb, i) => {
      const breakdown = mb.breakdown;
      return (
        <div class="mbp-tab-panel">
          <p class="mbp-my-build">{T.myBuild(tItem(breakdown.me.item), tNature(breakdown.me.nature), meEvLabel(breakdown.me))}</p>
          <p class="mbp-sub">{T.sub(breakdown.builds.length)}</p>
          <div class="mbp-scroll">
            <table class="mbp-table">
              <tr>
                <th class="lft"></th>
                {breakdown.builds.map((r, j) => (
                  <th>
                    {T.buildLabel(j + 1)}
                    <div class="mbp-build-meta">{tItem(r.build.item)}<br />{tNature(r.build.nature)}<br />{r.evLabel}</div>
                  </th>
                ))}
              </tr>
              <tr>
                <td class="lft">
                  <div class="mbp-lbl-icons">
                    <img class="mbp-mini-lbl" src={`/images/pokemon/pokemon-${myIcon}.webp`} alt={myName} />
                    <span>↓</span>
                    <img class="mbp-mini-lbl" src={`/images/pokemon/pokemon-${oppIcon}.webp`} alt={oppName} />
                  </div>
                </td>
                {breakdown.builds.map((r) => (
                  <td>
                    {r.myDmg?.pctLo != null && <span class="mbp-pct">{r.myDmg.pctLo.toFixed(1)}〜{r.myDmg.pctHi?.toFixed(1)}%</span>}
                    <span class="mbp-hits">{T.hitsDetail(r.myDmg)}</span>
                    <div class="mbp-move">{tMove(r.myDmg?.n ?? r.verdict.myMove)}</div>
                    {r.myDmg?.conds && <div class="mbp-conds">{T.condsLabel(r.myDmg.conds)}</div>}
                  </td>
                ))}
              </tr>
              <tr>
                <td class="lft">
                  <div class="mbp-lbl-icons">
                    <img class="mbp-mini-lbl" src={`/images/pokemon/pokemon-${oppIcon}.webp`} alt={oppName} />
                    <span>↓</span>
                    <img class="mbp-mini-lbl" src={`/images/pokemon/pokemon-${myIcon}.webp`} alt={myName} />
                  </div>
                </td>
                {breakdown.builds.map((r) => (
                  <td>
                    {r.oppDmg?.pctLo != null && <span class="mbp-pct">{r.oppDmg.pctLo.toFixed(1)}〜{r.oppDmg.pctHi?.toFixed(1)}%</span>}
                    <span class="mbp-hits">{T.hitsDetail(r.oppDmg)}</span>
                    <div class="mbp-move">{tMove(r.oppDmg?.n ?? r.verdict.oppMove)}</div>
                    {r.oppDmg?.conds && <div class="mbp-conds">{T.condsLabel(r.oppDmg.conds)}</div>}
                  </td>
                ))}
              </tr>
              <tr>
                <td class="lft">{T.rowSpeed}</td>
                {breakdown.builds.map((r) => (
                  <td class={`mbp-spd-cell ${r.verdict.fast ? 'mbp-spd-win' : 'mbp-spd-lose'}`}>
                    <div>{T.fastLabel(r.verdict.fast)}</div>
                    <div><img class="mbp-mini" src={`/images/pokemon/pokemon-${myIcon}.webp`} alt={myName} />S{r.verdict.myS} / <img class="mbp-mini" src={`/images/pokemon/pokemon-${oppIcon}.webp`} alt={oppName} />S{r.verdict.oppS}</div>
                  </td>
                ))}
              </tr>
              <tr>
                <td class="lft">{T.rowJudge}</td>
                {breakdown.builds.map((r) => (
                  <td class={r.verdict.win ? 'mbp-judge-win' : 'mbp-judge-lose'}>
                    <b class="mbp-sym">{r.verdict.sym}</b>
                    <div class="mbp-judge-text">{T.judgeText(r.verdict.win, T.hits(r.verdict.myHits), T.hits(r.verdict.oppHits), r.verdict.fast)}</div>
                  </td>
                ))}
              </tr>
            </table>
          </div>
        </div>
      );
    })}
  </div>

  {otherHref && <a class="mbp-link" href={otherHref}>{otherLabel}</a>}
</div>

<script>
  /**
   * /counters/・/pokemon/(有利・不利な相手)双方のポップアップ(details.ccard-wrap /
   * details.mu-cell-pop)を閉じる共通スクリプト。Astroが同一内容の<script>を
   * ページ内で自動的に1本へ重複排除するため、コンポーネントが何度使われても
   * このロジックは1回だけ登録される。
   * - ✕ボタンクリック / 画面外タップ / Escapeキーで閉じる
   */
  function closeAllMatchupPopups(except?: Element | null) {
    document.querySelectorAll('details.mu-cell-pop[open], details.ccard-wrap[open]').forEach((d) => {
      if (d !== except) d.removeAttribute('open');
    });
  }
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('.mbp-close')) {
      target.closest('details')?.removeAttribute('open');
      return;
    }
    // ポップアップ本体(表・リンクなど)の中をクリックした場合は何もしない
    // (中の要素を触っただけで意図せず閉じないようにする)。
    if (target.closest('.mu-pop, .ccard-pop')) return;
    // トリガー(summary)自体のクリックはネイティブのトグル動作に任せつつ、
    // 他に開いているポップアップがあれば閉じる(同時に複数開かない)。
    const summary = target.closest('details.mu-cell-pop > summary, details.ccard-wrap > summary');
    if (summary) {
      closeAllMatchupPopups(summary.closest('details'));
      return;
    }
    // それ以外(背景オーバーレイ・ページの他の場所)のクリックは全て閉じる。
    closeAllMatchupPopups();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllMatchupPopups();
  });
</script>

<style>
  .mbp { position: relative; font-size: .78rem; }
  .mbp-close {
    position: absolute; top: -6px; right: -6px; width: 26px; height: 26px; border-radius: 999px;
    border: none; background: #f1f5f9; color: #475569; font-size: .82rem; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center; z-index: 1;
  }
  .mbp-close:hover { background: #e2e8f0; }
  .mbp-hd { display: flex; align-items: center; gap: 6px; font-weight: 800; margin-bottom: 4px; padding-right: 22px; }
  .mbp-hd img { width: 28px; height: 28px; object-fit: contain; }
  .mbp-vs { color: #94a3b8; font-weight: 700; font-size: .74rem; }

  .mbp-tab-radio { position: absolute; opacity: 0; pointer-events: none; }
  .mbp-tab-labels { display: flex; gap: 4px; margin-bottom: 6px; flex-wrap: wrap; }
  .mbp-tab-label {
    display: flex; flex-direction: column; align-items: center; padding: 4px 8px; border-radius: 6px;
    border: 1px solid #e2e8f0; background: #f8fafc; cursor: pointer; font-size: .68rem; font-weight: 700;
    color: #64748b; line-height: 1.4;
  }
  .mbp-tab-sub { font-weight: 400; font-size: .9em; color: #94a3b8; }
  .mbp-tab-panels .mbp-tab-panel { display: none; }
  .mbp-tab-radio:nth-of-type(1):checked ~ .mbp-tab-labels label:nth-of-type(1),
  .mbp-tab-radio:nth-of-type(2):checked ~ .mbp-tab-labels label:nth-of-type(2),
  .mbp-tab-radio:nth-of-type(3):checked ~ .mbp-tab-labels label:nth-of-type(3) {
    background: var(--accent, #f97316); border-color: var(--accent, #f97316); color: #fff;
  }
  .mbp-tab-radio:nth-of-type(1):checked ~ .mbp-tab-panels .mbp-tab-panel:nth-of-type(1),
  .mbp-tab-radio:nth-of-type(2):checked ~ .mbp-tab-panels .mbp-tab-panel:nth-of-type(2),
  .mbp-tab-radio:nth-of-type(3):checked ~ .mbp-tab-panels .mbp-tab-panel:nth-of-type(3) {
    display: block;
  }
  /* タブなし(自分の型1件のみ)の場合は常に表示 */
  .mbp-tab-panels.single .mbp-tab-panel { display: block; }

  .mbp-my-build { font-size: .7rem; font-weight: 700; color: rgb(var(--black)); background: #f8fafc; border-radius: 6px; padding: 5px 8px; margin: 0 0 6px; line-height: 1.6; }
  .mbp-sub { font-size: .68rem; color: #64748b; line-height: 1.6; margin: 0 0 8px; }
  .mbp-scroll { overflow-x: auto; margin-bottom: 8px; }
  .mbp-table { border-collapse: collapse; font-size: .68rem; white-space: nowrap; }
  .mbp-table th, .mbp-table td { border: 1px solid #e2e8f0; padding: 5px 8px; text-align: center; vertical-align: top; }
  .mbp-table th { background: #f8fafc; font-weight: 800; }
  .mbp-table td.lft, .mbp-table th.lft { text-align: left; font-weight: 700; background: #f8fafc; white-space: normal; max-width: 92px; }
  .mbp-mini { width: 16px; height: 16px; object-fit: contain; vertical-align: -3px; }
  .mbp-lbl-icons { display: flex; flex-direction: column; align-items: center; gap: 1px; }
  .mbp-lbl-icons span { font-size: .7rem; color: #94a3b8; line-height: 1; }
  .mbp-mini-lbl { width: 26px; height: 26px; object-fit: contain; }
  .mbp-spd-cell { white-space: normal; }
  .mbp-spd-cell div:first-child { font-weight: 700; margin-bottom: 2px; }
  .mbp-build-meta { font-weight: 400; font-size: .9em; color: #64748b; margin-top: 2px; }
  .mbp-pct { font-weight: 800; display: block; }
  .mbp-hits { color: #475569; display: block; }
  .mbp-move { color: #94a3b8; font-size: .92em; margin-top: 2px; }
  /* ダメージ計算に効いた条件（天候・フィールド・いかく等）。%がどの前提の値かを示す */
  .mbp-conds { color: #b45309; font-size: .84em; margin-top: 1px; }
  .mbp-spd-win { color: #059669; font-weight: 700; }
  .mbp-spd-lose { color: #475569; }
  .mbp-judge-win { background: #ecfdf5; }
  .mbp-judge-lose { background: #f8fafc; }
  .mbp-sym { font-size: 1.1em; }
  .mbp-judge-text { white-space: normal; font-weight: 400; margin-top: 2px; font-size: .92em; }
  .mbp-link { display: inline-block; font-size: .8rem; font-weight: 700; color: var(--accent, #f97316); text-decoration: none; }
  .mbp-link:hover { text-decoration: underline; }
</style>
