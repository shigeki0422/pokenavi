---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SimulatorApp from '../components/SimulatorApp.astro';

const title = 'シミュレーション：M-B（バトルシミュレータ）| ポケナビ';
const description = '構築記事を公開されている環境トッププレイヤー同士の総当たり対戦（対戦AI同士）。パーティを選び、各ランカー・各ポケモンとの勝率・選出・1v1相性・実戦リプレイをデータで診断します。';
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
  </head>
  <body>
    <Header />
    <SimulatorApp mode="MB" />
    <Footer />
  </body>
</html>
