---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SimulatorApp from '../components/SimulatorApp.astro';

const title = 'M-B上位構築シミュレーター | 勝率・選出・1v1相性を診断 | ポケナビ';
const description = 'ポケモンチャンピオンズM-Bシーズンの上位ランカー構築データで対戦シミュレーション。パーティを選ぶだけで勝率・選出率・ポケモン1v1相性をAI対戦結果から分析。';
const siteUrl = 'https://pokenavi.jp';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ポケナビ M-Bシミュレーター',
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  url: siteUrl + '/simulator-mb/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  author: { '@type': 'Organization', name: 'ポケナビ', url: siteUrl },
};
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <SimulatorApp mode="MB" />
    <Footer />
  </body>
</html>
