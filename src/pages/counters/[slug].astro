---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MatchupBreakdownPopup from '../../components/MatchupBreakdownPopup.astro';
import { getMatchups, getMatchupBreakdown } from '../../scripts/party-builder/matchup-static';
import partySuggestSlugs from '../../data/party-suggest-slugs.json';
import { MATCHUP_SEASON } from '../../consts';

/**
 * 「○○対策」ページ: 使用率上位30体(targets.json、対戦相手として最も選出される
 * ポケモン)の各1体について、使用率上位200種の中から実際に有利(◎/○)を取れる
 * ポケモンを1v1事前計算(matchup-static.tsの既存エンジン)から抽出して並べる。
 * 新規データ収集ゼロ、既存の対戦データのみから生成できる。
 *
 * 判定基準: getMatchups()——/pokemon/{slug}/ページの「有利・不利な相手」
 * (MatchupSection.astro)と全く同じ関数——を使う。「相手(対象)の型は最大3種の
 * プールを集約評価し、自分(候補)の型は主流型1つに固定する」という前提を
 * getMatchups()/getMatchupBreakdown()に一本化し、対策ページ・ポケモン詳細
 * ページのどちらで見ても同じ判定になるようにする。
 * ポップアップの表示自体もMatchupBreakdownPopup.astro(簡単構築のmatchup_detail
 * ポップアップと同じ「型を列に並べ、型ごとに与ダメ・被ダメ・素早さ・判定を通しで
 * 見せる」構造)を/pokemon/(MatchupSection.astro)と共有し、今後どちらかの表示を
 * 直す時は1ファイルの修正で両方に反映されるようにする。
 */
export async function getStaticPaths() {
  const targetsPath = path.join(process.cwd(), 'public', 'builder-data', 'targets.json');
  const targets = JSON.parse(fs.readFileSync(targetsPath, 'utf8')) as { sp: string; icon: string; label?: string }[];
  const pokemonPages = await getCollection('pokemon', (p) => !p.data.draft);

  const nameToPage: Record<string, (typeof pokemonPages)[number]> = {};
  for (const p of pokemonPages) {
    if (p.data.pokemonName) nameToPage[p.data.pokemonName] = p;
  }

  const paths = [];
  for (const t of targets) {
    const page = nameToPage[t.sp];
    if (!page) continue;
    paths.push({
      params: { slug: page.id },
      props: {
        defenderName: t.sp,
        defenderIcon: t.icon,
        defenderSlug: page.id,
        defenderRank: page.data.usageRank ?? null,
        defenderAnalysisSlug: page.data.analysisSlug ?? null,
      },
    });
  }
  return paths;
}

const { defenderName, defenderIcon, defenderSlug, defenderRank, defenderAnalysisSlug } = Astro.props;

const psSlugSet = new Set(partySuggestSlugs as string[]);

const pokemonPages = await getCollection('pokemon', (p) => !p.data.draft);

// /matchup/[pair].astroと同一の使用率上位プール(直接比較ページが存在する種)を再構築し、
// 対策候補がこのプールに含まれる場合は/matchup/へのリンクも張る(旧実装では対策ページから
// /matchup/への導線が一切なく、/matchup/配下406ページが被リンクゼロの孤立ページだった)。
const poolTargets = JSON.parse(
  fs.readFileSync(path.join(process.cwd(), 'public', 'builder-data', 'targets.json'), 'utf8'),
) as { sp: string; icon: string }[];
const poolByName: Record<string, { slug: string; rank: number }> = {};
for (const t of poolTargets) {
  const page = pokemonPages.find((p) => p.data.pokemonName === t.sp);
  if (page) poolByName[t.sp] = { slug: page.id, rank: page.data.usageRank ?? 9999 };
}
const pairSlug = (aName: string, aSlug: string, aRank: number | null, bName: string, bSlug: string, bRank: number | null) => {
  const ar = aRank ?? 9999;
  const br = bRank ?? 9999;
  return ar <= br ? `${aSlug}-vs-${bSlug}` : `${bSlug}-vs-${aSlug}`;
};

type Counter = {
  slug: string;
  name: string;
  icon: string;
  sym: '◎' | '○';
  dep: boolean;
  rank: number | null;
  matchupHref: string | null;
  /** 対象(defender)にメガ進化の系統が複数ある場合(リザードンX/Y等)、
   * 系統ごとの内訳を全て並べる(1件のみが通常ケース)。 */
  breakdowns: { label: string; breakdown: NonNullable<ReturnType<typeof getMatchupBreakdown>> }[];
};
const counters: Counter[] = [];
for (const p of pokemonPages) {
  if (!p.data.pokemonName || p.data.dexNumber == null) continue;
  const icon = `${String(p.data.dexNumber).padStart(4, '0')}-${p.data.imageForm ?? '00'}`;
  if (icon === defenderIcon) continue;
  const matchups = getMatchups(icon);
  if (!matchups) continue;
  // defenderがメガ進化複数系統(リザードンX/Y等)の場合、getMatchups()は
  // targets.jsonの和名(defenderName)ではなく系統名(メガリザードンX等)で
  // 複数エントリを返すため、名前ではなくアイコンで一致させる。「対策」として
  // 挙げるのは、全系統に対して有利(◎/○)な場合のみ(片方にしか勝てないなら
  // 対策として不確実なため除外する)。
  const matched = matchups.filter((x) => x.icon === defenderIcon);
  if (!matched.length) continue;
  if (!matched.every((x) => x.sym === '◎' || x.sym === '○')) continue;
  const sym: '◎' | '○' = matched.some((x) => x.sym === '○') ? '○' : '◎';
  const dep = matched.some((x) => x.dep) || new Set(matched.map((x) => x.sym)).size > 1;

  const breakdowns = matched
    .map((mm) => {
      const breakdown = getMatchupBreakdown(icon, defenderIcon, undefined, mm.preferItem);
      return breakdown ? { label: mm.name, breakdown } : null;
    })
    .filter((b): b is NonNullable<typeof b> => !!b);
  if (!breakdowns.length) continue;

  const rank = p.data.usageRank ?? null;
  const poolEntry = poolByName[p.data.pokemonName];
  const matchupHref = poolEntry
    ? `/matchup/${pairSlug(p.data.pokemonName, p.id, rank, defenderName, defenderSlug, defenderRank)}/`
    : null;
  counters.push({ slug: p.id, name: p.data.pokemonName, icon, sym, dep, rank, matchupHref, breakdowns });
}
counters.sort((a, b) => {
  if (a.sym !== b.sym) return a.sym === '◎' ? -1 : 1;
  return (a.rank ?? 999) - (b.rank ?? 999);
});
const bestCounters = counters.filter((c) => c.sym === '◎');
const okCounters = counters.filter((c) => c.sym === '○');

const siteUrl = 'https://pokenavi.jp';
const rankText = defenderRank ? `使用率${defenderRank}位の` : '';
const title = `${defenderName}に強いポケモン ${MATCHUP_SEASON}【${rankText}対策ランキング】`;
const description = `${rankText}${defenderName}に強いポケモン${counters.length}体を使用率上位から抽出。1v1事前計算（実数値・タスキ/がんじょう考慮）で確実に有利を取れる対策ポケモンをランキング形式で紹介。`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${defenderName}対策ランキング`,
  description,
  url: `${siteUrl}/counters/${defenderSlug}/`,
  numberOfItems: counters.length,
  itemListElement: counters.slice(0, 20).map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    url: `${siteUrl}/pokemon/${c.slug}/`,
  })),
};
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      main { max-width: 900px; margin: 0 auto; padding: 1.4em 1em 4em; color: rgb(var(--gray-dark)); }
      h1 { font-size: 1.5rem; margin: 0 0 .3em; display: flex; align-items: center; gap: .5em; flex-wrap: wrap; }
      h1 img { width: 40px; height: 40px; object-fit: contain; }
      .lead { font-size: .9rem; color: rgb(var(--gray)); margin: 0 0 1.2em; line-height: 1.7; }
      .def-links { display: flex; flex-wrap: wrap; gap: .6em; font-size: .84rem; margin: 0 0 1.6em; }
      .def-links a { color: var(--accent); text-decoration: none; font-weight: 700; }
      .def-links a:hover { text-decoration: underline; }
      h2.sec { font-size: 1.05rem; font-weight: 800; margin: 1.6em 0 .7em; padding: .4em .8em; background: #f8fafc; border-left: 3px solid var(--accent); border-radius: 0 6px 6px 0; }
      .cgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
      .ccard-wrap { border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; overflow: hidden; transition: box-shadow .15s, border-color .15s; }
      .ccard-wrap:hover { box-shadow: 0 4px 12px rgba(0,0,0,.08); border-color: var(--accent); }
      .ccard-wrap[open] { border-color: var(--accent); }
      .ccard { display: flex; align-items: center; gap: 10px; padding: 10px 12px; cursor: pointer; list-style: none; }
      .ccard::-webkit-details-marker { display: none; }
      .ccard img.icon { width: 44px; height: 44px; object-fit: contain; flex-shrink: 0; }
      .ccard .info { min-width: 0; flex: 1; }
      .ccard .name { font-weight: 700; font-size: .9rem; color: rgb(var(--black)); }
      .ccard .rank { font-size: .72rem; color: rgb(var(--gray)); }
      .ccard .sym { font-size: 1.3rem; font-weight: 900; flex-shrink: 0; }
      .ccard .sym.best { color: #15803d; }
      .ccard .sym.ok { color: #4d7c0f; }
      .ccard .dep { font-size: .65rem; color: #7c3aed; font-weight: 800; vertical-align: 3px; }
      /* インライン展開だと画面下に長く伸びて見づらい・カード位置によって画面外に
         はみ出す(モバイルで報告された不具合)ため、/pokemon/(MatchupSection.astro)
         と同じく常時position:fixedで画面中央にポップアップ表示する。 */
      details.ccard-wrap[open]::before {
        content: ''; position: fixed; inset: 0; background: rgba(15, 23, 42, .35); z-index: 19;
      }
      .ccard-pop {
        position: fixed; z-index: 20; left: 50%; top: 50%; transform: translate(-50%, -50%);
        padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff;
        box-shadow: 0 12px 32px rgba(0,0,0,.2); width: max-content; max-width: 92vw; max-height: 82vh; overflow-y: auto;
      }
      .empty { font-size: .88rem; color: rgb(var(--gray)); padding: 1em; background: #f8fafc; border-radius: 8px; }
      .note { font-size: .78rem; color: rgb(var(--gray)); margin-top: 1.6em; line-height: 1.7; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1><img src={`/images/pokemon/pokemon-${defenderIcon}.webp`} alt={defenderName} />{defenderName}対策 — 有利を取れるポケモンランキング</h1>
      <p class="lead">
        ポケモンチャンピオンズ{MATCHUP_SEASON}環境で{rankText}{defenderName}に対し、{defenderName}の型プール（最大3種）を集約した1v1事前計算（実数値・きあいのタスキ/がんじょう考慮）で有利（◎・○）を取れる使用率上位のポケモンを{counters.length}体、判定順に並べました。タップすると型ごとの判定内訳を確認できます。
      </p>
      <div class="def-links">
        <a href={`/pokemon/${defenderSlug}/`}>→ {defenderName}自身の使用率・技採用率データを見る</a>
        {defenderAnalysisSlug && <a href={`/blog/${defenderAnalysisSlug}/`}>→ {defenderName}の考察記事を読む</a>}
      </div>

      {bestCounters.length > 0 && (
        <>
          <h2 class="sec">◎ 明確に有利を取れるポケモン（{bestCounters.length}体）</h2>
          <div class="cgrid">
            {bestCounters.map((c) => (
              <details class="ccard-wrap">
                <summary class="ccard">
                  <img class="icon" src={`/images/pokemon/pokemon-${c.icon}.webp`} alt={c.name} loading="lazy" />
                  <div class="info">
                    <div class="name">{c.name}</div>
                    <div class="rank">{c.rank ? `使用率${c.rank}位` : ''}</div>
                  </div>
                  <span class="sym best">◎{c.dep && <span class="dep">*</span>}</span>
                </summary>
                <div class="ccard-pop">
                  {c.breakdowns.map((b, i) => (
                    <MatchupBreakdownPopup
                      lang="ja"
                      myName={c.name}
                      myIcon={c.icon}
                      oppName={b.label}
                      oppIcon={defenderIcon}
                      myBreakdowns={[{ label: '', breakdown: b.breakdown }]}
                      otherHref={i === c.breakdowns.length - 1 ? `/pokemon/${c.slug}/` : null}
                      otherLabel={`${c.name}のページを見る →`}
                    />
                  ))}
                  {c.matchupHref && <a href={c.matchupHref} class="mbp-link" style="display:block;margin-top:6px">⚔ {defenderName}と主流型同士で詳しく比較 →</a>}
                </div>
              </details>
            ))}
          </div>
        </>
      )}

      {okCounters.length > 0 && (
        <>
          <h2 class="sec">○ やや有利を取れるポケモン（{okCounters.length}体）</h2>
          <div class="cgrid">
            {okCounters.map((c) => (
              <details class="ccard-wrap">
                <summary class="ccard">
                  <img class="icon" src={`/images/pokemon/pokemon-${c.icon}.webp`} alt={c.name} loading="lazy" />
                  <div class="info">
                    <div class="name">{c.name}</div>
                    <div class="rank">{c.rank ? `使用率${c.rank}位` : ''}</div>
                  </div>
                  <span class="sym ok">○{c.dep && <span class="dep">*</span>}</span>
                </summary>
                <div class="ccard-pop">
                  {c.breakdowns.map((b, i) => (
                    <MatchupBreakdownPopup
                      lang="ja"
                      myName={c.name}
                      myIcon={c.icon}
                      oppName={b.label}
                      oppIcon={defenderIcon}
                      myBreakdowns={[{ label: '', breakdown: b.breakdown }]}
                      otherHref={i === c.breakdowns.length - 1 ? `/pokemon/${c.slug}/` : null}
                      otherLabel={`${c.name}のページを見る →`}
                    />
                  ))}
                  {c.matchupHref && <a href={c.matchupHref} class="mbp-link" style="display:block;margin-top:6px">⚔ {defenderName}と主流型同士で詳しく比較 →</a>}
                </div>
              </details>
            ))}
          </div>
        </>
      )}

      {counters.length === 0 && (
        <p class="empty">現在算出できる対策ポケモンのデータがありません。</p>
      )}

      <p class="note">
        ※ 判定は{defenderName}の型プール（最大3種、使用率上位の持ち物・技構成）を集約した1v1事前計算に基づく目安です（交代・補助技・積み技は考慮していません）。<b>*</b>は型によって有利・不利の判定が割れることを示します（タップして内訳を確認できます）。実際のパーティでの詳しい判定は
        <a href="/party-builder/">パーティ工房</a>でご確認ください。
      </p>
    </main>
    <Footer />
  </body>
</html>
