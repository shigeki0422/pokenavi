---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import articleMeta from '../../data/article-meta.json';

const TYPE_NUM: Record<string, string> = {
	ノーマル: '00', かくとう: '01', ひこう: '02', どく: '03', じめん: '04',
	いわ: '05', むし: '06', ゴースト: '07', はがね: '08', ほのお: '09',
	みず: '10', くさ: '11', でんき: '12', エスパー: '13', こおり: '14',
	ドラゴン: '15', あく: '16', フェアリー: '17',
};
const SLUG: Record<string, string> = {
	'00': 'normal', '01': 'fighting', '02': 'flying', '03': 'poison', '04': 'ground',
	'05': 'rock', '06': 'bug', '07': 'ghost', '08': 'steel', '09': 'fire',
	'10': 'water', '11': 'grass', '12': 'electric', '13': 'psychic', '14': 'ice',
	'15': 'dragon', '16': 'dark', '17': 'fairy',
};
const typeImg = (jp: string) => `/images/types/type-${TYPE_NUM[jp]}-${SLUG[TYPE_NUM[jp]]}.png`;
const SLUG_TO_JP = Object.fromEntries(Object.entries(TYPE_NUM).map(([jp, n]) => [SLUG[n], jp]));

type Meta = Record<string, { name: string; rank: number; types: string[]; dex?: number; form?: string; pokemonId?: string | null }>;

export function getStaticPaths() {
	const num: Record<string, string> = {
		ノーマル: '00', かくとう: '01', ひこう: '02', どく: '03', じめん: '04',
		いわ: '05', むし: '06', ゴースト: '07', はがね: '08', ほのお: '09',
		みず: '10', くさ: '11', でんき: '12', エスパー: '13', こおり: '14',
		ドラゴン: '15', あく: '16', フェアリー: '17',
	};
	const slug: Record<string, string> = {
		'00': 'normal', '01': 'fighting', '02': 'flying', '03': 'poison', '04': 'ground',
		'05': 'rock', '06': 'bug', '07': 'ghost', '08': 'steel', '09': 'fire',
		'10': 'water', '11': 'grass', '12': 'electric', '13': 'psychic', '14': 'ice',
		'15': 'dragon', '16': 'dark', '17': 'fairy',
	};
	const used = new Set<string>();
	for (const v of Object.values(articleMeta as Meta)) for (const t of v.types) used.add(t);
	return [...used].map((jp) => ({ params: { type: slug[num[jp]] } }));
}

const { type } = Astro.params;
const jp = SLUG_TO_JP[type as string];
const entries = Object.entries(articleMeta as Meta)
	.map(([slug, v]) => ({ slug, ...v }))
	.filter((e) => e.types.includes(jp))
	.sort((a, b) => a.rank - b.rank);

const pageTitle = `【ポケモンチャンピオンズ】${jp}タイプ ポケモン情報まとめ`;
const pageDesc = `ポケモンチャンピオンズで使用率上位の${jp}タイプポケモンの考察記事まとめ。型・採用率・立ち回りを実データで分析しています。`;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} />
		<style>
			.t-hero { text-align: center; padding: 2.2rem 1rem 1.8rem; border-bottom: 1px solid rgb(var(--gray-light)); margin-bottom: 1.8rem; }
			.t-hero h1 { font-size: 1.7rem; margin: 0 0 0.5rem; display: flex; align-items: center; justify-content: center; gap: 10px; }
			.t-hero h1 img { width: 36px; height: 36px; }
			.t-hero p { color: rgb(var(--gray)); margin: 0; font-size: 0.92rem; }
			.t-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
			.t-row { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; color: inherit; background: #fff; transition: background 0.15s; }
			.t-row:hover { background: #f8fafc; }
			.t-icon { width: 48px; height: 48px; flex-shrink: 0; }
			.t-num { width: 44px; text-align: center; font-weight: 700; color: #e67e22; flex-shrink: 0; white-space: nowrap; font-size: 0.85rem; }
			.t-name { flex: 1; font-weight: 600; }
			.t-types { display: flex; gap: 3px; }
			.t-types img { width: 24px; height: 24px; }
			.back { display: block; text-align: center; margin: 1.5rem 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="t-hero">
				<h1><img src={typeImg(jp)} alt={jp} />{jp}タイプ 考察まとめ</h1>
				<p>使用率上位の{jp}タイプ（全{entries.length}件）</p>
			</section>
			<ol class="t-list">
				{entries.map((e) => (
					<li>
						<a class="t-row" href={e.pokemonId ? `/pokemon/${e.pokemonId}/` : `/blog/${e.slug}/`}>
							<span class="t-num">{e.rank}位</span>
							{e.dex
								? <img class="t-icon" src={`/images/pokemon/pokemon-${String(e.dex).padStart(4,'0')}-${e.form ?? '00'}.webp`} alt={e.name} loading="lazy" />
								: <div class="t-icon" />
							}
							<span class="t-name">{e.name}</span>
							<span class="t-types">
								{e.types.map((t) => <img src={typeImg(t)} alt={t} title={t} />)}
							</span>
						</a>
					</li>
				))}
			</ol>
			<a class="back" href="/ranking/">← 使用率ランキング全考察まとめへ</a>
		</main>
		<Footer />
	</body>
</html>
