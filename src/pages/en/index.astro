---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GlobalSearch from '../../components/GlobalSearch.astro';
import rankingData from '../../data/ranking.json';
import { getCollection } from 'astro:content';
import { POKEMON_NAME_EN as NAME_EN } from '../../i18n/pokemon-names';

const { dates, pokemon } = rankingData as {
  dates: string[];
  pokemon: { name: string; id: string | null; dates: Record<string, { rank: number; rate: number | null }> }[];
};

const lastDate = dates[dates.length - 1];
const top10 = [...pokemon]
  .filter(p => p.dates[lastDate]?.rank)
  .sort((a, b) => (a.dates[lastDate]?.rank ?? 999) - (b.dates[lastDate]?.rank ?? 999))
  .slice(0, 10);

const showDrafts = import.meta.env.INCLUDE_DRAFTS === 'true';
const allPokemonPages = (await getCollection('pokemon'))
  .filter(p => showDrafts || !p.data.draft)
  .sort((a, b) => (a.data.usageRank ?? 999) - (b.data.usageRank ?? 999));
const pokemonPages = allPokemonPages.slice(0, 10);
const pokemonTotal = allPokemonPages.length;

const fmtDate = (d: string) => { const [, m, day] = d.split('-'); return `${parseInt(m)}/${parseInt(day)}`; };

const siteUrl = 'https://pokenavi.jp';
const alternates = [
  { lang: 'ja', url: siteUrl + '/' },
  { lang: 'en', url: siteUrl + '/en/' },
  { lang: 'ko', url: siteUrl + '/ko/' },
  { lang: 'x-default', url: siteUrl + '/' },
];

const btnPrimary = 'display:inline-block;padding:0.6rem 1.3rem;border-radius:8px;text-decoration:none;font-weight:700;font-size:0.9rem;background:#f97316;color:#fff;';
const btnGhost = 'display:inline-block;padding:0.6rem 1.3rem;border-radius:8px;text-decoration:none;font-weight:700;font-size:0.9rem;background:#fff;border:1.5px solid #f97316;color:#f97316;';
const btnOrange = 'display:inline-block;padding:10px 28px;background:#f97316;color:white;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:700;';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Pokémon Champions Data Analysis | PokeNavi"
      description="Usage rate ranking, battle simulator, and analysis for Pokémon Champions. Data-driven competitive strategy."
      imageUrl="/og-image.png"
      alternates={alternates}
      ogLocale="en_US"
    />
    <style>
      .hero { text-align: center; padding: 3rem 1rem 2.5rem; border-bottom: 1px solid rgb(var(--gray-light)); margin-bottom: 2.5rem; }
      .hero h1 { font-size: 2.5rem; margin: 0 0 0.75rem; line-height: 1.2; }
      .hero p { font-size: 1.1rem; color: rgb(var(--gray)); margin: 0; }
      .section-title { font-size: 1.25rem; font-weight: 700; margin: 0 0 1.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid #f97316; color: rgb(var(--black)); }
      .bs-feature { border: 1px solid rgb(var(--gray-light)); border-radius: 14px; padding: 1.6rem 1.8rem; background: linear-gradient(135deg,#f5f7ff,#fff); box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
      .bs-feature h3 { margin: 0 0 0.5rem; font-size: 1.2rem; color: rgb(var(--black)); }
      .bs-feature p { margin: 0 0 1.1rem; color: rgb(var(--gray)); font-size: 0.95rem; line-height: 1.7; }
      .bs-points { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.2rem; padding: 0; list-style: none; }
      .bs-points li { background: #eef2ff; color: #000d8a; font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 9999px; }
      .bs-cta-row { display: flex; gap: 0.7rem; flex-wrap: wrap; }
      @media (max-width: 720px) { .hero h1 { font-size: 1.75rem; } }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <h1>Pokémon Champions<br />Data Analysis</h1>
        <p>Usage rankings, battle simulation, and data-driven strategy for Pokémon Champions</p>
        <GlobalSearch variant="hero" lang="en" />
      </section>

      <section style="margin-bottom:3rem">
        <h2 class="section-title">Battle Simulator <span style="font-size:0.8rem;font-weight:400;color:#f97316;margin-left:6px">Featured</span></h2>
        <div class="bs-feature">
          <h3>Diagnose your party's strength with AI round-robin battles</h3>
          <p>Test your party against all top-ranked trainers using a self-trained battle AI with look-ahead search. Get win rates, lead picks, 1v1 matchups, and replays — backed by data, not guesswork.</p>
          <ul class="bs-points">
            <li>All-ranker round-robin</li>
            <li>Win/loss path analysis</li>
            <li>1v1 matchup table</li>
            <li>Battle replays</li>
          </ul>
          <div class="bs-cta-row">
            <a style={btnPrimary} href="/simulator">Run Top-Env Simulation →</a>
            <a style={btnGhost} href="/battle-simulator">What is the Battle Simulator? →</a>
          </div>
        </div>
      </section>

      <section style="margin-bottom:3rem">
        <h2 class="section-title">Pokémon Data <span style="font-size:0.8rem;font-weight:400;color:rgb(var(--gray));margin-left:6px">Usage TOP10 — Updated {fmtDate(lastDate)}</span></h2>
        <div style="position:relative">
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px">
            {pokemonPages.map((p, i) => {
              const enName = NAME_EN[p.data.pokemonName] ?? p.data.pokemonName;
              return (
                <a href={`/pokemon/${p.id}/`} style="display:block;text-decoration:none;border:1px solid #e2e8f0;border-radius:8px;padding:10px 6px;text-align:center;transition:box-shadow 0.2s" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow=''">
                  <img
                    src={`/images/pokemon/pokemon-${String(p.data.dexNumber).padStart(4,'0')}-${p.data.imageForm ?? '00'}.webp`}
                    alt={enName}
                    style="width:64px;height:64px;display:block;margin:0 auto 4px"
                    loading={i < 4 ? 'eager' : 'lazy'}
                    width="64" height="64"
                  />
                  <div style="font-size:0.72rem;font-weight:bold;color:rgb(var(--gray));margin-bottom:1px">#{p.data.usageRank}</div>
                  <div style="font-size:0.75rem;font-weight:bold;color:rgb(var(--black))">{enName}</div>
                </a>
              );
            })}
          </div>
          <div style="position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(to bottom,transparent,white);pointer-events:none"></div>
        </div>
        <div style="text-align:center;margin-top:8px">
          <a style={btnOrange} href="/en/ranking/" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
            View full usage ranking (TOP200) →
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
