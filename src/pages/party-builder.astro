---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PartyBuilderApp from '../components/PartyBuilderApp.astro';
import ToolPageNotes from '../components/ToolPageNotes.astro';

const title = 'ポケモンチャンピオンズ パーティ工房 | 6匹の型をリアルタイム調整';
const description = 'ポケモンチャンピオンズの6匹を自由に微調整できるパーティ構築ツール。持ち物・特性・性格・EVをリアルタイムに変更しながら、想定敵との素早さ比較や1v1判定、タイプ相性バランスを確認できます。パーティは複数保存可能。';
const siteUrl = 'https://pokenavi.jp';

const faqs = [
  {
    q: '1v1判定はどこまで考慮していますか。',
    a: 'お互いの最大打点で殴り合った場合を評価し、素早さの先後、相手を倒すのに必要な手数、きあいのタスキとがんじょう、先制技を考慮しています。一方で交代・積み技・補助技・急所・追加効果は含みません。実戦の流れそのものではなく、正面からぶつかった場合の事前計算として扱ってください。',
  },
  {
    q: 'EV逆算では何ができますか。',
    a: '素早さ・火力・耐久の目標から、必要なEVを逆算して提案します。「この相手を抜きたい」「この攻撃を耐えたい」といった条件を満たす配分を、手作業で試さずに求められます。',
  },
  {
    q: '組んだパーティはどこに保存されますか。',
    a: 'お使いのブラウザ内に保存されます。サーバーには送信されないため、端末間の同期はありません。別の端末や他のツールで使う場合はエクスポート機能をご利用ください。ブラウザの閲覧データを消すと保存内容も消えます。',
  },
  {
    q: '「軸から簡単構築」で出たパーティを持ち込めますか。',
    a: '持ち込めます。簡単構築のページ下部にある「パーティ工房で型を微調整する」から移動すると、6匹がそのまま読み込まれた状態で工房が開きます。',
  },
  {
    q: '型を変えると何が再計算されますか。',
    a: '持ち物・特性・性格・EV・技を変更すると、実数値、仮想敵への与ダメージと被ダメージ、素早さの先後、1v1判定がその場で再計算されます。保存操作は不要で、変更は即座に反映されます。',
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ポケナビ パーティ工房',
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  url: siteUrl + '/party-builder/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  author: { '@type': 'Organization', name: 'ポケナビ', url: siteUrl },
};
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-party-builder.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <PartyBuilderApp>
      <ToolPageNotes faqs={faqs}>
        <h2>パーティ工房でできること</h2>
        <p>すでに6匹が決まっている構築を、<strong>数値を見ながら詰めるため</strong>のツールです。「なんとなく強そう」ではなく、抜けるか・耐えるか・落とせるかを実数値で確認しながら調整します。</p>
        <table>
          <thead><tr><th>やりたいこと</th><th>使う機能</th></tr></thead>
          <tbody>
            <tr><td>この相手を抜きたい</td><td>仮想敵との素早さ実数値比較。EVを動かすと先後の判定がその場で切り替わります</td></tr>
            <tr><td>この攻撃を耐えたい</td><td>被ダメージ表示。耐久にEVを振りながら、確定何発で落ちるかを確認します</td></tr>
            <tr><td>この相手を確定で落としたい</td><td>与ダメージ表示。技と持ち物を変えながら必要な火力を探ります</td></tr>
            <tr><td>全体のバランスを見たい</td><td>タイプ相性バランスと、使用率上位との1v1判定</td></tr>
          </tbody>
        </table>

        <h2>調整の進め方</h2>
        <ol>
          <li><strong>仮想敵を置く</strong> — 苦手な相手、よく当たる相手を指定します</li>
          <li><strong>素早さを決める</strong> — 抜きたい相手に対して先手を取れるラインまでSにEVを振ります</li>
          <li><strong>耐久と火力を配分する</strong> — 残りのEVを、耐えたい攻撃と落としたい相手に合わせて振り分けます</li>
          <li><strong>1v1判定で確かめる</strong> — 調整後に、環境上位との相性が崩れていないかを見ます</li>
        </ol>
        <p>1v1判定は正面からぶつかった場合の事前計算です。きあいのタスキとがんじょうは考慮しますが、交代や補助技は含みません。実戦では選出と立ち回りで結果が変わるため、判断の出発点として使ってください。</p>
      </ToolPageNotes>
    </PartyBuilderApp>
    <Footer />
  </body>
</html>
