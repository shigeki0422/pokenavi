---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import GlobalSearch from '../../components/GlobalSearch.astro';
import Header from '../../components/Header.astro';
import rankingData from '../../data/ranking.json';
import { POKEMON_NAME_KO as NAME_KO } from '../../i18n/pokemon-names';

const showDrafts = import.meta.env.INCLUDE_DRAFTS === 'true';
const allPokemonPages = (await getCollection('pokemon'))
	.filter((p) => showDrafts || !p.data.draft)
	.sort((a, b) => (a.data.usageRank ?? 999) - (b.data.usageRank ?? 999));
const pokemonPages = allPokemonPages.slice(0, 10);
const pokemonTotal = allPokemonPages.length;

const rSeasons = (rankingData as any).seasons as Record<string, { dates: string[]; pokemon: { name: string; id: string | null; dates: Record<string, { rank: number }> }[] }>;
const rSeasonKey = Object.keys(rSeasons).sort().at(-1)!;
const rSeason = rSeasons[rSeasonKey];
const rFirstD = rSeason.dates[0];
const rLastD = rSeason.dates[rSeason.dates.length - 1];
const fmtMD = (d: string) => { const [, m, dd] = d.split('-'); return `${parseInt(m)}/${parseInt(dd)}`; };
const pokeUrlByName: Record<string, string> = {};
for (const p of allPokemonPages) {
	if (p.data.pokemonName) pokeUrlByName[p.data.pokemonName] = `/ko/pokemon/${p.id}/`;
}
const rMovers = rSeason.pokemon.flatMap((p) => {
	const cur = p.dates[rLastD]?.rank;
	const prev = p.dates[rFirstD]?.rank;
	if (!cur || cur > 50 || !prev || prev === cur) return [];
	return [{ name: NAME_KO[p.name] ?? p.name, id: p.id, cur, prev, diff: prev - cur, url: pokeUrlByName[p.name] ?? null }];
});
const risers = [...rMovers].sort((a, b) => b.diff - a.diff).slice(0, 3).filter((m) => m.diff > 0);
const fallers = [...rMovers].sort((a, b) => a.diff - b.diff).slice(0, 3).filter((m) => m.diff < 0);

const siteUrl = 'https://pokenavi.jp';
const alternates = [
	{ lang: 'ja', url: siteUrl + '/' },
	{ lang: 'en', url: siteUrl + '/en/' },
	{ lang: 'ko', url: siteUrl + '/ko/' },
	{ lang: 'x-default', url: siteUrl + '/' },
];
const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: '포케나비',
	url: siteUrl + '/ko/',
	logo: { '@type': 'ImageObject', url: siteUrl + '/logo-mark.png' },
	description: '포켓몬 챔피언스 사용률 랭킹, 배틀 시뮬레이터, 데이터 기반 대전 공략 사이트.',
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="포켓몬 챔피언스 데이터 분석 | 포케나비"
			description="포켓몬 챔피언스 사용률 랭킹, 배틀 시뮬레이터, 데이터 기반 대전 공략 사이트."
			imageUrl="/og-image.png"
			alternates={alternates}
			ogLocale="ko_KR"
		/>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
		<style>
			.hero { text-align: center; padding: 3rem 1rem 2.5rem; border-bottom: 1px solid rgb(var(--gray-light)); margin-bottom: 2.5rem; }
			.hero h1 { font-size: 2.5rem; margin: 0 0 0.75rem; line-height: 1.2; }
			.hero p { font-size: 1.1rem; color: rgb(var(--gray)); margin: 0; }
			.section-title { font-size: 1.25rem; font-weight: 700; margin: 0 0 1.5rem; color: rgb(var(--black)); }
			.category-block { margin-bottom: 3.5rem; scroll-margin-top: 76px; }
			.category-head {
				display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.6rem 0.9rem;
				margin-bottom: 1.6rem; padding: 0.6rem 1rem 0.6rem 0.9rem;
				background: #eef2ff; border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0;
			}
			.category-title { font-size: 1.6rem; font-weight: 800; margin: 0; color: rgb(var(--black)); }
			.category-lead { margin: 0; font-size: 0.92rem; color: rgb(var(--gray)); }
			.beta-badge { font-size: 0.75rem; font-weight: 700; background: #fef3c7; color: #b45309; padding: 2px 8px; border-radius: 9999px; margin-left: 8px; vertical-align: middle; }
			.qn-wrap { margin: 0 0 2.5rem; }
			.qn-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; list-style: none; padding: 0; }
			.qn-tile {
				position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.3rem;
				width: auto; padding: 1rem 0.6rem; border: 1px solid rgb(var(--gray-light)); border-radius: 14px; background: #fff;
				text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.05);
				transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
			}
			.qn-tile:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.1); border-color: var(--accent); transform: translateY(-2px); }
			.qn-icon { font-size: 1.6rem; line-height: 1; }
			.qn-verb { font-size: 1.15rem; font-weight: 800; color: rgb(var(--black)); }
			.qn-lead { font-size: 0.76rem; color: rgb(var(--gray)); line-height: 1.4; }
			.qn-badge-new { position: absolute; top: 8px; right: 8px; font-size: 0.62rem; font-weight: 800; background: #fef3c7; color: #b45309; padding: 1px 6px; border-radius: 9999px; }
			.cta-banner {
				display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.75rem 1.8rem; background: var(--accent); color: #fff;
				border-radius: 9999px; text-decoration: none; font-weight: 700; font-size: 1rem; box-shadow: 0 2px 8px rgba(99,102,241,0.3); transition: opacity 0.2s;
			}
			.cta-banner:hover { opacity: 0.88; }
			.bs-feature { border: 1px solid rgb(var(--gray-light)); border-radius: 14px; padding: 1.6rem 1.8rem; background: linear-gradient(135deg, #f5f7ff, #ffffff); box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
			.bs-feature h3 { margin: 0 0 0.5rem; font-size: 1.2rem; color: rgb(var(--black)); }
			.bs-feature p { margin: 0 0 1.1rem; color: rgb(var(--gray)); font-size: 0.95rem; line-height: 1.7; }
			.bs-points { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.2rem; padding: 0; list-style: none; }
			.bs-points li { width: auto; background: #eef2ff; color: var(--accent-dark); font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 9999px; }
			@media (max-width: 640px) { .bs-points { display: none; } }
			.bs-cta-row { display: flex; gap: 0.7rem; flex-wrap: wrap; }
			.bs-cta { display: inline-block; padding: 0.6rem 1.3rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.9rem; }
			.bs-cta.primary { background: var(--accent); color: #fff; }
			.bs-cta.primary:hover { background: var(--accent-dark); }
			.bs-cta.ghost { background: #fff; border: 1px solid var(--accent); color: var(--accent); }
			.bs-cta.ghost:hover { background: #eef2ff; }
			@media (max-width: 720px) {
				.hero { padding: 1.75rem 1rem 1.5rem; }
				.hero h1 { font-size: 1.6rem; margin-bottom: 0.5rem; }
				.hero p { font-size: 1rem; }
				.qn-grid { grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
				.qn-tile { padding: 0.8rem 0.4rem; }
				.qn-icon { font-size: 1.4rem; }
				.qn-verb { font-size: 0.92rem; }
				.qn-lead { font-size: 0.66rem; }
			}
			html { scroll-behavior: smooth; }

			.trend-widget { max-width: 900px; margin: 0 auto 2rem; padding: 0 1em; }
			.tw-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 0.6rem; flex-wrap: wrap; }
			.tw-head h2 { font-size: 1rem; font-weight: 700; margin: 0; }
			.tw-period { font-size: 0.75rem; font-weight: 600; color: #94a3b8; margin-left: 8px; }
			.tw-more { font-size: 0.8rem; font-weight: 700; color: var(--accent, #f97316); text-decoration: none; white-space: nowrap; }
			.tw-more:hover { text-decoration: underline; }
			.tw-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
			.tw-col { border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; padding: 8px 10px; }
			.tw-col-label { font-size: 0.72rem; font-weight: 700; margin-bottom: 4px; }
			.tw-col-label.tw-up { color: #059669; }
			.tw-col-label.tw-down { color: #dc2626; }
			.tw-row { display: flex; align-items: center; gap: 8px; padding: 4px 2px; text-decoration: none; color: inherit; border-radius: 6px; }
			a.tw-row:hover { background: #f8fafc; }
			.tw-row img { width: 36px; height: 36px; object-fit: contain; flex-shrink: 0; }
			.tw-name { font-size: 0.82rem; font-weight: 700; color: #1e293b; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.tw-rank { font-size: 0.75rem; color: #64748b; margin-left: auto; white-space: nowrap; }
			.tw-rank strong { color: #1e293b; }
			.tw-diff { font-size: 0.75rem; font-weight: 700; white-space: nowrap; }
			.tw-diff.tw-up { color: #059669; }
			.tw-diff.tw-down { color: #dc2626; }
			@media (max-width: 720px) { .tw-cols { grid-template-columns: 1fr; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>데이터로 읽는 포켓몬 대전</h1>
				<p>대전 시뮬레이션·사용률·파티 구성을 데이터의 관점에서 분석합니다</p>
				<GlobalSearch variant="hero" lang="ko" />
			</section>

			{(risers.length > 0 || fallers.length > 0) && (
				<section class="trend-widget" aria-label="환경 변동">
					<div class="tw-head">
						<h2>📈 환경 변동<span class="tw-period">{fmtMD(rFirstD)}→{fmtMD(rLastD)}・사용률 TOP50</span></h2>
						<a href="/ko/ranking/" class="tw-more">랭킹 보기 →</a>
					</div>
					<div class="tw-cols">
						{risers.length > 0 && (
							<div class="tw-col">
								<div class="tw-col-label tw-up">급상승</div>
								{risers.map((m) => {
									const inner = (
										<>
											{m.id && <img src={`/images/pokemon/pokemon-${m.id}.webp`} alt={m.name} width="36" height="36" loading="lazy" />}
											<span class="tw-name">{m.name}</span>
											<span class="tw-rank">{m.prev}위→<strong>{m.cur}위</strong></span>
											<span class="tw-diff tw-up">▲{m.diff}</span>
										</>
									);
									return m.url ? <a href={m.url} class="tw-row">{inner}</a> : <div class="tw-row">{inner}</div>;
								})}
							</div>
						)}
						{fallers.length > 0 && (
							<div class="tw-col">
								<div class="tw-col-label tw-down">급락</div>
								{fallers.map((m) => {
									const inner = (
										<>
											{m.id && <img src={`/images/pokemon/pokemon-${m.id}.webp`} alt={m.name} width="36" height="36" loading="lazy" />}
											<span class="tw-name">{m.name}</span>
											<span class="tw-rank">{m.prev}위→<strong>{m.cur}위</strong></span>
											<span class="tw-diff tw-down">▼{-m.diff}</span>
										</>
									);
									return m.url ? <a href={m.url} class="tw-row">{inner}</a> : <div class="tw-row">{inner}</div>;
								})}
							</div>
						)}
					</div>
				</section>
			)}

			<nav class="qn-wrap" aria-label="빠른 이동">
				<div class="qn-grid">
					<a href="#sec-research" class="qn-tile">
						<span class="qn-icon" aria-hidden="true">🔍</span>
						<span class="qn-verb">조사</span>
						<span class="qn-lead">사용률 데이터로 현재 메타를 파악</span>
					</a>
					<a href="#sec-watch" class="qn-tile">
						<span class="qn-icon" aria-hidden="true">🎬</span>
						<span class="qn-verb">관전</span>
						<span class="qn-lead">대전 AI로 상위 구성의 움직임을 관전</span>
					</a>
					<a href="#sec-battle" class="qn-tile">
						<span class="qn-badge-new">NEW</span>
						<span class="qn-icon" aria-hidden="true">⚔️</span>
						<span class="qn-verb">대전</span>
						<span class="qn-lead">직접 파티를 구성해 메타에 도전</span>
					</a>
				</div>
			</nav>

			<section class="category-block" id="sec-research">
				<div class="category-head">
					<h2 class="category-title">조사</h2>
					<p class="category-lead">사용률 데이터로 현재 메타를 파악</p>
				</div>

				<div style="margin-bottom:1.8rem;display:flex;justify-content:center">
					<a href="/ko/ranking" class="cta-banner">📊 M-4 사용률 랭킹 보기 →</a>
				</div>

				<h3 class="section-title">포켓몬 정보 <span style="font-size:0.8rem;font-weight:400;color:rgb(var(--gray));margin-left:6px">사용률 TOP10</span></h3>
				<div style="position:relative">
					<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px">
						{pokemonPages.map((p, i) => {
							const koName = NAME_KO[p.data.pokemonName] ?? p.data.pokemonName;
							return (
								<a href={`/ko/pokemon/${p.id}/`} style="display:block;text-decoration:none;border:1px solid #e2e8f0;border-radius:8px;padding:10px 6px;text-align:center;transition:box-shadow 0.2s" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow=''">
									<img
										src={`/images/pokemon/pokemon-${String(p.data.dexNumber).padStart(4,'0')}-${p.data.imageForm ?? '00'}.webp`}
										alt={koName}
										style="width:64px;height:64px;display:block;margin:0 auto 4px"
										loading={i < 4 ? 'eager' : 'lazy'}
										width="64"
										height="64"
									/>
									<div style="font-size:0.72rem;font-weight:bold;color:rgb(var(--gray));margin-bottom:1px">{p.data.usageRank}위</div>
									<div style="font-size:0.75rem;font-weight:bold;color:rgb(var(--black))">{koName}</div>
								</a>
							);
						})}
					</div>
					<div style="position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(to bottom,transparent,white);pointer-events:none"></div>
				</div>
				<div style="text-align:center;margin-top:8px">
					<a href="/ko/pokemon/" style="display:inline-block;padding:10px 28px;background:var(--accent);color:white;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:700;transition:opacity 0.2s" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
						전체 보기（총{pokemonTotal}건）→
					</a>
				</div>
			</section>

			<section class="category-block" id="sec-watch">
				<div class="category-head">
					<h2 class="category-title">관전</h2>
					<p class="category-lead">대전 AI로 상위 구성의 움직임을 관전</p>
				</div>
				<div class="bs-feature">
					<h3>학습 AI 리그전으로 내 파티의 강함을 데이터로 진단</h3>
					<p>자체 학습한 대전 AI에 선읽기 탐색을 결합해, 선택한 파티를 전체 랭커와 총전. 승률·선출·1v1 상성·실전 리플레이를 「감각」이 아닌 「대전 데이터」로 확인할 수 있습니다.</p>
					<ul class="bs-points">
						<li>전체 랭커 총전</li>
						<li>승패 루트 분석</li>
						<li>1v1 상성표</li>
						<li>대전 리플레이</li>
					</ul>
					<div class="bs-cta-row">
						<a class="bs-cta primary" href="/ko/simulator-mb">상위 환경 시뮬레이션 사용하기 →</a>
						<a class="bs-cta ghost" href="/ko/battle-simulator">가상 배틀 관전이란? (배틀 시뮬레이터) →</a>
					</div>
				</div>
			</section>

			<section class="category-block" id="sec-battle">
				<div class="category-head">
					<h2 class="category-title">대전</h2>
					<p class="category-lead">축 제안부터 세부 조정까지, 직접 파티를 구성해 메타에 도전</p>
				</div>
				<div class="bs-feature">
					<h3>축만 고르면 AI 시뮬레이션이 파티를 자동 제안</h3>
					<p>축으로 삼고 싶은 포켓몬을 지정하면, 시뮬레이션이 나머지 칸을 채워 균형 잡힌 파티를 여러 개 제안합니다. 각 포켓몬의 역할, 사용률 상위와의 공격·방어·스피드·1v1 상성, 밸류 넷 기반 예상 승률까지 데이터로 확인할 수 있습니다.</p>
					<ul class="bs-points">
						<li>축 지정으로 자동 완성</li>
						<li>공격·방어·스피드 상성</li>
						<li>포켓몬 단위 1v1 상성</li>
						<li>파티 단위 상성</li>
					</ul>
					<div class="bs-cta-row">
						<a class="bs-cta primary" href="/ko/party-suggest">축으로 간단 구성 사용하기 →</a>
					</div>
				</div>
				<div class="bs-feature" style="margin-top:1.2rem">
					<h3>파티 공방<span class="beta-badge">NEW</span></h3>
					<p>포켓몬 챔피언스의 6마리를 자유롭게 미세 조정할 수 있는 파티 구성 도구. 지닌 물건·특성·성격·EV를 실시간으로 변경하면서 예상 상대와의 스피드 비교, 1v1 판정, 타입 상성 밸런스를 확인할 수 있습니다. 파티는 여러 개 저장 가능합니다.</p>
					<ul class="bs-points">
						<li>지닌물건·특성·성격·EV 편집</li>
						<li>예상 상대와의 스피드 비교</li>
						<li>1v1 판정</li>
						<li>타입 상성 밸런스</li>
					</ul>
					<div class="bs-cta-row">
						<a class="bs-cta primary" href="/ko/party-builder">파티 공방 사용하기 →</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
