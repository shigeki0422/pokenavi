---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GlobalSearch from '../../components/GlobalSearch.astro';
import rankingData from '../../data/ranking.json';

const { dates, pokemon } = rankingData as {
  dates: string[];
  pokemon: { name: string; id: string | null; dates: Record<string, { rank: number; rate: number | null }> }[];
};

const lastDate = dates[dates.length - 1];
const top10 = [...pokemon]
  .filter(p => p.dates[lastDate]?.rank)
  .sort((a, b) => (a.dates[lastDate]?.rank ?? 999) - (b.dates[lastDate]?.rank ?? 999))
  .slice(0, 10);

const fmtDate = (d: string) => { const [, m, day] = d.split('-'); return `${parseInt(m)}/${parseInt(day)}`; };

const NAME_KO: Record<string, string> = {
  'ガブリアス': '한카리아스', 'ミミッキュ': '따라큐', 'マスカーニャ': '마스카냐',
  'ブリジュラス': '브리지벨라스', 'メタグロス': '메타그로스', 'ライチュウ': '라이츄',
  'リザードン': '리자몽', 'ムクホーク': '찌르호크', 'アーマーガア': '아머까오',
  'カバルドン': '하마돈', 'アローラキュウコン': '알로라나인테일', 'バシャーモ': '번치코',
  'アシレーヌ': '어시레느', 'サザンドラ': '삼삼드래', 'ラグラージ': '대짱이',
  'イダイトウ(オス)': '이나하', 'ギャラドス': '갸라도스', 'キラフロル': '키라플로르',
  'ウォッシュロトム': '워시로토무', 'マフォクシー': '마폭시', 'カイリュー': '망나뇽',
  'オーロンゲ': '어둠대기리', 'ペリッパー': '왕큰부리', 'サーフゴー': '서프고',
  'クチート': '입치트', 'ドドゲザン': '도도게자', 'ラウドボーン': '라우드본',
  'ゲンガー': '팬텀', 'ゲッコウガ': '개굴닌자', 'ドラミドロ': '드래캄',
  'ガルーラ': '캥카', 'エーフィ': '에브이', 'ウルガモス': '볼케니온',
  'メガライチュウY': '메가라이츄Y', 'スコヴィラン': '스코비라', 'ドドゲザン': '킹드라',
  'ニンフィア': '님피아', 'ブラッキー': '블래키', 'グライオン': '글라이온',
  'ヘルガー': '헬가', 'カプ・レヒレ': '카푸느지느', 'カプ・テテフ': '카푸나비나',
  'ナットレイ': '나시', 'ランドロス': '랜드로스', 'ドリュウズ': '몰드류',
};

const siteUrl = 'https://pokenavi.jp';
const alternates = [
  { lang: 'ja', url: siteUrl + '/' },
  { lang: 'en', url: siteUrl + '/en/' },
  { lang: 'ko', url: siteUrl + '/ko/' },
  { lang: 'x-default', url: siteUrl + '/' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead
      title="포켓몬 챔피언스 데이터 분석 | 포케나비"
      description="포켓몬 챔피언스 사용률 랭킹, 배틀 시뮬레이터, 데이터 기반 대전 공략 사이트."
      imageUrl="/og-image.png"
      alternates={alternates}
      ogLocale="ko_KR"
    />
    <style>
      .hero { text-align: center; padding: 3rem 1rem 2.5rem; border-bottom: 1px solid rgb(var(--gray-light)); margin-bottom: 2.5rem; }
      .hero h1 { font-size: 2.5rem; margin: 0 0 0.75rem; line-height: 1.2; }
      .hero p { font-size: 1.1rem; color: rgb(var(--gray)); margin: 0; }
      .section-title { font-size: 1.25rem; font-weight: 700; margin: 0 0 1.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid rgb(var(--accent)); color: rgb(var(--black)); }
      .bs-feature { border: 1px solid rgb(var(--gray-light)); border-radius: 14px; padding: 1.6rem 1.8rem; background: linear-gradient(135deg, #f5f7ff, #ffffff); box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
      .bs-feature h3 { margin: 0 0 0.5rem; font-size: 1.2rem; color: rgb(var(--black)); }
      .bs-feature p { margin: 0 0 1.1rem; color: rgb(var(--gray)); font-size: 0.95rem; line-height: 1.7; }
      .bs-points { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.2rem; padding: 0; list-style: none; }
      .bs-points li { background: #eef2ff; color: var(--accent-dark); font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 9999px; }
      .bs-cta-row { display: flex; gap: 0.7rem; flex-wrap: wrap; }
      .bs-cta { display: inline-block; padding: 0.6rem 1.3rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.9rem; }
      .bs-cta.primary { background: var(--accent); color: #fff; }
      .bs-cta.primary:hover { background: var(--accent-dark); }
      .bs-cta.ghost { background: #fff; border: 1px solid var(--accent); color: var(--accent); }
      .bs-cta.ghost:hover { background: #eef2ff; }
      @media (max-width: 720px) { .hero h1 { font-size: 1.75rem; } }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <h1>포켓몬 챔피언스<br />데이터 분석</h1>
        <p>포켓몬 챔피언스 랭크 배틀의 사용률 랭킹, AI 배틀 시뮬레이터, 데이터 기반 공략</p>
        <GlobalSearch variant="hero" lang="ko" />
      </section>

      <section style="margin-bottom:3rem">
        <h2 class="section-title">배틀 시뮬레이터 <span style="font-size:0.8rem;font-weight:400;color:rgb(var(--accent));margin-left:6px">주목 기능</span></h2>
        <div class="bs-feature">
          <h3>학습 AI 리그전으로 내 파티의 강함을 데이터 진단</h3>
          <p>자체 학습 배틀 AI와 선읽기 탐색을 조합해, 선택한 파티를 전체 랭커와 총전. 승률·선발·1v1 상성·실전 리플레이를 「감각」이 아닌 「대전 데이터」로 확인할 수 있습니다.</p>
          <ul class="bs-points">
            <li>전체 랭커 총전</li>
            <li>승패 루트 분석</li>
            <li>1v1 상성표</li>
            <li>대전 리플레이</li>
          </ul>
          <div class="bs-cta-row">
            <a class="bs-cta primary" href="/simulator">상위 환경 시뮬레이션 →</a>
            <a class="bs-cta ghost" href="/battle-simulator">배틀 시뮬레이터란? →</a>
          </div>
        </div>
      </section>

      <section style="margin-bottom:3rem">
        <h2 class="section-title">사용률 랭킹 <span style="font-size:0.8rem;font-weight:400;color:rgb(var(--gray));margin-left:6px">TOP10 — {fmtDate(lastDate)} 업데이트</span></h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px">
          {top10.map((p, i) => {
            const rank = p.dates[lastDate]?.rank ?? i + 1;
            const name = NAME_KO[p.name] ?? p.name;
            return (
              <a href="/ko/ranking/" style="display:block;text-decoration:none;border:1px solid #e2e8f0;border-radius:8px;padding:10px 6px;text-align:center;transition:box-shadow 0.2s" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow=''">
                {p.id && <img src={`/images/pokemon/pokemon-${p.id}.webp`} alt={name} style="width:64px;height:64px;display:block;margin:0 auto 4px" loading={i < 4 ? 'eager' : 'lazy'} width="64" height="64" />}
                <div style="font-size:0.72rem;font-weight:bold;color:rgb(var(--gray));margin-bottom:1px">{rank}위</div>
                <div style="font-size:0.75rem;font-weight:bold;color:rgb(var(--black))">{name}</div>
              </a>
            );
          })}
        </div>
        <div style="text-align:center;margin-top:12px">
          <a href="/ko/ranking/" style="display:inline-block;padding:10px 28px;background:var(--accent);color:white;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:700;transition:opacity 0.2s" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
            전체 랭킹 보기 (TOP200) →
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
