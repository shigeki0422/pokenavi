---
// 簡単構築の複数軸モード（軸2〜6体・ライブ計算）。AdSense のオファーウォールはこのURLだけを対象にする
import { MATCHUP_SEASON } from '../../../consts';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PartySuggestApp from '../../../components/PartySuggestApp.astro';

const title = `포켓몬 챔피언스 ${MATCHUP_SEASON} 여러 축으로 간단 구성 | 2~6마리 축으로 팀 자동 제안`;
const description = `포켓몬 챔피언스 ${MATCHUP_SEASON} 시즌 대응. 사용하고 싶은 포켓몬을 2~6마리 지정하면 그 조합을 축으로 나머지 칸을 채운 파티를 제안합니다.`;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" adsSkipPremium
      alternates={[
        { lang: 'ja', url: 'https://pokenavi.jp/party-suggest/multi/' },
        { lang: 'en', url: 'https://pokenavi.jp/en/party-suggest/multi/' },
        { lang: 'ko', url: 'https://pokenavi.jp/ko/party-suggest/multi/' },
        { lang: 'x-default', url: 'https://pokenavi.jp/party-suggest/multi/' },
      ]}
      ogLocale="ko_KR"
    />
  </head>
  <body>
    <Header />
    <PartySuggestApp mode="multi" lang="ko" />
    <div style="max-width:860px;margin:0 auto;padding:0 1.2rem 3rem;text-align:center">
      <p style="font-size:.85rem;color:rgb(var(--gray));margin-bottom:.6rem">6마리가 정해졌다면 세부 설정을 조정해 보세요</p>
      <a href="/ko/party-builder/" style="display:inline-flex;align-items:center;gap:.5rem;padding:.55rem 1.4rem;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none;font-weight:700;font-size:.9rem">
        파티 공방에서 세부 조정하기 →
      </a>
    </div>
    <Footer />
  </body>
</html>
