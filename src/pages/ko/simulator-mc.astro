---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SimulatorApp from '../../components/SimulatorApp.astro';

const title = 'M-C 시뮬레이터(M-6 환경) | 승률·선출·1v1 상성 진단';
const description = '포켓몬 챔피언스 M-6 상위 환경의 사용률·육성 형태에 맞춰 생성한 100개 파티의 리그전 대전 시뮬레이션. 승률·선출률·포켓몬 1v1 상성·리플레이를 AI 대전 결과로부터 분석합니다.';
const siteUrl = 'https://pokenavi.jp';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '포케나비 M-C 시뮬레이터',
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  url: siteUrl + '/ko/simulator-mc/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  author: { '@type': 'Organization', name: '포케나비', url: siteUrl },
};
const alternates = [
  { lang: 'ja', url: siteUrl + '/simulator-mc/' },
  { lang: 'en', url: siteUrl + '/en/simulator-mc/' },
  { lang: 'ko', url: siteUrl + '/ko/simulator-mc/' },
  { lang: 'x-default', url: siteUrl + '/simulator-mc/' },
];

---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png"
      alternates={alternates}
      ogLocale="ko_KR"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <SimulatorApp mode="MC" lang="ko" />
    <Footer />
  </body>
</html>
