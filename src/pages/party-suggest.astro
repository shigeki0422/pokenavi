---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import iconsData from '../../public/sim-data/icons.json';
import moveTypesData from '../../public/sim-data/move_types.json';

const title = 'M-3 パーティ提案 | ポケナビ';
const description = '軸にしたいポケモンを指定すると、シミュレーションによりバランスの良いパーティを提案。各ポケの役割・パーティ統計・使用率上位との1v1相性を表示します。';

const ICONS = iconsData as Record<string, string>;
const MOVET = moveTypesData as Record<string, string>;
const NATURE: Record<string, string> = {いじっぱり:'A↑C↓',さみしがり:'A↑B↓',ゆうかん:'A↑S↓',やんちゃ:'A↑D↓',ずぶとい:'B↑A↓',わんぱく:'B↑C↓',のんき:'B↑S↓',のうてんき:'B↑D↓',ひかえめ:'C↑A↓',おっとり:'C↑B↓',れいせい:'C↑S↓',うっかりや:'C↑D↓',おだやか:'D↑A↓',おとなしい:'D↑B↓',なまいき:'D↑S↓',しんちょう:'D↑C↓',おくびょう:'S↑A↓',せっかち:'S↑B↓',ようき:'S↑C↓',むじゃき:'S↑D↓'};
const TYPEICON: Record<string, [string,string]> = {ノーマル:['00','normal'],かくとう:['01','fighting'],ひこう:['02','flying'],どく:['03','poison'],じめん:['04','ground'],いわ:['05','rock'],むし:['06','bug'],ゴースト:['07','ghost'],はがね:['08','steel'],ほのお:['09','fire'],みず:['10','water'],くさ:['11','grass'],でんき:['12','electric'],エスパー:['13','psychic'],こおり:['14','ice'],ドラゴン:['15','dragon'],あく:['16','dark'],フェアリー:['17','fairy']};
const ITEM_PNG: Record<string, string> = {きあいのタスキ:'item-0275-tasuki.png',こだわりスカーフ:'item-0287-scarf.png',オボンのみ:'item-0158-obon.png',ラムのみ:'item-0157-ram.png',ヤチェのみ:'item-0188-yache.png',ハバンのみ:'item-0197-haban.png'};
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
    <style is:global>
      main{width:auto;max-width:1040px;margin:0 auto;padding:1.4em 1em 4em;color:rgb(var(--gray-dark));overflow-x:clip}
      h1{font-size:1.5rem;margin:0 0 .2em}
      .lead{font-size:.88rem;color:rgb(var(--gray));margin:0 0 .5em}
      .note{font-size:.8rem;color:rgb(var(--gray));background:#fff8e6;border:1px solid #f0d888;border-radius:8px;padding:.55em .8em;margin:0 0 1.1em}
      .card{background:#fff;border:1px solid rgb(var(--gray-light));border-radius:12px;box-shadow:0 1px 3px rgba(var(--black),.05);padding:1em;margin-bottom:1.1em}
      .muted{font-size:.8rem;color:rgb(var(--gray))}
      .row{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
      .btn{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:.55em 1.2em;font-weight:700;font-size:.85rem;cursor:pointer;font-family:var(--font-atkinson)}
      .btn:disabled{opacity:.5;cursor:default}
      @media(hover:hover){.btn:hover{background:var(--accent-dark)}}
      input,.inp{font-size:.9rem;padding:.5em .6em;border:1px solid rgb(var(--gray-light));border-radius:8px;font-family:inherit}
      /* コア選択（simulator絞り込み準拠） */
      .corebox{}
      .filter-chips{display:flex;flex-wrap:wrap;gap:5px;align-items:center;margin-bottom:.4em}
      .filter-chip{display:inline-flex;align-items:center;gap:2px;padding:2px 4px 2px 3px;background:#eef2ff;border:1px solid #c7d2fe;border-radius:999px;font-size:.74rem;font-weight:700;color:#3730a3}
      .filter-chip img{width:26px;height:26px;object-fit:contain;flex-shrink:0}
      .filter-chip-x{background:none;border:none;cursor:pointer;color:#94a3b8;font-size:.75rem;line-height:1;padding:0 3px;display:flex;align-items:center}
      .filter-chip-x:hover{color:#dc2626}
      .filter-wrap{position:relative}
      .filter-inp{width:100%;box-sizing:border-box;padding:.5em .7em;border:1px solid rgb(var(--gray-light));border-radius:8px;font-size:.85rem;outline:none;font-family:var(--font-atkinson)}
      .filter-inp:focus{border-color:var(--accent)}
      .filter-sug{position:absolute;top:calc(100% + 2px);left:0;right:0;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,.12);z-index:200;overflow:hidden;max-height:280px;overflow-y:auto}
      .sug-item{display:flex;align-items:center;gap:8px;padding:6px 12px;cursor:pointer;font-size:.85rem;border-bottom:1px solid #f8fafc}
      .sug-item:last-child{border-bottom:none}
      .sug-item:hover,.sug-item.act{background:#fff7ed}
      .sug-item img{width:30px;height:30px;object-fit:contain;flex-shrink:0}
      .sug-item .rk{margin-left:auto;font-size:.7rem;color:rgb(var(--gray))}
      .sug-item mark{background:#fef9c3;color:inherit;border-radius:2px;padding:0 1px}
      .sug-item.added{opacity:.4;pointer-events:none}
      .sug .hd{display:flex;justify-content:space-between;align-items:center;font-weight:700;margin-bottom:.4em}
      .sc{color:var(--accent);font-weight:800}
      .role{display:inline-block;background:#eef2ff;color:#3730a3;border-radius:6px;padding:1px 6px;font-size:.7rem;margin:2px 3px 0 0}
      .stats{display:flex;flex-wrap:wrap;gap:6px;margin:.2em 0 .7em;font-size:.78rem}
      .stats span{background:rgb(var(--gray-light));border-radius:6px;padding:3px 8px}

      /* 構成カード（SimPartyCard準拠） */
      .iconrow{display:grid;grid-template-columns:repeat(6,1fr);gap:4px;margin-bottom:.5em}
      .montab{position:relative;display:flex;flex-direction:column;align-items:center;padding:.25em .1em;border:1.5px solid rgb(var(--gray-light));border-radius:8px;background:#fff;cursor:pointer;font-family:var(--font-atkinson);overflow:hidden;transition:border-color .12s,background .12s}
      .montab:hover{border-color:#94a3b8;background:#f8fafc}
      .montab.active{border-color:var(--accent);background:#eef2ff}
      .montab.core{border-color:#f59e0b;background:#fff7ed}
      .montab.core.active{border-color:var(--accent);background:#eef2ff}
      .monicon{width:40px;height:40px;object-fit:contain}
      .mname{font-size:.56rem;font-weight:700;text-align:center;color:rgb(var(--gray-dark));line-height:1.15;word-break:break-all}
      .mitem{font-size:.5rem;color:rgb(var(--gray));text-align:center;line-height:1.15}
      .mmega{position:absolute;top:2px;right:3px;font-size:.6rem;color:#b45309;font-weight:900}
      .mcore{position:absolute;top:2px;left:3px;font-size:.6rem;color:#f59e0b;font-weight:900}
      .detail{border-top:1px solid rgb(var(--gray-light));padding-top:.5em;margin-bottom:.5em}
      .dgrid{display:flex;flex-wrap:wrap;gap:.35em .8em;margin-bottom:.35em;align-items:center}
      .dcell{font-size:.82rem;display:inline-flex;align-items:center;gap:.25em}
      .drow{display:flex;align-items:flex-start;gap:.35em;margin:.35em 0}
      .lbl{display:inline-block;font-size:.62rem;font-weight:800;padding:.1em .45em;border-radius:5px;color:#fff;flex-shrink:0}
      .lbl.item{background:#0ea5e9}.lbl.abil{background:#8b5cf6}.lbl.nat{background:#f59e0b}.lbl.mv{background:#10b981}.lbl.ev{background:#64748b}
      .dval{font-weight:600;color:rgb(var(--gray-dark))}
      .mvwrap{display:inline-flex;flex-wrap:wrap;gap:.25em;align-items:center}
      .mvchip{display:inline-flex;align-items:center;gap:.15em;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:9999px;padding:.08em .5em;font-size:.72rem;font-weight:600}
      .tic{width:14px;height:14px;vertical-align:-2px}
      .iic{width:20px;height:20px;object-fit:contain;vertical-align:-5px}
      .evchip{display:inline-flex;align-items:center;gap:.1em;color:#fff;font-size:.68rem;font-weight:700;padding:.06em .5em;border-radius:5px}
      .ev-H{background:#16a34a}.ev-A{background:#dc2626}.ev-B{background:#2563eb}.ev-C{background:#7c3aed}.ev-D{background:#0d9488}.ev-S{background:#db2777}

      /* 1v1グリッド（simulator mtx準拠） */
      .bg-cc{background:#dcfce7;color:#15803d}.bg-cb{background:#d1fae5;color:#15803d}.bg-cn{background:rgb(var(--gray-light));color:rgb(var(--gray))}.bg-cw{background:#ffedd5;color:#c2410c}.bg-cx{background:#fee2e2;color:#b91c1c}
      .mg{overflow-x:auto;margin-top:.4em}
      table.mtx{font-size:.72rem;border-collapse:separate;border-spacing:2px}
      table.mtx th{font-size:.7rem;font-weight:700;padding:.2em;vertical-align:bottom;text-align:center}
      table.mtx td{text-align:center;border-radius:5px;font-weight:800;padding:.3em;min-width:34px;white-space:nowrap;font-size:.9rem}
      .mtx-ico{width:30px;height:30px;object-fit:contain;display:block;margin:0 auto}
      .mtx-name{font-size:.56rem;line-height:1.05;margin-top:1px;white-space:nowrap;color:rgb(var(--gray-dark));text-align:center}
      .mtx-corner{font-size:.56rem;color:rgb(var(--gray));text-align:center;line-height:1.15;white-space:nowrap;font-weight:700}
      .mtx-rowh{display:flex;align-items:center;gap:4px}
      .mtx-rowh .mtx-ico{width:26px;height:26px;margin:0}
      .mtx-rowh .mtx-name{margin-top:0;text-align:left}

      /* 詳細タブ */
      .tabbar{display:flex;flex-wrap:wrap;gap:4px;border-bottom:2px solid rgb(var(--gray-light));margin-top:.7em}
      .tb{border:none;background:none;padding:.5em .8em;font-size:.8rem;font-weight:700;color:rgb(var(--gray));cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;font-family:var(--font-atkinson);border-radius:6px 6px 0 0}
      .tb:hover{background:#f8fafc;color:rgb(var(--gray-dark))}
      .tb.active{color:var(--accent);border-bottom-color:var(--accent)}
      .tb b{color:inherit;font-weight:800}
      .pane{padding-top:.6em}
      table.dtl{width:100%;border-collapse:collapse;font-size:.78rem}
      table.dtl th{text-align:left;font-size:.68rem;font-weight:800;color:rgb(var(--gray));background:#f8fafc;padding:.35em .5em;border-bottom:1px solid rgb(var(--gray-light));white-space:nowrap}
      table.dtl td{padding:.3em .5em;border-bottom:1px solid #f1f5f9;vertical-align:middle}
      table.dtl tr.hole td{background:#fef2f2}
      .dtl-mem{display:inline-flex;flex-wrap:wrap;gap:2px;align-items:center}
      .dtl-mem img{width:24px;height:24px;object-fit:contain}
      .dtl-ico{width:24px;height:24px;object-fit:contain;vertical-align:-6px}
      .dtl-tname{display:inline-flex;align-items:center;gap:4px;white-space:nowrap;font-weight:700}
      .dtl-hole{color:#dc2626;font-weight:700;font-size:.74rem}
      .dtl-ok{color:#16a34a;font-weight:800}.dtl-ng{color:#dc2626;font-weight:800}

      /* マトリクス（脅威対応・タイプ相性：味方を列に） */
      table.mtx td.tc-both{background:#dcfce7}
      table.mtx td.tc-wall{background:#dbeafe}
      table.mtx td.tc-off{background:#ffedd5}
      table.mtx td.tc-none{background:#f8fafc;color:#cbd5e1}
      .tc-w{color:#1d4ed8;font-weight:800}.tc-o{color:#c2410c;font-weight:800}
      table.mtx td.df-imm{background:#99f6e4;color:#0f766e}
      table.mtx td.df-r2{background:#bbf7d0;color:#15803d}
      table.mtx td.df-r1{background:#dcfce7;color:#15803d}
      table.mtx td.df-n{background:#fff;color:#cbd5e1}
      table.mtx td.df-w1{background:#fee2e2;color:#b91c1c}
      table.mtx td.df-w2{background:#fca5a5;color:#7f1d1d}
      .tm-atk{display:inline-block;background:#c2410c;color:#fff;border-radius:3px;font-size:.54rem;font-weight:800;padding:0 2px;margin-right:2px;vertical-align:1px;line-height:1.35}
      .tm-def{font-weight:800;font-size:.74rem}
      .mtx-legend{display:flex;flex-wrap:wrap;gap:.5em .9em;font-size:.72rem;color:rgb(var(--gray-dark));margin-bottom:.4em;align-items:center}
      .mtx-legend b{padding:1px 5px;border-radius:4px}
      .mtx-legend b.lg-wall{background:#dbeafe;color:#1d4ed8}
      .mtx-legend b.lg-off{background:#ffedd5;color:#c2410c}
      .mtx-legend b.lg-w{background:#fee2e2;color:#b91c1c}
      .mtx-legend b.lg-r{background:#dcfce7;color:#15803d}
      table.mtx td.ao-good{background:#bbf7d0;color:#15803d;font-weight:800}
      table.mtx td.ao-neu{background:#fff;color:#cbd5e1}
      table.mtx td.ao-bad{background:#f1f5f9;color:#94a3b8}
      table.mtx td.ao-none{background:#f8fafc;color:#e2e8f0}
      .mtx-legend b.ao-good{background:#bbf7d0;color:#15803d}.mtx-legend b.ao-bad{background:#f1f5f9;color:#64748b}
      table.mtx th.mtx-stick{position:sticky;left:0;background:#fff;z-index:2;box-shadow:2px 0 3px -1px rgba(0,0,0,.14);width:96px;min-width:96px;max-width:96px;overflow:hidden}
      table.mtx th.mtx-stick .mtx-rowh{width:100%}
      table.mtx th.mtx-stick .mtx-rowh .mtx-ico{flex-shrink:0}
      table.mtx th.mtx-stick .mtx-name{white-space:normal;word-break:break-all;line-height:1.05;flex:1;min-width:0}
      table.mtx th.mtx-corner.mtx-stick{z-index:3}
      table.mtx th.th-hole .mtx-name{color:#dc2626}
      table.dtl.arch td{vertical-align:middle}
      .arch-lb{font-weight:700;font-size:.82rem;display:flex;flex-wrap:wrap;align-items:baseline;gap:.4em}
      .advbar{width:100px;height:12px;border-radius:6px;background:#eef2f7;overflow:hidden;display:inline-flex;vertical-align:middle}
      .advfill.sp-maybe{background:#a7f3d0}
      .sp-maybe-t{color:#0d9488;font-weight:700}
      table.mtx td.sp-win{background:#dcfce7;color:#15803d}
      table.mtx td.sp-may{background:#fef9c3;color:#a16207}
      table.mtx td.sp-lose{background:#f1f5f9;color:#94a3b8}
      .mtx-legend b.sp-win{background:#dcfce7;color:#15803d}
      .mtx-legend b.sp-may{background:#fef9c3;color:#a16207}
      .mtx-legend b.sp-lose{background:#f1f5f9;color:#64748b}
      .sp-val{font-size:.56rem;font-weight:800;color:var(--accent);white-space:nowrap}
      table.mtx td.fire-cell,table.mtx td.sp-cell,table.mtx td.mu-cell,table.mtx td.at-cell{cursor:pointer}
      table.mtx td.fire-cell:hover,table.mtx td.sp-cell:hover,table.mtx td.mu-cell:hover,table.mtx td.at-cell:hover{outline:2px solid var(--accent);outline-offset:-2px}
      .mu-dep{color:#7c3aed;font-weight:900;font-size:.6rem;vertical-align:2px}
      /* 詳細ポップアップ */
      .pop-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1000;display:flex;align-items:center;justify-content:center;padding:1em}
      .pop-card{background:#fff;border-radius:14px;box-shadow:0 12px 48px rgba(0,0,0,.25);max-width:560px;width:100%;max-height:82vh;overflow:auto;padding:1.1em 1.2em;position:relative}
      .pop-x{position:absolute;top:.6em;right:.7em;background:none;border:none;font-size:1.1rem;color:rgb(var(--gray));cursor:pointer;line-height:1}
      .pop-x:hover{color:#dc2626}
      .pop-hd{display:flex;align-items:center;gap:.4em;font-weight:800;font-size:.95rem;margin-bottom:.2em}
      .pop-hd img{width:30px;height:30px;object-fit:contain}
      .pop-hd .arw{color:rgb(var(--gray));font-weight:900}
      .pop-sub{font-size:.76rem;color:rgb(var(--gray));margin-bottom:.7em}
      table.pop-t{width:100%;border-collapse:collapse;font-size:.8rem}
      table.pop-t th{font-size:.66rem;font-weight:800;color:rgb(var(--gray));background:#f8fafc;padding:.4em .5em;border-bottom:1px solid rgb(var(--gray-light));text-align:center;white-space:nowrap}
      table.pop-t th.lft,table.pop-t td.lft{text-align:left}
      table.pop-t td{padding:.4em .5em;border-bottom:1px solid #f1f5f9;text-align:center;white-space:nowrap}
      table.pop-t td.best{background:#ecfdf5;font-weight:800}
      .pop-pct{font-weight:700}.pop-ko{font-size:.7rem;color:rgb(var(--gray))}
      .pop-col-sub{font-size:.6rem;color:rgb(var(--gray));font-weight:600;display:block}
      .pop-types{display:block;margin:2px 0}.pop-types img{width:18px;height:18px;vertical-align:middle}
      .mvchip-s{display:inline-flex;align-items:center;gap:.15em;font-weight:700}
      .spd-row{display:flex;align-items:center;gap:.6em;padding:.4em .5em;border-radius:8px;margin:.2em 0;font-size:.85rem}
      .spd-row.me{background:#eef2ff;border:1.5px solid var(--accent);font-weight:800}
      .spd-row.faster{background:#fef2f2}.spd-row.slower{background:#f0fdf4}
      .spd-row img{width:26px;height:26px;object-fit:contain;flex-shrink:0}
      .pop-t .dtl-ico{width:18px;height:18px}
      .spd-s{font-weight:800;min-width:70px}
      .spd-tag{font-size:.68rem;font-weight:800;border-radius:5px;padding:1px 6px;margin-left:auto}
      .spd-tag.t-out{background:#dcfce7;color:#15803d}.spd-tag.t-in{background:#fee2e2;color:#b91c1c}.spd-tag.t-eq{background:#f1f5f9;color:#64748b}
      .advfill{height:100%;border-radius:6px}
      .advfill.adv-good{background:#16a34a}.advfill.adv-mid{background:#f59e0b}.advfill.adv-bad{background:#dc2626}
      .advtxt{font-weight:800;font-size:.82rem;margin-left:.4em;display:inline-block;vertical-align:middle}
      .advtxt.adv-good{color:#15803d}.advtxt.adv-mid{color:#b45309}.advtxt.adv-bad{color:#b91c1c}
      table.mtx td.ko1{background:#bbf7d0;color:#15803d}table.mtx td.ko1r{background:#dcfce7;color:#15803d}
      table.mtx td.ko2{background:#fef9c3;color:#a16207}table.mtx td.ko2r{background:#fefce8;color:#a16207}
      table.mtx td.ko3,table.mtx td.ko3r{background:#f1f5f9;color:#64748b}table.mtx td.ko0{background:#f8fafc;color:#cbd5e1}
      .mtx-legend b.ko1{background:#bbf7d0;color:#15803d}.mtx-legend b.ko2{background:#fef9c3;color:#a16207}.mtx-legend b.ko0{background:#f1f5f9;color:#64748b}
      .ko-note{color:#7c3aed;font-weight:900;font-size:.6rem;vertical-align:2px;margin-left:1px}
      .sc-scarf{display:inline-block;background:#fde68a;color:#92400e;border-radius:4px;font-size:.62rem;font-weight:800;padding:0 4px;margin-left:5px;vertical-align:1px}
      .bd-box{background:#f8fafc;border:1px solid rgb(var(--gray-light));border-radius:10px;padding:.7em .9em;margin-bottom:.7em}
      .bd-title{font-size:.82rem;font-weight:700;margin-bottom:.4em}
      .bd-segs{display:flex;flex-wrap:wrap;gap:.4em 1.1em;font-size:.82rem;font-weight:700}
      .bd-seg{display:inline-flex;align-items:center;gap:.3em}
      .bd-dot{width:11px;height:11px;border-radius:3px;display:inline-block}
      .bd-net{background:#6366f1}.bd-rich{background:#f59e0b}.bd-con{background:#10b981}
      .bd-strip{display:flex;flex-wrap:wrap;align-items:center;gap:.35em .9em;font-size:.76rem;color:rgb(var(--gray-dark));background:#f8fafc;border:1px solid rgb(var(--gray-light));border-radius:8px;padding:.35em .6em;margin:0 0 .6em}
      .bd-strip .bd-lb{font-weight:800;color:rgb(var(--gray))}
      .bd-strip .bd-seg{font-weight:700}
      .sim-ctrl{display:flex;flex-wrap:wrap;gap:.6em;align-items:center;margin:.4em 0}
      select.inp{font-family:inherit}
      .soon-tag{display:inline-block;background:#e2e8f0;color:#64748b;font-size:.58rem;font-weight:800;border-radius:9999px;padding:.05em .5em;margin-left:.35em;vertical-align:1px}
      .soon-box{text-align:center;padding:2em 1em;color:rgb(var(--gray))}
      .soon-badge{display:inline-block;background:#eef2ff;color:#3730a3;font-weight:800;font-size:.9rem;border-radius:9999px;padding:.35em 1.1em;margin-bottom:.6em}
      .sim-res{display:flex;flex-wrap:wrap;align-items:center;gap:.5em;margin-top:.8em;font-size:.9rem}
      .sim-wld{font-weight:700;color:rgb(var(--gray-dark))}
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>M-3 パーティ提案</h1>
      <p class="lead">軸にしたいポケモンを指定すると、シミュレーションによりバランスの良いパーティを提案します。各ポケの役割・パーティ統計・使用率上位との1v1相性つき。</p>
      <p class="note">※ 現在は使用率上位のポケモンを軸とした提案に対応しています。使用率の低いポケモンを軸にしたパーティ提案は未対応で、今後追加予定です。</p>

      <div class="card">
        <div class="corebox">
          <div id="core-chips" class="filter-chips"></div>
          <div class="filter-wrap">
            <input type="text" id="core-filter" class="filter-inp" placeholder="軸にするポケモンを検索（ひらがな可・空欄でおまかせ）" autocomplete="off" />
            <div class="filter-sug" id="core-sug" style="display:none"></div>
          </div>
        </div>
        <div class="row" style="margin-top:.6em">
          <button id="go" class="btn">提案する</button>
        </div>
        <div id="status" class="muted" style="margin-top:.5em"></div>
      </div>
      <div id="out"></div>
      <div id="popup" class="pop-overlay" style="display:none">
        <div class="pop-card"><button class="pop-x" id="pop-x" aria-label="閉じる">✕</button><div id="pop-body"></div></div>
      </div>
    </main>
    <Footer />

    <script is:inline define:vars={{ ICONS, MOVET, NATURE, TYPEICON, ITEM_PNG }}>
      const API = /(^|\.)pokenavi\.jp$/.test(location.hostname) ? 'https://pokenavi-suggest-799947701075.asia-northeast1.run.app' : 'http://localhost:8899';
      const EVK = ['H','A','B','C','D','S'];
      const esc = s => (s||'').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      const toKatakana = s => s.replace(/[ぁ-ゖ]/g, c => String.fromCharCode(c.charCodeAt(0) + 0x60));
      const _regionalPrefix = [['ヒスイ',3],['ガラル',3],['アローラ',4]];

      function iconUrl(name){
        const n = (name||'').replace(' (','(');
        const base = n.split('(')[0].trim();
        let id = ICONS[n] || ICONS[base];
        if(!id){ for(const [p,l] of _regionalPrefix){ if(n.startsWith(p)){ id=ICONS[n.slice(l)+'('+p+')']; if(id) break; } } }
        if(!id){ const k = Object.keys(ICONS).find(kk=>kk.split('(')[0].trim()===base); if(k) id=ICONS[k]; }
        return id ? `/images/pokemon/pokemon-${id}.webp` : null;
      }
      function icoImg(name, cls){
        const u = iconUrl(name);
        return u ? `<img class="${cls}" src="${u}" alt="${esc(name)}" title="${esc(name)}" onerror="this.style.display='none'">` : '';
      }
      function typeIco(move){
        const t = MOVET[move]; const e = t ? TYPEICON[t] : null;
        return e ? `<img class="tic" src="/images/types/type-${e[0]}-${e[1]}.png" alt="${esc(t)}">` : '';
      }
      function itemIco(item){
        return ITEM_PNG[item] ? `<img class="iic" src="/images/items/${ITEM_PNG[item]}" alt="">` : '';
      }
      function evChips(ev){
        return (ev||'').split(/\s+/).filter(Boolean).map(tok=>{
          const k = tok[0], v = tok.slice(1);
          return EVK.includes(k) ? `<span class="evchip ev-${k}">${k}<b>${v}</b></span>` : '';
        }).join('');
      }
      function natDisp(na){ return na ? `${na}${NATURE[na] ? ` (${NATURE[na]})` : ''}` : '—'; }

      function detailHtml(m){
        return `<div class="dgrid">
            <div class="dcell"><span class="lbl item">持ち物</span><span class="dval">${itemIco(m.item)}${esc(m.item)||'—'}</span></div>
            <div class="dcell"><span class="lbl abil">特性</span><span class="dval">${esc(m.ability)||'—'}</span></div>
            <div class="dcell"><span class="lbl nat">性格</span><span class="dval">${esc(natDisp(m.nature))}</span></div>
          </div>
          <div class="drow"><span class="lbl mv">技</span><span class="mvwrap">${m.moves.map(x=>`<span class="mvchip">${typeIco(x)}${esc(x)}</span>`).join('')||'—'}</span></div>
          <div class="drow"><span class="lbl ev">EV</span><span class="mvwrap">${evChips(m.ev)||'—'}</span></div>
          ${(m.roles&&m.roles.length)?`<div style="margin-top:.35em">${m.roles.map(r=>`<span class="role">${esc(r)}</span>`).join('')}</div>`:''}`;
      }

      const col = c => ({'◎':'bg-cc','○':'bg-cb','△':'bg-cn','▲':'bg-cw','×':'bg-cx'}[c]||'bg-cn');
      function matchupHtml(res){
        const mu = res.matchup; if(!mu) return '';
        const head = `<tr><th class="mtx-corner mtx-stick">自分 ＼ 相手</th>` + mu.tops.map(t=>`<th>${icoImg(t.sp,'mtx-ico')}<div class="mtx-name">${esc(t.label)}</div></th>`).join('') + `</tr>`;
        const rows = mu.rows.map(rw=>{
          const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(rw.mon,'mtx-ico')}<div class="mtx-name">${esc(rw.mon)}</div></div></th>`;
          const cells = rw.cells.map((c,j)=>`<td class="${col(c.v)} mu-cell" data-mon="${esc(rw.mon)}" data-opp="${esc(mu.tops[j].sp)}">${c.v}${c.dep?'<span class="mu-dep">*</span>':''}</td>`).join('');
          return `<tr>${hd}${cells}</tr>`;
        }).join('');
        return `<div class="mtx-legend"><span>複数の想定型を踏まえたポケモン単位の相性。◎有利 ○やや有利 △五分 ▲やや不利 ×不利。<b>*</b>＝型により有利不利が変化。<b>セルをクリックで判定根拠</b>（与被ダメ・確定数・素早さ）。</span></div>
          <div class="mg"><table class="mtx">${head}${rows}</table></div>`;
      }
      function typeIcoByName(t){ const e=TYPEICON[t]; return e?`<img class="dtl-ico" src="/images/types/type-${e[0]}-${e[1]}.png" alt="${esc(t)}">`:''; }
      function memIcons(list){ return list&&list.length ? `<span class="dtl-mem">${list.map(n=>icoImg(n,'')).join('')}</span>` : ''; }

      function memRowHead(m){
        return `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(m.name,'mtx-ico')}<div class="mtx-name">${esc(m.name)}</div></div></th>`;
      }
      const DEFG = x => x===0?'0':x<=0.25?'¼':x<0.5?'½':x<1?'½':x>=4?'×4':x>1?'×2':'';
      const DEFC = x => x===0?'df-imm':x<0.5?'df-r2':x<1?'df-r1':x>=4?'df-w2':x>1?'df-w1':'df-n';
      function _typeMatrix(res, corner, cellFn, legend){
        const tm = (res.details||{}).typematrix; if(!tm) return '';
        const mem = res.mons;
        const head = `<tr><th class="mtx-corner mtx-stick">${corner}</th>` + tm.rows.map(r=>`<th title="${esc(r.type)}">${typeIcoByName(r.type)}</th>`).join('') + `</tr>`;
        const rows = mem.map((m,mi)=>`<tr>${memRowHead(m)}${tm.rows.map(r=>cellFn(r.cells[mi], m, r.type)).join('')}</tr>`).join('');
        return `${legend}<div class="mg"><table class="mtx">${head}${rows}</table></div>`;
      }
      function attackTypeHtml(res){
        const cell = (c, mon, type)=>{
          const mult = c.atk;
          const inner = mult==null?'–':(DEFG(mult)||'・');
          const cls = mult==null?'ao-none':mult>=2?'ao-good':mult===1?'ao-neu':'ao-bad';
          return `<td class="${cls} at-cell" data-mon="${esc(mon.name)}" data-type="${esc(type)}">${inner}</td>`;
        };
        return _typeMatrix(res, '自分 ＼ 攻撃', cell,
          `<div class="mtx-legend"><span>各味方が<b>そのタイプを攻撃するときの最大倍率</b>。<b class="ao-good">×2</b>=抜群で通る <b class="ao-bad">½/0</b>=通りにくい。<b>セルをクリックで技別の倍率</b>。</span></div>`);
      }
      function defenseTypeHtml(res){
        const cell = c=>`<td class="${DEFC(c.def)}">${DEFG(c.def)||'・'}</td>`;
        return _typeMatrix(res, '自分 ＼ 被弾', cell,
          `<div class="mtx-legend"><span>各味方が<b>そのタイプ技を受けるときの被弾倍率</b>。<b class="df-w1">×2/×4</b>=弱点 <b class="df-r1">½以下</b>=半減 <b class="df-imm">0</b>=無効。受けの穴が一目で分かります。</span></div>`);
      }

      function sugHtml(res, i){
        const tabs = res.mons.map((m,j)=>`<button class="montab${m.core?' core':''}${j===0?' active':''}" data-i="${i}" data-j="${j}">
            ${m.core?'<span class="mcore">◆</span>':''}${m.mega?'<span class="mmega">★</span>':''}
            ${icoImg(m.name,'monicon')}
            <span class="mname">${esc(m.name)}</span>
            <span class="mitem">${esc(m.item)||'—'}</span>
          </button>`).join('');
        const _skip = {'脅威対応率':1,'攻撃カバー':1,'防御相補':1};
        const st = res.stats ? `<div class="stats">${Object.entries(res.stats).filter(([k])=>!_skip[k]).map(([k,v])=>`<span><b>${esc(k)}</b> ${esc(String(v))}</span>`).join('')}</div>` : '';
        const dt = res.details || {};
        const tm = dt.typematrix;
        const arch = res.archetypes;
        const avgAdv = arch&&arch.length ? Math.round(arch.reduce((s,x)=>s+x.adv,0)/arch.length*100) : null;
        const tbar = `<div class="tabbar">
            <button class="tb active" data-i="${i}" data-t="atktype">攻撃相性</button>
            <button class="tb" data-i="${i}" data-t="deftype">防御相性</button>
            <button class="tb" data-i="${i}" data-t="mu">ポケモン相性</button>
            <button class="tb" data-i="${i}" data-t="speed">素早さ</button>
            <button class="tb" data-i="${i}" data-t="arch">想定パーティ相性</button>
            <button class="tb" data-i="${i}" data-t="sim">実戦テスト<span class="soon-tag">準備中</span></button>
          </div>`;
        return `<div class="card sug" data-sug="${i}">
          <div class="hd"><span>提案 ${i+1}</span></div>
          ${st}
          <div class="iconrow">${tabs}</div>
          <div class="detail" id="det-${i}">${detailHtml(res.mons[0])}</div>
          ${tbar}
          <div class="pane" id="pane-${i}">${attackTypeHtml(res)}</div>
        </div>`;
      }
      function archetypeHtml(res){
        const a = res.archetypes; if(!a||!a.length) return '<div class="muted">評価データがありません</div>';
        const rows = a.slice().sort((x,y)=>y.adv-x.adv).map(x=>{
          const pct = Math.round(x.adv*100);
          const cls = pct>=55?'adv-good':pct<45?'adv-bad':'adv-mid';
          const opp = x.opp.map(n=>icoImg(n,'dtl-ico')).join('');
          return `<tr>
            <td><div class="arch-lb">${esc(x.label)}</div><div class="dtl-mem">${opp}</div></td>
            <td><div class="advbar"><div class="advfill ${cls}" style="width:${pct}%"></div></div><div class="advtxt ${cls}">${pct}%</div></td></tr>`;
        }).join('');
        return `<div class="mtx-legend"><span>いくつかの構築に対してAI同士の対戦シミュレーションから想定勝率を算出。</span></div>
          <table class="dtl arch"><tr><th>対戦相手</th><th>想定勝率</th></tr>${rows}</table>`;
      }
      function firepowerHtml(res){
        const fp = res.firepower; if(!fp) return '';
        const head = `<tr><th class="mtx-corner mtx-stick">自分 ＼ 相手</th>` + fp.tops.map(t=>`<th>${icoImg(t.sp,'mtx-ico')}<div class="mtx-name">${esc(t.label)}</div></th>`).join('') + `</tr>`;
        const rows = fp.rows.map(r=>{
          const cells = r.cells.map((c,j)=>{
            const tip = 'クリックで技×相手型の内訳' + (c.move?'（想定 '+c.move+'）':'');
            return `<td class="${c.cls} fire-cell" data-mon="${esc(r.mon)}" data-opp="${esc(fp.tops[j].sp)}" title="${esc(tip)}">${c.lab}${c.note?'<span class="ko-note">*</span>':''}</td>`;
          }).join('');
          return `<tr>${memRowHead({name:r.mon})}${cells}</tr>`;
        }).join('');
        return `<div class="mtx-legend"><span>各味方の<b>最大打点技</b>で上位30体を落とす手数（実数値・持ち物込み）。<b class="ko1">確1</b>=確定1発 <b class="ko2">確2</b>。<b>確2〜確3</b>のような幅は<b>相手の型（耐久振り等）による差</b>。<b>*</b>=ばけのかわ/がんじょう/タスキ考慮。<b>セルをクリックで技×型の内訳</b>。</span></div>
          <div class="mg"><table class="mtx">${head}${rows}</table></div>`;
      }
      const SPSYM = {win:'◎', may:'△', lose:'×'};
      function speedHtml(res){
        const sp = res.speed; if(!sp) return '';
        const head = `<tr><th class="mtx-corner mtx-stick">自分 ＼ 相手</th>` + sp.tops.map(t=>`<th>${icoImg(t.sp,'mtx-ico')}<div class="mtx-name">${esc(t.label)}</div></th>`).join('') + `</tr>`;
        const rows = sp.rows.map(r=>{
          const hd = `<th class="mtx-stick"><div class="mtx-rowh">${icoImg(r.mon,'mtx-ico')}<div class="mtx-name">${esc(r.mon)}<br><span class="sp-val">S${r.spd}${r.scarf?'⚡':''}</span></div></div></th>`;
          const cells = r.cells.map((c,j)=>`<td class="${col(SPSYM[c])} sp-cell" data-mon="${esc(r.mon)}" data-opp="${esc(sp.tops[j].sp)}">${SPSYM[c]}</td>`).join('');
          return `<tr>${hd}${cells}</tr>`;
        }).join('');
        return `<div class="mtx-legend"><span>味方（左・素早さ順）が上位30体より速いか（スカーフ込み）。<b class="bg-cc">◎</b>＝相手の全型より速い <b class="bg-cn">△</b>＝型次第で前後 <b class="bg-cx">×</b>＝全型より遅い。<b>セルをクリックで相手型別Sの内訳</b>。</span></div>
          <div class="mg"><table class="mtx">${head}${rows}</table></div>`;
      }
      function simHtml(res, i){
        const a = res.archetypes||[];
        const opts = a.map((x,k)=>`<option value="${k}">${esc(x.label)}</option>`).join('');
        return `<div class="mtx-legend"><span>提案パーティを<b>実際にMCTSで対戦</b>させ、勝敗を集計します。価値ネット＋探索で戦う本物のシミュレーションです（数十秒）。</span></div>
          <div class="sim-ctrl">
            <label class="muted">相手 <select class="inp sim-opp" data-i="${i}">${opts}</select></label>
            <label class="muted">試合数 <input class="inp sim-k" data-i="${i}" type="number" value="6" min="2" max="20" style="width:64px"></label>
            <button class="btn sim-run" data-i="${i}">実戦テスト実行</button>
          </div>
          <div class="sim-out" id="sim-out-${i}"></div>`;
      }
      async function runSim(i){
        const res = LAST[i];
        const opp = +document.querySelector(`.sim-opp[data-i="${i}"]`).value;
        const k = +document.querySelector(`.sim-k[data-i="${i}"]`).value;
        const btn = document.querySelector(`.sim-run[data-i="${i}"]`); btn.disabled=true;
        const out = document.getElementById('sim-out-'+i);
        out.innerHTML = `<div class="muted" style="margin-top:.6em">対戦中…（${k}戦・数十秒）</div>`;
        try{
          const r = await fetch(API+'/simulate',{method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({specs:res.specs, opp_idx:opp, k})});
          const d = await r.json();
          if(d.error){ out.innerHTML='<div class="muted">エラー: '+esc(d.error)+'</div>'; btn.disabled=false; return; }
          const pct=Math.round(d.wr*100); const cls=pct>=55?'adv-good':pct<45?'adv-bad':'adv-mid';
          out.innerHTML = `<div class="sim-res"><b>${esc(d.label)}</b> と ${d.k}戦
            <div class="advbar" style="width:160px"><div class="advfill ${cls}" style="width:${pct}%"></div></div>
            <span class="advtxt ${cls}">勝率 ${pct}%</span>
            <span class="sim-wld">${d.wins}勝 ${d.losses}敗${d.draws?' '+d.draws+'分':''}</span></div>`;
        }catch(e){ out.innerHTML='<div class="muted">提案サーバに接続できません</div>'; }
        btn.disabled=false;
      }
      function paneHtml(res, t, i){
        if(t==='deftype') return defenseTypeHtml(res);
        if(t==='mu') return matchupHtml(res);
        if(t==='speed') return speedHtml(res);
        if(t==='arch') return archetypeHtml(res);
        if(t==='sim') return `<div class="soon-box"><div class="soon-badge">Coming Soon</div><div class="muted">より深い対戦をシミュレーションし、動かし方などを提案する機能は現在準備中です。</div></div>`;
        return attackTypeHtml(res);
      }

      // 詳細ポップアップ（火力セル→技×型、素早さセル→型別S）
      function popShow(html){ document.getElementById('pop-body').innerHTML=html; document.getElementById('popup').style.display='flex'; }
      function popHide(){ document.getElementById('popup').style.display='none'; }
      function suggOf(el){ const c=el.closest('.sug'); return c?LAST[+c.dataset.sug]:null; }
      function fireDetailHtml(d){
        const cols = d.cols.map(c=>`<th>型${c.idx}<span class="pop-types">${typeIcoByName(c.t1)}${c.t2?typeIcoByName(c.t2):''}</span><span class="pop-col-sub">${esc(c.item)}<br>${esc(c.ev)}<br>${esc(c.ability)}</span></th>`).join('');
        const rows = d.rows.map(r=>{
          const cells = r.cells.map(c=>`<td class="${c.best?'best':''}">${c.best?'★':''}<span class="pop-pct">${esc(c.pct)}</span><br><span class="pop-ko">${esc(c.ko)}${c.note?'・'+esc(c.note):''}</span></td>`).join('');
          return `<tr><td class="lft"><span class="mvchip-s">${typeIcoByName(r.type)}${esc(r.move)}</span></td>${cells}</tr>`;
        }).join('');
        return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(d.mon)}<span class="arw">→</span>${icoImg(d.opp,'')}${esc(d.opp)}</div>
          <div class="pop-sub">自分の攻撃技（行）× 相手の想定型（列）の与ダメ％／確定数。★＝その型への最大打点。</div>
          <div style="overflow-x:auto"><table class="pop-t"><tr><th class="lft">技</th>${cols}</tr>${rows}</table></div>`;
      }
      function speedDetailHtml(d){
        const items = d.builds.map(b=>({s:b.s, mine:false, item:b.item, ev:b.ev, idx:b.idx, scarf:b.scarf}));
        items.push({s:d.my_s, mine:true, scarf:d.my_scarf});
        items.sort((a,b)=>b.s-a.s);
        const rows = items.map(it=>{
          if(it.mine) return `<div class="spd-row me">${icoImg(d.mon,'')}<span class="spd-s">S${it.s}${it.scarf?'⚡':''}</span><span>あなた（${esc(d.mon)}）</span></div>`;
          const cmp = d.my_s>it.s?'out':(d.my_s<it.s?'in':'eq');
          const tag = cmp==='out'?'<span class="spd-tag t-out">抜ける</span>':cmp==='in'?'<span class="spd-tag t-in">抜かれる</span>':'<span class="spd-tag t-eq">同速</span>';
          const cls = cmp==='out'?'slower':(cmp==='in'?'faster':'');
          return `<div class="spd-row ${cls}">${icoImg(d.opp,'')}<span class="spd-s">S${it.s}${it.scarf?'⚡':''}</span><span>型${it.idx} ${esc(it.item)} ${esc(it.ev)}</span>${tag}</div>`;
        }).join('');
        return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(d.mon)}<span class="arw">vs</span>${icoImg(d.opp,'')}${esc(d.opp)}</div>
          <div class="pop-sub">相手の想定型のS実数値（速い順）。あなたの行より下＝抜ける／上＝抜かれる。</div>${rows}`;
      }
      function matchupDetailHtml(d){
        const cols = d.cols.map(c=>`<th>型${c.idx}<span class="pop-types">${typeIcoByName(c.t1)}${c.t2?typeIcoByName(c.t2):''}</span><span class="pop-col-sub">${esc(c.item)}<br>${esc(c.nature)}<br>${esc(c.ev)}</span></th>`).join('');
        const dmgRow = (lab, arr) => `<tr><td class="lft">${lab}</td>${arr.map(c=>`<td><span class="pop-pct">${esc(c.pct)}</span> <span class="pop-ko">${esc(c.ko)}</span><br><span class="pop-ko">${esc(c.move)}</span></td>`).join('')}</tr>`;
        const spRow = `<tr><td class="lft">素早さ</td>${d.spd.map(c=>`<td class="${c.fast?'sp-win':'sp-lose'}">${esc(c.txt)}</td>`).join('')}</tr>`;
        const jRow = `<tr><td class="lft">判定</td>${d.judge.map(c=>`<td class="${col(c.v)}"><b style="font-size:1.05em">${c.v}</b><br><span class="pop-ko">${esc(c.txt)}</span></td>`).join('')}</tr>`;
        return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(d.mon)}<span class="arw">vs</span>${icoImg(d.opp,'')}${esc(d.opp)}</div>
          <div class="pop-sub">相手の想定型別に、互いの最大打点1発の確定数・素早さ・勝敗判定（タスキ/がんじょう/ばけのかわ考慮）。</div>
          <div style="overflow-x:auto"><table class="pop-t"><tr><th class="lft"> </th>${cols}</tr>${dmgRow('与ダメ（自→相）',d.me)}${dmgRow('被ダメ（相→自）',d.op)}${spRow}${jRow}</table></div>`;
      }
      function atkDetailHtml(d){
        const EFF = e=>e>=2?'×2':e===1?'×1':e===0?'無効':e<=0.25?'¼':'½';
        const CLR = e=>e>=2?'#15803d':e===1?'#64748b':'#dc2626';
        const rows = d.moves.map(m=>{
          const val = m.atk ? `<span style="font-weight:800;color:${CLR(m.eff)}">${EFF(m.eff)}</span>` : '<span class="muted">変化技</span>';
          return `<tr><td class="lft"><span class="mvchip-s">${typeIcoByName(m.type)}${esc(m.name)}</span></td><td>${val}</td></tr>`;
        }).join('');
        return `<div class="pop-hd">${icoImg(d.mon,'')}${esc(d.mon)}<span class="arw">→</span>${typeIcoByName(d.type)}${esc(d.type)}</div>
          <div class="pop-sub">${esc(d.mon)}の各技が <b>${esc(d.type)}</b>タイプに対して何倍か（×2=抜群 ½=半減 無効=0倍）。</div>
          <table class="pop-t"><tr><th class="lft">技</th><th>${esc(d.type)}への倍率</th></tr>${rows}</table>`;
      }
      async function openAtkDetail(el){
        const res = suggOf(el); if(!res) return;
        popShow('<div class="muted" style="padding:1em">計算中…</div>');
        try{
          const d = await fetch(API+'/atk_detail', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({specs:res.specs, mon:el.dataset.mon, type:el.dataset.type})}).then(r=>r.json());
          popShow(atkDetailHtml(d));
        }catch(e){ popShow('<div class="muted" style="padding:1em">取得に失敗しました</div>'); }
      }
      async function openDetail(el, kind){
        const res = suggOf(el); if(!res) return;
        const body = {specs:res.specs, mon:el.dataset.mon, opp:el.dataset.opp};
        popShow('<div class="muted" style="padding:1em">計算中…</div>');
        try{
          const d = await fetch(API+'/'+kind, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)}).then(r=>r.json());
          const render = {fire_detail:fireDetailHtml, speed_detail:speedDetailHtml, matchup_detail:matchupDetailHtml}[kind];
          popShow(render(d));
        }catch(e){ popShow('<div class="muted" style="padding:1em">取得に失敗しました</div>'); }
      }
      document.getElementById('pop-x').addEventListener('click', popHide);
      document.getElementById('popup').addEventListener('click', e=>{ if(e.target.id==='popup') popHide(); });
      document.addEventListener('keydown', e=>{ if(e.key==='Escape') popHide(); });
      document.addEventListener('click', e=>{
        const fc=e.target.closest('.fire-cell'); if(fc){ openDetail(fc,'fire_detail'); return; }
        const sc=e.target.closest('.sp-cell'); if(sc){ openDetail(sc,'speed_detail'); return; }
        const mc=e.target.closest('.mu-cell'); if(mc){ openDetail(mc,'matchup_detail'); return; }
        const ac=e.target.closest('.at-cell'); if(ac){ openAtkDetail(ac); return; }
      });

      let LAST = [];
      function bindTabs(){
        document.querySelectorAll('.montab').forEach(btn=>{
          btn.addEventListener('click', ()=>{
            const i = +btn.dataset.i, j = +btn.dataset.j;
            document.querySelectorAll(`.montab[data-i="${i}"]`).forEach(b=>b.classList.toggle('active', +b.dataset.j===j));
            document.getElementById('det-'+i).innerHTML = detailHtml(LAST[i].mons[j]);
          });
        });
        document.querySelectorAll('.tb').forEach(btn=>{
          btn.addEventListener('click', ()=>{
            const i = +btn.dataset.i, t = btn.dataset.t;
            document.querySelectorAll(`.tb[data-i="${i}"]`).forEach(b=>b.classList.toggle('active', b.dataset.t===t));
            document.getElementById('pane-'+i).innerHTML = paneHtml(LAST[i], t, i);
          });
        });
      }

      // コア選択（アイコン付きサジェスト・ひらがな対応・メガ/X/Y指定・チップでストック）
      let SPECIES = [];   // {label, sp, mega, id, icon, rank}
      let CORE = [];      // 同上
      let _sugActive = -1;
      const vid = v => v.sp + '' + (v.mega==null?'*':v.mega);

      fetch(API + '/species').then(r=>r.json()).then(d=>{
        SPECIES = d.map(v=>({label:v.label, sp:v.sp, mega:v.mega, id:vid(v), icon:iconUrl(v.sp), rank:v.rank}));
      }).catch(()=>{});

      function renderCoreChips(){
        const el = document.getElementById('core-chips');
        el.innerHTML = CORE.map(p=>`<span class="filter-chip" title="${esc(p.label)}">${p.icon?`<img src="${p.icon}" alt="${esc(p.sp)}">`:''}${esc(p.label)}<button class="filter-chip-x" data-id="${esc(p.id)}">✕</button></span>`).join('');
        el.querySelectorAll('.filter-chip-x').forEach(b=>b.addEventListener('click',()=>removeCore(b.dataset.id)));
        document.getElementById('core-filter').placeholder = CORE.length ? 'さらに追加…（ひらがな可）' : '軸にするポケモンを検索（ひらがな可・空欄でおまかせ）';
      }
      function addCore(id){
        const v = SPECIES.find(s=>s.id===id);
        if(v && !CORE.some(p=>p.id===id)) CORE.push(v);
        const inp = document.getElementById('core-filter'); inp.value=''; inp.focus();
        document.getElementById('core-sug').style.display='none'; _sugActive=-1;
        renderCoreChips();
      }
      function removeCore(id){ CORE = CORE.filter(p=>p.id!==id); renderCoreChips(); }

      function hlSug(text, q){ const qk=toKatakana(q); const t=qk!==q?qk:q; const i=text.indexOf(t); if(i<0) return esc(text); return esc(text.slice(0,i))+'<mark>'+esc(text.slice(i,i+t.length))+'</mark>'+esc(text.slice(i+t.length)); }
      function onFilterInput(val){
        const sug = document.getElementById('core-sug'); _sugActive=-1;
        const q = val.trim(); if(!q){ sug.style.display='none'; return; }
        const qk = toKatakana(q);
        const hits = SPECIES.filter(s=>s.label.includes(q)||s.label.includes(qk)).slice(0,12);
        if(!hits.length){ sug.innerHTML='<div class="sug-item added">該当なし</div>'; sug.style.display='block'; return; }
        sug.innerHTML = hits.map((s,i)=>{
          const already = CORE.some(p=>p.id===s.id);
          const rk = (s.rank && s.rank<9999) ? `<span class="rk">使用${s.rank}位</span>` : '';
          return `<div class="sug-item${already?' added':''}" data-id="${esc(s.id)}" data-idx="${i}">${s.icon?`<img src="${s.icon}" alt="">`:''}<span>${hlSug(s.label,q)}</span>${rk}</div>`;
        }).join('');
        sug.querySelectorAll('.sug-item[data-id]').forEach(el=>el.addEventListener('click',()=>{ if(!el.classList.contains('added')) addCore(el.dataset.id); }));
        sug.style.display='block';
      }
      function onFilterKey(e){
        const sug = document.getElementById('core-sug');
        const items = [...sug.querySelectorAll('.sug-item[data-id]:not(.added)')];
        if(sug.style.display==='none') return;
        if(e.key==='ArrowDown'){ e.preventDefault(); _sugActive=Math.min(_sugActive+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('act',i===_sugActive)); }
        else if(e.key==='ArrowUp'){ e.preventDefault(); _sugActive=Math.max(_sugActive-1,0); items.forEach((el,i)=>el.classList.toggle('act',i===_sugActive)); }
        else if(e.key==='Enter'){ e.preventDefault(); if(_sugActive>=0&&items[_sugActive]) addCore(items[_sugActive].dataset.id); else if(items.length===1) addCore(items[0].dataset.id); }
        else if(e.key==='Escape'){ sug.style.display='none'; _sugActive=-1; }
      }
      document.getElementById('core-filter').addEventListener('input', e=>onFilterInput(e.target.value));
      document.getElementById('core-filter').addEventListener('keydown', onFilterKey);
      document.addEventListener('click', e=>{ if(!e.target.closest('.filter-wrap')) document.getElementById('core-sug').style.display='none'; });

      async function run(){
        const core = CORE.map(p=>({sp:p.sp, mega:p.mega}));
        const go = document.getElementById('go'); go.disabled = true;
        document.getElementById('status').textContent = '生成・評価中…（10〜20秒）';
        document.getElementById('out').innerHTML = '';
        try{
          const r = await fetch(API + '/suggest', {method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({core, ncand:100, top:5})});
          const d = await r.json();
          if(d.error){ document.getElementById('status').textContent = 'エラー: ' + d.error; go.disabled=false; return; }
          LAST = d.results;
          document.getElementById('status').textContent = (d.fixed.length? '固定軸: ' + d.fixed.join(' + ') + ' / ' : '') + d.results.length + '件';
          document.getElementById('out').innerHTML = d.results.map((res,i)=>sugHtml(res,i)).join('');
          bindTabs();
        }catch(e){ document.getElementById('status').textContent = '提案サーバに接続できません（scripts/product3_server.py を起動してください）'; }
        go.disabled = false;
      }
      document.getElementById('go').addEventListener('click', run);
    </script>
  </body>
</html>
