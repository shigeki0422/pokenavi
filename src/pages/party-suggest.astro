---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PartySuggestApp from '../components/PartySuggestApp.astro';

const title = 'ポケモンチャンピオンズM-4 軸から簡単構築(パーティ提案) | 軸から最適構築を自動生成';
const description = 'ポケモンチャンピオンズM-4対応。軸にしたいポケモンを指定するだけで環境に合った6匹を自動提案。各ポケの役割・選出ガイド・使用率TOP30との1v1相性をAIシミュレーション結果から診断。';
const siteUrl = 'https://pokenavi.jp';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ポケナビ 軸から簡単構築',
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  url: siteUrl + '/party-suggest/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  author: { '@type': 'Organization', name: 'ポケナビ', url: siteUrl },
};
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <PartySuggestApp />
    <div style="max-width:860px;margin:0 auto;padding:0 1.2rem 3rem;text-align:center">
      <p style="font-size:.85rem;color:rgb(var(--gray));margin-bottom:.6rem">6匹が決まったら細かい型を調整したい方へ</p>
      <a href="/party-builder/" style="display:inline-flex;align-items:center;gap:.5rem;padding:.55rem 1.4rem;background:rgb(var(--accent));color:#fff;border-radius:8px;text-decoration:none;font-weight:700;font-size:.9rem">
        パーティ工房で型を微調整する →
      </a>
    </div>
    <Footer />
  </body>
</html>
