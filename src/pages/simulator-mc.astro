---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SimulatorApp from '../components/SimulatorApp.astro';
import ToolPageNotes from '../components/ToolPageNotes.astro';

const title = 'M-Cシミュレーター（M-6環境） | 勝率・選出・1v1相性を診断';
const description = 'ポケモンチャンピオンズM-6上位環境の使用率・型に合わせて生成した100パーティの総当たり対戦シミュレーション。勝率・選出率・ポケモン1v1相性・リプレイをAI対戦結果から分析。';
const siteUrl = 'https://pokenavi.jp';

const faqs = [
  {
    q: 'この対戦データは何ですか。',
    a: 'M-6 上位環境を再現したパーティ同士を、対戦AIに操作させて総当たりで戦わせた結果です。人間同士の対戦記録ではなく、同じ条件で繰り返し戦わせたシミュレーションです。',
  },
  {
    q: 'ここに並ぶパーティは M-6 の上位構築ですか。',
    a: 'M-6 の上位構築そのものではありません。M-6 上位環境の使用率・型の統計に合わせて生成した100パーティで、その100パーティ同士を総当たりさせた結果です。',
  },
  {
    q: '勝率はどう読めばいいですか。',
    a: '同じ2つのパーティを複数回戦わせた結果の集計です。相性がはっきり出る組み合わせほど偏った数字になります。50%前後は「選出と立ち回り次第」と読むのが実態に近く、パーティ同士の優劣が確定しているわけではありません。',
  },
  {
    q: '1v1相性表の色と数字は何ですか。',
    a: '各マスは自分の1体と相手の1体が最大火力で殴り合った場合の評価です。数字は1発あたりの与ダメージと被ダメージの割合で、緑は自分が勝つ組み合わせ、赤は相手が勝つ組み合わせを表します。倒すのに必要な手数が少ない方が勝ち、手数が同じなら素早さが速い方が勝ちます。きあいのタスキ・がんじょう・先制技も考慮しています。',
  },
  {
    q: 'リプレイでは何が分かりますか。',
    a: '実際のシミュレーション結果をターンごとに再生できます。各手番でAIがどの技を候補に挙げ、どれを本命と読んだかも表示されるため、「なぜその選択になったか」を追えます。',
  },
  {
    q: '自分のパーティで試せますか。',
    a: 'このページは収録済みのパーティ同士の対戦結果を見るためのものです。自分の構築を数値で詰めたい場合はパーティ工房、軸から組み立てたい場合は軸から簡単構築をお使いください。',
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ポケナビ M-Cシミュレーター',
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  url: siteUrl + '/simulator-mc/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  author: { '@type': 'Organization', name: 'ポケナビ', url: siteUrl },
};
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <SimulatorApp mode="MC">
      <ToolPageNotes faqs={faqs}>
        <h2>このページで分かること</h2>
        <p>M-6 上位環境の使用率・型に合わせて生成した100パーティを対戦AIで総当たりさせた結果を、収録済みのデータから閲覧できます。<strong>M-6 環境でどのポケモン・型がどう振る舞うか</strong>を先に知ることができます。</p>
        <ul>
          <li><strong>勝率</strong> — 選んだパーティが、環境を再現した他のパーティに対してどこまで通用するか</li>
          <li><strong>選出傾向</strong> — 6匹のうち実際に選ばれやすいのはどの3匹か</li>
          <li><strong>1v1相性表</strong> — 個体同士の噛み合いを、与ダメージと被ダメージの数値付きで一覧</li>
          <li><strong>リプレイ</strong> — 実際の対戦をターンごとに再生。AIがその手番で何を読んだかも確認できます</li>
        </ul>

        <h2>結果の読み方</h2>
        <p>勝率だけを見てパーティの優劣を決めないでください。シミュレーションは同じ条件で繰り返した平均であり、実戦では選出と読み合いで結果が動きます。次のような見方が実用的です。</p>
        <table>
          <thead><tr><th>見たいこと</th><th>見る場所</th></tr></thead>
          <tbody>
            <tr><td>このパーティの弱点</td><td>VSパーティを勝率順に並べ、負け越している相手の共通点を探す</td></tr>
            <tr><td>特定のポケモンへの強さ</td><td>VSポケモンで、そのポケモンが選出された対戦の勝敗を見る</td></tr>
            <tr><td>勝ち筋・負け筋</td><td>対戦サマリの「残りやすい主軸」「落ちやすい自個体」</td></tr>
          </tbody>
        </table>
        <p>1v1相性表は最大火力で殴り合った想定の事前計算です。交代・積み技・補助技を絡めた実戦の流れまでは表現していないため、リプレイと併せて確認すると実態に近づきます。</p>
      </ToolPageNotes>
    </SimulatorApp>
    <Footer />
  </body>
</html>
