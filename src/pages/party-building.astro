---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolPageNotes from '../components/ToolPageNotes.astro';
import rankingData from '../data/ranking.json';

const title = 'ポケモンチャンピオンズ AI構築ツール | 軸から自動生成・パーティ工房';
const description = 'ポケモンチャンピオンズのAIパーティ構築ツール2種。軸ポケモンから残り5枠を自動生成する「軸から簡単構築」と、1v1相性を見ながら6匹の型を微調整できる「パーティ工房」。';
const siteUrl = 'https://pokenavi.jp';

/** シーズン名・集計規模はranking.jsonから引く(固定値だと更新のたびに古くなる)。 */
const seasons = (rankingData as any).seasons as Record<string, { dates: string[]; pokemon: unknown[] }>;
const seasonKey = Object.keys(seasons).sort().at(-1)!;
const season = seasons[seasonKey];
const speciesCount = season.pokemon.length;
const latestDate = [...season.dates].sort().at(-1)!;
const fmtDate = (d: string) => { const [, m, dd] = d.split('-'); return `${parseInt(m)}月${parseInt(dd)}日`; };

const faqs = [
  {
    q: 'どちらのツールを使えばいいですか。',
    a: '軸にしたいポケモンだけ決まっていて残り5枠が白紙なら「軸から簡単構築」、6匹はすでに決まっていて型を詰めたいなら「パーティ工房」です。まず簡単構築でたたき台を作り、工房で仕上げる流れが基本になります。',
  },
  {
    q: '提案や判定は何を根拠にしていますか。',
    a: `ポケモンチャンピオンズの実際の対戦データ(シーズン${seasonKey}・${speciesCount}体)から集計した技・持ち物・特性・性格・EVの採用率と同居率をもとに、各ポケモンの主流型を再現し、対戦シミュレーションで評価しています。想像で組んだ型ではなく、実際に使われている型が基準です。`,
  },
  {
    q: 'データはいつ更新されますか。',
    a: `使用率ランキングは毎日更新しています(最新の集計日は${fmtDate(latestDate)})。シーズンが変わると提案の基準も新シーズンのデータに切り替わります。`,
  },
  {
    q: '作ったパーティは保存されますか。',
    a: 'パーティ工房で組んだパーティはお使いのブラウザ内に保存されます。端末間の同期はないため、別の端末で使う場合はエクスポート機能をお使いください。',
  },
  {
    q: '提案されたパーティをそのまま使えば勝てますか。',
    a: '提案は「環境全体に対してバランスが取れた構成」を示すものです。実際の勝敗は選出と立ち回りに大きく左右されるため、たたき台として使い、想定する相手に合わせてパーティ工房で調整することをおすすめします。',
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ポケナビ パーティ構築',
  description,
  url: siteUrl + '/party-building/',
  isPartOf: { '@type': 'WebSite', name: 'ポケナビ', url: siteUrl },
  hasPart: [
    {
      '@type': 'SoftwareApplication',
      name: '軸から簡単構築',
      url: siteUrl + '/party-suggest/',
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'パーティ工房',
      url: siteUrl + '/party-builder/',
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web',
    },
  ],
};
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      main { max-width: 900px; margin: 0 auto; padding: 2em 1.2em 4em; color: rgb(var(--gray-dark)); }
      h1 { font-size: 1.7rem; margin: 0 0 .5em; }
      .lead { color: rgb(var(--gray)); font-size: .96rem; line-height: 1.8; margin: 0 0 1.8em; max-width: 640px; }
      .cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
      }
      @media (max-width: 720px) {
        .cards { grid-template-columns: 1fr; }
      }
      .card {
        display: flex;
        flex-direction: column;
        border: 1px solid rgb(var(--gray-light));
        border-radius: 12px;
        padding: 1.4rem 1.3rem;
        background: #fff;
        transition: box-shadow .15s, border-color .15s;
      }
      .card:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.08); border-color: rgb(var(--gray)); }
      .card-head { display: flex; align-items: center; gap: .5em; margin-bottom: .4em; flex-wrap: wrap; }
      .card h2 { font-size: 1.15rem; margin: 0; color: rgb(var(--black)); }
      .badge {
        font-size: .62rem;
        font-weight: 700;
        background: #fef3c7;
        color: #b45309;
        border-radius: 9999px;
        padding: .15em .6em;
        letter-spacing: .02em;
      }
      .card .for-whom {
        font-size: .82rem;
        font-weight: 700;
        color: var(--accent);
        margin: .2em 0 .6em;
      }
      .card p.desc { font-size: .9rem; line-height: 1.75; margin: 0 0 .6em; flex-grow: 1; }
      .card ul { margin: 0 0 1em; padding-left: 1.2em; font-size: .85rem; line-height: 1.7; color: rgb(var(--gray-dark)); }
      .cta {
        display: inline-block;
        text-align: center;
        padding: .7em 1.4em;
        background: var(--accent);
        color: #fff;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 700;
        font-size: .92rem;
        margin-top: auto;
      }
      .cta:hover { background: var(--accent-dark); }
      .usage-tip {
        margin-top: 1.8rem;
        background: #eef2ff;
        border-left: 3px solid var(--accent);
        border-radius: 8px;
        padding: .9em 1.1em;
        font-size: .88rem;
        line-height: 1.7;
        color: rgb(var(--gray-dark));
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>パーティ構築</h1>
      <p class="lead">ポケモンチャンピオンズのパーティ構築を支援する、AIシミュレーションに裏付けられた2つのツールです。目的に合わせて使い分けることで、たたき台づくりから細かな詰めまでをカバーできます。</p>

      <div class="cards">
        <div class="card">
          <div class="card-head">
            <h2>軸から簡単構築</h2>
          </div>
          <p class="for-whom">まず全体像がほしい人向け</p>
          <p class="desc">軸にしたいポケモンを1体決めるだけで、AIが環境に合った残り5枠を自動提案します。</p>
          <ul>
            <li>相性・素早さ関係を考慮した自動提案</li>
            <li>選出ガイド付き</li>
            <li>使用率TOP30との1v1相性を診断</li>
          </ul>
          <a class="cta" href="/party-suggest">軸から簡単構築を使う →</a>
        </div>

        <div class="card">
          <div class="card-head">
            <h2>パーティ工房</h2>
            <span class="badge">NEW</span>
          </div>
          <p class="for-whom">自分の構築を日々詰めたい人向け</p>
          <p class="desc">6匹の型（持ち物・特性・性格・EV・技）を1ポイント単位で自由に微調整できます。</p>
          <ul>
            <li>仮想敵との素早さ比較・1v1判定</li>
            <li>与ダメ・被ダメをリアルタイム表示</li>
            <li>パーティ保存・提案・EV逆算</li>
          </ul>
          <a class="cta" href="/party-builder">パーティ工房を使う →</a>
        </div>
      </div>

      <p class="usage-tip">まず「軸から簡単構築」でたたき台を作り、「パーティ工房」で仮想敵に合わせて詰めるのがおすすめです。</p>

    <ToolPageNotes faqs={faqs}>
        <h2>どちらを使うか</h2>
        <p>2つのツールは、構築のどの段階にいるかで使い分けます。迷ったら、いま手元に「何が決まっているか」で選んでください。</p>
        <table>
          <thead>
            <tr><th>いまの状態</th><th>使うツール</th><th>できること</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>軸1体だけ決まっている</td>
              <td>軸から簡単構築</td>
              <td>残り5枠を自動で埋め、各ポケモンの役割と選出の指針まで提示します。</td>
            </tr>
            <tr>
              <td>6匹は決まっている</td>
              <td>パーティ工房</td>
              <td>持ち物・特性・性格・EV・技を1ポイント単位で調整し、与ダメージと被ダメージの変化をその場で確認できます。</td>
            </tr>
            <tr>
              <td>特定の相手に勝てない</td>
              <td>パーティ工房</td>
              <td>仮想敵を指定して素早さ実数値を比較し、1v1で有利を取れるかを判定します。</td>
            </tr>
          </tbody>
        </table>

        <h2>提案と判定の根拠</h2>
        <p>どちらのツールも、想像で組んだ型ではなく<strong>実際に使われている型</strong>を基準にしています。シーズン{seasonKey}の対戦データから{speciesCount}体分を集計し、次の項目をポケモンごとに保持しています。</p>
        <ul>
          <li><strong>技・持ち物・特性・性格・EV</strong> — それぞれの採用率を上位から集計。主流型の再現に使います</li>
          <li><strong>同居率</strong> — どのポケモンと一緒に使われているか。提案時の並びの自然さに反映されます</li>
          <li><strong>種族値・タイプ相性・メガシンカ後の数値</strong> — 実数値計算と1v1判定の土台です</li>
        </ul>
        <p>1v1判定は、両者の主流型の実数値をもとに、素早さの先後・最大打点技・相手を倒すのに必要な攻撃回数を計算しています。きあいのタスキやがんじょうも考慮します。交代や補助技は含まないため、あくまで「正面からぶつかった場合」の事前計算として使ってください。</p>

        <h3>使う前に知っておくこと</h3>
        <p>使用率ランキングは毎日更新しており、最新の集計日は{fmtDate(latestDate)}です。シーズンが変わると、提案の基準も自動的に新シーズンのデータへ切り替わります。</p>

    </ToolPageNotes>
    </main>
    <Footer />
  </body>
</html>
