---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import rankingData from '../data/ranking.json';
import { getCollection } from 'astro:content';

const NAME_MAP: Record<string, string> = {
  'イダイトウ(オス)': 'イダイトウ (オス)',
  'イダイトウ(メス)': 'イダイトウ（メス）',
  'アローラキュウコン': 'キュウコン（アローラ）',
  'フラエッテ(永遠)': 'フラエッテ（永遠）',
  'ヒスイゾロアーク': 'ゾロアーク（ヒスイ）',
  'ヒスイウインディ': 'ウインディ（ヒスイ）',
  'ヒスイヌメルゴン': 'ヌメルゴン（ヒスイ）',
  'ヒスイバクフーン': 'バクフーン（ヒスイ）',
  'ガラルヤドラン': 'ヤドラン（ガラル）',
  'ガラルヤドキング': 'ヤドキング（ガラル）',
  'ルガルガン(昼)': 'ルガルガン（まひる）',
  'ルガルガン(たそがれ)': 'ルガルガン（たそがれ）',
  'ルガルガン(まよなか)': 'ルガルガン（まよなか）',
  'ニャオニクス(オス)': 'ニャオニクス（オス）',
  'ニャオニクス(メス)': 'ニャオニクス（メス）',
  'ケンタロス:水': 'ケンタロス（水）',
  'ケンタロス:炎': 'ケンタロス（炎）',
  'ケンタロス:格': 'ケンタロス（格）',
  'ヒスイクレベース': 'クレベース（ヒスイ）',
  'ヒスイジュナイパー': 'ジュナイパー（ヒスイ）',
  'ガラルマッギョ': 'マッギョ（ガラル）',
  'ヒスイダイケンキ': 'ダイケンキ（ヒスイ）',
  'アローラライチュウ': 'ライチュウ（アローラ）',
};

const showDrafts = import.meta.env.INCLUDE_DRAFTS === 'true';
const pokemonPages = await getCollection('pokemon', p => showDrafts || !p.data.draft);
const pageById: Record<string, string> = {};
for (const p of pokemonPages) {
  pageById[p.data.pokemonName] = p.id;
}

const { dates, pokemon } = rankingData as {
  dates: string[];
  pokemon: { name: string; id: string | null; dates: Record<string, { rank: number; rate: number | null }> }[];
};

const fmtDate = (d: string) => {
  const [, m, day] = d.split('-');
  return `${parseInt(m)}/${parseInt(day)}`;
};

const pageTitle = 'ポケモンチャンピオンズ 使用率ランキング';
const pageDesc = 'ポケモンチャンピオンズ シングルバトルの使用率ランキング推移。日付ごとの順位変動をまとめて確認できます。';
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={pageTitle} description={pageDesc} imageUrl="/og-image.png" />
    <style>
      main { max-width: 1100px; margin: auto; padding: 1em 1.5em; overflow-x: hidden; }
      h1 { font-size: 1.5rem; margin-bottom: 0.3rem; }
      .subtitle { color: #64748b; font-size: 0.88rem; margin-bottom: 1.2rem; }

      .table-wrap { overflow-x: auto; }
      table { border-collapse: collapse; width: 100%; font-size: 0.88rem; white-space: nowrap; }
      th { background: #f1f5f9; padding: 8px 10px; border: 1px solid #cbd5e1; text-align: center; font-weight: 600; color: #475569; }
      th.col-pokemon { text-align: left; min-width: 140px; }
      td { border: 1px solid #e2e8f0; padding: 6px 10px; text-align: center; vertical-align: middle; }
      td.col-rank { font-weight: 700; color: #dc2626; width: 44px; }
      td.col-pokemon { text-align: left; }
      tr:hover td { background: #f8fafc; }
      tr:nth-child(1) td.col-rank { color: #b45309; }
      tr:nth-child(2) td.col-rank { color: #6b7280; }
      tr:nth-child(3) td.col-rank { color: #92400e; }

      .poke-cell { display: flex; align-items: center; gap: 8px; text-decoration: none; color: inherit; }
      .poke-cell:hover .poke-name { text-decoration: underline; }
      .poke-cell img { width: 36px; height: 36px; flex-shrink: 0; }
      .poke-name { font-weight: 600; }

      .rate-cell { position: relative; }
      .rate-bar-bg { position: absolute; left: 0; top: 0; bottom: 0; background: #dbeafe; z-index: 0; }
      .rate-val { position: relative; z-index: 1; font-weight: 600; }
      .rank-val { color: #374151; }

      .delta-up { color: #16a34a; font-size: 0.75em; }
      .delta-down { color: #dc2626; font-size: 0.75em; }
      .delta-same { color: #94a3b8; font-size: 0.75em; }

      .new-badge { font-size: 0.65em; background: #fef08a; color: #854d0e; padding: 1px 5px; border-radius: 4px; font-weight: 700; }

      .pager { margin: 12px 0; }
      .pager-inner { display: flex; flex-wrap: wrap; gap: 6px; }
      .pager-btn { padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; cursor: pointer; font-size: 0.85rem; color: #374151; }
      .pager-btn:hover { background: #f1f5f9; }
      .pager-btn.active { background: #3b82f6; color: #fff; border-color: #3b82f6; font-weight: 700; }

      @media (max-width: 600px) {
        html, body { overflow-x: hidden; }
        main { padding: 0.5em; width: 100%; box-sizing: border-box; }
        .pager-inner { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; max-width: 100%; }
        .pager-btn { flex-shrink: 0; padding: 6px 8px; font-size: 0.78rem; white-space: nowrap; }
        table, table th, table td { white-space: normal !important; }
        .poke-cell img { width: 28px; height: 28px; }
        th, td { padding: 5px 6px; font-size: 0.85rem; }
        th.col-pokemon { min-width: 0; }
        .poke-name { font-size: 0.85rem; }
        .col-date-old { display: none; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>使用率ランキング</h1>
      <p class="subtitle">シングルバトル　最終更新：{fmtDate(dates[dates.length - 1])}　全{pokemon.length}件</p>

      <div class="pager" id="pager"></div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:44px">順位</th>
              <th class="col-pokemon">ポケモン</th>
              {dates.map((d, i) => (
                <th class={i < dates.length - 1 ? 'col-date-old' : ''}>{fmtDate(d)}{i === dates.length - 1 ? ' 最新' : ''}</th>
              ))}
            </tr>
          </thead>
          <tbody id="ranking-tbody">
            {pokemon.map((p) => {
              const latestDate = dates[dates.length - 1];
              const latestData = p.dates[latestDate];
              const currentRank = latestData?.rank ?? '–';
              const imgSrc = p.id ? `/images/pokemon/pokemon-${p.id}.webp` : null;
              const lookupName = NAME_MAP[p.name] ?? p.name;
              const pokemonUrl = pageById[lookupName] ? `/pokemon/${pageById[lookupName]}/` : null;

              return (
                <tr>
                  <td class="col-rank">{currentRank}</td>
                  <td class="col-pokemon">
                    {pokemonUrl ? (
                      <a class="poke-cell" href={pokemonUrl}>
                        {imgSrc && <img src={imgSrc} alt={p.name} loading="lazy" />}
                        <span class="poke-name">{p.name}</span>
                      </a>
                    ) : (
                      <div class="poke-cell">
                        {imgSrc && <img src={imgSrc} alt={p.name} loading="lazy" />}
                        <span class="poke-name">{p.name}</span>
                      </div>
                    )}
                  </td>
                  {dates.map((d, di) => {
                    const data = p.dates[d];
                    const isOld = di < dates.length - 1;
                    if (!data) return <td class={isOld ? 'col-date-old' : ''}>–</td>;

                    const prevDate = di > 0 ? dates[di - 1] : null;
                    const prevData = prevDate ? p.dates[prevDate] : null;
                    const rankDelta = prevData ? prevData.rank - data.rank : null;

                    let deltaEl = null;
                    if (rankDelta !== null) {
                      if (rankDelta > 0) deltaEl = <span class="delta-up">▲{rankDelta}</span>;
                      else if (rankDelta < 0) deltaEl = <span class="delta-down">▼{Math.abs(rankDelta)}</span>;
                      else deltaEl = <span class="delta-same">–</span>;
                    }

                    return (
                      <td class={isOld ? 'col-date-old' : ''}>
                        <span class="rank-val">{data.rank}位</span>{' '}
                        {deltaEl}
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div class="pager" id="pager-bottom"></div>
    </main>
    <Footer />
    <script>
      const PAGE_SIZE = 50;
      const rows = Array.from(document.querySelectorAll<HTMLElement>('#ranking-tbody tr'));
      let currentPage = 1;
      const totalPages = Math.ceil(rows.length / PAGE_SIZE);

      function renderPage(page: number) {
        currentPage = page;
        rows.forEach((row, i) => {
          row.style.display = (i >= (page - 1) * PAGE_SIZE && i < page * PAGE_SIZE) ? '' : 'none';
        });
        renderPagers();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function renderPagers() {
        const html = buildPagerHtml();
        document.getElementById('pager')!.innerHTML = html;
        document.getElementById('pager-bottom')!.innerHTML = html;
        document.querySelectorAll('.pager-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const p = parseInt((btn as HTMLElement).dataset.page!);
            if (!isNaN(p)) renderPage(p);
          });
        });
      }

      function buildPagerHtml(): string {
        const pages: string[] = [];
        for (let p = 1; p <= totalPages; p++) {
          const active = p === currentPage;
          pages.push(`<button class="pager-btn${active ? ' active' : ''}" data-page="${p}">${(p-1)*PAGE_SIZE+1}–${Math.min(p*PAGE_SIZE, rows.length)}位</button>`);
        }
        return `<div class="pager-inner">${pages.join('')}</div>`;
      }

      renderPage(1);
    </script>
  </body>
</html>
