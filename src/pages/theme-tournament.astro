---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import data from '../data/theme_tournament_M-3.json';

const title = '【M-3】テーマパーティ総当たり勝率ランキング | ポケナビ';
const description = `戦略テーマ別パーティ${data.n}構築をAI対戦エンジン（MCTS@${data.mcts_sims}）で総当たり（各ペア1戦・計${data.total_games}戦）。勝率順にランキングし、構築ごとの勝敗・対戦相性をデータで可視化します。`;

const ranked = data.order.map((i: number, rk: number) => ({ ...data.parties[i], idx: i, rank: rk + 1 }));

function parseSpec(s: string) {
  const name = s.split('@')[0].split(':')[0];
  const item = s.includes('@') ? s.split('@')[1].split(':')[0] : '';
  const f = s.split(':');
  const nature = f.length > 1 ? f[1] : '';
  const moves = f.length > 2 && f[2] ? f[2].split('|') : [];
  return { name, item, nature, moves };
}
const detail = data.parties.map((p: any) => p.specs.map(parseSpec));
const themes = data.parties.map((p: any) => p.theme);
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
    <style>
      main { width: auto; max-width: 920px; margin: 0 auto; padding: 1.4em 1em 4em; color: rgb(var(--gray-dark)); }
      h1 { font-size: 1.5rem; margin: 0 0 .3em; }
      .lead { font-size: .88rem; color: rgb(var(--gray)); margin: 0 0 1em; line-height: 1.6; }
      .note { font-size: .78rem; color: rgb(var(--gray)); background: rgb(var(--gray-light)); border-radius: 8px; padding: .6em .8em; margin: 0 0 1.2em; line-height: 1.55; }
      .row { display: grid; grid-template-columns: 2.2rem 1fr; gap: .5rem; align-items: center;
             background: #fff; border: 1px solid rgb(var(--gray-light)); border-radius: 10px; padding: .6em .7em; margin-bottom: .5em; cursor: pointer; transition: box-shadow .15s; }
      .row:hover { box-shadow: 0 2px 8px rgba(var(--black), .08); }
      .rank { font-size: 1.1rem; font-weight: 800; text-align: center; color: rgb(var(--gray)); }
      .rank.top { color: var(--accent); }
      .main { min-width: 0; }
      .toprow { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
      .theme { font-weight: 700; font-size: .95rem; }
      .wr { font-weight: 800; font-size: .95rem; color: var(--accent); }
      .wld { font-size: .78rem; color: rgb(var(--gray)); }
      .bar { height: 7px; border-radius: 9999px; background: rgb(var(--gray-light)); overflow: hidden; margin: .35em 0; }
      .fill { height: 100%; border-radius: 9999px; background: linear-gradient(90deg, #60a5fa, var(--accent)); }
      .icons { display: flex; flex-wrap: wrap; gap: .1rem; }
      .icons img { width: 38px; height: 38px; image-rendering: -webkit-optimize-contrast; }
      .icons .ph { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; font-size: .55rem; color: rgb(var(--gray)); background: rgb(var(--gray-light)); border-radius: 6px; }
      .detail { display: none; grid-column: 1 / -1; margin-top: .5em; border-top: 1px dashed rgb(var(--gray-light)); padding-top: .6em; }
      .detail.open { display: block; }
      .mon { font-size: .8rem; margin-bottom: .35em; line-height: 1.45; }
      .mon b { font-weight: 700; }
      .mon .mv { color: rgb(var(--gray)); }
      .mon .it { color: #b45309; }
      .mxh { font-size: .8rem; font-weight: 700; margin: .7em 0 .3em; }
      .mlist { display: flex; flex-wrap: wrap; gap: .25rem; }
      .chip { font-size: .72rem; padding: .12em .5em; border-radius: 6px; white-space: nowrap; }
      .chip.w { background: #dcfce7; color: #15803d; }
      .chip.l { background: #fee2e2; color: #b91c1c; }
      .chip.d { background: rgb(var(--gray-light)); color: rgb(var(--gray)); }
      .seg { display:flex; gap:.4rem; margin:.3em 0 .1em; }
      .seg button { font-size:.74rem; padding:.2em .7em; border:1px solid rgb(var(--gray-light)); background:#fff; border-radius:6px; cursor:pointer; }
      .seg button.on { background: var(--accent); color:#fff; border-color: var(--accent); }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>テーマパーティ総当たり勝率ランキング<span style="font-size:.9rem;color:rgb(var(--gray))"> （{data.season}）</span></h1>
      <p class="lead">
        戦略テーマ別の{data.n}構築を、対戦AI（探索MCTS@{data.mcts_sims}）で総当たり対戦させた結果です。
        全{data.total_games}戦（各ペア1戦・3体選出）の勝率で順位付けしています。行をタップすると構成と対戦相性を表示します。
      </p>
      <p class="note">
        ⚠️ 各ペア<b>1戦のみ</b>の暫定結果です。ポケモン対戦は乱数（命中・急所・選出）を含むため、1戦の勝敗にはブレがあります。傾向の把握用としてご覧ください（対戦数は今後拡張予定）。
      </p>

      <div id="board">
        {ranked.map((p: any) => (
          <div class="row" data-idx={p.idx}>
            <div class={`rank${p.rank <= 3 ? ' top' : ''}`}>{p.rank}</div>
            <div class="main">
              <div class="toprow">
                <span class="theme">{p.theme}</span>
                <span class="wr">{(p.winrate * 100).toFixed(1)}%</span>
                <span class="wld">{p.wins}勝 {p.losses}敗{p.draws ? ` ${p.draws}分` : ''}</span>
              </div>
              <div class="bar"><div class="fill" style={`width:${(p.winrate * 100).toFixed(1)}%`}></div></div>
              <div class="icons">
                {p.mons.map((m: any) => (
                  m.id
                    ? <img src={`/images/pokemon/pokemon-${m.id}.webp`} alt={m.name} title={m.name} loading="lazy" />
                    : <span class="ph">{m.name}</span>
                ))}
              </div>
            </div>
            <div class="detail" data-detail={p.idx}></div>
          </div>
        ))}
      </div>
    </main>
    <Footer />

    <script define:vars={{ detail, themes, grid: data.parties.map((p: any) => p.row), order: data.order }}>
      const rankOf = {};
      order.forEach((idx, rk) => { rankOf[idx] = rk + 1; });

      function buildDetail(idx) {
        const mons = detail[idx];
        let html = '';
        for (const m of mons) {
          html += `<div class="mon"><b>${m.name}</b>`;
          if (m.item) html += ` <span class="it">@${m.item}</span>`;
          if (m.nature) html += ` <span class="mv">${m.nature}</span>`;
          if (m.moves.length) html += `<br><span class="mv">${m.moves.join(' / ')}</span>`;
          html += `</div>`;
        }
        const wins = [], losses = [];
        const r = grid[idx];
        for (let j = 0; j < r.length; j++) {
          if (j === idx) continue;
          if (r[j] === 'W') wins.push(j);
          else if (r[j] === 'L') losses.push(j);
        }
        const byRank = (a, b) => (rankOf[a] || 999) - (rankOf[b] || 999);
        wins.sort(byRank); losses.sort(byRank);
        const chips = (arr, cls) => arr.length
          ? `<div class="mlist">${arr.map(j => `<span class="chip ${cls}">${themes[j]}</span>`).join('')}</div>`
          : `<div class="mv" style="font-size:.76rem">なし</div>`;
        html += `<div class="mxh" style="color:#15803d">勝った相手 (${wins.length})</div>${chips(wins, 'w')}`;
        html += `<div class="mxh" style="color:#b91c1c">負けた相手 (${losses.length})</div>${chips(losses, 'l')}`;
        return html;
      }

      document.querySelectorAll('.row').forEach(row => {
        row.addEventListener('click', () => {
          const idx = +row.dataset.idx;
          const d = row.querySelector('.detail');
          const open = d.classList.contains('open');
          if (!open && !d.dataset.built) { d.innerHTML = buildDetail(idx); d.dataset.built = '1'; }
          d.classList.toggle('open');
        });
      });
    </script>
  </body>
</html>
