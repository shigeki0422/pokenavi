---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const showDrafts = import.meta.env.INCLUDE_DRAFTS === 'true';
const allPosts = (await getCollection('blog'))
	.filter((post) => showDrafts || !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postsTotal = allPosts.length;
const posts = allPosts.slice(0, 6);   // ホームは最新6件まで（全件は /blog）

const allPokemonPages = (await getCollection('pokemon'))
	.filter((p) => showDrafts || !p.data.draft)
	.sort((a, b) => (a.data.usageRank ?? 999) - (b.data.usageRank ?? 999));
const pokemonPages = allPokemonPages.slice(0, 10);
const pokemonTotal = allPokemonPages.length;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pokenavi.jp';
const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	url: siteUrl,
	logo: { '@type': 'ImageObject', url: siteUrl + '/logo-mark.png' },
	description: SITE_DESCRIPTION,
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} imageUrl="/og-image.png" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
		<style>
			.hero {
				text-align: center;
				padding: 3rem 1rem 2.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				margin-bottom: 2.5rem;
			}
			.hero h1 {
				font-size: 2.5rem;
				margin: 0 0 0.75rem;
				line-height: 1.2;
			}
			.hero p {
				font-size: 1.1rem;
				color: rgb(var(--gray));
				margin: 0;
			}
			.section-title {
				font-size: 1.25rem;
				font-weight: 700;
				margin: 0 0 1.5rem;
				padding-bottom: 0.5rem;
				border-bottom: 2px solid rgb(var(--accent));
				color: rgb(var(--black));
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 0.75rem);
			}
			ul li a {
				display: block;
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				width: 100%;
				border-radius: 12px;
				margin-bottom: 0.5rem;
			}
			.title {
				margin: 0 0 0.25rem;
				color: rgb(var(--black));
				font-size: 1rem;
				line-height: 1.4;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
			ul li a:hover .title {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.bs-feature {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.6rem 1.8rem;
				background: linear-gradient(135deg, #f5f7ff, #ffffff);
				box-shadow: 0 1px 4px rgba(0,0,0,0.05);
			}
			.bs-feature h3 { margin: 0 0 0.5rem; font-size: 1.2rem; color: rgb(var(--black)); }
			.bs-feature p { margin: 0 0 1.1rem; color: rgb(var(--gray)); font-size: 0.95rem; line-height: 1.7; }
			.bs-points { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.2rem; padding: 0; list-style: none; }
			.bs-points li { width: auto; background: #eef2ff; color: var(--accent-dark); font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 9999px; }
			.bs-cta-row { display: flex; gap: 0.7rem; flex-wrap: wrap; }
			.bs-cta { display: inline-block; padding: 0.6rem 1.3rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.9rem; }
			.bs-cta.primary { background: var(--accent); color: #fff; }
			.bs-cta.primary:hover { background: var(--accent-dark); }
			.bs-cta.ghost { background: #fff; border: 1px solid var(--accent); color: var(--accent); }
			.bs-cta.ghost:hover { background: #eef2ff; }
			@media (max-width: 720px) {
				.hero h1 { font-size: 1.75rem; }
				ul li { width: 100%; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>データで読み解くポケモン対戦</h1>
				<p>対戦シミュレーション・使用率・パーティ構成をデータの観点で分析します</p>
			</section>

			<section style="margin-bottom:3rem">
				<h2 class="section-title">バトルシミュレータ <span style="font-size:0.8rem;font-weight:400;color:rgb(var(--accent));margin-left:6px">注目機能</span></h2>
				<div class="bs-feature">
					<h3>学習AI同士の対戦で、パーティの強さをデータ診断</h3>
					<p>自己対戦で学習した対戦AIに先読み探索を組み合わせ、選んだパーティを全ランカーと総当たり。勝率・選出・1v1相性・実戦リプレイを「感覚」ではなく「対戦データ」で確認できます。</p>
					<ul class="bs-points">
						<li>全ランカー総当たり</li>
						<li>勝ち筋・負け筋の分析</li>
						<li>1v1相性表</li>
						<li>対戦リプレイ</li>
					</ul>
					<div class="bs-cta-row">
						<a class="bs-cta primary" href="/simulator">上位環境シミュレーションを使う →</a>
						<a class="bs-cta ghost" href="/battle-simulator">バトルシミュレータとは →</a>
					</div>
				</div>
			</section>

			<section style="margin-bottom:3rem">
				<h2 class="section-title">ポケモン情報 <span style="font-size:0.8rem;font-weight:400;color:rgb(var(--gray));margin-left:6px">使用率 TOP10</span></h2>
				<div style="position:relative">
					<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px">
						{pokemonPages.map((p) => (
							<a href={`/pokemon/${p.id}/`} style="display:block;text-decoration:none;border:1px solid #e2e8f0;border-radius:8px;padding:10px 6px;text-align:center;transition:box-shadow 0.2s" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow=''">
								<img
									src={`/images/pokemon/pokemon-${String(p.data.dexNumber).padStart(4,'0')}-${p.data.imageForm ?? '00'}.webp`}
									alt={p.data.pokemonName}
									style="width:64px;height:64px;display:block;margin:0 auto 4px"
									loading="eager"
									width="64"
									height="64"
								/>
								<div style="font-size:0.72rem;font-weight:bold;color:rgb(var(--gray));margin-bottom:1px">{p.data.usageRank}位</div>
								<div style="font-size:0.75rem;font-weight:bold;color:rgb(var(--black))">{p.data.pokemonName}</div>
							</a>
						))}
					</div>
					<div style="position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(to bottom,transparent,white);pointer-events:none"></div>
				</div>
				<div style="text-align:center;margin-top:8px">
					<a href="/pokemon/" style="display:inline-block;padding:10px 28px;background:var(--accent);color:white;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:700;transition:opacity 0.2s" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
						すべて見る（全{pokemonTotal}件）→
					</a>
				</div>
			</section>

			<section>
				<h2 class="section-title">考察記事 <span style="font-size:0.8rem;font-weight:400;color:rgb(var(--gray));margin-left:6px">最新{posts.length}件</span></h2>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h3 class="title">{post.data.title}</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				<div style="text-align:center;margin-top:8px">
					<a href="/blog/" style="display:inline-block;padding:10px 28px;background:var(--accent);color:white;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:700;transition:opacity 0.2s" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
						すべて見る（全{postsTotal}件）→
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
