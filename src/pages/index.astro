---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import articleMeta from '../data/article-meta.json';
import rankingData from '../data/ranking.json';

const TYPE_COLOR: Record<string, string> = {
	'ノーマル':'#9da0aa','ほのお':'#f87c3f','みず':'#4fa4e0','くさ':'#5abf5a',
	'でんき':'#f5c344','こおり':'#70cdd8','かくとう':'#c44d4d','どく':'#a55fa5',
	'じめん':'#c9a84c','ひこう':'#8899ee','エスパー':'#f75587','むし':'#a4b700',
	'いわ':'#b8a038','ゴースト':'#7b6fbe','ドラゴン':'#7766ee','あく':'#6e5f5c',
	'はがね':'#aaaac0','フェアリー':'#f4a8c6',
};

const showDrafts = import.meta.env.INCLUDE_DRAFTS === 'true';
const allPosts = (await getCollection('blog'))
	.filter((post) => showDrafts || !post.data.draft)
	.sort((a, b) => {
		const ma = (articleMeta as any)[a.id];
		const mb = (articleMeta as any)[b.id];
		return (ma?.rank ?? 999) - (mb?.rank ?? 999);
	});
const m4Posts = allPosts.filter((p) => p.id.includes('-m4')).slice(0, 6);
const m3Posts = allPosts.filter((p) => p.id.includes('-m3'));
const m3PostsTotal = m3Posts.length;
const m3PostsPreview = m3Posts.slice(0, 3);
const m2Posts = allPosts.filter((p) => p.id.includes('-m2'));
const m2PostsTotal = m2Posts.length;
const m2PostsPreview = m2Posts.slice(0, 3);

const allPokemonPages = (await getCollection('pokemon'))
	.filter((p) => showDrafts || !p.data.draft)
	.sort((a, b) => (a.data.usageRank ?? 999) - (b.data.usageRank ?? 999));
const pokemonPages = allPokemonPages.slice(0, 10);
const pokemonTotal = allPokemonPages.length;

const rSeasons = (rankingData as any).seasons as Record<string, { dates: string[]; pokemon: { name: string; id: string | null; dates: Record<string, { rank: number }> }[] }>;
const rSeasonKey = Object.keys(rSeasons).sort().at(-1)!;
const rSeason = rSeasons[rSeasonKey];
const rFirstD = rSeason.dates[0];
const rLastD = rSeason.dates[rSeason.dates.length - 1];
const fmtMD = (d: string) => { const [, m, dd] = d.split('-'); return `${parseInt(m)}/${parseInt(dd)}`; };
const pokeUrlByName: Record<string, string> = {};
for (const p of allPokemonPages) {
	if (p.data.pokemonName) pokeUrlByName[p.data.pokemonName] = `/pokemon/${p.id}/`;
}
const rMovers = rSeason.pokemon.flatMap((p) => {
	const cur = p.dates[rLastD]?.rank;
	const prev = p.dates[rFirstD]?.rank;
	if (!cur || cur > 50 || !prev || prev === cur) return [];
	return [{ name: p.name, id: p.id, cur, prev, diff: prev - cur, url: pokeUrlByName[p.name] ?? null }];
});
const risers = [...rMovers].sort((a, b) => b.diff - a.diff).slice(0, 3).filter(m => m.diff > 0);
const fallers = [...rMovers].sort((a, b) => a.diff - b.diff).slice(0, 3).filter(m => m.diff < 0);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pokenavi.jp';
const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	url: siteUrl,
	logo: { '@type': 'ImageObject', url: siteUrl + '/logo-mark.png' },
	description: SITE_DESCRIPTION,
};

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: siteUrl,
	potentialAction: {
		'@type': 'SearchAction',
		target: { '@type': 'EntryPoint', urlTemplate: siteUrl + '/pokemon/?q={search_term_string}' },
		'query-input': 'required name=search_term_string',
	},
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} imageUrl="/og-image.png" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
		<style>
			.hero {
				text-align: center;
				padding: 3rem 1rem 2.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				margin-bottom: 2.5rem;
			}
			.hero h1 {
				font-size: 2.5rem;
				margin: 0 0 0.75rem;
				line-height: 1.2;
			}
			.hero p {
				font-size: 1.1rem;
				color: rgb(var(--gray));
				margin: 0;
			}
			.section-title {
				font-size: 1.25rem;
				font-weight: 700;
				margin: 0 0 1.5rem;
				color: rgb(var(--black));
			}
			.category-block {
				margin-bottom: 3.5rem;
				scroll-margin-top: 76px;
			}
			.category-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.6rem 0.9rem;
				margin-bottom: 1.6rem;
				padding: 0.6rem 1rem 0.6rem 0.9rem;
				border-bottom: none;
				background: #eef2ff;
				border-left: 3px solid var(--accent);
				border-radius: 0 8px 8px 0;
			}
			.category-title {
				font-size: 1.6rem;
				font-weight: 800;
				margin: 0;
				color: rgb(var(--black));
			}
			.category-lead {
				margin: 0;
				font-size: 0.92rem;
				color: rgb(var(--gray));
			}
			.beta-badge {
				font-size: 0.75rem;
				font-weight: 700;
				background: #fef3c7;
				color: #b45309;
				padding: 2px 8px;
				border-radius: 9999px;
				margin-left: 8px;
				vertical-align: middle;
			}
			.qn-wrap {
				margin: 0 0 2.5rem;
			}
			.qn-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.9rem;
				list-style: none;
				padding: 0;
			}
			.qn-tile {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				gap: 0.3rem;
				width: auto;
				padding: 1rem 0.6rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				background: #fff;
				text-decoration: none;
				box-shadow: 0 1px 4px rgba(0,0,0,0.05);
				transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
			}
			.qn-tile:hover {
				box-shadow: 0 4px 14px rgba(0,0,0,0.1);
				border-color: var(--accent);
				transform: translateY(-2px);
			}
			.qn-icon {
				font-size: 1.6rem;
				line-height: 1;
			}
			.qn-verb {
				font-size: 1.15rem;
				font-weight: 800;
				color: rgb(var(--black));
			}
			.qn-lead {
				font-size: 0.76rem;
				color: rgb(var(--gray));
				line-height: 1.4;
			}
			.qn-badge-new {
				position: absolute;
				top: 8px;
				right: 8px;
				font-size: 0.62rem;
				font-weight: 800;
				background: #fef3c7;
				color: #b45309;
				padding: 1px 6px;
				border-radius: 9999px;
			}
			.cta-banner {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.75rem 1.8rem;
				background: var(--accent);
				color: #fff;
				border-radius: 9999px;
				text-decoration: none;
				font-weight: 700;
				font-size: 1rem;
				box-shadow: 0 2px 8px rgba(99,102,241,0.3);
				transition: opacity 0.2s;
			}
			.cta-banner:hover {
				opacity: 0.88;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 0.75rem);
			}
			ul li a {
				display: block;
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				width: 100%;
				border-radius: 12px;
				margin-bottom: 0.5rem;
			}
			.title {
				margin: 0 0 0.25rem;
				color: rgb(var(--black));
				font-size: 1rem;
				line-height: 1.4;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
			ul li a:hover .title {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.bs-feature {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.6rem 1.8rem;
				background: linear-gradient(135deg, #f5f7ff, #ffffff);
				box-shadow: 0 1px 4px rgba(0,0,0,0.05);
			}
			.bs-feature h3 { margin: 0 0 0.5rem; font-size: 1.2rem; color: rgb(var(--black)); }
			.bs-feature p { margin: 0 0 1.1rem; color: rgb(var(--gray)); font-size: 0.95rem; line-height: 1.7; }
			.bs-points { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.2rem; padding: 0; list-style: none; }
			.bs-points li { width: auto; background: #eef2ff; color: var(--accent-dark); font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 9999px; }
			@media (max-width: 640px) { .bs-points { display: none; } }
			.bs-cta-row { display: flex; gap: 0.7rem; flex-wrap: wrap; }
			.bs-cta { display: inline-block; padding: 0.6rem 1.3rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.9rem; }
			.bs-cta.primary { background: var(--accent); color: #fff; }
			.bs-cta.primary:hover { background: var(--accent-dark); }
			.bs-cta.ghost { background: #fff; border: 1px solid var(--accent); color: var(--accent); }
			.bs-cta.ghost:hover { background: #eef2ff; }
			@media (max-width: 720px) {
				.hero { padding: 1.75rem 1rem 1.5rem; }
				.hero h1 { font-size: 1.6rem; margin-bottom: 0.5rem; }
				.hero p { font-size: 1rem; }
				ul li { width: 100%; }
				.qn-grid { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
				.qn-tile { padding: 0.8rem 0.5rem; }
				.qn-icon { font-size: 1.4rem; }
				.qn-verb { font-size: 1.02rem; }
				.qn-lead { font-size: 0.7rem; }
			}
			html {
				scroll-behavior: smooth;
			}

			/* 環境変動ウィジェット */
			.trend-widget {
				max-width: 900px;
				margin: 0 auto 2rem;
				padding: 0 1em;
			}
			.tw-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 0.6rem; flex-wrap: wrap; }
			.tw-head h2 { font-size: 1rem; font-weight: 700; margin: 0; }
			.tw-period { font-size: 0.75rem; font-weight: 600; color: #94a3b8; margin-left: 8px; }
			.tw-more { font-size: 0.8rem; font-weight: 700; color: var(--accent, #f97316); text-decoration: none; white-space: nowrap; }
			.tw-more:hover { text-decoration: underline; }
			.tw-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
			.tw-col { border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; padding: 8px 10px; }
			.tw-col-label { font-size: 0.72rem; font-weight: 700; margin-bottom: 4px; }
			.tw-col-label.tw-up { color: #059669; }
			.tw-col-label.tw-down { color: #dc2626; }
			.tw-row { display: flex; align-items: center; gap: 8px; padding: 4px 2px; text-decoration: none; color: inherit; border-radius: 6px; }
			a.tw-row:hover { background: #f8fafc; }
			.tw-row img { width: 36px; height: 36px; object-fit: contain; flex-shrink: 0; }
			.tw-name { font-size: 0.82rem; font-weight: 700; color: #1e293b; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.tw-rank { font-size: 0.75rem; color: #64748b; margin-left: auto; white-space: nowrap; }
			.tw-rank strong { color: #1e293b; }
			.tw-diff { font-size: 0.75rem; font-weight: 700; white-space: nowrap; }
			.tw-diff.tw-up { color: #059669; }
			.tw-diff.tw-down { color: #dc2626; }
			@media (max-width: 720px) {
				.tw-cols { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>データで読み解くポケモン対戦</h1>
				<p>対戦シミュレーション・使用率・パーティ構成をデータの観点で分析します</p>
				<GlobalSearch variant="hero" />
			</section>

			{(risers.length > 0 || fallers.length > 0) && (
				<section class="trend-widget" aria-label="環境変動">
					<div class="tw-head">
						<h2>📈 環境変動<span class="tw-period">{fmtMD(rFirstD)}→{fmtMD(rLastD)}・使用率TOP50</span></h2>
						<a href="/trends/" class="tw-more">変動ランキングを見る →</a>
					</div>
					<div class="tw-cols">
						{risers.length > 0 && (
							<div class="tw-col">
								<div class="tw-col-label tw-up">急上昇</div>
								{risers.map(m => {
									const inner = (
										<>
											{m.id && <img src={`/images/pokemon/pokemon-${m.id}.webp`} alt={m.name} width="36" height="36" loading="lazy" />}
											<span class="tw-name">{m.name}</span>
											<span class="tw-rank">{m.prev}位→<strong>{m.cur}位</strong></span>
											<span class="tw-diff tw-up">▲{m.diff}</span>
										</>
									);
									return m.url ? <a href={m.url} class="tw-row">{inner}</a> : <div class="tw-row">{inner}</div>;
								})}
							</div>
						)}
						{fallers.length > 0 && (
							<div class="tw-col">
								<div class="tw-col-label tw-down">急落</div>
								{fallers.map(m => {
									const inner = (
										<>
											{m.id && <img src={`/images/pokemon/pokemon-${m.id}.webp`} alt={m.name} width="36" height="36" loading="lazy" />}
											<span class="tw-name">{m.name}</span>
											<span class="tw-rank">{m.prev}位→<strong>{m.cur}位</strong></span>
											<span class="tw-diff tw-down">▼{-m.diff}</span>
										</>
									);
									return m.url ? <a href={m.url} class="tw-row">{inner}</a> : <div class="tw-row">{inner}</div>;
								})}
							</div>
						)}
					</div>
				</section>
			)}

			<nav class="qn-wrap" aria-label="サイトの使い方クイックナビ">
				<div class="qn-grid">
					<a href="#sec-research" class="qn-tile">
						<span class="qn-icon" aria-hidden="true">🔍</span>
						<span class="qn-verb">調べる</span>
						<span class="qn-lead">使用率データで現環境を把握</span>
					</a>
					<a href="#sec-read" class="qn-tile">
						<span class="qn-icon" aria-hidden="true">📖</span>
						<span class="qn-verb">読む</span>
						<span class="qn-lead">考察記事で環境とポケモンを深掘り</span>
					</a>
					<a href="#sec-watch" class="qn-tile">
						<span class="qn-icon" aria-hidden="true">🎬</span>
						<span class="qn-verb">観る</span>
						<span class="qn-lead">対戦AIで上位構築の動きを観戦</span>
					</a>
					<a href="#sec-battle" class="qn-tile">
						<span class="qn-badge-new">NEW</span>
						<span class="qn-icon" aria-hidden="true">⚔️</span>
						<span class="qn-verb">戦う</span>
						<span class="qn-lead">自分のパーティを構築して環境に挑む</span>
					</a>
				</div>
			</nav>

			<section class="category-block" id="sec-research">
				<div class="category-head">
					<h2 class="category-title">調べる</h2>
					<p class="category-lead">使用率データで現環境を把握</p>
				</div>

				<div style="margin-bottom:1.8rem;display:flex;justify-content:center;flex-wrap:wrap;gap:10px">
					<a href="/ranking" class="cta-banner">📊 M-5 使用率ランキングを見る →</a>
				</div>
				<div style="margin-bottom:1.8rem;display:flex;justify-content:center;flex-wrap:wrap;gap:8px;font-size:0.85rem">
					<a href="/trends/" style="padding:8px 16px;border:1px solid #e2e8f0;border-radius:8px;text-decoration:none;color:inherit;font-weight:700">📈 環境変動（急上昇・急落）</a>
					<a href="/counters/" style="padding:8px 16px;border:1px solid #e2e8f0;border-radius:8px;text-decoration:none;color:inherit;font-weight:700">🛡️ ポケモン別対策ランキング</a>
					<a href="/matchup/" style="padding:8px 16px;border:1px solid #e2e8f0;border-radius:8px;text-decoration:none;color:inherit;font-weight:700">⚔️ 1v1直接比較</a>
				</div>

				<h3 class="section-title">ポケモン情報 <span style="font-size:0.8rem;font-weight:400;color:rgb(var(--gray));margin-left:6px">使用率 TOP10</span></h3>
				<div style="position:relative">
					<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px">
						{pokemonPages.map((p) => (
							<a href={`/pokemon/${p.id}/`} style="display:block;text-decoration:none;border:1px solid #e2e8f0;border-radius:8px;padding:10px 6px;text-align:center;transition:box-shadow 0.2s" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow=''">
								<img
									src={`/images/pokemon/pokemon-${String(p.data.dexNumber).padStart(4,'0')}-${p.data.imageForm ?? '00'}.webp`}
									alt={p.data.pokemonName}
									style="width:64px;height:64px;display:block;margin:0 auto 4px"
									loading="eager"
									width="64"
									height="64"
								/>
								<div style="font-size:0.72rem;font-weight:bold;color:rgb(var(--gray));margin-bottom:1px">{p.data.usageRank}位</div>
								<div style="font-size:0.75rem;font-weight:bold;color:rgb(var(--black))">{p.data.pokemonName}</div>
							</a>
						))}
					</div>
					<div style="position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(to bottom,transparent,white);pointer-events:none"></div>
				</div>
				<div style="text-align:center;margin-top:8px">
					<a href="/pokemon/" style="display:inline-block;padding:10px 28px;background:var(--accent);color:white;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:700;transition:opacity 0.2s" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
						すべて見る（全{pokemonTotal}件）→
					</a>
				</div>
			</section>

			<section class="category-block" id="sec-read">
				<div class="category-head">
					<h2 class="category-title">読む</h2>
					<p class="category-lead">考察記事で環境とポケモンを深掘り</p>
				</div>

				<section style="margin-bottom:3rem">
				<h3 class="section-title">考察記事 — M-4 シーズン <span style="font-size:0.75rem;font-weight:700;background:#fef3c7;color:#b45309;padding:2px 8px;border-radius:9999px;margin-left:8px">最新</span></h3>
				<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px">
					{m4Posts.map((post, i) => {
						const meta = (articleMeta as any)[post.id];
						const dex = meta?.dex;
						const form = meta?.form ?? '00';
						const types: string[] = meta?.types ?? [];
						const rank: number | null = meta?.rank ?? null;
						const imgSrc = dex ? `/images/pokemon/pokemon-${String(dex).padStart(4,'0')}-${form}.webp` : null;
						return (
							<a href={`/blog/${post.id}/`} style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #e2e8f0;border-radius:10px;text-decoration:none;background:white;transition:box-shadow 0.2s" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow=''">
								{imgSrc
									? <img src={imgSrc} alt={meta?.name ?? ''} width="64" height="64" loading={i < 4 ? 'eager' : 'lazy'} style="width:64px;height:64px;flex-shrink:0" />
									: <div style="width:64px;height:64px;background:#f1f5f9;border-radius:8px;flex-shrink:0" />
								}
								<div style="flex:1;min-width:0">
									{rank && <div style="font-size:0.7rem;color:#dc2626;font-weight:700;margin-bottom:2px">使用率 {rank}位</div>}
									<div style="font-size:0.82rem;font-weight:700;color:rgb(var(--black));line-height:1.35;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{post.data.title}</div>
