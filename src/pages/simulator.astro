      }
      const NATURE = {いじっぱり:'A↑C↓',さみしがり:'A↑B↓',ゆうかん:'A↑S↓',やんちゃ:'A↑D↓',ずぶとい:'B↑A↓',わんぱく:'B↑C↓',のんき:'B↑S↓',のうてんき:'B↑D↓',ひかえめ:'C↑A↓',おっとり:'C↑B↓',れいせい:'C↑S↓',うっかりや:'C↑D↓',おだやか:'D↑A↓',おとなしい:'D↑B↓',なまいき:'D↑S↓',しんちょう:'D↑C↓',おくびょう:'S↑A↓',せっかち:'S↑B↓',ようき:'S↑C↓',むじゃき:'S↑D↓'};
      const MOVET = {};   // 技名→タイプ（initで取得）
      const TYPEICON = {ノーマル:['00','normal'],かくとう:['01','fighting'],ひこう:['02','flying'],どく:['03','poison'],じめん:['04','ground'],いわ:['05','rock'],むし:['06','bug'],ゴースト:['07','ghost'],はがね:['08','steel'],ほのお:['09','fire'],みず:['10','water'],くさ:['11','grass'],でんき:['12','electric'],エスパー:['13','psychic'],こおり:['14','ice'],ドラゴン:['15','dragon'],あく:['16','dark'],フェアリー:['17','fairy']};
      function typeIcon(move){ const t=MOVET[move], e=TYPEICON[t]; return e?`<img class="tic" src="/images/types/type-${e[0]}-${e[1]}.png" alt="${t}" title="${t}">`:''; }
      function typeIconName(t){ const e=TYPEICON[t]; return e?`<img class="rp-tic" src="/images/types/type-${e[0]}-${e[1]}.png" alt="${t}" title="${t}">`:''; }
      const WEATHER={sunny:'☀ 晴れ',rain:'🌧 あめ',sandstorm:'🌪 すなあらし',hail:'❄ あられ',snow:'❄ ゆき'};
      const STATUS_JP={burn:'やけど',poison:'どく',badpoison:'もうどく',paralysis:'まひ',sleep:'ねむり',freeze:'こおり'};
      const ITEM_PNG={"きあいのタスキ":"item-0275-tasuki.png","こだわりスカーフ":"item-0287-scarf.png","オボンのみ":"item-0158-obon.png","ラムのみ":"item-0157-ram.png","ヤチェのみ":"item-0188-yache.png","ハバンのみ":"item-0197-haban.png"};
      const ITEM_SPR={"オレンのみ":[-408,-96],"ラムのみ":[-456,-96],"オボンのみ":[0,-120],"カゴのみ":[-48,-120],"ヒメリのみ":[-72,-120],"ヨロギのみ":[-96,-120],"ビアーのみ":[-120,-120],"リンドのみ":[-24,-144],"モモンのみ":[-48,-144],"リリバのみ":[-72,-144],"オッカのみ":[-96,-144],"チーゴのみ":[-120,-144],"イトケのみ":[-144,-144],"ロゼルのみ":[-168,-144],"ウタンのみ":[-192,-144],"ナモのみ":[-216,-144],"ヤチェのみ":[-240,-144],"ソクノのみ":[-264,-144],"タンガのみ":[-312,-144],"シュカのみ":[-336,-144],"ヨプのみ":[-360,-144],"カシブのみ":[-384,-144],"バコウのみ":[-408,-144],"ホズのみ":[-432,-144],"ハバンのみ":[-456,-144],"コランのみ":[0,-168]};
      function itemIcon(it){ if(ITEM_PNG[it]) return `<img class="iic" src="/images/items/${ITEM_PNG[it]}" alt="">`; const s=ITEM_SPR[it]; return s?`<span class="iic iic-spr" style="background-position:${s[0]}px ${s[1]}px"></span>`:''; }
      // 盤面の行動表示。技の所属側を「確認(相手の技=3-n)」「減少(自分の与ダメ=n)」から判定し、
      // ダメ行/確認行/外し行で (名前,技) を拾う。確認行の無い再使用技(ドラゴンテール等)も取りこぼさない。
      // side1=自分(P1), side2=相手(P2)。ミラー(両者同名)でも取り違えない。
      function parseActions(logs, actives){ const m={1:{},2:{}}; let ord=0; const moveSide={};
        (logs||[]).forEach(raw=>{ const pm=raw.match(/^▷P(\d+):\s*/); if(!pm)return; const obs=+pm[1]; if(obs!==1&&obs!==2)return; const l=raw.slice(pm[0].length); let r;
          if(r=l.match(/^(.+?) の技【(.+?)】を確認/)) moveSide[r[2]]=3-obs;
          else if(r=l.match(/^(.+?) に (.+?) で (?:約)?-?\d+% 減少/)){ if(moveSide[r[2]]==null) moveSide[r[2]]=obs; }
        });
        const put=(side,name,move,force)=>{ if(side!==1&&side!==2)return; if(force||!m[side][name]) m[side][name]={move, order:(m[side][name]?m[side][name].order:++ord)}; };
        (logs||[]).forEach(raw=>{ const l=raw.replace(/^▷P\d+:\s*/,''); let r;
          if(r=l.match(/^(.+?) の (.+?) → .+? に \d+ダメ/)) put(moveSide[r[2]],r[1],r[2]);
          else if(r=l.match(/^(.+?) の (.+?) は外れた/)) put(moveSide[r[2]],r[1],r[2]);
          else if(r=l.match(/^(.+?) の技【(.+?)】を確認/)) put(moveSide[r[2]],r[1],r[2]);
          // 確認/減少の無い再使用技も拾う（守り系・防がれた技など）。側は盤面のアクティブ名で確定。
          else if(actives){
            if(r=l.match(/^(.+?) の (キングシールド|トーチカ|ニードルガード|まもる|みきり|こらえる)！/)) put(actives[r[1]],r[1],r[2],true);
            else if(r=l.match(/^(.+?) は身を守っている/)) put(actives[r[1]],r[1],'守り');
            else if(r=l.match(/^(.+?) の (.+?) は .+? に防がれた/)) put(actives[r[1]],r[1],r[2]);
            else if(r=l.match(/^(.+?) は (.+?) を使った/)) put(actives[r[1]],r[1],r[2]);
          }
        });
        return m; }
      // 詳細ログの表示順補正：おやこあいの「追撃」は本体ヒットの後に判定されるので、本体ダメ行の後ろへ入れ替える
      function reorderLogs(logs){
        const a=[...logs];
        for(let i=0;i<a.length-1;i++){
          if(/おやこあい 追撃！/.test(a[i]) && / → .+ に \d+ダメ/.test(a[i+1])){ const t=a[i]; a[i]=a[i+1]; a[i+1]=t; i++; }
        }
        return a;
      }
      // 簡易ログ：技・交代を発生順に1行ずつ（①②で行動順、各行に技→対象・与ダメ・結果）
      function summarizeTurn(logs, actives){
        const events=[]; const megaed=new Set(); let ord=0, last=null, pendingOut=null;
        const moveOwner={}; const sideName={}; const protectAct={}; const SIDEJP={1:'自分',2:'相手'};
        const newAct=(side,name,move)=>{ const e={kind:'act',side:side||0,order:++ord,name,move,target:null,dmg:null,tags:[]}; if(side)sideName[side+'|'+name]=e; if(move)moveOwner[move]=e; events.push(e); last=e; return e; };
        // 行動は技名(moveOwner)でのみ照合する。名前だけの照合はミラー(同名)で別の技に化けるため禁止。
        const findActor=(name,move)=>{ return (move&&moveOwner[move])?moveOwner[move]:null; };
        const tag=t=>{ if(last&&last.kind==='act'&&!last.tags.includes(t)) last.tags.push(t); };
        (logs||[]).forEach(raw=>{ const pm=raw.match(/^▷P(\d+):\s*/); const obs=pm?+pm[1]:0; const side=obs?3-obs:0; const l=pm?raw.slice(pm[0].length):raw; let m;
          if(/^P[12]選出:|見せ合い/.test(l)) return;
          if(obs&&(m=l.match(/^(.+?) に (.+?) で (?:約)?-?\d+% 減少/))){ const e=moveOwner[m[2]]; if(e&&!e.side){ e.side=obs; sideName[obs+'|'+e.name]=e; } return; }
          if(m=l.match(/^(.+?) はメガ進化した！/)){ megaed.add(m[1]); return; }
          if(m=l.match(/^(.+?) の (.+?) → (.+?) に (\d+)ダメ/)){ const e=findActor(m[1],m[2])||newAct(0,m[1],m[2]); e.move=e.move||m[2]; e.target=m[3]; e.dmg=+m[4]; last=e; return; }
          if(m=l.match(/^おやこあい 追撃！ (\d+)ダメ/)){ if(last&&last.kind==='act') last.pb=(last.pb||0)+(+m[1]); return; }
          if(m=l.match(/^(.+?) は (.+?) を使った/)){ const e=findActor(m[1],m[2]); if(!e){ newAct(side,m[1],m[2]); } else { if(side&&!e.side){e.side=side;sideName[side+'|'+m[1]]=e;} last=e; } return; }
          if(m=l.match(/^(.+?) の技【(.+?)】を確認/)){ let e=side?sideName[side+'|'+m[1]]:null; if(!e){ e=newAct(side,m[1],m[2]); } else { last=e; } if(m[2])moveOwner[m[2]]=e; return; }
          if(m=l.match(/^(.+?) の (.+?) は外れた/)){ const e=findActor(m[1],m[2])||newAct(side,m[1],m[2]); e.tags.push('外し'); last=e; return; }
          if(m=l.match(/^(.+?) はひるんで動けない/)){ const e=findActor(m[1],null)||newAct(side,m[1],'ひるみで動けない'); last=e; return; }
          // 守り系：再使用ターンは確認行が無いので「身を守っている」「X の キングシールド！」から拾う
          if(m=l.match(/^(.+?) は身を守っている/)){ const nm=m[1]; let e=events.find(x=>x.kind==='act'&&x.name===nm); if(!e){ e=newAct((actives&&actives[nm])||0,nm,'守り'); } protectAct[nm]=e; last=e; return; }
          if(m=l.match(/^(.+?) の (キングシールド|トーチカ|ニードルガード|まもる|みきり|こらえる)！/)){ const e=protectAct[m[1]]; if(e){ e.move=m[2]; last=e; } return; }
          if(m=l.match(/^(.+?) は疲れてこんらんした/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：こんらん（あばれ終了）`}); return; }
          if(m=l.match(/^(.+?) はこんらんして自分を傷つけた/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：こんらんで自傷`}); return; }
          if(m=l.match(/^(.+?) はこんらんした/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：こんらんになった`}); return; }
          if(m=l.match(/^(.+?) は引っ込んだ/)){ pendingOut=m[1]; return; }
          if(m=l.match(/^(.+?) が出てきた/)){ events.push({kind:'sw',order:++ord,text:pendingOut?`${pendingOut} → ${m[1]}`:`${m[1]} 繰り出し`}); pendingOut=null; last=null; return; }
          if(m=l.match(/^(.+?) が登場した/)){ events.push({kind:'sw',order:++ord,text:`${m[1]}（瀕死後）`}); last=null; return; }
          if(m=l.match(/^(.+?) は強制交代させられ/)){ events.push({kind:'sw',order:++ord,text:`${m[1]} が強制交代`}); return; }
          // ダメージ系（特性・設置・状態・天候・反動）を漏れなく
          if(m=l.match(/^(.+?) の (.+?)！ (.+?) に (\d+) のダメージ/)){ events.push({kind:'dmg',order:++ord,text:`${m[2]}：${m[3]}に${m[4]}`}); return; }
          if(m=l.match(/^(.+?) はステルスロックの効果を受けた！\((\d+)\)/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：ステルスロック ${m[2]}`}); return; }
          if(m=l.match(/^(.+?) は (.+?) で (\d+) のダメージを受けた/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：${m[2]} ${m[3]}`}); return; }
          if(m=l.match(/^(.+?) は (.+?) のダメージを受けた！\((\d+)\)/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：${m[2]} ${m[3]}`}); return; }
          if(m=l.match(/^(.+?) は (?:.+? の )?反動を受けた！\((\d+)\)/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：反動 ${m[2]}`}); return; }
          if(m=l.match(/^(.+?) の (.+?) が叩き落とされた！/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]} の ${m[2]} を落とした`}); return; }
          if(m=l.match(/^(.+?) の ばけのかわ が破れた！\((\d+)\)/)){ const e=(last&&last.kind==='act')?last:null; if(e){ e.target=m[1]; e.dmg=+m[2]; if(!e.tags.includes('ばけのかわ')) e.tags.push('ばけのかわ'); } else { events.push({kind:'dmg',order:++ord,text:`${m[1]}：ばけのかわ が破れた（${m[2]}）`}); } return; }
          if(m=l.match(/^(.+?) は (.+?) に効かない/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]} は ${m[2]} に無効（効果なし）`}); return; }
          if(m=l.match(/^(.+?) の (.+?) は (.+?) に防がれた/)){ let e=findActor(m[1],m[2]); if(!e){ e=newAct((actives&&actives[m[1]])||0,m[1],m[2]); } if(!e.tags.includes('防がれた')) e.tags.push('防がれた'); last=e; return; }
          if(m=l.match(/^(.+?) の オボンのみ が発動！ HPが (\d+) 回復/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：オボンのみ +${m[2]}回復`}); return; }
          if(m=l.match(/^(.+?) の でんきにかえる！/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：でんきにかえる（充電）`}); return; }
          if(m=l.match(/^(.+?) (?:の|は) (.+?) で HPが (\d+) 回復/)){ events.push({kind:'dmg',order:++ord,text:`${m[1]}：${m[2]} +${m[3]}回復`}); return; }
          if(/ばつぐん/.test(l)){ tag('効果抜群'); return; }
          if(/いまひとつ/.test(l)){ tag('いまひとつ'); return; }
          if(/急所に当たった/.test(l)){ tag('急所'); return; }
          if(/(タスキ|がんじょう).*耐え/.test(l)){ tag('相手耐え'); return; }
          if(/吹き始めた/.test(l)){ tag('展開'); return; }
          if(/まき散らされ|ステルスロックを/.test(l)){ tag('設置'); return; }
          if(m=l.match(/^(.+?) は倒れた/)){ tag(`${m[1]}を倒した`); return; }
          if(m=l.match(/(こうげき|ぼうぎょ|とくこう|とくぼう|すばやさ) が.*?(上が|下が)/)){ tag(`${m[1]}${m[2]==='上が'?'↑':'↓'}`); return; }
        });
        if(actives) events.forEach(e=>{ if(e.kind==='act'&&!e.side&&actives[e.name]) e.side=actives[e.name]; });
        const circ=['①','②','③','④']; let an=0;
        return events.sort((a,b)=>a.order-b.order).map(e=>{
          if(e.kind==='sw') return `<span class="rlog-sw">交代</span> ${e.text}`;
          if(e.kind==='dmg') return `<span class="rlog-dmg">↳ ${e.text}</span>`;
          an++; const sl=e.side?`<span class="rlog-side s${e.side}">${SIDEJP[e.side]}</span> `:''; let s=`${circ[an-1]||an} ${sl}${megaed.has(e.name)?'<span class="rlog-mega">メガ</span> ':''}${e.name}：${e.move||'—'}`;
          if(e.dmg!=null) s+=` → ${e.target} に ${e.dmg}${e.pb?'+'+e.pb:''}`;
          if(e.tags.length) s+=`（${e.tags.join('・')}）`;
          return s;
        });
      }
      function selComp(containerId, i){
        const c = $(containerId); const p = parseSpec(c._specs[i]);
        c.querySelectorAll('.montab').forEach((e,j)=>e.classList.toggle('active', j===i));
        const ev = p.evs.length===6 ? ['H','A','B','C','D','S'].map((l,k)=>(p.evs[k]&&p.evs[k]!=='0')?`<span class="evchip ev-${l}">${l}<b>${p.evs[k]}</b></span>`:null).filter(Boolean).join('') : '';
        const nat = p.nature ? `${p.nature}${NATURE[p.nature]?` (${NATURE[p.nature]})`:''}` : '—';
        const moves = p.moves.length ? p.moves.map(m=>`<span class="mvchip">${typeIcon(m)}${m}</span>`).join('') : '—';
        $(containerId+'-d').innerHTML =
          `<div class="cdgrid">
             <div class="cdcell"><span class="cdlabel item">持ち物</span><span class="cdval">${itemIcon(p.item)}${p.item||'—'}</span></div>
             <div class="cdcell"><span class="cdlabel abil">特性</span><span class="cdval">${p.ability||'—'}</span></div>
             <div class="cdcell"><span class="cdlabel nat">性格</span><span class="cdval">${nat}</span></div>
           </div>
           <div class="cdrow mvrow"><span class="cdlabel mv">技</span><span class="mvwrap">${moves}</span></div>
           <div class="cdrow mvrow"><span class="cdlabel ev">EV</span><span class="mvwrap">${ev||'—'}</span></div>`;
      }

      const rankNo=l=>{const mm=(l||'').match(/#(\d+)/);return mm?+mm[1]:99999;};  // 「M-1#100」の100を数値で抽出（番号順ソート用）
      if(STATIC){
        Promise.all([
          fetch(META+'/index.json').then(r=>r.json()),
          fetch(META+'/icons.json').then(r=>r.json()),
          fetch(META+'/move_types.json').then(r=>r.json())
        ]).then(([idx,ic,mt])=>{ RANKERS=(idx.subjects||[]).slice().sort((a,b)=>rankNo(a.label)-rankNo(b.label)); ICONS=ic; Object.assign(MOVET,mt);
          RANKERS.forEach(s=>SAVEDWR[s.label]=s.win_rate); renderSubjectList();
          if(RANKERS.length) selectSubject(RANKERS[0]); });
      } else {
        Promise.all([
          fetch(API+'/api/f1/rankers').then(r=>r.json()),
          fetch(API+'/api/f1/saved').then(r=>r.json()),
          fetch(API+'/api/f1/icons').then(r=>r.json()),
          fetch(API+'/api/f1/move_types').then(r=>r.json())
        ]).then(([rs,sv,ic,mt])=>{ RANKERS=rs.slice().sort((a,b)=>rankNo(a.label)-rankNo(b.label)); SAVED=sv; ICONS=ic; Object.assign(MOVET,mt); renderSubjectList();
          const first = RANKERS.findIndex(r=>sv[r.label]); selectSubject(RANKERS[first>=0?first:0]); });
      }

      function subjectWR(label){ if(STATIC) return (label in SAVEDWR)?SAVEDWR[label]:null;
        const s=SAVED[label]; if(!s) return null;
        const a=s.cards; return a.length? a.reduce((t,c)=>t+c.win_rate,0)/a.length : null; }
      function renderSubjectList(){
        $('subject-list').innerHTML = RANKERS.map((r,i)=>{ const wr=subjectWR(r.label);
          const wrs = wr!=null? `<span class="wr ${wr>=0.55?'g':wr<=0.45?'r':'n'}">${Math.round(wr*100)}%</span>` : `<span class="muted">未</span>`;
          return `<div class="pitem" data-i="${i}" onclick="selectSubjectIdx(${i})"><span class="nm">${r.label}</span>${wrs}</div>`;
        }).join('');
      }
      function selectSubjectIdx(i){ selectSubject(RANKERS[i]); }
      async function selectSubject(r){
        SUBJECT=r; OPP=null;
        document.querySelectorAll('#subject-list .pitem').forEach(e=>e.classList.toggle('active', RANKERS[+e.dataset.i]===r));
        $('opp-comp').innerHTML = '<div class="muted">左の一覧から対戦相手を選択</div>';
        $('detail').innerHTML = ''; $('progress-wrap').classList.add('hidden');
        CARDS = {}; SUBJDATA = null;
        if(STATIC){
          $('btn-analyze').classList.add('hidden'); setStatus('読み込み中…','#b45309');
          $('subject-comp').innerHTML='<div class="muted">読み込み中…</div>'; $('opp-list').innerHTML='';
          const d = await fetch(`${R2}/subjects/${r.file}`).then(x=>x.json()).catch(()=>null);
          if(!SUBJECT || SUBJECT!==r) return;   // 連打時の取り違え防止
          if(!d){ setStatus('データ取得に失敗しました','#dc2626'); return; }
          SUBJDATA=d; SUBJECT={label:r.label, party:d.subject.party, file:r.file}; AID=r.label;
          renderComp('subject-comp', d.subject.party, `${r.label} の構成`);
          d.cards.forEach(c=>CARDS[c.label]=c); setStatus('',''); renderTab();
          return;
        }
        renderComp('subject-comp', r.party, `${r.label} の構成`);
        if(SAVED[r.label]){ AID=SAVED[r.label].analysis_id; $('btn-analyze').classList.add('hidden'); setStatus('','');
          SAVED[r.label].cards.forEach(c=>CARDS[c.label]=c); renderTab();
        } else { AID=null; $('btn-analyze').classList.remove('hidden'); setStatus('未計算','');
          $('opp-list').innerHTML='<div class="muted" style="padding:.6em">「このパーティで総当たり」を実行してください</div>'; $('summary').textContent=''; }
      }

      $('btn-analyze').onclick = async ()=>{
        if(!SUBJECT) return; $('btn-analyze').disabled=true; $('progress-wrap').classList.remove('hidden'); setStatus('分析中…','#b45309');
        const res = await fetch(API+'/api/f1/analyze',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({p1:SUBJECT.party,n:10,season:'M-2',exclude_label:SUBJECT.label})}).then(r=>r.json());
        AID=res.analysis_id; pollProgress();
      };
      async function pollProgress(){
        const p = await fetch(API+`/api/f1/progress/${AID}`).then(r=>r.json());
        if(p.error){ setStatus('エラー: '+p.error,'#dc2626'); return; }
        $('progress-fill').style.width=(p.total?Math.round(p.done/p.total*100):0)+'%';
        $('progress-text').textContent=`${p.done} / ${p.total} 戦（${p.cards.length}カード）`;
        p.cards.forEach(c=>CARDS[c.label]=c); if(TAB==='ranker') renderTab();
        if(p.running){ setStatus('分析中…','#b45309'); setTimeout(pollProgress,2000); }
        else{ setStatus('完了','#16a34a'); $('btn-analyze').disabled=false; renderSubjectList(); }
      }

      function switchTab(t){ TAB=t; $('tab-ranker').classList.toggle('active',t==='ranker'); $('tab-pokemon').classList.toggle('active',t==='pokemon');
        OPP=null; $('opp-comp').innerHTML='<div class="muted">左の一覧から選択</div>'; $('detail').innerHTML=''; renderTab(); }
      function renderTab(){ $('sortbar').style.display = 'flex'; if(TAB==='ranker') renderRankerTab(); else renderPokemonTab(); }
      function setSort(s){
        if(TAB==='ranker'){
          if(s===SORT){ if(s==='wr') WRDIR=WRDIR==='asc'?'desc':'asc'; else NUMDIR=NUMDIR==='asc'?'desc':'asc'; }
          else SORT=s;
          renderRankerTab();
        } else {
          if(s===PSORT){ if(s==='wr') PWDIR=PWDIR==='asc'?'desc':'asc'; else PNDIR=PNDIR==='asc'?'desc':'asc'; }
          else PSORT=s;
          renderPokeList();
        }
      }

      // VS ランカー
      function renderRankerTab(){
        $('sort-num').classList.toggle('btn-active', SORT==='num');
        $('sort-wr').classList.toggle('btn-active', SORT==='wr');
        $('sort-num').textContent = SORT==='num' ? (NUMDIR==='asc' ? '番号順 ↑' : '番号順 ↓') : '番号順';
        $('sort-wr').textContent = SORT==='wr' ? (WRDIR==='asc' ? '勝率順 ↑（苦手→得意）' : '勝率順 ↓（得意→苦手）') : '勝率順';
        const rn = l => { const m=l.match(/#(\d+)/); return m?+m[1]:9999; };
        const cards = Object.values(CARDS).sort((a,b)=>
          SORT==='num' ? (NUMDIR==='asc'?rn(a.label)-rn(b.label):rn(b.label)-rn(a.label))
                       : (WRDIR==='asc'?a.win_rate-b.win_rate:b.win_rate-a.win_rate));
        if(!cards.length){ $('opp-list').innerHTML='<div class="muted" style="padding:.6em">データなし</div>'; $('summary').textContent=''; return; }
        const s=cards.filter(c=>c.win_rate>=0.6).length,w=cards.filter(c=>c.win_rate<=0.4).length;
        $('summary').textContent=`${SUBJECT.label} vs 全${cards.length}ランカー ｜ 得意 ${s}・五分 ${cards.length-s-w}・苦手 ${w}`;
        $('opp-list').innerHTML = cards.map(c=>{ const wr=Math.round(c.win_rate*100),cls=c.win_rate>=0.6?'g':c.win_rate<=0.4?'r':'n';
          return `<div class="pitem" data-label="${encodeURIComponent(c.label)}" onclick="selectOppRanker('${c.label.replace(/'/g,"\\'")}')"><span class="nm">${c.label}</span><span class="muted">${c.wins}-${c.losses}-${c.draws}</span><span class="wr ${cls}">${wr}%</span></div>`;
        }).join('');
        if(!OPP || !CARDS[OPP]) selectOppRanker(cards[0].label);
        else document.querySelectorAll('#opp-list .pitem').forEach(e=>e.classList.toggle('active', decodeURIComponent(e.dataset.label||'')===OPP));
      }
      function selectOppRanker(label){ OPP=label; const c=CARDS[label];
        document.querySelectorAll('#opp-list .pitem').forEach(e=>e.classList.toggle('active', decodeURIComponent(e.dataset.label||'')===label));
        renderComp('opp-comp', c.specs, `${label} の構成`);
        renderRankerDetail(label, c);
      }
      function verdict(wr){
        if(wr>=1) return {t:'完勝（全勝）',c:'#15803d',bg:'#dcfce7',i:'🏆'};
        if(wr>=0.67) return {t:'有利',c:'#15803d',bg:'#dcfce7',i:'✅'};
        if(wr>=0.34) return {t:'互角',c:'#475569',bg:'#f1f5f9',i:'⚖'};
        if(wr>0) return {t:'苦戦',c:'#b91c1c',bg:'#fee2e2',i:'⚠'};
        return {t:'相性最悪（全敗）',c:'#b91c1c',bg:'#fee2e2',i:'🛑'};
      }
      async function renderRankerDetail(label,c){
        stopAuto();
        $('detail').innerHTML='<div class="muted">読み込み中…</div>';
        let b, d;
        if(STATIC){ const o=(SUBJDATA&&SUBJDATA.opp&&SUBJDATA.opp[label])||{}; b=o.faults||{}; d=o.matchup||{}; }
        else { [b,d] = await Promise.all([
          fetch(API+'/api/f1/faults',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({analysis_id:AID,label})}).then(r=>r.json()),
          fetch(API+'/api/matchup_explain',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({p1:SUBJECT.party,p2:c.specs,season:'M-2'})}).then(r=>r.json())
        ]); }
        const selMe=new Map((b.sel_me||[]).map(x=>[x[0],x[1]])), selOpp=new Map((b.sel_opp||[]).map(x=>[x[0],x[1]]));
        const chips=(names,m)=>names.map(nm=>{const cnt=m.get(nm)||0;return `<span class="chip ${cnt?'sel':'bench'}">${nm}${cnt?` ${cnt}/${c.n}`:''}</span>`;}).join('');
        let h=`<div class="sect"><div class="sect-head">🎯 選出（${c.n}戦）</div><div class="sect-body">
          <div style="margin-bottom:.3em"><span class="muted">自分:</span> ${chips(d.namesA,selMe)}</div>
          <div><span class="muted">相手:</span> ${chips(d.namesB,selOpp)}</div>
          <div class="muted" style="margin-top:.3em">※強調＝実際に選出。淡色＝控え。</div></div></div>`;
        const wrp=Math.round(b.win_rate*100), v=verdict(b.win_rate);
        const pchip=(x,good)=>{const u=iconUrl(x.name);return `<span class="pchip ${good?'good':'bad'}">${u?`<img src="${u}" onerror="this.style.display='none'">`:''}${x.name} ${Math.round(x.rate*100)}%</span>`;};
        const carry=b.own_carry_on_win||[], ko=b.opp_ko_on_win||[];
        h+=`<div class="sect"><div class="sect-head">📊 対戦サマリ</div><div class="sect-body">
          <div class="row" style="margin-bottom:.5em">
            <span class="verdict" style="color:${v.c};background:${v.bg}">${v.i} ${v.t}</span>
            <div class="hpbar" style="max-width:180px"><div class="hpfill" style="width:${wrp}%;background:${v.c}"></div></div>
            <span class="wr-tag" style="color:${v.c}">${wrp}%</span>
            <span class="muted">${b.wins}勝 ${b.losses}敗 ${b.draws}分</span>
          </div>`;
        if(b.win_rate>=0.5 && (carry.length||ko.length)){
          h+=`<div class="fbox win"><b class="g">勝ち筋</b>`;
          if(carry.length) h+=`<div class="frow"><span class="muted">残りやすい主軸: </span>${carry.slice(0,4).map(x=>pchip(x,true)).join('')}</div>`;
          if(ko.length) h+=`<div class="frow"><span class="muted">安定して倒せる相手: </span>${ko.slice(0,4).map(x=>pchip(x,true)).join('')}</div>`;
          h+=`</div>`;
        }
        if(b.losses>0 && (b.opp_survive_on_loss.length||b.your_dead_on_loss.length||b.setup_loss_rate>=0.3)){
          h+=`<div class="fbox lose"><b class="r">負け筋</b>`;
          if(b.opp_survive_on_loss.length) h+=`<div class="frow"><span class="muted">倒し切れない核: </span>${b.opp_survive_on_loss.slice(0,4).map(x=>pchip(x,false)).join('')}</div>`;
          if(b.your_dead_on_loss.length) h+=`<div class="frow"><span class="muted">落ちやすい自個体: </span>${b.your_dead_on_loss.slice(0,4).map(x=>pchip(x,false)).join('')}</div>`;
          if(b.setup_loss_rate>=0.3) h+=`<div class="frow"><b class="r">積み全抜き負け ${Math.round(b.setup_loss_rate*100)}%</b></div>`;
          h+=`</div>`;
        }
        const br=b.battle_results||[]; const escL=label.replace(/'/g,"\\'");
        const tabs=Array.from({length:c.n},(_,i)=>{const res=br[i];const cls=res===1?'win':res===2?'lose':'draw';const mk=res===1?'○勝':res===2?'●負':res===0?'△分':'';return `<button class="rtab ${cls}" id="rchip-${i}" onclick="openReplay('${escL}',${i})">第${i+1}戦${mk?` <b>${mk}</b>`:''}</button>`;}).join('');
        h+=`<div class="rp-pick-hd">🎬 <b>対戦記録</b> — 実際のシミュレーション結果を再生（タブで各戦、<span class="g">勝</span>/<span class="r">負</span>）</div>
          <div class="rtab-row">${tabs}</div>
          <div class="sect rp-panel" id="rp-box" style="margin-top:0">
            <div class="sect-body">
              <div class="row" id="replay-ctrl">
                <span id="rp-title" class="rp-title"></span>
                <button class="btn btn-sm btn-ghost" onclick="stepTurn(-1)">◀</button>
                <span id="replay-turn"></span>
                <button class="btn btn-sm btn-ghost" onclick="stepTurn(1)">▶</button>
                <button id="btn-auto" class="btn btn-sm" onclick="toggleAuto()">自動再生</button>
                <span id="replay-result" class="wr-tag"></span>
              </div>
              <div id="replay-sides"></div>
              <div id="replay-log" class="log"></div>
            </div>
          </div>
        </div></div>`;
        h+=matrixHTML(d, selMe, selOpp);
        $('detail').innerHTML=h;
        if(c.n>0) openReplay(label, 0, true);   // 1戦目を既定で開く
      }
      function matrixHTML(d, selMe, selOpp){
        const cell=v=>v==='A'?'bg-g':v==='B'?'bg-r':'bg-n';
        const hdr=n=>{const u=iconUrl(n); return `${u?`<img class="mtx-ico" src="${u}" title="${n}" alt="${n}" onerror="this.style.display='none'">`:''}<div class="mtx-name">${n}</div>`;};
        let mt=`<div class="muted" style="margin-bottom:.4em"><span class="bg-g" style="padding:0 .3em;border-radius:3px">自分勝ち</span> <span class="bg-r" style="padding:0 .3em;border-radius:3px">相手勝ち</span> ｜ 数字=与/被ダメ%${selMe?' ｜ 淡色＝選出されなかった個体':''}</div><div style="overflow-x:auto"><table class="mtx"><tr><th class="mtx-corner">自分 ↓<br>相手 →</th>`;
        d.namesB.forEach(n=>{const sd=selOpp&&selOpp.get(n);mt+=`<th class="${!selOpp||sd?'':'dim'} ${sd?'mtx-sel':''}">${hdr(n)}</th>`;}); mt+='</tr>';
        d.cells.forEach((row,i)=>{ const nm=d.namesA[i], rsel=selMe&&selMe.get(nm), rdim=(!selMe||rsel)?'':'dim';
          mt+=`<tr><th class="${rdim} ${rsel?'mtx-sel':''}">${hdr(nm)}</th>`;
          row.forEach((cc,j)=>{const dim=(!selMe||(rsel&&selOpp.get(d.namesB[j])))?'':'dim';mt+=`<td class="${cell(cc.v)} ${dim}">${cc.dealt}/${cc.taken}</td>`;}); mt+='</tr>'; });
        mt+='</table></div>';
        const help = `<details class="mtx-help"><summary>表の見方（与/被ダメと勝敗）</summary>
          <div class="mtx-help-body">
            各マスは「左の自分の個体」対「上の相手の個体」の1v1を、互いの<b>最大火力で殴り合った</b>想定で評価します（メガ石持ちはメガ後で評価）。<br>
            ・<b>数字「与／被」</b>＝1発あたりの最大ダメージ割合。<b>与</b>＝自分の最大打点が相手の最大HPの何%か／<b>被</b>＝相手の最大打点が自分の何%か。<br>
            ・<b>勝敗</b>（<span class="bg-g" style="padding:0 .3em;border-radius:3px">緑＝自分勝ち</span>／<span class="bg-r" style="padding:0 .3em;border-radius:3px">赤＝相手勝ち</span>）＝この火力で<b>相手を倒すのに必要な手数が少ない方</b>。手数が同じなら<b>素早さが速い方</b>が勝ち。きあいのタスキ／がんじょう（1発耐え）や先制技も加味します。<br>
            ・例：<b>与45／被83で相手勝ち</b>＝自分は45%×3発必要、相手は83%×2発で倒し切り、かつ相手が速い、という評価。
          </div></details>`;
        return `<div class="sect"><div class="sect-head">⚔ 1v1相性表（自分有利 ${d.a_win} / 相手有利 ${d.b_win}）</div><div class="sect-body">${help}${mt}</div></div>`;
      }
      function buildsHTML(d){ const bt=arr=>{let t='<table class="bt"><tbody>';
        (arr||[]).forEach(x=>t+=`<tr><td style="font-weight:700">${x.name}</td><td class="muted">${x.type}</td><td>${x.item}</td><td class="muted">${x.ability}</td><td class="muted">S${x.speed}</td><td class="muted" style="white-space:normal">${(x.moves||[]).join('・')}</td></tr>`);
        return t+'</tbody></table>';};
        return `<div class="sect"><div class="sect-head">🧬 型情報</div><div class="sect-body"><div class="muted" style="font-weight:700;color:#dc2626">相手</div>${bt(d.buildsB)}<div class="muted" style="font-weight:700;color:var(--accent-dark);margin-top:.5em">自分</div>${bt(d.buildsA)}</div></div>`;
      }

      // VS ポケモン（相手に選出された各ポケモンに対する実戦勝敗・型別勝率）
      async function renderPokemonTab(){
        if(!SUBJECT){ return; }
        if(!AID){ $('opp-list').innerHTML='<div class="muted" style="padding:.6em">「このパーティで総当たり」を実行すると、相手ポケモン別の勝敗が表示されます</div>'; $('summary').textContent=''; $('detail').innerHTML=''; $('opp-comp').innerHTML='<div class="muted">左の一覧から選択</div>'; return; }
        $('opp-list').innerHTML='<div class="muted" style="padding:.6em">集計中…</div>';
        const d = STATIC ? (SUBJDATA&&SUBJDATA.vs_pokemon || {pokemon:[]})
          : await fetch(API+'/api/f1/vs_pokemon',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({analysis_id:AID})}).then(r=>r.json());
        if(d.error){ $('opp-list').innerHTML=`<div class="muted" style="padding:.6em">${d.error}</div>`; $('summary').textContent=''; return; }
        POKES=d.pokemon||[]; VSPOKE={}; POKES.forEach(p=>VSPOKE[p.name]=p);
        renderPokeList();
      }
      function renderPokeList(){
        $('sort-num').classList.toggle('btn-active', PSORT==='num');
        $('sort-wr').classList.toggle('btn-active', PSORT==='wr');
        $('sort-num').textContent = PSORT==='num' ? (PNDIR==='asc' ? '対戦数順 ↑（少→多）' : '対戦数順 ↓（多→少）') : '対戦数順';
        $('sort-wr').textContent = PSORT==='wr' ? (PWDIR==='asc' ? '勝率順 ↑（苦手→得意）' : '勝率順 ↓（得意→苦手）') : '勝率順';
        const arr = [...POKES].sort((a,b)=>
          PSORT==='num' ? (PNDIR==='asc'?a.n-b.n:b.n-a.n)
                        : (PWDIR==='asc'?a.win_rate-b.win_rate:b.win_rate-a.win_rate));
        if(!arr.length){ $('opp-list').innerHTML='<div class="muted" style="padding:.6em">選出データなし</div>'; $('summary').textContent=''; return; }
        $('summary').textContent=`相手に選出された ${arr.length}種のポケモンに対する ${SUBJECT.label} の戦績（選出された対戦のみ集計）`;
        $('opp-list').innerHTML = arr.map(p=>{const wr=Math.round(p.win_rate*100),cls=p.win_rate>=0.6?'g':p.win_rate<=0.4?'r':'n';
          return `<div class="pitem" data-pk="${encodeURIComponent(p.name)}" onclick="selectOppPoke('${p.name.replace(/'/g,"\\'")}')"><span class="nm">${p.name}</span><span class="muted">${p.wins}-${p.losses}-${p.draws}</span><span class="wr ${cls}">${wr}%</span></div>`;}).join('');
        if(OPP&&VSPOKE[OPP]) document.querySelectorAll('#opp-list .pitem').forEach(e=>e.classList.toggle('active', decodeURIComponent(e.dataset.pk||'')===OPP));
        else selectOppPoke(arr[0].name);
      }
      async function selectOppPoke(nm){
        OPP=nm;
        document.querySelectorAll('#opp-list .pitem').forEach(e=>e.classList.toggle('active', decodeURIComponent(e.dataset.pk||'')===nm));
        const p=VSPOKE[nm];
        if(p){ const wr=Math.round(p.win_rate*100),cls=p.win_rate>=0.6?'g':p.win_rate<=0.4?'r':'n';
          $('opp-comp').innerHTML=`<div class="ctitle">${nm}</div><div>通算 <b>${p.wins}勝 ${p.losses}敗 ${p.draws}分</b> <span class="wr ${cls}">${wr}%</span></div>`; }
        // 型別戦績
        let h='';
        if(p&&p.builds&&p.builds.length){
          h+=`<div class="sect"><div class="sect-head">📊 ${nm} の型別戦績（${p.builds.length}型）</div><div class="sect-body">`;
          const _evk=['H','A','B','C','D','S'];
          [...p.builds].sort((a,b)=>{                       // 第一キー=勝率(降順)、以降は 持ち物→性格→技→EV→特性
            if(b.win_rate!==a.win_rate) return b.win_rate-a.win_rate;
            const s=(x,y)=>((x||'')<(y||'')?-1:(x||'')>(y||'')?1:0);
            let c=s(a.item,b.item)||s(a.nature,b.nature); if(c) return c;
            const ma=(a.moves||[]).slice().sort().join('/'),mb=(b.moves||[]).slice().sort().join('/'); if(ma!==mb) return ma<mb?-1:1;
            for(const k of _evk){const d=((a.evs||{})[k]||0)-((b.evs||{})[k]||0); if(d) return d;}
            return s(a.ability,b.ability);
          }).forEach(b=>{const wr=Math.round(b.win_rate*100),cls=b.win_rate>=0.6?'g':b.win_rate<=0.4?'r':'n';
            const nat=b.nature?`${b.nature}${NATURE[b.nature]?` (${NATURE[b.nature]})`:''}`:'—';
            const moves=(b.moves&&b.moves.length)?b.moves.map(m=>`<span class="mvchip">${typeIcon(m)}${m}</span>`).join(''):'—';
            const ev=b.evs?['H','A','B','C','D','S'].map(l=>b.evs[l]?`<span class="evchip ev-${l}">${l}<b>${b.evs[l]}</b></span>`:null).filter(Boolean).join(''):'';
            const evx=b.ev_variants>1?` <span class="muted" style="font-size:.7rem">ほかEV${b.ev_variants-1}種</span>`:'';
            h+=`<div class="bvrow">
              <div class="bvhd"><span class="wr ${cls}">${wr}%</span><span class="muted">${b.wins}勝 ${b.losses}敗 ${b.draws}分</span></div>
              <div class="cdgrid">
                <div class="cdcell"><span class="cdlabel item">持ち物</span><span class="cdval">${itemIcon(b.item)}${b.item||'—'}</span></div>
                <div class="cdcell"><span class="cdlabel abil">特性</span><span class="cdval">${b.ability||'—'}</span></div>
                <div class="cdcell"><span class="cdlabel nat">性格</span><span class="cdval">${nat}</span></div>
              </div>
              <div class="cdrow mvrow"><span class="cdlabel mv">技</span><span class="mvwrap">${moves}</span></div>
              <div class="cdrow mvrow"><span class="cdlabel ev">EV</span><span class="mvwrap">${ev||'—'}${evx}</span></div>
              <div class="use">使用ランカー: ${(b.labels||[]).join('・')}</div></div>`;});
          h+=`</div></div>`;
        }
        // 代表型（最多使用）に対する1v1相性表
        $('detail').innerHTML = h + '<div class="muted" style="padding:.5em">1v1相性表を計算中…</div>';
        const spec = (p&&p.builds&&p.builds[0]&&p.builds[0].spec) ? p.builds[0].spec : nm;
        const d = STATIC ? (p&&p.matchup || {namesA:[],namesB:[],cells:[],a_win:0,b_win:0})
          : await fetch(API+'/api/matchup_explain',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({p1:SUBJECT.party,p2:[spec],season:'M-2'})}).then(r=>r.json());
        $('detail').innerHTML = h + (d.cells&&d.cells.length ? matrixHTML(d, null, null) : '');
      }

      // リプレイ（インライン）
      async function openReplay(label,idx,noscroll){ stopAuto();
        document.querySelectorAll('.rtab').forEach(e=>e.classList.remove('act')); const ch=$('rchip-'+idx); ch&&ch.classList.add('act');
        const box=$('rp-box'); if(box){ box.classList.remove('hidden'); const t=$('rp-title'); if(t)t.textContent=`第${idx+1}戦 再生`; $('replay-sides').innerHTML='<div class="muted">読み込み中…</div>'; }
        const d=STATIC ? ((SUBJDATA&&SUBJDATA.opp&&SUBJDATA.opp[label]&&SUBJDATA.opp[label].replays[idx]) || {error:'記録なし'})
          : await fetch(API+'/api/f1/replay',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({analysis_id:AID,label,idx})}).then(r=>r.json());
        if(d.error){ $('replay-sides').innerHTML=`<div class="muted r">${d.error}</div>`; return; }
        RBATTLE=d; RTURN=0; renderReplay(0); if(!noscroll) box&&box.scrollIntoView({behavior:'smooth',block:'nearest'}); }
      function closeReplay(){ stopAuto(); const b=$('rp-box'); if(b)b.classList.add('hidden'); RBATTLE=null; document.querySelectorAll('.rtab').forEach(e=>e.classList.remove('act')); }
      const hpColor=f=>f>0.5?'#22c55e':f>0.2?'#eab308':'#ef4444';
      function renderMon(p,active,mine,action){
        const f=p.max_hp?p.hp/p.max_hp:0; const u=iconUrl(p.name);
        const boosts=Object.entries(p.stages||{}).filter(([,v])=>v).map(([k,v])=>`<span class="${v>0?'bup':'bdn'}">${k}${v>0?'▲':'▼'}${Math.abs(v)}</span>`).join(' ');
        return `<div class="rp-mon ${active?'act':''} ${p.alive?'':'dead'}">
          <div class="rp-mon-ico">${u?`<img src="${u}" alt="${p.name}" onerror="this.style.display='none'">`:''}${active?`<span class="rp-active-badge">${mine?'🔵':'🔴'}</span>`:''}${p.alive?'':'<span class="rp-x">×</span>'}</div>
          <div class="rp-mon-body">
            <div class="rp-mon-name">${p.name}${typeIconName(p.type1)}${p.type2?typeIconName(p.type2):''}</div>
            ${(()=>{const b=`${p.mega?'<span class="rp-mega">メガ</span>':''}${p.blade_forme?'<span class="rp-forme">ブレード</span>':''}${p.hero?'<span class="rp-forme">マイティ</span>':''}${p.status?`<span class="rp-status">${STATUS_JP[p.status]||p.status}</span>`:''}${p.disguise_broken?'<span class="rp-disg">皮破れ</span>':''}${p.electro_charged?'<span class="rp-charge">充電</span>':''}${p.confused?'<span class="rp-vol">😵こんらん</span>':''}${p.seeded?'<span class="rp-vol">🌱やどりぎ</span>':''}${p.taunt?'<span class="rp-vol">😈ちょうはつ</span>':''}${p.encore?'<span class="rp-vol">🔄アンコール</span>':''}${p.salted?'<span class="rp-vol">🧂しおづけ</span>':''}${p.transformed?'<span class="rp-vol">🎭へんしん</span>':''}${p.substitute_hp?`<span class="rp-vol">🪆みがわり(${p.substitute_hp})</span>`:''}${p.illusion_name?`<span class="rp-vol">イリュージョン:${p.illusion_name}</span>`:''}`;return b?`<div class="rp-badges">${b}</div>`:'';})()}
            <div class="row" style="gap:.3rem"><div class="hpbar"><div class="hpfill" style="width:${Math.round(f*100)}%;background:${hpColor(f)}"></div></div><span class="rp-hp">${p.hp}/${p.max_hp}</span></div>
            ${boosts?`<div class="rp-boost">${boosts}</div>`:''}
            ${action?`<div class="rp-move"><span class="rp-order ${action.order===1?'first':''}" title="${action.order===1?'先攻':'後攻'}">${action.order}</span>${typeIcon(action.move)||'➤'} ${action.move}</div>`:''}
          </div>
        </div>`;
      }
      function hazardBar(sd){
        const h=[];
        if(sd.stealth_rock) h.push('ステルスロック');
        if(sd.spikes) h.push('まきびし'+(sd.spikes>1?`×${sd.spikes}`:''));
        if(sd.toxic_spikes) h.push('どくびし'+(sd.toxic_spikes>1?`×${sd.toxic_spikes}`:''));
        if(sd.reflect) h.push('リフレクター');
        if(sd.light_screen) h.push('ひかりのかべ');
        if(sd.aurora_veil) h.push('オーロラベール');
        return `<div class="rp-haz">${h.map(x=>`<span class="hazchip">${x}</span>`).join('')}</div>`;
      }
      function renderColumn(sd,mine,act){
        return `<div class="rp-col ${mine?'mine':'opp'}"><div class="rp-label">${mine?'自分':'相手'}</div>${hazardBar(sd)}
          ${sd.party.map((p,i)=>renderMon(p,i===sd.active_idx,mine,(act||{})[p.name])).join('')}</div>`;
      }
      function renderReplay(idx){ if(!RBATTLE)return; RTURN=Math.max(0,Math.min(idx,RBATTLE.turns.length-1)); const t=RBATTLE.turns[RTURN];
        const acn={}; const a1=t.side1.party[t.side1.active_idx], a2=t.side2.party[t.side2.active_idx]; if(a1&&a2&&a1.name!==a2.name){ acn[a1.name]=1; acn[a2.name]=2; }
        const wc=t.weather_count?`（あと${t.weather_count}）`:''; const wx=(t.weather&&WEATHER[t.weather])?`${WEATHER[t.weather]}${wc}　`:''; const trc=t.trick_room_count?`（あと${t.trick_room_count}）`:''; const tr=t.trick_room?`🌀 トリックルーム${trc}`:''; const ACT=parseActions(t.logs, acn);
        const banner=(wx||tr)?`<div class="rp-banner">${wx}${tr}</div>`:'';
        $('replay-sides').innerHTML=`${banner}<div class="rp-grid">${renderColumn(t.side1,true,ACT[1])}${renderColumn(t.side2,false,ACT[2])}</div>`;
        const simple=summarizeTurn(t.logs, acn);
        $('replay-log').innerHTML =
          `<div class="rlog-simple">${simple.length?simple.map(s=>`<div>${s}</div>`).join(''):'<div class="muted">行動なし</div>'}</div>`
          + `<details class="rlog-detail"><summary>詳細ログを見る</summary><div class="rlog-full">${reorderLogs(t.logs||[]).map(l=>`<div>${l}</div>`).join('')||'—'}</div></details>`;
        $('replay-turn').textContent=`ターン ${t.turn} / ${RBATTLE.turns.length-1}`;
        const rb=$('replay-result'); if(RTURN===RBATTLE.turns.length-1){rb.textContent='🏆 '+RBATTLE.winner;rb.className='wr-tag '+(RBATTLE.result===1?'g':RBATTLE.result===2?'r':'n');}else rb.textContent=''; }
      function stepTurn(d){stopAuto();renderReplay(RTURN+d);}
      function toggleAuto(){if(autoTimer)stopAuto();else{$('btn-auto').textContent='停止';autoTimer=setInterval(()=>{if(RTURN>=RBATTLE.turns.length-1){stopAuto();return;}renderReplay(RTURN+1);},900);}}
      function stopAuto(){if(autoTimer){clearInterval(autoTimer);autoTimer=null;}const b=$('btn-auto');if(b)b.textContent='自動再生';}
    </script>
  </body>
</html>
