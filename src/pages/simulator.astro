---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SimulatorApp from '../components/SimulatorApp.astro';

const title = 'シミュレーション：M-A（バトルシミュレータ）| ポケナビ';
const description = 'M-A環境（M-1／M-2）のランカー同士の総当たり対戦シミュレーション。パーティを選び、各ランカー・各ポケモンとの勝率・選出・1v1相性・実戦リプレイをデータで診断します。';
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} imageUrl="/og-image.png" />
  </head>
  <body>
    <Header />
    <SimulatorApp mode="MA" />
    <Footer />
  </body>
</html>
