# Cloudflare Web Analytics
# Cloudflare ダッシュボード → Web Analytics → サイト追加 → トークンを取得
# 本番では Cloudflare Pages の環境変数に設定する
PUBLIC_CF_BEACON_TOKEN=

# Google AdSense
# https://adsense.google.com/ で取得したパブリッシャーID（例: ca-pub-XXXXXXXXXXXXXXXX）
# 本番では Cloudflare Pages の環境変数に設定する
PUBLIC_ADSENSE_CLIENT_ID=

# Amazon アソシエイト
# https://affiliate.amazon.co.jp/ で取得したトラッキングID（例: pokenavi-22）
# 未設定でもリンクは機能するが、収益は発生しない
PUBLIC_AMAZON_ASSOCIATE_TAG=

# 忍者AdMax（軸2件以上の/party-suggest/ライブ計算待ち専用の広告ダイアログ）
# AdMaxの管理画面（広告枠の管理）で発行される埋め込みHTML（<div>+<script>）を
# そのまま1行の文字列として貼り付ける（改行はエスケープ不要、シングルクォートで囲む）。
# PC向け/スマホ向けは別の広告枠(別タグ)が必要。表示時のビューポート幅(640px)で
# どちらを使うか自動で出し分ける。片方だけ設定してももう片方は空のまま無効化される。
# 両方未設定なら機能自体が無効化され、従来どおり広告なしの待機表示になる。
PUBLIC_ADMAX_SUGGEST_LOADING_EMBED=
PUBLIC_ADMAX_SUGGEST_LOADING_EMBED_MOBILE=
